        Me.DesignerMenus.AddToolbar(Me.Commands, "align-vcenter", "Middle", "Align vertical centers", StudioDesignerGlyph("align-vcenter", 40, dark))
        Me.DesignerMenus.AddToolbar(Me.Commands, "align-bottom", "Bottom", "Align bottom edges", StudioDesignerGlyph("align-bottom", 40, dark))
