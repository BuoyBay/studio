''' Prompt suffix naming files the user attached in the agent pane. Agents read them with
''' their own file tools; Studio never uploads attachment bytes itself.
Private Function StudioAttachmentNote(attachments As Array Of ChatAttachment) As String
    Dim note As String = "\n\nAttached files (read them with your file tools):"
    For Each attachment As ChatAttachment In attachments
        note += "\n- " + attachment.Path + " (" + attachment.MimeType + ", " + ChatByteSize(attachment.Size) + ")"
    Next
    Return note
End Function

''' A short, human-readable argument summary for an inline tool row.
Private Function StudioToolDetail(arguments As JSONItem) As String
    If arguments = Nil Then Return ""
    Dim source As JSONItem = arguments
    If source.HasKey("params") Then source = source.Value("params")
    If source.HasKey("arguments") Then source = source.Value("arguments")
    If Not source.IsObject() Then Return ""
    For Each key As String In ["path", "item", "itemId", "file", "query", "name", "script", "target"]
        If source.HasKey(key) Then
            Dim text As String = source.Value(key).AsString().Or("")
            If text <> "" Then Return String.Left(text, 160)
        End If
    Next
    Return ""
End Function

