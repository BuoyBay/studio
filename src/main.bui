Private Class StudioAgentAccessWindow Inherits Window
    Public Property HostWindow As Weak StudioWindow
    Private Property Tools As Array Of Checkbox = []
    Private Property Resources As Checkbox = New Checkbox()
    Private Property Attachments As Checkbox = New Checkbox()
    Private Property Guidance As Checkbox = New Checkbox()
    Private Property ApplyButton As StudioAgentAccessSave = New StudioAgentAccessSave()
    Private Property Explanation As Label = New Label()

    Public Sub Constructor(owner As StudioWindow, settings As StudioAgentAccess)
        Me.HostWindow = owner
        Me.Title = "Agent tools and resources"
        Me.Move(180, 120, 680, 520)
        Me.Explanation.Text = "Controls Studio-hosted capabilities. Review edits asks before applying buffer changes.\nScripts run with OS privileges; native provider commands remain disabled.\nChanges apply to a fresh session. Stop the agent before changing access."
        Me.Explanation.Multiline = True
        Me.Explanation.Move(20, 16, 640, 72)
        Me.AddSubview(Me.Explanation)
        Dim names As Array Of String = StudioAgentAccess.ToolNames()
        For i As Integer = 0 To Array.Count(names) - 1
            Dim box As New Checkbox()
            box.Caption = names(i)
            box.AccessibleLabel = "Enable agent tool " + names(i)
            box.Value = If(settings.DisabledTools.Contains(names(i)), Checkbox.CheckState.False, Checkbox.CheckState.True)
            box.Move(20 + (i \ 8) * 330, 98 + (i Mod 8) * 30, 320, 26)
            Me.Tools.Append(box)
            Me.AddSubview(box)
        Next
        Me.Resources.Caption = "Project buffer resources (MCP)"
        Me.Attachments.Caption = "Attached project item previews"
        Me.Guidance.Caption = "Buoy compiler guidance in context"
        Me.Resources.Value = If(settings.Resources, Checkbox.CheckState.True, Checkbox.CheckState.False)
        Me.Attachments.Value = If(settings.Attachments, Checkbox.CheckState.True, Checkbox.CheckState.False)
        Me.Guidance.Value = If(settings.Guidance, Checkbox.CheckState.True, Checkbox.CheckState.False)
        Me.Resources.Move(20, 352, 640, 26)
        Me.Attachments.Move(20, 382, 640, 26)
        Me.Guidance.Move(20, 412, 640, 26)
        Me.AddSubview(Me.Resources)
        Me.AddSubview(Me.Attachments)
        Me.AddSubview(Me.Guidance)
        Me.ApplyButton.Caption = "Apply"
        Me.ApplyButton.Owner = Me
        Me.ApplyButton.Move(550, 464, 110, 28)
        Me.AddSubview(Me.ApplyButton)
    End Sub

    Public Sub Save()
        Dim owner As StudioWindow = Me.HostWindow
        If owner = Nil Then Return
        Dim disabled As New Set Of String()
        Dim names As Array Of String = StudioAgentAccess.ToolNames()
        For i As Integer = 0 To Array.Count(names) - 1
            If Me.Tools(i).Value <> Checkbox.CheckState.True Then disabled.Add(names(i))
        Next
        If owner.ApplyAgentTools(disabled, Me.Resources.Value = Checkbox.CheckState.True, Me.Attachments.Value = Checkbox.CheckState.True, Me.Guidance.Value = Checkbox.CheckState.True) Then Me.Close()
    End Sub
End Class

