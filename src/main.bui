Const StudioPrefsDomain As String = "com.buoy.studio"

Private Function StudioConfigObject(source As String) As JSONItem
    Dim encoded As Bytes = Bytes.FromString(source, Text.Encodings.UTF8)
    If encoded.Count > 65536 Then Throw New InvalidArgumentException("Studio JSON config exceeds 64 KiB")
    Dim compact As New Bytes()
    Dim quoted As Boolean = False
    Dim escaped As Boolean = False
    For i As Integer = 0 To encoded.Count - 1
        Dim value As Integer = encoded.Item(i)
        If Not quoted And (value = 10 Or value = 13) Then
            compact.Append(32)
        Else
            compact.Append(value)
        End If
        If quoted Then
            If escaped Then
                escaped = False
            ElseIf value = 92 Then
                escaped = True
            ElseIf value = 34 Then
                quoted = False
            End If
        ElseIf value = 34 Then
            quoted = True
        End If
    Next
    compact.Append(10)
    Dim decoder As New JSONLDecoder(65536, 65537, 1)
    Dim decoded As Array Of JSONItem = decoder.Feed(compact)
    decoder.Finish()
    If Array.Count(decoded) <> 1 Then Throw New InvalidArgumentException("One Studio JSON config object is required")
    Return decoded(0)
End Function

Private Sub Need(passed As Boolean, message As String)
    If Not passed Then Throw New Exception(message)
End Sub

''' Toolbar artwork comes from the same Buoy glyph set as the designer and navigator.
Private Function StudioIcon(key As String) As Picture
    Dim glyph As Picture = StudioGlyph(key, 40, StudioGlyphsDark())
    If glyph <> Nil Then glyph.Scale = 2.0
    Return glyph
End Function

''' Buoy glyph tint follows the same appearance test as the toolbar glyphs.
Private Function StudioGlyphsDark() As Boolean
    Dim dark As Boolean = StudioUsesDarkAppearance()
    #If TargetLinux Then
        If String.Contains(System.EnvironmentVariable("GTK_THEME").Or(""), ":dark", True) Then dark = True
    #End If
    Return dark
End Function

Private Function StudioGlyphFile(key As String) As String
    If StudioGlyphSource(key) = "" Then key = "status.unknown"
    Dim appearance As String = "light"
    If StudioGlyphsDark() Then appearance = "dark"
    Dim iconSuffix As String = ".png"
    #If TargetMac Then
        iconSuffix = "-2x.png"
    #End If
    #If TargetWindows Then
        iconSuffix = ".ico"
    #End If
    Dim item As FileSystemItem = FileSystemItem.AppResource(key + "-" + appearance + iconSuffix)
    If item = Nil Then Return ""
    Return item.FullPath()
End Function

Private Function StudioShortcut(key As String) As String
    #If TargetMac Then
        Return "Cmd+" + key
    #Else
        Return "Ctrl+" + key
    #End If
End Function

''' The startup document: a complete, compilable declarative window, so the designer
''' opens on a realistic form instead of an empty canvas.
Private Function StudioExampleLayout() As String
    Dim text As String = "Public Window ContactWindow\n"
    text += "    Title = \"New Contact\"\n"
    text += "    Frame = (120, 120, 520, 360)\n"
    text += "    Control Label heading\n        Text = \"Contact details\"\n        Frame = (20, 16, 280, 22)\n    End Control\n"
    text += "    Control Label nameLabel\n        Text = \"Name:\"\n        Frame = (20, 56, 84, 22)\n    End Control\n"
    text += "    Control TextField nameField\n        AccessibleLabel = \"Name\"\n        Text = \"Ada Lovelace\"\n        Frame = (112, 54, 280, 24)\n    End Control\n"
    text += "    Control Label emailLabel\n        Text = \"Email:\"\n        Frame = (20, 92, 84, 22)\n    End Control\n"
    text += "    Control TextField emailField\n        AccessibleLabel = \"Email address\"\n        Text = \"ada@example.com\"\n        Frame = (112, 90, 280, 24)\n    End Control\n"
    text += "    Control View optionsGroup\n        Frame = (20, 136, 372, 92)\n"
    text += "        Control Checkbox updatesBox\n            Caption = \"Send product updates\"\n            Frame = (12, 14, 240, 22)\n        End Control\n"
    text += "        Control Checkbox favoriteBox\n            Caption = \"Add to Favorites\"\n            Value = Checkbox.CheckState.True\n            Frame = (12, 50, 240, 22)\n        End Control\n"
    text += "    End Control\n"
    text += "    Control Button cancelButton\n        Caption = \"Cancel\"\n        Frame = (300, 312, 96, 28)\n    End Control\n"
    text += "    Control Button saveButton\n        Caption = \"Save\"\n        Frame = (404, 312, 96, 28)\n    End Control\n"
    text += "End Window\n"
    Return text
End Function

