    Private Sub BuildSourceCommands(menu As Menu)
        Me.MenuEntry(menu, "Snippet Templates…", "snippets", "")
        Me.MenuEntry(menu, "Import Xippets / Studio Templates…", "snippets-import", "")
        Me.MenuEntry(menu, "Export User Templates…", "snippets-export", "")
        menu.AddSeparator()
        Dim groups As New Map Of String, MenuItem()
        For Each info As StudioEditorCommandInfo In StudioEditorCommandList()
            Dim tag As String = "source:" + info.Id
            Dim found As Boolean = False
            For Each existing As StudioCommand In Me.Navigation.Commands.Search("", "source")
                If existing.ID = tag Then found = True
            Next
            If Not found Then Me.Navigation.Commands.Register(tag, info.Title, "source")
            ' Source bindings run through the focused canvas, not native menu accelerators.
            If Me.Navigation.Commands.Binding(tag) = "" And (String.Contains(info.Shortcut, "Primary+") Or String.Contains(info.Shortcut, "Alt+")) Then Me.Navigation.Commands.Bind(tag, info.Shortcut, False)
            If Me.Menus.FindMenuByTag(tag) <> Nil Then Continue For
            Dim group As MenuItem
            If groups.ContainsKey(info.Category) Then
                group = groups.Get(info.Category).Value
            Else
                group = New MenuItem()
                group.Caption = info.Category
                group.Tag = "source-group:" + info.Category
                groups.Set(info.Category, group)
                menu.AddItem(group)
                If info.Category = "Multi-Cursor" Then
                    Dim gesture As New MenuItem()
                    #If TargetMac Then
                        gesture.Caption = "Option-click: add/remove cursor · Option-drag: column select"
                    #Else
                        gesture.Caption = "Alt-click: add/remove cursor · Shift+Alt-drag: column select"
                    #End If
                    gesture.Tag = "source-hint:multicursor"
                    gesture.Enabled = False
                    group.AddMenuItem(gesture)
                    group.AddSeparator()
                End If
            End If
            Dim entry As New MenuItem()
            entry.Caption = info.Title
            Dim shortcut As String = Me.Navigation.Commands.Binding(tag)
            If shortcut = "" And Not String.Contains(info.Shortcut, "+") Then shortcut = info.Shortcut
            If shortcut <> "" Then entry.Caption += " (" + StudioEditorShortcutLabel(shortcut) + ")"
            entry.Tag = tag
            group.AddMenuItem(entry)
        Next
    End Sub

    Public Function ShellSnippetToken() As String
        If Me.SelectedId = "" Then Return ""
        Dim token As String = Me.LanguageRevisionToken() + "|" + Me.SelectedId + "|" + String.From(Me.WorkspaceGeneration)
        For Each selection As StudioEditorSelection In Me.CurrentSourceEditor().GetSelections()
            token += ":a" + String.From(selection.Anchor) + ":c" + String.From(selection.Caret)
        Next
        token += ":primary" + String.From(Me.CurrentSourceEditor().PrimarySelectionIndex)
        If Me.LastSourceEditor = Me.SplitEditor And Me.SourceSplitEnabled Then token += ":split"
        Return token
    End Function

    Public Sub ShowSnippets(action As String = "")
        If Me.SelectedId = "" Then Throw New InvalidArgumentException("Open a text document first")
        Me.SetDesignMode(False)
        If Me.SnippetView = Nil Then Me.SnippetView = New StudioShellSnippetWindow()
        Me.SnippetView.Present(Me.SnippetLibrary, Me, Me.CurrentSourceEditor().LanguageMode, Me.ShellSnippetToken())
        If action <> "" Then Me.SnippetView.Command(action)
    End Sub

    Public Function ShellInsertSnippet(id As String, expectedToken As String) As String
        Try
            If Me.SelectedId = "" Or Me.DesignMode Or Me.CurrentSourceEditor().IsReadOnly Then Return "Snippet destination is unavailable"
            If expectedToken <> Me.ShellSnippetToken() Then Return "Snippet destination changed; reopen the picker"
            If String.Compare(Me.CurrentSourceEditor().Text, Me.Workspace.ReadItem(Me.SelectedId).Text, True) <> 0 Then Return "Editor text is not synchronized"
            Dim template As JSONItem = Me.SnippetLibrary.TemplateWithId(id)
            If template = Nil Then Return "Snippet no longer exists"
            If Not StudioSnippetLanguageMatches(template.Value("language").AsString().Value, Me.CurrentSourceEditor().LanguageMode) Then Return "Snippet language does not match this document"
            Dim expansion As StudioSnippetExpansion = Me.SnippetLibrary.ExpansionFor(id)
            If expansion = Nil Then Return Me.SnippetLibrary.LastError
            Me.CurrentSourceEditor().InsertSnippetExpansion(expansion.Text, expansion.Indexes, expansion.Starts, expansion.Lengths, expansion.FinalCaret)
            Me.CurrentSourceEditor().Focus()
            Return ""
        Catch e As Exception
            Return e.Message
        End Try
    End Function

    Public Sub ShellSnippetsChanged()
        If Me.PersistLayout Then Prefs.Set(StudioPrefsDomain, "studio.userSnippets", Me.SnippetLibrary.ExportText())
    End Sub

