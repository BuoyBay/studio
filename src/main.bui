Private Class StudioShellLanguageSubmit Inherits Button
    Public Property Owner As Weak StudioShellLanguageQuery
    Handle Action()
        Dim query As StudioShellLanguageQuery = Me.Owner
        If query <> Nil Then query.Submit()
    End Handle
End Class

Private Class StudioShellLanguageQuery Inherits Window
    Public Property HostWindow As Weak StudioWindow
    Public Property CommandKind As String
    Public Property Token As String
    Public Property Snapshot As StudioLanguageBuffer
    Public Property Query As TextField = New TextField()
    Private Property SubmitButton As StudioShellLanguageSubmit = New StudioShellLanguageSubmit()
    Public Sub Constructor()
        Super.Constructor()
        Me.Move(180, 180, 500, 120)
        Me.Query.Move(16, 16, 468, 28)
        Me.SubmitButton.Caption = "Request"
        Me.SubmitButton.Owner = Me
        Me.SubmitButton.Move(364, 64, 120, 28)
        Me.AddSubview(Me.Query)
        Me.AddSubview(Me.SubmitButton)
    End Sub
    Public Sub Submit()
        Dim target As StudioWindow = Me.HostWindow
        If target = Nil Then Return
        Dim current As StudioLanguageBuffer = target.LanguageBuffer()
        If current = Nil Or Me.Snapshot = Nil Then Return
        If target.LanguageRevisionToken() <> Me.Token Or current.Path <> Me.Snapshot.Path Or current.Line <> Me.Snapshot.Line Or current.Column <> Me.Snapshot.Column Or current.EndLine <> Me.Snapshot.EndLine Or current.EndColumn <> Me.Snapshot.EndColumn Then
            target.LanguageStatus("Document or selection changed; request this action again.")
            Me.Visible = False
            Return
        End If
        target.Language.Command(Me.CommandKind, Me.Query.Text)
        Me.Visible = False
    End Sub
    Handle Closing() As Boolean
        Me.Visible = False
        Return True
    End Handle
End Class

Private Function StudioSourceCommand(tag As String) As String
    Dim known As String = StudioEditorCommand(tag)
    If known <> "" Then Return known
    If tag = "source:next-problem" Then Return "goToNextMarker"
    If tag = "source:previous-problem" Then Return "goToPreviousMarker"
    If Not String.StartsWith(tag, "source:") Then Return ""
    Dim name As String = String.Substring(tag, 7)
    If StudioEditorCommandInfoFor(name) <> Nil Then Return name
    Return ""
End Function

Private Class ProjectEditor Inherits StudioCodeEditor
    Public Property Owner As Weak StudioWindow
    Handle TextChanged()
        Dim target As StudioWindow = Me.Owner
        If target <> Nil Then
            target.EditorChangedFrom(Me)
            target.QueueInlineCompletion(Me)
        End If
    End Handle
    Handle SelectionChanged()
        Dim target As StudioWindow = Me.Owner
        If target <> Nil Then
            target.EditorSelectionChangedFrom(Me)
            target.UpdateInlineWaitingTicket(Me)
        End If
    End Handle
    Handle SymbolAction(action As String, symbol As StudioEditorSymbol)
        Dim target As StudioWindow = Me.Owner
        If target = Nil Then Return
        target.EditorSelectionChangedFrom(Me)
        Select Case action
            Case "definition", "references", "rename"
                target.LanguageCommand(action)
            Case "info"
                target.LanguageCommand("hover")
            Case "documentation"
                target.ShowDocumentation("")
                If target.Documentation <> Nil Then target.Documentation.ShowTopic(symbol.QualifiedName, "symbol")
            Case "findInProject"
                target.ShowProjectSearch()
        End Select
    End Handle
    Handle ShortcutRequested(chord As String) As Boolean
        Dim target As StudioWindow = Me.Owner
        If target = Nil Then Return False
        Return target.SourceShortcut(chord, Me)
    End Handle
    Handle ProblemRequested(lineIndex As Integer, message As String)
        Dim target As StudioWindow = Me.Owner
        If target <> Nil Then
            target.EditorSelectionChangedFrom(Me)
            target.ShowEditorProblems(lineIndex, message)
        End If
    End Handle
    Handle ClipboardCopied(text As String)
        Dim target As StudioWindow = Me.Owner
        If target <> Nil Then
            target.EditorSelectionChangedFrom(Me)
            target.SourceClipboardCopied(text)
        End If
    End Handle
    Handle CompletionRequested(trigger As String, position As Integer, prefix As String)
        Dim target As StudioWindow = Me.Owner
        If target <> Nil Then target.SourceCompletion(trigger, Me)
    End Handle
    Handle HistoryAvailable(redo As Boolean) As Boolean
        Dim target As StudioWindow = Me.Owner
        If target = Nil Then Return False
        Return target.SourceHistoryAvailable(redo)
    End Handle
    Handle UndoRequested(redo As Boolean)
        Dim target As StudioWindow = Me.Owner
        If target = Nil Then Return
        target.EditorSelectionChangedFrom(Me)
        If redo Then
            target.Action("redo")
        Else
            target.Action("undo")
        End If
    End Handle
End Class

