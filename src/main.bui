    Public Sub Constructor(persistLayout As Boolean)
        Super.Constructor()
        Me.PersistLayout = persistLayout
        Me.Title = StudioCurrentWindowTitle("")
        If persistLayout Then
            Dim display As Screen = System.Screen(0)
            Dim startupWidth As Integer = Math.Max(640, Math.Min(1440, Math.Round(display.Width) - 32))
            Dim startupHeight As Integer = Math.Max(480, Math.Min(900, Math.Round(display.Height) - 120))
            Dim startupLeft As Integer = Math.Round(display.Left + (display.Width - startupWidth) / 2.0)
            Me.Move(startupLeft, Math.Round(display.Top) + 48, startupWidth, startupHeight)
        Else
            Me.Move(70, 60, 1440, 900)
        End If
        Me.Link.Host = Me
        If Me.PersistLayout Then
            Me.Panes.Load(StudioPrefsDomain)
            Me.EditorSettings.Load(StudioPrefsDomain)
            StudioScriptSettings.Load(StudioPrefsDomain)
            Me.AgentAccess.Load(StudioPrefsDomain)
            StudioCompletionSettings.Load(StudioPrefsDomain)
        End If
        Me.GitBridge.Host = Me
        Me.Navigation.Host = Me
        Me.Navigation.Domain = StudioPrefsDomain
        #If TargetLinux Then
            Me.Navigation.LinuxNative = True
        #End If
        Me.BuildMenus()
        If Me.PersistLayout Then
            Dim issue As String = Me.Navigation.Load()
            If issue <> "" Then Me.AddMessage(issue)
        End If
        Me.BuildToolbar()
        Me.BuildPanes()
        If Me.PersistLayout Then
            Dim savedSnippets As String = Prefs.Get(StudioPrefsDomain, "studio.userSnippets", "")
            If savedSnippets <> "" Then
                If Me.SnippetLibrary.ImportText(savedSnippets) < 0 Then Me.AddMessage("Saved snippets: " + Me.SnippetLibrary.LastError)
            End If
        End If
        Me.Editor.SnippetProvider = Me.SnippetLibrary
        Me.SplitEditor.SnippetProvider = Me.SnippetLibrary
        Me.Editor.Owner = Me
        Me.SplitEditor.Owner = Me
        Me.Tabs.Owner = Me
        Me.EditorSettings.Apply(Me.SplitEditor)
        Me.Editor.ShowsSymbolActions = True
        Me.SplitEditor.ShowsSymbolActions = True
        Me.EditorSettings.Apply(Me.Editor)
        Me.Designer.Catalog.RegisterBuiltinControls()
        RegisterStudioMaskEditors(Me.Designer.Catalog)
        Me.Designer.AttachHost(Me)
        Me.Designer.SetViewport(1.0, 24.0, 24.0)
        Me.Workspace.RegisterItem("layout-example", "ContactWindow.bui", "source", StudioExampleLayout())
        Me.Workspace.RegisterItem("main", "main.bui", "source", "Import ContactWindow\nSub Main(args As Array Of String)\n    Dim form As New ContactWindow()\n    form.Show()\n    Application.Run()\nEnd Sub\n")
        Me.Workspace.RegisterItem("notes", "Notes.md", "document", "# Contact sample\n\nAgents read registered items, including unsaved text.\nProposed changes stay previews until you choose Apply changes.\n")
        For Each initial As ProjectItem In Me.Workspace.Items()
            Me.DiskText.Set(initial.Id, initial.Text)
        Next
        Me.Chat.AttachHost(Me)
        Me.CurrentWorkingDirectory = System.EnvironmentVariable("BUOY_STUDIO_CWD").Or(System.EnvironmentVariable("PWD").Or("."))
        Me.ConfigureProviders()
        Dim suggestions As Array Of String = ["Explain the open file", "Check the project and fix any compile errors", "Add a Save button to the window layout"]
        Me.Chat.SetEmptyState("Ask the agent", "Nothing is sent until you press Send.", suggestions)
        ' Development toggle: View > Web Chat Transcript switches web and native transcripts.
        If Prefs.Get(StudioPrefsDomain, "studio.webChat", "on") = "off" Then Me.Chat.UsePlainTranscript()
        Me.Chat.SetDarkAppearance(StudioUsesDarkAppearance())
        Me.ModeSwitch.AddSegment("Design")
        Me.ModeSwitch.AddSegment("Source")
        Me.ModeSwitch.SelectedSegmentIndex = 0
        Me.Filter.Placeholder = "Filter"
        Me.AddMessage("Opened the Contact sample. Drag controls on the canvas or edit them in the Inspector.")
        Me.SelectItemId("layout-example")
        Me.SelectControlPath("ContactWindow/nameField")
        Me.Poller.Owner = Me
        Me.Poller.Period = 30
        Me.Poller.Start()
    End Sub

    Private Sub ConfigureButton(button As StudioButton, title As String, actionName As String)
        button.Owner = Me
        button.Caption = title
        button.ActionName = actionName
    End Sub

    Private Function MenuEntry(menu As Menu, caption As String, tag As String, shortcut As String) As MenuItem
        Dim item As New MenuItem()
        item.Caption = caption
        item.Tag = tag
        Dim registered As Boolean = False
        For Each command As StudioCommand In Me.Navigation.Commands.Search("", "global")
            If command.ID = tag Then registered = True
        Next
        For Each command As StudioCommand In Me.Navigation.Commands.Search("", "source")
            If command.ID = tag Then registered = True
        Next
        If Not registered Then Me.Navigation.Commands.Register(tag, caption)
        If shortcut <> "" And Me.Navigation.Commands.Binding(tag) = "" Then
            Dim conflict As String = Me.Navigation.Commands.Bind(tag, shortcut, Me.Navigation.LinuxNative)
            If conflict <> "" Then Me.AddMessage("Shortcut for " + caption + ": " + conflict)
        End If
        Dim primary As String = "Ctrl"
        #If TargetMac Then
            primary = "Cmd"
        #End If
        item.Shortcut = Me.Navigation.Commands.NativeShortcut(tag, primary)
        If String.StartsWith(tag, "source:") Then item.Shortcut = ""
        menu.AddItem(item)
        Return item
    End Function

