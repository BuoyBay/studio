''' Monospace cells a codepoint occupies when drawn alone: 0 for combining marks,
''' joiners, variation selectors and other marks that draw on the preceding character,
''' 2 for East Asian wide/fullwidth characters and emoji, otherwise 1. A table-driven
''' approximation of Unicode East Asian Width; tabs are the caller's concern.
Public Function StudioCellWidth(code As Integer) As Integer
    If code < &h0300 Then Return 1
    StudioCellTables.Prepare()
    If SyntaxInRanges(code, StudioCellTables.ZeroWidth) Then Return 0
    If SyntaxInRanges(code, StudioCellTables.Wide) Then Return 2
    Return 1
End Function

''' Cell geometry of one line: where a caret may stop and which cell it is drawn at.
''' Positions are codepoint indices 0..Count. A caret stops only between clusters: a
''' base character plus its combining marks, a ZWJ emoji sequence, or a regional-
''' indicator flag pair are one cluster. Tabs advance to the next IndentWidth stop.
Public Class StudioLineLayout
    ''' Visual cell before codepoint i (Count + 1 entries).
    Public Property Visual As Array Of Integer = []
    ''' True where a caret may stop before codepoint i (Count + 1 entries).
    Public Property Boundary As Array Of Boolean = []
    Public Property Count As Integer = 0
    ''' True when every character is one cell and one cluster (no tabs, no wide text).
    Public Property Simple As Boolean = True

    Public Sub Constructor(line As String, indentWidth As Integer)
        Dim tab As Integer = Math.Max(1, indentWidth)
        Dim column As Integer = 0
        Dim joinNext As Boolean = False
        Dim pictographicBase As Boolean = False
        Dim regionalRun As Integer = 0
        Dim previousControl As Boolean = False
        Dim index As Integer = 0
        Array.Append(Me.Visual, 0)
        Array.Append(Me.Boundary, True)
        For Each ch As String In String.Chars(line)
            Dim code As Integer = String.Asc(ch)
            Dim cells As Integer = 1
            Dim joined As Boolean = False
            Dim flag As Boolean = code >= &h1F1E6 And code <= &h1F1FF
            StudioCellTables.Prepare()
            Dim pictographic As Boolean = SyntaxInRanges(code, StudioCellTables.Pictographic)
            Dim control As Boolean = SyntaxInRanges(code, StudioCellTables.Control)
            Dim pairedFlag As Boolean = flag And regionalRun Mod 2 = 1
            Dim joinedEmoji As Boolean = joinNext And pictographic
            If code = 9 Then
                cells = tab - (column Mod tab)
                Me.Simple = False
            Else
                Dim natural As Integer = StudioCellWidth(code)
                If index > 0 And Not control And Not previousControl And (joinedEmoji Or natural = 0 Or pairedFlag) Then
                    joined = True
                    ' A flag pair is one wide glyph: the second indicator adds the second cell.
                    cells = 0
                    If pairedFlag Then cells = 1
                Else
                    cells = Math.Max(1, natural)
                    If control And natural = 0 Then cells = 0
                End If
                If natural <> 1 Or joined Then Me.Simple = False
            End If
            If flag Then
                regionalRun += 1
            Else
                regionalRun = 0
            End If
            If code = &h200D Then
                joinNext = pictographicBase
                pictographicBase = False
            ElseIf SyntaxInRanges(code, StudioCellTables.Extend) Then
                joinNext = False
            Else
                joinNext = False
                pictographicBase = pictographic
            End If
            previousControl = control
            Me.Boundary(index) = Not joined
            column += cells
            Array.Append(Me.Visual, column)
            Array.Append(Me.Boundary, True)
            index += 1
        Next
        Me.Count = index
        If index > 0 Then Me.Boundary(0) = True
    End Sub

    ''' Total width in cells.
    Public Property Width As Integer
        Get
            Return Me.Visual(Me.Count)
        End Get
    End Property

    ''' Visual cell of a codepoint column; columns past the end continue one cell each.
    Public Function CellOf(column As Integer) As Integer
        If column <= 0 Then Return 0
        If column >= Me.Count Then Return Me.Visual(Me.Count) + column - Me.Count
        Return Me.Visual(column)
    End Function

    ''' The caret stop nearest to a (fractional) visual cell.
    Public Function ColumnAt(visualTarget As Double) As Integer
        If visualTarget <= 0 Then Return 0
        Dim previous As Integer = 0
        For i As Integer = 1 To Me.Count
            If Me.Boundary(i) Then
                If visualTarget < (Me.Visual(previous) + Me.Visual(i)) / 2.0 Then Return previous
                previous = i
            End If
        Next
        Return Me.Count
    End Function

    ''' The caret stop at or before `column`.
    Public Function StopBefore(column As Integer) As Integer
        Dim i As Integer = Math.Max(0, Math.Min(column, Me.Count))
        While i > 0 And Not Me.Boundary(i)
            i -= 1
        Wend
        Return i
    End Function

    ''' The caret stop at or after `column`.
    Public Function StopAfter(column As Integer) As Integer
        Dim i As Integer = Math.Max(0, Math.Min(column, Me.Count))
        While i < Me.Count And Not Me.Boundary(i)
            i += 1
        Wend
        Return i
    End Function

    ''' The previous caret stop strictly before `column` (0 stays 0).
    Public Function PreviousStop(column As Integer) As Integer
        If column <= 0 Then Return 0
        Return Me.StopBefore(Math.Min(column, Me.Count) - 1)
    End Function

    ''' The next caret stop strictly after `column` (Count stays Count).
    Public Function NextStop(column As Integer) As Integer
        If column >= Me.Count Then Return Me.Count
        Return Me.StopAfter(Math.Max(0, column) + 1)
    End Function
End Class

' ---- Block structure (smart indent) -----------------------------------------------------

Public Enum StudioBlockRole As Integer
    None = 0
    Opens = 1
    Continues = 2
    Closes = 3
End Enum

''' How one line takes part in Buoy block structure. `Kind` names the block family
''' ("if", "for", "sub", "#if", ...) shared by its opener, middle and closing lines.
Public Class StudioBlockInfo
    Public Property Role As StudioBlockRole = StudioBlockRole.None
    Public Property Kind As String = ""
    ''' The closing line an opener expects ("End If", "Next", "Loop", "#End If", ...).
    Public Property Closer As String = ""
    ''' A `Property` declaration that may be followed by Get/Set blocks.
    Public Property IsPropertyHeader As Boolean = False
    ''' A Sub/Function/Property/Operator signature (opens a body unless in an Interface).
    Public Property IsMember As Boolean = False
End Class

Private Function SyntaxBlockModifier(word As String) As Boolean
    Select Case word
    Case "public", "private", "protected", "internal", "shared", "static", "partial", "overrides", "async", "inline", "export", "final", "sequential", "packed", "flags", "extension", "iterator"
        Return True
    End Select
    Return False
End Function

''' Closing line for a block family.
Public Function StudioBlockCloser(kind As String) As String
    Select Case kind
    Case "for"
        Return "Next"
    Case "do"
        Return "Loop"
    Case "#if"
        Return "#End If"
    Case "if"
        Return "End If"
    Case "while"
        Return "End While"
    Case "select"
        Return "End Select"
    Case "try"
        Return "End Try"
    Case "sub"
        Return "End Sub"
    Case "function"
        Return "End Function"
    Case "class"
        Return "End Class"
    Case "interface"
        Return "End Interface"
    Case "enum"
        Return "End Enum"
    Case "flags enum"
        Return "End Flags Enum"
    Case "structure"
        Return "End Structure"
    Case "get"
        Return "End Get"
    Case "set"
        Return "End Set"
    Case "handle"
        Return "End Handle"
    Case "operator"
        Return "End Operator"
    Case "with"
        Return "End With"
    Case "synclock"
        Return "End SyncLock"
    Case "namespace"
        Return "End Namespace"
    Case "window"
        Return "End Window"
    Case "view"
        Return "End View"
    Case "control"
        Return "End Control"
    Case "tab"
        Return "End Tab"
    Case "page"
        Return "End Page"
    Case "constraints"
        Return "End Constraints"
    End Select
    Return ""
End Function

''' Classifies a source line for block structure, ignoring comments and string
''' contents. Single-line forms (`If x Then y`, `Declare Function`, abstract members)
''' are not openers. Whether a member opens a body inside an Interface is the
''' caller's concern (`IsMember`).
Public Function StudioClassifyBlock(line As String, inComment As Boolean) As StudioBlockInfo
    Dim info As New StudioBlockInfo()
    Dim tokens As StudioSyntaxLine = StudioTokenizeLine(line, inComment)
    Dim words As Array Of String = []
    Dim kinds As Array Of StudioTokenKind = []
    For Each token As StudioSyntaxToken In tokens.Tokens
        If token.Kind <> StudioTokenKind.Comment Then
            Array.Append(words, String.LCase(String.Substring(line, token.Start, token.Length)))
            Array.Append(kinds, token.Kind)
        End If
    Next
    Dim count As Integer = Array.Count(words)
    If count = 0 Then Return info
    Dim first As Integer = 0
    Dim isFlags As Boolean = False
    Dim isAbstract As Boolean = False
    While first < count - 1 And (SyntaxBlockModifier(words(first)) Or words(first) = "abstract")
        If words(first) = "flags" Then isFlags = True
        If words(first) = "abstract" Then isAbstract = True
        first += 1
    Wend
    Dim word As String = words(first)
    Dim following As String = ""
    If first + 1 < count Then following = words(first + 1)
    Dim last As String = words(count - 1)
    Dim kind As String = ""
    Dim role As StudioBlockRole = StudioBlockRole.None
    Select Case word
    Case "#if"
        kind = "#if"
        role = StudioBlockRole.Opens
    Case "#else", "#elseif"
        kind = "#if"
        role = StudioBlockRole.Continues
    Case "#end"
        kind = "#if"
        role = StudioBlockRole.Closes
    Case "end"
        Dim target As Integer = first + 1
        If target < count Then
            If words(target) = "flags" And target + 1 < count Then
                kind = "flags enum"
            Else
                kind = words(target)
            End If
            If kind = "wend" Then kind = ""
            If StudioBlockCloser(kind) <> "" Or kind = "property" Or kind = "block" Or kind = "lambda" Then role = StudioBlockRole.Closes
        End If
    Case "next"
        kind = "for"
        role = StudioBlockRole.Closes
    Case "loop"
        kind = "do"
        role = StudioBlockRole.Closes
    Case "wend"
        kind = "while"
        role = StudioBlockRole.Closes
    Case "else", "elseif"
        kind = "if"
        role = StudioBlockRole.Continues
    Case "case"
        kind = "select"
        role = StudioBlockRole.Continues
    Case "catch", "finally"
        kind = "try"
        role = StudioBlockRole.Continues
    Case "if"
        If last = "then" Then
            kind = "if"
            role = StudioBlockRole.Opens
        End If
    Case "for", "while", "do", "select", "with", "synclock", "namespace"
        kind = word
        role = StudioBlockRole.Opens
    Case "try"
        If count = first + 1 Then
            kind = "try"
            role = StudioBlockRole.Opens
        End If
    Case "class", "interface", "structure"
        kind = word
        role = StudioBlockRole.Opens
    Case "enum"
        kind = "enum"
        If isFlags Then kind = "flags enum"
        role = StudioBlockRole.Opens
    Case "sub", "function", "operator"
        info.IsMember = True
        If Not isAbstract Then
            kind = word
            role = StudioBlockRole.Opens
        End If
    Case "handle"
        kind = "handle"
        role = StudioBlockRole.Opens
    Case "get", "set"
        If count = first + 1 Or following = "(" Then
            kind = word
            role = StudioBlockRole.Opens
        End If
    Case "property"
        info.IsMember = True
        Dim hasValue As Boolean = False
        For i As Integer = first + 1 To count - 1
            If String.StartsWith(words(i), "=") Then hasValue = True
        Next
        info.IsPropertyHeader = Not hasValue And Not isAbstract
    Case "window", "view", "control"
        If first + 1 < count And kinds(Math.Min(first + 1, count - 1)) <> StudioTokenKind.Punctuation Then
            kind = word
            role = StudioBlockRole.Opens
        End If
    Case "tab"
        If first + 1 < count And kinds(Math.Min(first + 1, count - 1)) = StudioTokenKind.Text Then
            kind = "tab"
            role = StudioBlockRole.Opens
        End If
    Case "page", "constraints"
        If count = first + 1 Then
            kind = word
            role = StudioBlockRole.Opens
        End If
    End Select
    info.Role = role
    info.Kind = kind
    If role = StudioBlockRole.Opens Then info.Closer = StudioBlockCloser(kind)
    Return info
End Function

' ---- Compiler columns ------------------------------------------------------------------

''' Converts a compiler diagnostic column to a 0-based codepoint column within `line`.
''' `buoy --diagnostic-format json` reports `character` 1-based and counted in UTF-8
''' bytes. A byte inside a multi-byte character maps to that character; columns <= 1
''' map to 0 and columns past the end map to the line length.
Public Function StudioColumnFromUtf8(line As String, byteColumn As Integer) As Integer
    Dim target As Integer = byteColumn - 1
    If target <= 0 Then Return 0
    Dim used As Integer = 0
    Dim column As Integer = 0
    For Each ch As String In String.Chars(line)
        Dim size As Integer = String.LenBytes(ch)
        If used + size > target Then Return column
        used += size
        column += 1
    Next
    Return column
End Function

''' The compiler's 1-based UTF-8 byte column for a 0-based codepoint column of `line`.
Public Function StudioUtf8Column(line As String, column As Integer) As Integer
    Dim count As Integer = Math.Max(0, Math.Min(column, String.Len(line)))
    Return String.LenBytes(String.Left(line, count)) + 1 + Math.Max(0, column - count)
End Function

' ---- Language modes ----------------------------------------------------------------------
' Studio also edits auxiliary documents. A mode selects the lexical highlighter only;
' Buoy's block, indent and comment rules apply in "buoy" mode alone. The boolean line
' state carried between lines means "inside a block comment" for Buoy and "inside a
' fenced code block" for Markdown; plain text and JSON carry no state.

''' Normalizes a mode name: "buoy", "plain", "json" or "markdown" ("" and unknown names
''' are "plain").
Public Function StudioLanguageModeName(mode As String) As String
    Select Case String.LCase(String.Trim(mode))
    Case "buoy", "bui"
        Return "buoy"
    Case "json", "jsonc"
        Return "json"
    Case "markdown", "md"
        Return "markdown"
    End Select
    Return "plain"
End Function

''' The mode for a file path by extension: .bui -> buoy, .json/.jsonc/.buipkg.json ->
''' json, .md/.markdown -> markdown, anything else -> plain.
Public Function StudioLanguageModeForPath(filePath As String) As String
    Dim lower As String = String.LCase(filePath)
    If String.EndsWith(lower, ".bui") Then Return "buoy"
    If String.EndsWith(lower, ".json") Or String.EndsWith(lower, ".jsonc") Then Return "json"
    If String.EndsWith(lower, ".md") Or String.EndsWith(lower, ".markdown") Then Return "markdown"
    Return "plain"
End Function

''' Splits every non-whitespace run not covered by a token into Plain tokens, keeping
''' tokens ordered (the editor draws tokens only).
Private Function SyntaxFillGaps(source As String, tokens As Array Of StudioSyntaxToken) As Array Of StudioSyntaxToken
    Dim codes As Array Of Integer = SyntaxCodes(source)
    Dim filled As Array Of StudioSyntaxToken = []
    Dim cursor As Integer = 0
    Dim k As Integer = 0
    While cursor < Array.Count(codes) Or k < Array.Count(tokens)
        Dim nextStart As Integer = Array.Count(codes)
        If k < Array.Count(tokens) Then nextStart = tokens(k).Start
        While cursor < nextStart
            If SyntaxIsSpace(codes(cursor)) Then
                cursor += 1
                Continue While
            End If
            Dim runStart As Integer = cursor
            While cursor < nextStart
                If SyntaxIsSpace(codes(cursor)) Then Exit While
                cursor += 1
            Wend
            Array.Append(filled, New StudioSyntaxToken(runStart, cursor - runStart, StudioTokenKind.Plain))
        Wend
        If k < Array.Count(tokens) Then
            Array.Append(filled, tokens(k))
            cursor = Math.Max(cursor, tokens(k).Start + tokens(k).Length)
            k += 1
        End If
    Wend
    Return filled
End Function

Private Function SyntaxPlainLine(line As String) As StudioSyntaxLine
    Dim info As New StudioSyntaxLine()
    info.LanguageMode = "plain"
    info.Source = line
    Dim noTokens As Array Of StudioSyntaxToken = []
    info.Tokens = SyntaxFillGaps(line, noTokens)
    Return info
End Function

Private Function SyntaxJsonLine(line As String) As StudioSyntaxLine
    Dim info As New StudioSyntaxLine()
    info.LanguageMode = "json"
    info.Source = line
    Dim codes As Array Of Integer = SyntaxCodes(line)
    Dim tokens As Array Of StudioSyntaxToken = []
    Dim i As Integer = 0
    While i < Array.Count(codes)
        Dim code As Integer = codes(i)
        If code = 34 Then
            Dim j As Integer = i + 1
            While j < Array.Count(codes)
                If codes(j) = 92 Then
                    j += 2
                    Continue While
                End If
                If codes(j) = 34 Then Exit While
                j += 1
            Wend
            Dim finish As Integer = Math.Min(Array.Count(codes), j + 1)
            ' A string followed by ':' is an object key.
            Dim after As Integer = finish
            While after < Array.Count(codes)
                If Not SyntaxIsSpace(codes(after)) Then Exit While
                after += 1
            Wend
            Dim kind As StudioTokenKind = StudioTokenKind.Text
            If after < Array.Count(codes) Then
                If codes(after) = 58 Then kind = StudioTokenKind.TypeName
            End If
            Array.Append(tokens, New StudioSyntaxToken(i, finish - i, kind))
            i = finish
        ElseIf SyntaxIsDigit(code) Or (code = 45 And i + 1 < Array.Count(codes)) Then
            Dim j As Integer = i + 1
            While j < Array.Count(codes)
                Dim c As Integer = codes(j)
                If Not (SyntaxIsDigit(c) Or c = 46 Or c = 101 Or c = 69 Or c = 43 Or c = 45) Then Exit While
                j += 1
            Wend
            Array.Append(tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Number))
            i = j
        ElseIf SyntaxIsWordStart(code) Then
            Dim j As Integer = i + 1
            While j < Array.Count(codes)
                If Not SyntaxIsWord(codes(j)) Then Exit While
                j += 1
            Wend
            Dim word As String = SyntaxLowerSlice(codes, i, j - i)
            Dim kind As StudioTokenKind = StudioTokenKind.Plain
            If word = "true" Or word = "false" Or word = "null" Then kind = StudioTokenKind.Literal
            Array.Append(tokens, New StudioSyntaxToken(i, j - i, kind))
            i = j
        ElseIf SyntaxIsSpace(code) Then
            i += 1
        Else
            Array.Append(tokens, New StudioSyntaxToken(i, 1, StudioTokenKind.Punctuation))
            i += 1
        End If
    Wend
    info.Tokens = SyntaxFillGaps(line, tokens)
    Return info
End Function

Private Function SyntaxIsFence(line As String) As Boolean
    Dim trimmed As String = String.LTrim(line)
    Return String.StartsWith(trimmed, "```") Or String.StartsWith(trimmed, "~~~")
End Function

Private Function SyntaxMarkdownLine(line As String, inFence As Boolean) As StudioSyntaxLine
    Dim info As New StudioSyntaxLine()
    info.LanguageMode = "markdown"
    info.Source = line
    info.StartsInComment = inFence
    Dim codes As Array Of Integer = SyntaxCodes(line)
    Dim count As Integer = Array.Count(codes)
    Dim tokens As Array Of StudioSyntaxToken = []
    Dim lead As Integer = 0
    While lead < count
        If Not SyntaxIsSpace(codes(lead)) Then Exit While
        lead += 1
    Wend
    If SyntaxIsFence(line) Then
        info.EndsInComment = Not inFence
        If lead < count Then Array.Append(tokens, New StudioSyntaxToken(lead, count - lead, StudioTokenKind.Directive))
        info.Tokens = tokens
        Return info
    End If
    info.EndsInComment = inFence
    If inFence Then
        Dim noTokens As Array Of StudioSyntaxToken = []
        info.Tokens = SyntaxFillGaps(line, noTokens)
        For Each token As StudioSyntaxToken In info.Tokens
            token.Kind = StudioTokenKind.Text
        Next
        Return info
    End If
    If lead >= count Then Return info
    Dim first As Integer = codes(lead)
    If first = 35 Then
        ' ATX heading: the whole line.
        Array.Append(tokens, New StudioSyntaxToken(lead, count - lead, StudioTokenKind.Keyword))
        info.Tokens = tokens
        Return info
    End If
    If first = 62 Then
        Array.Append(tokens, New StudioSyntaxToken(lead, count - lead, StudioTokenKind.Comment))
        info.Tokens = tokens
        Return info
    End If
    Dim i As Integer = lead
    ' List markers: -, *, +, or digits followed by '.' / ')'.
    If (first = 45 Or first = 42 Or first = 43) And lead + 1 < count Then
        If codes(lead + 1) = 32 Then
            Array.Append(tokens, New StudioSyntaxToken(lead, 1, StudioTokenKind.Punctuation))
            i = lead + 1
        End If
    End If
    While i < count
        Dim code As Integer = codes(i)
        If code = 96 Then
            Dim j As Integer = i + 1
            While j < count
                If codes(j) = 96 Then Exit While
                j += 1
            Wend
            Dim finish As Integer = Math.Min(count, j + 1)
            Array.Append(tokens, New StudioSyntaxToken(i, finish - i, StudioTokenKind.Text))
            i = finish
        ElseIf code = 91 Then
            ' [label](target)
            Dim j As Integer = i + 1
            While j < count
                If codes(j) = 93 Then Exit While
                j += 1
            Wend
            If j + 1 < count And j < count Then
                If codes(j + 1) = 40 Then
                    Dim k As Integer = j + 2
                    While k < count
                        If codes(k) = 41 Then Exit While
                        k += 1
                    Wend
                    Dim finish As Integer = Math.Min(count, k + 1)
                    Array.Append(tokens, New StudioSyntaxToken(i, finish - i, StudioTokenKind.FunctionName))
                    i = finish
                    Continue While
                End If
            End If
            Array.Append(tokens, New StudioSyntaxToken(i, 1, StudioTokenKind.Punctuation))
            i += 1
        ElseIf code = 42 Or code = 95 Then
            Dim j As Integer = i
            While j < count
                If codes(j) <> code Then Exit While
                j += 1
            Wend
            Array.Append(tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Directive))
            i = j
        ElseIf SyntaxIsSpace(code) Then
            i += 1
        Else
            Dim j As Integer = i
            While j < count
                Dim c As Integer = codes(j)
                If SyntaxIsSpace(c) Or c = 96 Or c = 91 Or c = 42 Or c = 95 Then Exit While
                j += 1
            Wend
            If j = i Then j = i + 1
            Array.Append(tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Plain))
            i = j
        End If
    Wend
    info.Tokens = tokens
    Return info
End Function

''' Tokens of one line in a language mode (see StudioLanguageModeName). "buoy" is
''' StudioTokenizeLine; `state` is the mode's carried line state.
Public Function StudioTokenizeLineFor(mode As String, line As String, state As Boolean) As StudioSyntaxLine
    Select Case mode
    Case "buoy"
        Return StudioTokenizeLine(line, state)
    Case "json"
        Return SyntaxJsonLine(line)
    Case "markdown"
        Return SyntaxMarkdownLine(line, state)
    End Select
    Return SyntaxPlainLine(line)
End Function

''' The carried state after `line` in a mode (cheap for lines that cannot change it).
Public Function StudioLineStateAfter(mode As String, line As String, state As Boolean) As Boolean
    Select Case mode
    Case "buoy"
        Return StudioCommentStateAfter(line, state)
    Case "markdown"
        If SyntaxIsFence(line) Then Return Not state
        Return state
    End Select
    Return False
End Function

''' Markdown ATX heading level of a line (1-6), 0 when it is not a heading.
Public Function StudioMarkdownHeadingLevel(line As String) As Integer
    Dim trimmed As String = String.LTrim(line)
    If String.Len(line) - String.Len(trimmed) > 3 Then Return 0
    Dim level As Integer = 0
    While level < String.Len(trimmed) And level < 7
        If String.Substring(trimmed, level, 1) <> "#" Then Exit While
        level += 1
    Wend
    If level = 0 Or level > 6 Then Return 0
    If level < String.Len(trimmed) Then
        If String.Substring(trimmed, level, 1) <> " " Then Return 0
    End If
    Return level
End Function
