' Buoy lexical highlighting for Studio's source editor.
' Token classes and vocabulary mirror the documentation viewer's `highlightTokens`
' (documentation.html) and libraries/buoy-highlighting/vocabulary.mjs, so source
' code looks the same in the editor and in the documentation. Lexical only: no
' semantic validation. Pure data; no GUI dependency.

Public Enum StudioTokenKind As Integer
    Plain = 0
    Comment = 1
    Keyword = 2
    TypeName = 3
    Text = 4
    Number = 5
    Directive = 6
    FunctionName = 7
    Literal = 8
    Punctuation = 9
    ColorLiteral = 10
End Enum

''' One highlighted run: codepoint `Start` and `Length` within its line.
Public Class StudioSyntaxToken
    Public Property Start As Integer
    Public Property Length As Integer
    Public Property Kind As StudioTokenKind

    Public Sub Constructor(start As Integer, length As Integer, kind As StudioTokenKind)
        Me.Start = start
        Me.Length = length
        Me.Kind = kind
    End Sub
End Class

''' The tokens of one line plus the block-comment state entering and leaving it.
''' Whitespace is not tokenized; every other character belongs to exactly one token.
Public Class StudioSyntaxLine
    Public Property Tokens As Array Of StudioSyntaxToken = []
    Public Property StartsInComment As Boolean = False
    Public Property EndsInComment As Boolean = False
    Public Property Source As String = ""
    Public Property SpellingKey As String = ""
    Public Property LanguageMode As String = "buoy"
End Class

Private Class StudioSyntaxWords
    Public Shared Property Ready As Boolean = False
    Public Shared Property Kinds As Map Of String, Integer = New Map Of String, Integer()

    Public Shared Sub Prepare()
        If StudioSyntaxWords.Ready Then Return
        StudioSyntaxWords.Ready = True
        ' Order matters: literals win over keywords, keywords over types (as in the viewer).
        StudioSyntaxWords.AddWords("integer double string boolean single byte int8 uint8 int16 uint16 int32 uint32 int64 uint64 ptr bytes array optional result map object color datetime variant jsonitem window view control timer picture cfstringref cstring closure currency", 3)
        StudioSyntaxWords.AddWords("addhandler addressof and as byref byval call case catch class const constant constructor destructor continue declare default defined delegate destructor dim do each else elseif end enum event exit false finally flags for function get handle if implements import in inherits interface is isa lambda lib loop mod new next not of operator optional or overrides packed paramarray private property protected public raise readonly assigns async await redim return select selector sequential set shared static step structure sub super then throw to try trycast ctype until var weak wend when while with xor alias raiseevent partial internal", 2)
        StudioSyntaxWords.AddWords("true false nil me", 8)
    End Sub

    Private Shared Sub AddWords(words As String, kind As Integer)
        For Each word As String In String.Split(words, " ")
            If word <> "" Then StudioSyntaxWords.Kinds.Set(word, kind)
        Next
    End Sub
End Class

''' Classifies a bare word exactly as the editor does when no context applies:
''' Keyword, TypeName, Literal or Plain.
Public Function StudioWordKind(word As String) As StudioTokenKind
    StudioSyntaxWords.Prepare()
    Dim key As String = String.LCase(word)
    If StudioSyntaxWords.Kinds.ContainsKey(key) Then Return CType(StudioSyntaxWords.Kinds.Get(key).Value, StudioTokenKind)
    Return StudioTokenKind.Plain
End Function

''' The documentation viewer's CSS class for a token kind ("t-kw", "t-com", ...).
Public Function StudioTokenClass(kind As StudioTokenKind) As String
    Select Case kind
    Case StudioTokenKind.Comment
        Return "t-com"
    Case StudioTokenKind.Keyword
        Return "t-kw"
    Case StudioTokenKind.TypeName
        Return "t-type"
    Case StudioTokenKind.Text
        Return "t-str"
    Case StudioTokenKind.Number
        Return "t-num"
    Case StudioTokenKind.Directive
        Return "t-pre"
    Case StudioTokenKind.FunctionName
        Return "t-fn"
    Case StudioTokenKind.Literal
        Return "t-lit"
    Case StudioTokenKind.Punctuation
        Return "t-punc"
    Case StudioTokenKind.ColorLiteral
        Return "t-color"
    End Select
    Return ""
End Function

Private Function SyntaxIsWordStart(code As Integer) As Boolean
    Return (code >= 65 And code <= 90) Or (code >= 97 And code <= 122) Or code = 95
End Function

Private Function SyntaxIsDigit(code As Integer) As Boolean
    Return code >= 48 And code <= 57
End Function

Private Function SyntaxIsWord(code As Integer) As Boolean
    Return SyntaxIsWordStart(code) Or SyntaxIsDigit(code)
End Function

Private Function SyntaxIsMark(code As Integer) As Boolean
    Return code >= &h0300 And StudioCellWidth(code) = 0
End Function

Private Function SyntaxIsHex(code As Integer) As Boolean
    Return SyntaxIsDigit(code) Or (code >= 65 And code <= 70) Or (code >= 97 And code <= 102)
End Function

Private Function SyntaxIsSpace(code As Integer) As Boolean
    Return code = 32 Or code = 9 Or code = 13 Or code = 12
End Function

Private Function SyntaxIsPunctuation(code As Integer) As Boolean
    Select Case code
    Case 40, 41, 91, 93, 123, 125, 46, 44, 58, 59, 61, 60, 62, 43, 45, 42, 47, 92, 94, 38, 124, 33, 63
        Return True
    End Select
    Return False
End Function

Private Function SyntaxCodes(line As String) As Array Of Integer
    Dim codes As Array Of Integer = []
    For Each ch As String In String.Chars(line)
        Array.Append(codes, String.Asc(ch))
    Next
    Return codes
End Function

Private Function SyntaxFindBlockEnd(codes As Array Of Integer, start As Integer) As Integer
    Dim i As Integer = start
    While i + 1 < Array.Count(codes)
        If codes(i) = 42 And codes(i + 1) = 47 Then Return i
        i += 1
    End While
    Return -1
End Function

''' Length of an `&c` colour literal starting at `i` (8 or 6 hex digits followed by a
''' word boundary), or 0.
Private Function SyntaxColorLength(codes As Array Of Integer, i As Integer) As Integer
    Dim n As Integer = Array.Count(codes)
    If i + 1 >= n Then Return 0
    If codes(i) <> 38 Or (codes(i + 1) <> 99 And codes(i + 1) <> 67) Then Return 0
    Dim digits As Integer = 0
    While i + 2 + digits < n
        If Not SyntaxIsHex(codes(i + 2 + digits)) Then Exit While
        digits += 1
    End While
    For Each wanted As Integer In [8, 6]
        If digits >= wanted Then
            Dim after As Integer = i + 2 + wanted
            If after >= n Then Return wanted + 2
            If Not SyntaxIsWord(codes(after)) Then Return wanted + 2
        End If
    Next
    Return 0
End Function

''' Length of an `&h`/`&b`/`&o` integer literal starting at `i`, or 0.
Private Function SyntaxRadixLength(codes As Array Of Integer, i As Integer) As Integer
    Dim n As Integer = Array.Count(codes)
    If i + 2 >= n Or codes(i) <> 38 Then Return 0
    Dim marker As Integer = codes(i + 1)
    If marker <> 104 And marker <> 72 And marker <> 98 And marker <> 66 And marker <> 111 And marker <> 79 Then Return 0
    Dim j As Integer = i + 2
    While j < n
        If Not (SyntaxIsHex(codes(j)) Or codes(j) = 95) Then Exit While
        j += 1
    End While
    If j = i + 2 Then Return 0
    If j < n Then
        If SyntaxIsWord(codes(j)) Then Return 0
    End If
    Return j - i
End Function

Private Function SyntaxNumberEnd(codes As Array Of Integer, i As Integer) As Integer
    Dim n As Integer = Array.Count(codes)
    Dim j As Integer = i
    While j < n
        If Not (SyntaxIsDigit(codes(j)) Or codes(j) = 95) Then Exit While
        j += 1
    End While
    If j + 1 < n Then
        If codes(j) = 46 And SyntaxIsDigit(codes(j + 1)) Then
            j += 1
            While j < n
                If Not SyntaxIsDigit(codes(j)) Then Exit While
                j += 1
            End While
        End If
    End If
    If j + 1 < n Then
        If codes(j) = 101 Or codes(j) = 69 Then
            Dim k As Integer = j + 1
            If codes(k) = 43 Or codes(k) = 45 Then k += 1
            If k < n Then
                If SyntaxIsDigit(codes(k)) Then
                    j = k
                    While j < n
                        If Not SyntaxIsDigit(codes(j)) Then Exit While
                        j += 1
                    End While
                End If
            End If
        End If
    End If
    Return j
End Function

Private Function SyntaxStartsComment(codes As Array Of Integer, i As Integer) As Boolean
    If codes(i) = 39 Then Return True
    If codes(i) = 47 And i + 1 < Array.Count(codes) Then Return codes(i + 1) = 47 Or codes(i + 1) = 42
    Return False
End Function

Private Function SyntaxLowerSlice(codes As Array Of Integer, start As Integer, length As Integer) As String
    Dim text As String = ""
    For i As Integer = start To start + length - 1
        Dim code As Integer = codes(i)
        If code >= 65 And code <= 90 Then code += 32
        text += String.Chr(code)
    Next
    Return text
End Function

''' Tokenizes one line. `inComment` is True when the line starts inside a `/* */` block.
Public Function StudioTokenizeLine(line As String, inComment As Boolean) As StudioSyntaxLine
    StudioSyntaxWords.Prepare()
    Dim info As New StudioSyntaxLine()
    info.Source = line
    info.StartsInComment = inComment
    Dim codes As Array Of Integer = SyntaxCodes(line)
    Dim n As Integer = Array.Count(codes)
    Dim i As Integer = 0
    If inComment Then
        Dim close As Integer = SyntaxFindBlockEnd(codes, 0)
        If close < 0 Then
            If n > 0 Then Array.Append(info.Tokens, New StudioSyntaxToken(0, n, StudioTokenKind.Comment))
            info.EndsInComment = True
            Return info
        End If
        Array.Append(info.Tokens, New StudioSyntaxToken(0, close + 2, StudioTokenKind.Comment))
        i = close + 2
    End If
    Dim firstContent As Boolean = True
    Dim lastWord As String = ""
    While i < n
        Dim code As Integer = codes(i)
        If SyntaxIsSpace(code) Then
            i += 1
            Continue While
        End If
        Dim leading As Boolean = firstContent
        firstContent = False
        If code = 34 Then
            Dim j As Integer = i + 1
            While j < n
                If codes(j) = 92 Then
                    j += 2
                ElseIf codes(j) = 34 Then
                    j += 1
                    Exit While
                Else
                    j += 1
                End If
            End While
            j = Math.Min(j, n)
            Array.Append(info.Tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Text))
            lastWord = ""
            i = j
        ElseIf code = 39 Or (code = 47 And i + 1 < n And codes(Math.Min(i + 1, n - 1)) = 47) Then
            Array.Append(info.Tokens, New StudioSyntaxToken(i, n - i, StudioTokenKind.Comment))
            i = n
        ElseIf code = 47 And i + 1 < n And codes(Math.Min(i + 1, n - 1)) = 42 Then
            Dim close As Integer = SyntaxFindBlockEnd(codes, i + 2)
            If close < 0 Then
                Array.Append(info.Tokens, New StudioSyntaxToken(i, n - i, StudioTokenKind.Comment))
                info.EndsInComment = True
                Return info
            End If
            Array.Append(info.Tokens, New StudioSyntaxToken(i, close + 2 - i, StudioTokenKind.Comment))
            i = close + 2
        ElseIf code = 35 And leading And i + 1 < n And SyntaxIsWordStart(codes(Math.Min(i + 1, n - 1))) Then
            Dim j As Integer = i + 1
            While j < n
                If Not ((codes(j) >= 65 And codes(j) <= 90) Or (codes(j) >= 97 And codes(j) <= 122)) Then Exit While
                j += 1
            End While
            Array.Append(info.Tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Directive))
            lastWord = ""
            i = j
        ElseIf code = 38 And SyntaxColorLength(codes, i) > 0 Then
            Dim length As Integer = SyntaxColorLength(codes, i)
            Array.Append(info.Tokens, New StudioSyntaxToken(i, length, StudioTokenKind.ColorLiteral))
            lastWord = ""
            i += length
        ElseIf code = 38 And SyntaxRadixLength(codes, i) > 0 Then
            Dim length As Integer = SyntaxRadixLength(codes, i)
            Array.Append(info.Tokens, New StudioSyntaxToken(i, length, StudioTokenKind.Number))
            lastWord = ""
            i += length
        ElseIf SyntaxIsDigit(code) Then
            Dim j As Integer = SyntaxNumberEnd(codes, i)
            Array.Append(info.Tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Number))
            lastWord = ""
            i = j
        ElseIf SyntaxIsWordStart(code) Then
            Dim j As Integer = i + 1
            While j < n
                ' Combining marks stay with the letter they decorate (one drawn cluster).
                If Not SyntaxIsWord(codes(j)) And Not SyntaxIsMark(codes(j)) Then Exit While
                j += 1
            End While
            Dim word As String = SyntaxLowerSlice(codes, i, j - i)
            If word = "rem" And leading Then
                Array.Append(info.Tokens, New StudioSyntaxToken(i, n - i, StudioTokenKind.Comment))
                i = n
                Continue While
            End If
            Dim kind As StudioTokenKind = StudioTokenKind.Plain
            If StudioSyntaxWords.Kinds.ContainsKey(word) Then
                kind = CType(StudioSyntaxWords.Kinds.Get(word).Value, StudioTokenKind)
            ElseIf j < n And codes(Math.Min(j, n - 1)) = 40 Then
                kind = StudioTokenKind.FunctionName
            ElseIf lastWord = "sub" Or lastWord = "function" Then
                kind = StudioTokenKind.FunctionName
            ElseIf code >= 65 And code <= 90 And lastWord = "as" Then
                kind = StudioTokenKind.TypeName
            End If
            Array.Append(info.Tokens, New StudioSyntaxToken(i, j - i, kind))
            lastWord = word
            i = j
        ElseIf SyntaxIsPunctuation(code) Then
            Dim j As Integer = i + 1
            While j < n
                If Not SyntaxIsPunctuation(codes(j)) Then Exit While
                If SyntaxStartsComment(codes, j) Then Exit While
                If codes(j) = 38 And (SyntaxColorLength(codes, j) > 0 Or SyntaxRadixLength(codes, j) > 0) Then Exit While
                j += 1
            End While
            Array.Append(info.Tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Punctuation))
            lastWord = ""
            i = j
        Else
            ' Non-ASCII text and other symbols: one plain run up to the next boundary.
            Dim j As Integer = i + 1
            While j < n
                If codes(j) < 128 Then Exit While
                j += 1
            End While
            Array.Append(info.Tokens, New StudioSyntaxToken(i, j - i, StudioTokenKind.Plain))
            lastWord = ""
            i = j
        End If
    End While
    Return info
End Function

''' Block-comment state after `line`, without building tokens. Lines with no `/*`,
''' `*/` take a fast path, so scanning thousands of lines stays cheap.
Public Function StudioCommentStateAfter(line As String, inComment As Boolean) As Boolean
    If inComment Then
        If Not String.Contains(line, "*/") Then Return True
    ElseIf Not String.Contains(line, "/*") Then
        Return False
    End If
    Return StudioTokenizeLine(line, inComment).EndsInComment
End Function

''' Debug/test helper: "class:text" pairs separated by spaces, plain tokens as "text".
Public Function StudioDescribeTokens(line As StudioSyntaxLine) As String
    Dim parts As Array Of String = []
    For Each token As StudioSyntaxToken In line.Tokens
        Dim piece As String = String.Substring(line.Source, token.Start, token.Length)
        Dim cls As String = StudioTokenClass(token.Kind)
        If cls = "" Then
            Array.Append(parts, piece)
        Else
            Array.Append(parts, cls + ":" + piece)
        End If
    Next
    Return String.Join(parts, " ")
End Function

' ---- Unicode cells -------------------------------------------------------------------

Private Function SyntaxInRanges(code As Integer, ranges As Array Of Integer) As Boolean
    Dim i As Integer = 0
    While i + 1 < Array.Count(ranges)
        If code < ranges(i) Then Return False
        If code <= ranges(i + 1) Then Return True
        i += 2
    End While
    Return False
End Function

Private Class StudioCellTables
    Public Shared Property Ready As Boolean = False
    Public Shared Property ZeroWidth As Array Of Integer = []
    Public Shared Property Wide As Array Of Integer = []
    Public Shared Property Pictographic As Array Of Integer = []
    Public Shared Property Extend As Array Of Integer = []
    Public Shared Property Control As Array Of Integer = []

    Public Shared Sub Prepare()
        If StudioCellTables.Ready Then Return
        StudioCellTables.Ready = True
        ' Unicode 17.0 emoji-data/GraphemeBreakProperty, Unicode License V3
        ' (bundled unicode-LICENSE.txt). Exact GB11 context; cell widths remain approximate.
