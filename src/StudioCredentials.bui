Import secretstore

''' Studio's injectable storage boundary, backed by the reusable SecretStore package.
Public Interface StudioCredentialStorage Inherits SecretRecordStorage
End Interface

''' Stable service/account namespace across Studio builds and application bundle paths.
Public Class StudioCredentialStore Implements StudioCredentialStorage
    Private Property Store As SecretRecordStore

    Public Sub Constructor(hostID As String)
        Me.Store = New SecretRecordStore("com.buoy.studio.chatgpt", hostID)
    End Sub

    Public Function Acquire() As Boolean
        Return Me.Store.Acquire()
    End Function
    Public Sub Release()
        Me.Store.Release()
    End Sub
    Public Function Load() As String
        Return Me.Store.Load()
    End Function
    Public Sub Save(record As String)
        Me.Store.Save(record)
    End Sub
    Public Sub Delete()
        Me.Store.Delete()
    End Sub
End Class
