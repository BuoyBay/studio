    ''' Live English spelling in code, comments and strings. View-only; never autocorrects.
    Public Property AllowsSpellCheck As Boolean = True
    Public Property SpellCheckEnabled As Boolean = True
    Private Property mSpellingTimer As StudioSpellingTimer
    Private Property mSpellingPending As Array Of StudioSyntaxLine = []
    Private Property mSpellingScheduled As Boolean = False

    Public Sub SpellingTick()
        Me.mSpellingScheduled = False
        If Me.SpellCheckEnabled And Me.AllowsSpellCheck Then
            For Each info As StudioSyntaxLine In Me.mSpellingPending
                Me.mSpelling.Check(info)
            Next
        End If
        Me.mSpellingPending = []
        Me.Invalidate()
    End Sub

    Private Function PaintedSpelling(lineIndex As Integer) As Array Of StudioSpellingWord
        Dim info As StudioSyntaxLine = Me.LineTokens(lineIndex)
        Dim cached As StudioSpellingCacheEntry = Me.mSpelling.Cached(info)
        If cached <> Nil Then Return cached.Words
        If Not Me.mSpellingScheduled Then
            If Me.mSpellingTimer = Nil Then
                Me.mSpellingTimer = New StudioSpellingTimer()
                Me.mSpellingTimer.Owner = Me
                Me.mSpellingTimer.Period = 180
            End If
            Me.mSpellingScheduled = True
            Me.mSpellingTimer.Start()
        End If
        If Array.Count(Me.mSpellingPending) < 100 Then
            Dim seen As Boolean = False
            For Each pending As StudioSyntaxLine In Me.mSpellingPending
                If pending = info Then seen = True
            Next
            If Not seen Then Array.Append(Me.mSpellingPending, info)
        End If
        Return []
    End Function
    Private Property mSpelling As StudioSpelling = New StudioSpelling()
    Private Property mContextSpelling As StudioSpellingWord
    Private Property mContextSpellingLine As Integer = -1
    Private Property mContextSpellingSource As String = ""

    Public Function SpellingOnLine(lineIndex As Integer) As Array Of StudioSpellingWord
        If Not Me.SpellCheckEnabled Or Not Me.AllowsSpellCheck Or lineIndex < 0 Or lineIndex >= Me.LineCount Then Return []
        Return Me.mSpelling.Check(Me.LineTokens(lineIndex))
    End Function

    Public Sub IgnoreSpelling(word As String)
        Me.mSpelling.Ignore(word)
        Me.Invalidate()
    End Sub

    ''' Raised after every user edit (typing, paste, cut, indent, IME commit).
    Event TextChanged()
    ''' Primary+Z / Primary+Shift+Z / Primary+Y: the host applies its own undo history.
    Event UndoRequested(redo As Boolean)
    ''' The host supplies availability because it owns document history.
    Event HistoryAvailable(redo As Boolean) As Boolean
    ''' The caret or selection moved (keyboard, mouse, edits, host calls).
    Event SelectionChanged()
    ''' Breakpoint lines changed: toggled in the gutter, or moved by an edit.
    Event BreakpointsChanged()
    Event ProblemRequested(lineIndex As Integer, message As String)
    ''' A symbol action chosen from the context menu (or requested with
    ''' RequestSymbolAction): "definition", "references", "documentation", "info",
    ''' "rename" or "findInProject". Only offered while ShowsSymbolActions is True.
    Event SymbolAction(action As String, symbol As StudioEditorSymbol)
    ''' Offer Go to Definition / Find References / Documentation / ... in the context
    ''' menu (the host must handle SymbolAction).
    Public Property ShowsSymbolActions As Boolean = False
    ''' Highlight the other occurrences of the identifier under the caret (VS Code's
    ''' word highlight).
    Public Property HighlightsWordOccurrences As Boolean = True
    ''' Files dropped onto the editor from another application. Return True when the
    ''' host handled them (e.g. opened them); otherwise their paths are inserted at the
    ''' drop point, one per line.
    Event FilesDropped(files As Array Of FileSystemItem) As Boolean

    Public Sub Constructor()
        Super.Constructor()
        Array.Append(Me.mTokens, Nil)
        Array.Append(Me.mLines, "")
        Array.Append(Me.mStarts, 0)
        Array.Append(Me.mStates, False)
        Me.Cursor = CursorType.IBeam
        Me.mSettledFingerprint = EditorTextFingerprint("")
    End Sub

    ' ---- Public surface --------------------------------------------------------------

    Public Property FontName As String
        Get
            If Me.mFontName <> "" Then Return Me.mFontName
            #If TargetMac Then
                Return "Menlo"
            #ElseIf TargetWindows Then
                Return "Consolas"
            #Else
                Return "monospace"
            #End If
        End Get
        Set
            Me.mFontName = value
            Me.mMeasuredFor = ""
            Me.Invalidate()
        End Set
    End Property

    ''' The whole document (LF line endings). Setting it from the host keeps the caret
    ''' and scroll position near the change when most lines are unchanged (undo/redo,
    ''' designer edits); a mostly different text resets to the top. Does not raise
    ''' TextChanged.
    Public Property Text As String
        Get
            If Not Me.mTextValid Then
                Me.mText = String.Join(Me.mLines, "\n")
                Me.mTextValid = True
            End If
            Return Me.mText
        End Get
        Set
            Me.ReplaceDocument(value)
        End Set
    End Property

    Public Property LineHeight As Double
        Get
            Return Math.Round(Me.FontSize * 1.55)
        End Get
    End Property

    Public Property LineCount As Integer
        Get
            Return Array.Count(Me.mLines)
        End Get
    End Property

    Public Property SelectionStart As Integer
        Get
            Return Math.Min(Me.mAnchor, Me.mCaret)
        End Get
    End Property

    Public Property SelectionLength As Integer
        Get
            Return Math.Abs(Me.mCaret - Me.mAnchor)
        End Get
    End Property

    Public Property CaretPosition As Integer
        Get
            Return Me.mCaret
        End Get
    End Property

    Public Property SelectedText As String
        Get
            Return Me.Slice(Me.SelectionStart, Me.SelectionLength)
        End Get
    End Property

    Public Property ScrollX As Double
        Get
            Return Me.mScrollX
        End Get
    End Property

    Public Property ScrollY As Double
        Get
            Return Me.mScrollY
        End Get
    End Property

    Public Property IsDark As Boolean
        Get
            If String.Compare(Me.Appearance, "dark", True) = 0 Then Return True
            If String.Compare(Me.Appearance, "light", True) = 0 Then Return False
            Dim gtkTheme As String = String.LCase(System.EnvironmentVariable("GTK_THEME").Or(""))
            If String.EndsWith(gtkTheme, ":dark") Or String.EndsWith(gtkTheme, "-dark") Then Return True
            Return StudioUsesDarkAppearance()
        End Get
    End Property

    ''' Fire TextChanged synchronously (TextArea-compatible test hook).
    Public Sub PerformChange()
        RaiseEvent TextChanged()
    End Sub

    Public Sub SelectRange(start As Integer, length As Integer)
        Me.ClearComposition()
        If Me.InSnippet Then Me.EndSnippet()
        Me.ClearExtras()
        Me.mAnchor = Me.Clamp(start)
        Me.mCaret = Me.Clamp(start + Math.Max(0, length))
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    Public Sub SelectAll()
        Me.SelectRange(0, Me.TotalLength())
    End Sub

    ''' Replace the selection as if typed; raises TextChanged.
    Public Sub InsertAtSelection(value As String)
        If Me.HasExtras() Then
            Me.RunBatch("@paste", False, [value], True)
            Return
        End If
        Me.EditRange(Me.SelectionStart, Me.SelectionLength, value, -1, -1, "paste")
    End Sub

    ''' Zero-based line index containing a document position.
    Public Function LineOfPosition(position As Integer) As Integer
        Dim lo As Integer = 0
        Dim hi As Integer = Array.LastIndex(Me.mStarts)
        Dim target As Integer = Me.Clamp(position)
        While lo < hi
            Dim middle As Integer = (lo + hi + 1) \ 2
            If Me.mStarts(middle) <= target Then
                lo = middle
            Else
                hi = middle - 1
            End If
        End While
        Return lo
    End Function

    Public Function LineStartPosition(lineIndex As Integer) As Integer
        Return Me.mStarts(Math.Max(0, Math.Min(lineIndex, Array.LastIndex(Me.mStarts))))
    End Function

    ''' Cached highlighting for one line (tokenizing it, and the lines above it for
    ''' block-comment state, when needed).
    Public Function LineTokens(lineIndex As Integer) As StudioSyntaxLine
        Dim index As Integer = Math.Max(0, Math.Min(lineIndex, Array.LastIndex(Me.mLines)))
        Me.EnsureStates(index)
        Dim cached As StudioSyntaxLine = Me.mTokens(index)
        Dim state As Boolean = Me.mStates(index)
        If cached <> Nil Then
            If cached.StartsInComment = state And String.Compare(cached.Source, Me.mLines(index), True) = 0 Then Return cached
        End If
        cached = StudioTokenizeLineFor(Me.mLanguageMode, Me.mLines(index), state)
        Me.mTokens(index) = cached
        Return cached
    End Function

    ''' Scroll by logical points (wheel, trackpad, programmatic).
    Public Sub ScrollBy(dx As Double, dy As Double)
        Me.SetScroll(Me.mScrollX + dx, Me.mScrollY + dy)
    End Sub

    Public Sub ScrollToLine(lineIndex As Integer)
        Me.UnfoldAround(lineIndex)
        Me.SetScroll(Me.mScrollX, Me.RowOfLine(Math.Max(0, Math.Min(lineIndex, Array.LastIndex(Me.mLines)))) * Me.LineHeight)
    End Sub

    ''' Attach native input: IME, wheel/trackpad scrolling and (macOS) Tab/paging keys.
    ''' Call after the editor is in a window (window Opening); pair with Close().
    Public Sub Open()
        If Me.mSlot >= 0 Then Return
        Me.mSlot = -1
        For i As Integer = 0 To Array.LastIndex(StudioEditorRegistry.Slots)
            If StudioEditorRegistry.Slots(i).Editor = Nil Then
                Me.mSlot = i
                Exit For
            End If
        Next
        If Me.mSlot < 0 Then
            Me.mSlot = Array.Count(StudioEditorRegistry.Slots)
            Dim slot As New StudioEditorRegistrySlot()
            slot.Editor = Me
            Array.Append(StudioEditorRegistry.Slots, slot)
        Else
            StudioEditorRegistry.Slots(Me.mSlot).Editor = Me
        End If
        Try
            Me.OpenInputMethod()
        Catch e As Exception
            Me.RecordNativeInputError("Input method unavailable: " + e.Message)
        End Try
        Try
            Me.AttachWheel()
        Catch e As Exception
            Me.RecordNativeInputError("Wheel scrolling unavailable: " + e.Message)
        End Try
        Me.AttachDragDrop()
    End Sub

    ''' Detach native input before the window's native views are destroyed. Idempotent.
    Public Sub Close()
        Me.mHadFocus = False
        If Me.mSpellingTimer <> Nil Then Me.mSpellingTimer.Stop()
        Me.mSpellingPending = []
        Me.mSpellingScheduled = False
        Me.StopBlinking()
        Me.mFrame = Nil
        Me.StopEdgeScroll()
        If Me.mNativeDragActive Then
            Me.mNativeDragActive = False
            StudioCodeEditor.StudioDragActive = False
        End If
        Me.DetachDragDrop()
        Try
            Me.DetachWheel()
        Catch e As Exception
            Me.RecordNativeInputError(e.Message)
        End Try
        Try
            Me.CloseInputMethod()
        Catch e As Exception
            Me.RecordNativeInputError(e.Message)
        End Try
        If Me.mSlot >= 0 And Me.mSlot < Array.Count(StudioEditorRegistry.Slots) Then
            If StudioEditorRegistry.Slots(Me.mSlot).Editor = Me Then StudioEditorRegistry.Slots(Me.mSlot).Editor = Nil
        End If
        Me.mSlot = -1
        If StudioEditorRegistry.OpenCount() = 0 Then Array.Clear(StudioEditorRegistry.Slots)
        #If TargetMac Then
            If StudioEditorRegistry.OpenCount() = 0 Then EditorRemoveMacMonitor()
        #End If
    End Sub

    Public Property IsOpen As Boolean
        Get
            Return Me.mSlot >= 0
        End Get
    End Property

    ' ---- Multiple selections ---------------------------------------------------------
    ' The editor holds an ordered, non-overlapping set of selections, one of them
    ' primary. SelectionStart/SelectionLength/CaretPosition/SelectedText/SelectRange and
    ' the input method work on the primary selection; editing and navigation commands
    ' apply to every selection, each command as one TextChanged (one host undo step).

    ''' Number of selections (cursors); 1 unless multi-cursor editing is active.
    Public Property SelectionCount As Integer
        Get
            Return Array.Count(Me.mExtraCarets) + 1
        End Get
    End Property

    ''' The primary caret position and active cursor count for host status bars.
    Public Function CursorStatusText() As String
        Dim status As String = "Ln " + String.From(Me.CaretLine + 1) + ", Col " + String.From(Me.CaretCell + 1)
        If Me.SelectionCount > 1 Then status += " · " + String.From(Me.SelectionCount) + " cursors"
        Return status
    End Function

    ''' Every selection in document order.
    Public Function GetSelections() As Array Of StudioEditorSelection
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim picked As Array Of StudioEditorSelection = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Array.Append(picked, New StudioEditorSelection(anchors(i), carets(i)))
        Next
        Return picked
    End Function

    ''' Index of the primary selection within GetSelections().
    Public Property PrimarySelectionIndex As Integer
        Get
            Dim anchors As Array Of Integer = []
            Dim carets As Array Of Integer = []
            Return Me.SortedSelections(anchors, carets)
        End Get
    End Property

    ''' Replaces every selection (clamped, snapped out of character clusters; overlapping
    ''' ones merge). `primary` indexes `selections`; -1 makes the last one primary.
    Public Sub SetSelections(selections As Array Of StudioEditorSelection, primary As Integer = -1)
        If Array.Count(selections) = 0 Then Return
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        For Each item As StudioEditorSelection In selections
            Array.Append(anchors, Me.SnapPosition(Me.Clamp(item.Anchor)))
            Array.Append(carets, Me.SnapPosition(Me.Clamp(item.Caret)))
        Next
        Dim chosen As Integer = primary
        If chosen < 0 Or chosen > Array.LastIndex(anchors) Then chosen = Array.LastIndex(anchors)
        Me.ClearComposition()
        Me.ApplySelections(anchors, carets, chosen)
        Me.NormalizeSelections()
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Adds a selection (a cursor when anchor = caret) and makes it primary.
    Public Sub AddSelection(anchor As Integer, caret As Integer)
        Me.RememberCursors()
        Me.AddSelectionQuiet(Me.SnapPosition(Me.Clamp(anchor)), Me.SnapPosition(Me.Clamp(caret)))
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Keeps only the primary selection (Escape).
    Public Sub CollapseSelections()
        If Array.Count(Me.mExtraCarets) = 0 Then Return
        Me.ClearExtras()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    Private Sub ClearExtras()
        If Array.Count(Me.mExtraCarets) = 0 Then Return
        Me.mExtraAnchors = []
        Me.mExtraCarets = []
    End Sub

    Private Function NoPieces() As Array Of String
        Dim empty As Array Of String = []
        Return empty
    End Function

    Private Function HasExtras() As Boolean
        Return Array.Count(Me.mExtraCarets) > 0
    End Function

    ''' All selections sorted by start (then length); returns the primary's index.
    Private Function SortedSelections(ByRef anchors As Array Of Integer, ByRef carets As Array Of Integer) As Integer
        anchors = []
        carets = []
        Dim count As Integer = Array.Count(Me.mExtraCarets) + 1
        If count = 1 Then
            Array.Append(anchors, Me.mAnchor)
            Array.Append(carets, Me.mCaret)
            Return 0
        End If
        Dim allAnchors As Array Of Integer = []
        Dim allCarets As Array Of Integer = []
        Array.Append(allAnchors, Me.mAnchor)
        Array.Append(allCarets, Me.mCaret)
        For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
            Array.Append(allAnchors, Me.mExtraAnchors(i))
            Array.Append(allCarets, Me.mExtraCarets(i))
        Next
        ' One packed key per selection: start, then (capped) length, then index.
        Dim keys As Array Of Integer = []
        For i As Integer = 0 To count - 1
            Dim start As Integer = Math.Min(allAnchors(i), allCarets(i))
            Dim span As Integer = Math.Min(Math.Abs(allCarets(i) - allAnchors(i)), 4095)
            Array.Append(keys, (start * 4096 + span) * 1048576 + i)
        Next
        Array.Sort(keys)
        Dim primary As Integer = 0
        For k As Integer = 0 To count - 1
            Dim i As Integer = keys(k) Mod 1048576
            If i = 0 Then primary = k
            Array.Append(anchors, allAnchors(i))
            Array.Append(carets, allCarets(i))
        Next
        Return primary
    End Function

    ''' Sets the selections from parallel arrays; entry `primary` becomes primary.
    Private Sub ApplySelections(anchors As Array Of Integer, carets As Array Of Integer, primary As Integer)
        Dim chosen As Integer = Math.Max(0, Math.Min(primary, Array.LastIndex(carets)))
        Me.mAnchor = Me.Clamp(anchors(chosen))
        Me.mCaret = Me.Clamp(carets(chosen))
        Dim extraAnchors As Array Of Integer = []
        Dim extraCarets As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(carets)
            If i <> chosen Then
                Array.Append(extraAnchors, Me.Clamp(anchors(i)))
                Array.Append(extraCarets, Me.Clamp(carets(i)))
            End If
        Next
        Me.mExtraAnchors = extraAnchors
        Me.mExtraCarets = extraCarets
    End Sub

    ''' Sorts the selections and merges overlapping ones (cursors at one place, or a
    ''' cursor touching a selection, join); the merged one holding the primary is primary.
    Private Sub NormalizeSelections()
        If Array.Count(Me.mExtraCarets) = 0 Then Return
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim primary As Integer = Me.SortedSelections(anchors, carets)
        Dim outAnchors As Array Of Integer = []
        Dim outCarets As Array Of Integer = []
        Dim outPrimary As Integer = 0
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim s As Integer = Math.Min(anchors(i), carets(i))
            Dim e As Integer = Math.Max(anchors(i), carets(i))
            Dim k As Integer = Array.LastIndex(outCarets)
            If k >= 0 Then
                Dim ps As Integer = Math.Min(outAnchors(k), outCarets(k))
                Dim pe As Integer = Math.Max(outAnchors(k), outCarets(k))
                If s < pe Or s = ps Or (s = pe And (s = e Or ps = pe)) Then
                    Dim merged As Integer = Math.Max(pe, e)
                    If i = primary And s <> e Then
                        ' The primary's direction wins.
                        If anchors(i) <= carets(i) Then
                            outAnchors(k) = ps
                            outCarets(k) = merged
                        Else
                            outAnchors(k) = merged
                            outCarets(k) = ps
                        End If
                    ElseIf outAnchors(k) <= outCarets(k) Then
                        outCarets(k) = merged
                    Else
                        outAnchors(k) = merged
                    End If
                    If i = primary Then outPrimary = k
                    Continue For
                End If
            End If
            Array.Append(outAnchors, anchors(i))
            Array.Append(outCarets, carets(i))
            If i = primary Then outPrimary = Array.LastIndex(outCarets)
        Next
        Me.ApplySelections(outAnchors, outCarets, outPrimary)
    End Sub

    ''' Pushes the primary to the secondary set and makes (anchor, caret) primary.
    Private Sub AddSelectionQuiet(anchor As Integer, caret As Integer)
        Me.ClearComposition()
        Array.Append(Me.mExtraAnchors, Me.mAnchor)
        Array.Append(Me.mExtraCarets, Me.mCaret)
        Me.mAnchor = anchor
        Me.mCaret = caret
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.NormalizeSelections()
    End Sub

    ''' Compact text form of every selection, primary first (change detection and the
    ''' cursor history).
    Private Function SelectionKey() As String
        Dim parts As Array Of String = []
        Array.Append(parts, String.From(Me.mAnchor))
        Array.Append(parts, String.From(Me.mCaret))
        For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
            Array.Append(parts, String.From(Me.mExtraAnchors(i)))
            Array.Append(parts, String.From(Me.mExtraCarets(i)))
        Next
        Return String.Join(parts, ",")
    End Function

    Private Function ExtrasKey() As String
        If Array.Count(Me.mExtraCarets) = 0 Then Return ""
        Dim parts As Array Of String = []
        For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
            Array.Append(parts, String.From(Me.mExtraAnchors(i)))
            Array.Append(parts, String.From(Me.mExtraCarets(i)))
        Next
        Return String.Join(parts, ",")
    End Function

    ''' Restores a SelectionKey() string (primary first).
    Private Sub ApplySelectionKey(key As String)
        Dim parts As Array Of String = String.Split(key, ",", True)
        If Array.Count(parts) < 2 Then Return
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim i As Integer = 0
        While i + 1 < Array.Count(parts)
            Array.Append(anchors, Me.Clamp(Integer.Parse(parts(i)).Or(0)))
            Array.Append(carets, Me.Clamp(Integer.Parse(parts(i + 1)).Or(0)))
            i += 2
        Wend
        Me.ApplySelections(anchors, carets, 0)
        Me.NormalizeSelections()
    End Sub

    ''' Saves the selections for undoCursor before a cursor operation.
    Private Sub RememberCursors()
        Dim key As String = Me.SelectionKey()
        If Array.Count(Me.mCursorHistory) > 0 Then
            If Array.Last(Me.mCursorHistory) = key Then Return
        End If
        Array.Append(Me.mCursorHistory, key)
        If Array.Count(Me.mCursorHistory) > 64 Then Array.RemoveAt(Me.mCursorHistory, 0)
    End Sub

    ''' Undo the last cursor operation (add cursor, add occurrence, column select...).
    Private Sub UndoCursorOperation()
        If Array.Count(Me.mCursorHistory) = 0 Then Return
        Dim key As String = Array.Last(Me.mCursorHistory)
        Array.RemoveAt(Me.mCursorHistory, Array.LastIndex(Me.mCursorHistory))
        Me.ClearComposition()
        Me.ApplySelectionKey(key)
        Me.mPreferredColumn = -1
        Me.EnsureCaretVisible()
    End Sub

    ''' Text of every selection in document order.
    Private Function SelectionTexts() As Array Of String
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim texts As Array Of String = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim s As Integer = Math.Min(anchors(i), carets(i))
            Array.Append(texts, Me.Slice(s, Math.Abs(carets(i) - anchors(i))))
        Next
        Return texts
    End Function

    ''' Where a position lands when [s, e) is replaced by text ending at newEnd.
    Private Function MapThroughEdit(position As Integer, s As Integer, e As Integer, newEnd As Integer) As Integer
        If position >= e Then Return position + newEnd - e
        If position <= s Then Return position
        Return Math.Min(position, newEnd)
    End Function

    ' ---- Caret, view state and navigation ------------------------------------------

    ''' 0-based line of the caret.
    Public Property CaretLine As Integer
        Get
            Return Me.LineOfPosition(Me.mCaret)
        End Get
    End Property

    ''' 0-based codepoint column of the caret within its line.
    Public Property CaretColumn As Integer
        Get
            Return Me.mCaret - Me.mStarts(Me.LineOfPosition(Me.mCaret))
        End Get
    End Property

    ''' 0-based cell column of the caret (tabs expanded, wide characters two cells).
    Public Property CaretCell As Integer
        Get
            Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
            Return Me.VisualColumn(Me.mLines(lineIndex), Me.mCaret - Me.mStarts(lineIndex))
        End Get
    End Property

    ''' Text of one 0-based line ("" when out of range).
    Public Function LineText(lineIndex As Integer) As String
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return ""
        Return Me.mLines(lineIndex)
    End Function

    ''' Kind of the latest user edit: "typing", "delete", "newline", "paste", "cut",
    ''' "indent", "comment", "move", "duplicate", "replace", "drop" or "edit".
    Public Property LastEditKind As String
        Get
            Return Me.mEditKind
        End Get
    End Property

    ''' True when the latest edit continued a run of typing or deleting at the same place,
    ''' so a host undo stack may merge it with the previous step.
    Public Property LastEditContinuesTyping As Boolean
        Get
            Return Me.mContinuesTyping
        End Get
    End Property

    Public Function CaptureViewState() As StudioEditorViewState
        Dim state As New StudioEditorViewState()
        state.Anchor = Me.mAnchor
        state.Caret = Me.mCaret
        For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
            Array.Append(state.Extras, Me.mExtraAnchors(i))
            Array.Append(state.Extras, Me.mExtraCarets(i))
        Next
        state.ScrollX = Me.mScrollX
        state.ScrollY = Me.mScrollY
        state.Folded = Array.Clone(Me.mFolded)
        For Each header As Integer In Me.mFolded
            If header >= 0 And header <= Array.LastIndex(Me.mLines) Then
                Array.Append(state.FoldHeaders, String.Trim(Me.mLines(header)))
            Else
                Array.Append(state.FoldHeaders, "")
            End If
        Next
        Return state
    End Function

    ''' Restores a captured selection and scroll position, clamped to the current text and
    ''' snapped out of character clusters. Pair with setting Text for exact host undo.
    Public Sub RestoreViewState(state As StudioEditorViewState)
        If state = Nil Then Return
        Me.ClearComposition()
        Me.mAnchor = Me.SnapPosition(Me.Clamp(state.Anchor))
        Me.mCaret = Me.SnapPosition(Me.Clamp(state.Caret))
        Me.ClearExtras()
        Dim k As Integer = 0
        While k + 1 < Array.Count(state.Extras)
            Array.Append(Me.mExtraAnchors, Me.SnapPosition(Me.Clamp(state.Extras(k))))
            Array.Append(Me.mExtraCarets, Me.SnapPosition(Me.Clamp(state.Extras(k + 1))))
            k += 2
        Wend
        Me.NormalizeSelections()
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        If Array.Count(state.FoldHeaders) = Array.Count(state.Folded) And Array.Count(state.Folded) > 0 Then
            Me.SetFoldedLines(Me.AnchorFolds(state.Folded, state.FoldHeaders))
        Else
            Me.SetFoldedLines(state.Folded)
        End If
        Me.SetScroll(state.ScrollX, state.ScrollY)
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Caret to the first non-blank character of a 1-based line, centred, focused.
    Public Sub GoToLine(lineNumber As Integer)
        Dim lineIndex As Integer = Math.Max(0, Math.Min(lineNumber - 1, Array.LastIndex(Me.mLines)))
        Dim column As Integer = String.Len(Me.LeadingWhitespace(Me.mLines(lineIndex)))
        Me.RevealRange(Me.mStarts(lineIndex) + column, 0)
    End Sub

    ''' Selects `length` codepoints at a 0-based line and 0-based codepoint column,
    ''' centred and focused. Out-of-range values are clamped.
    Public Sub GoToLocation(lineIndex As Integer, column As Integer, length As Integer = 0)
        Dim index As Integer = Math.Max(0, Math.Min(lineIndex, Array.LastIndex(Me.mLines)))
        Dim lineLength As Integer = String.Len(Me.mLines(index))
        Dim start As Integer = Math.Max(0, Math.Min(column, lineLength))
        Me.RevealRange(Me.mStarts(index) + start, Math.Max(0, Math.Min(length, lineLength - start)))
    End Sub

    ''' A compiler diagnostic location exactly as `buoy --diagnostic-format json` reports
    ''' it: `line` and `character` are both 1-based and `character` counts UTF-8 bytes.
    ''' A byte inside a multi-byte character lands on that character and the identifier
    ''' there is selected; character <= 0 goes to the line's first non-blank character.
    Public Sub GoToCompilerLocation(line As Integer, character As Integer)
        Dim lineIndex As Integer = Math.Max(0, Math.Min(line - 1, Array.LastIndex(Me.mLines)))
        If character <= 0 Then
            Me.GoToLine(lineIndex + 1)
            Return
        End If
        Dim column As Integer = StudioColumnFromUtf8(Me.mLines(lineIndex), character)
        Me.GoToLocation(lineIndex, column, Me.WordLengthAt(lineIndex, column))
    End Sub

    ''' Selects a document range, scrolls it to the middle of the view when it is not
    ''' already visible, and focuses the editor.
    Public Sub RevealRange(start As Integer, length As Integer)
        Me.ClearComposition()
        Me.ClearExtras()
        Me.mAnchor = Me.Clamp(start)
        Me.mCaret = Me.Clamp(start + Math.Max(0, length))
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.CenterCaret()
        Me.Invalidate()
        Me.FinishInteraction()
        Me.Focus()
    End Sub

    Private Sub CenterCaret()
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Me.UnfoldAround(lineIndex)
        Dim top As Double = Me.RowOfPosition(Me.mCaret) * Me.LineHeight
        Dim visible As Double = Me.ViewHeight() - Me.ScrollbarSize()
        If top < Me.mScrollY Or top + Me.LineHeight > Me.mScrollY + visible Then
            Me.SetScroll(Me.mScrollX, top - (visible - Me.LineHeight) / 2.0)
        End If
        Me.EnsureCaretVisible()
    End Sub

    Private Function WordLengthAt(lineIndex As Integer, column As Integer) As Integer
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim index As Integer = Math.Max(0, column)
        While index < Array.Count(codes)
            If Not EditorIsWordCode(String.Asc(codes(index))) Then Exit While
            index += 1
        End While
        Return index - Math.Max(0, column)
    End Function

    ''' Position of the bracket matching the one beside the caret (code only), or -1.
    Public Function MatchingBracket() As Integer
        Dim origin As Integer = -1
        Return Me.BracketPair(Me.mCaret, origin)
    End Function

    ' ---- Diagnostics markers ---------------------------------------------------------

    ''' Replaces the diagnostics shown in the editor (copied; lines clamped to the text).
    Public Sub SetMarkers(markers As Array Of StudioEditorMarker)
        Dim copies As Array Of StudioEditorMarker = []
        For Each marker As StudioEditorMarker In markers
            If marker <> Nil Then
                Dim lineIndex As Integer = Math.Max(0, Math.Min(marker.Line, Array.LastIndex(Me.mLines)))
                Array.Append(copies, New StudioEditorMarker(lineIndex, Math.Max(0, marker.Column), Math.Max(0, marker.Length), marker.Severity, marker.Message))
            End If
        Next
        Me.mMarkers = copies
        Me.Invalidate()
    End Sub

    Public Sub ClearMarkers()
        Me.mMarkers = []
        Me.Invalidate()
    End Sub

    ''' Copies of the current markers, at their edit-adjusted lines.
    Public Function Markers() As Array Of StudioEditorMarker
        Dim copies As Array Of StudioEditorMarker = []
        For Each marker As StudioEditorMarker In Me.mMarkers
            Array.Append(copies, New StudioEditorMarker(marker.Line, marker.Column, marker.Length, marker.Severity, marker.Message))
        Next
        Return copies
    End Function

    ''' Diagnostics on a visible row, including the contents of collapsed folds.
    Public Function GutterMarkersOnLine(lineIndex As Integer) As Array Of StudioEditorMarker
        Dim found As Array Of StudioEditorMarker = []
        If lineIndex < 0 Or lineIndex >= Array.Count(Me.mLines) Then Return found
        Dim row As Integer = Me.RowOfLine(lineIndex)
        For Each marker As StudioEditorMarker In Me.mMarkers
            If Me.RowOfLine(marker.Line) = row Then
                found.Append(New StudioEditorMarker(marker.Line, marker.Column, marker.Length, marker.Severity, marker.Message))
            End If
        Next
        Return found
    End Function

    Public Function GutterMarker(lineIndex As Integer) As StudioEditorMarker
        Dim best As StudioEditorMarker = Nil
        If lineIndex < 0 Or lineIndex >= Array.Count(Me.mLines) Then Return best
        Dim row As Integer = Me.RowOfLine(lineIndex)
        For Each marker As StudioEditorMarker In Me.mMarkers
            If Me.RowOfLine(marker.Line) <> row Then Continue For
            If best = Nil Then
                best = marker
            ElseIf CType(marker.Severity, Integer) < CType(best.Severity, Integer) Then
                best = marker
            End If
        Next
        If best = Nil Then Return best
        Return New StudioEditorMarker(best.Line, best.Column, best.Length, best.Severity, best.Message)
    End Function

    Public Function ProblemText(lineIndex As Integer) As String
        Dim message As String = ""
        For Each marker As StudioEditorMarker In Me.GutterMarkersOnLine(lineIndex)
            If message <> "" Then message += "\n\n"
            message += StudioMarkerSeverityName(marker.Severity) + " — line " + String.From(marker.Line + 1) + ":" + String.From(marker.Column + 1) + "\n" + marker.Message
        Next
        Return message
    End Function

    Public Function ActivateGutterProblem(lineIndex As Integer) As Boolean
        Dim marker As StudioEditorMarker = Me.GutterMarker(lineIndex)
        If marker = Nil Then Return False
        ' Capture the full list before navigation unfolds a collapsed region.
        Dim message As String = Me.ProblemText(lineIndex)
        Me.GoToLocation(marker.Line, marker.Column, marker.Length)
        RaiseEvent ProblemRequested(marker.Line, message)
        Return True
    End Function

    Public Function MarkersOnLine(lineIndex As Integer) As Array Of StudioEditorMarker
        Dim found As Array Of StudioEditorMarker = []
        For Each marker As StudioEditorMarker In Me.mMarkers
            If marker.Line = lineIndex Then Array.Append(found, New StudioEditorMarker(marker.Line, marker.Column, marker.Length, marker.Severity, marker.Message))
        Next
        Return found
    End Function

    ''' A marker for a compiler diagnostic (`line` and `character` 1-based, `character`
    ''' in UTF-8 bytes, as in --diagnostic-format json). character <= 0 marks the whole
    ''' line; otherwise the identifier (or single character) at that column.
    Public Function CompilerMarker(line As Integer, character As Integer, severity As StudioMarkerSeverity, message As String) As StudioEditorMarker
        Dim lineIndex As Integer = Math.Max(0, Math.Min(line - 1, Array.LastIndex(Me.mLines)))
        If character <= 0 Then Return New StudioEditorMarker(lineIndex, 0, 0, severity, message)
        Dim column As Integer = StudioColumnFromUtf8(Me.mLines(lineIndex), character)
        Return New StudioEditorMarker(lineIndex, column, Math.Max(1, Me.WordLengthAt(lineIndex, column)), severity, message)
    End Function

    ''' Selects the next (or previous) marker after the selection, wrapping around.
    Public Function GoToNextMarker(forward As Boolean = True) As Boolean
        If Array.Count(Me.mMarkers) = 0 Then Return False
        Dim origin As Integer = Me.SelectionStart
        Dim best As StudioEditorMarker = Nil
        Dim bestStart As Integer = 0
        Dim wrapMarker As StudioEditorMarker = Nil
        Dim wrapStart As Integer = 0
        For Each marker As StudioEditorMarker In Me.mMarkers
            Dim start As Integer = Me.MarkerStart(marker)
            If forward Then
                If start > origin And (best = Nil Or start < bestStart) Then
                    best = marker
                    bestStart = start
                End If
                If wrapMarker = Nil Or start < wrapStart Then
                    wrapMarker = marker
                    wrapStart = start
                End If
            Else
                If start < origin And (best = Nil Or start > bestStart) Then
                    best = marker
                    bestStart = start
                End If
                If wrapMarker = Nil Or start > wrapStart Then
                    wrapMarker = marker
                    wrapStart = start
                End If
            End If
        Next
        If best = Nil Then
            best = wrapMarker
            bestStart = wrapStart
        End If
        Dim length As Integer = best.Length
        If length > 0 Then length = Math.Min(length, Me.mStarts(best.Line) + String.Len(Me.mLines(best.Line)) - bestStart)
        Me.RevealRange(bestStart, Math.Max(0, length))
        Return True
    End Function

    ''' Document position where a marker's highlight begins (first non-blank character
    ''' for whole-line markers).
    Private Function MarkerStart(marker As StudioEditorMarker) As Integer
        Dim lineIndex As Integer = Math.Max(0, Math.Min(marker.Line, Array.LastIndex(Me.mLines)))
        Dim line As String = Me.mLines(lineIndex)
        Dim column As Integer = Math.Min(marker.Column, String.Len(line))
        If marker.Length <= 0 Then column = String.Len(Me.LeadingWhitespace(line))
        Return Me.mStarts(lineIndex) + column
    End Function

    ' ---- Breakpoints and the debugger's execution line -------------------------------

    ''' Shows the breakpoint lane at the gutter's left edge; clicking it toggles a
    ''' breakpoint on that line and raises BreakpointsChanged.
    Public Property ShowsBreakpoints As Boolean
        Get
            Return Me.mShowsBreakpoints
        End Get
        Set
            Me.mShowsBreakpoints = value
            Me.Invalidate()
        End Set
    End Property

    ''' Sorted 0-based breakpoint lines (edit-adjusted).
    Public Function Breakpoints() As Array Of Integer
        Return Array.Clone(Me.mBreakpoints)
    End Function

    ''' Replaces the breakpoint lines (0-based; clamped, sorted, de-duplicated). Does not
    ''' raise BreakpointsChanged.
    Public Sub SetBreakpoints(lines As Array Of Integer)
        Me.mBreakpoints = Array.Clone(lines)
        Me.NormalizeBreakpoints()
        Me.Invalidate()
    End Sub

    Public Function HasBreakpoint(lineIndex As Integer) As Boolean
        For Each line As Integer In Me.mBreakpoints
            If line = lineIndex Then Return True
        Next
        Return False
    End Function

    ''' Toggles a breakpoint on a 0-based line, raises BreakpointsChanged and returns
    ''' whether the line now has one.
    Public Function ToggleBreakpoint(lineIndex As Integer) As Boolean
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return False
        Dim enabled As Boolean = Not Me.HasBreakpoint(lineIndex)
        If enabled Then
            Array.Append(Me.mBreakpoints, lineIndex)
            Me.NormalizeBreakpoints()
        Else
            Dim kept As Array Of Integer = []
            For Each line As Integer In Me.mBreakpoints
                If line <> lineIndex Then Array.Append(kept, line)
            Next
            Me.mBreakpoints = kept
        End If
        Me.Invalidate()
        RaiseEvent BreakpointsChanged()
        Return enabled
    End Function

    ''' 0-based line where the debugger is stopped, -1 for none. Setting a line draws the
    ''' execution arrow and highlight and scrolls the line into view (the caret stays).
    Public Property ExecutionLine As Integer
        Get
            Return Me.mExecutionLine
        End Get
        Set
            Dim hadLane As Boolean = Me.LaneWidth() > 0
            If value < 0 Then
                Me.mExecutionLine = -1
                If hadLane <> (Me.LaneWidth() > 0) Then Me.RowsChanged()
            Else
                Me.mExecutionLine = Math.Min(value, Array.LastIndex(Me.mLines))
                If hadLane <> (Me.LaneWidth() > 0) Then Me.RowsChanged()
                Me.UnfoldAround(Me.mExecutionLine)
                Dim top As Double = Me.RowOfLine(Me.mExecutionLine) * Me.LineHeight
                Dim visible As Double = Me.ViewHeight() - Me.ScrollbarSize()
                If top < Me.mScrollY Or top + Me.LineHeight > Me.mScrollY + visible Then Me.SetScroll(Me.mScrollX, top - (visible - Me.LineHeight) / 2.0)
            End If
            Me.Invalidate()
        End Set
    End Property

    Private Sub NormalizeBreakpoints()
        Dim last As Integer = Array.LastIndex(Me.mLines)
        Dim clamped As Array Of Integer = []
        For Each line As Integer In Me.mBreakpoints
            Array.Append(clamped, Math.Max(0, Math.Min(line, last)))
        Next
        Me.mBreakpoints = EditorUniqueSorted(clamped)
    End Sub

    ''' Keeps markers, breakpoints and the execution line on their text when lines
    ''' [first, first+removed) are replaced by `inserted` lines.
    Private Sub ShiftLineData(first As Integer, removed As Integer, inserted As Integer, followEnd As Boolean)
        Dim lastRemoved As Integer = first + removed - 1
        Dim newLast As Integer = first + inserted - 1
        Dim delta As Integer = inserted - removed
        Me.FoldsEdited(first, removed, inserted, followEnd)
        If delta = 0 And Not followEnd Then Return
        For Each marker As StudioEditorMarker In Me.mMarkers
            marker.Line = EditorShiftedLine(marker.Line, first, lastRemoved, newLast, delta, followEnd)
        Next
        Dim moved As Boolean = False
        For i As Integer = 0 To Array.LastIndex(Me.mBreakpoints)
            Dim shifted As Integer = EditorShiftedLine(Me.mBreakpoints(i), first, lastRemoved, newLast, delta, followEnd)
            If shifted <> Me.mBreakpoints(i) Then
                Me.mBreakpoints(i) = shifted
                moved = True
            End If
        Next
        If moved Then
            Me.mBreakpoints = EditorUniqueSorted(Me.mBreakpoints)
            Me.mBreakpointsMoved = True
        End If
        If Me.mExecutionLine >= 0 Then Me.mExecutionLine = EditorShiftedLine(Me.mExecutionLine, first, lastRemoved, newLast, delta, followEnd)
    End Sub

    ''' Moves line data with lines that MoveLines permutes within [first, last].
    Private Sub RotateLineData(first As Integer, last As Integer, down As Boolean)
        Me.FoldsRotated(first, last, down)
        For Each marker As StudioEditorMarker In Me.mMarkers
            marker.Line = EditorRotatedLine(marker.Line, first, last, down)
        Next
        Dim moved As Boolean = False
        For i As Integer = 0 To Array.LastIndex(Me.mBreakpoints)
            Dim rotated As Integer = EditorRotatedLine(Me.mBreakpoints(i), first, last, down)
            If rotated <> Me.mBreakpoints(i) Then
                Me.mBreakpoints(i) = rotated
                moved = True
            End If
        Next
        If moved Then
            Me.mBreakpoints = EditorUniqueSorted(Me.mBreakpoints)
            Me.mBreakpointsMoved = True
        End If
        If Me.mExecutionLine >= 0 Then Me.mExecutionLine = EditorRotatedLine(Me.mExecutionLine, first, last, down)
    End Sub

    ' ---- Find and replace --------------------------------------------------------------
    ' All search scopes share PCRE2 Unicode case folding and word boundaries.
    ' Literal queries are escaped; replacement escapes only expand in Grep mode.

    ''' Highlights every match of `query` in the visible text ("" clears) and makes it the
    ''' query for findNext/findPrevious (Primary+G / Primary+Shift+G).
    Public Sub SetFindHighlight(query As String, caseSensitive As Boolean = False, wholeWord As Boolean = False, regex As Boolean = False, multiline As Boolean = True, dotAll As Boolean = False)
        Dim changed As Boolean = String.Compare(query, Me.mFindQuery, True) <> 0 Or caseSensitive <> Me.mFindCase Or wholeWord <> Me.mFindWord Or regex <> Me.mFindRegex Or multiline <> Me.mFindMultiline Or dotAll <> Me.mFindDotAll
        If changed Or Not Me.mRegexCacheValid Or String.Compare(Me.mRegexCacheText, Me.Text, True) <> 0 Then
            ' Validate before replacing the remembered query or highlights.
            Dim hits As Array Of StudioFindHit = []
            Try
                hits = StudioFindHits(Me.Text, query, regex, caseSensitive, wholeWord, multiline, dotAll)
            Catch e As Exception
                Return
            End Try
            Me.mRegexHits = hits
            Me.mRegexCacheText = Me.Text
            Me.mRegexCacheValid = True
        End If
        If changed Then Me.mRegexSelected = False
        Me.mFindRegex = regex
        Me.mFindMultiline = multiline
        Me.mFindDotAll = dotAll
        Me.mFindQuery = query
        Me.mFindCase = caseSensitive
        Me.mFindWord = wholeWord
        Me.Invalidate()
    End Sub

    Private Function RegexHighlights(reportErrors As Boolean = False) As Array Of StudioFindHit
        If Not Me.mRegexCacheValid Or String.Compare(Me.mRegexCacheText, Me.Text, True) <> 0 Then
            Try
                Me.mRegexHits = StudioFindHits(Me.Text, Me.mFindQuery, Me.mFindRegex, Me.mFindCase, Me.mFindWord, Me.mFindMultiline, Me.mFindDotAll)
            Catch e As Exception
                If reportErrors Then Throw e
                Dim empty As Array Of StudioFindHit = []
                Return empty
            End Try
            Me.mRegexCacheText = Me.Text
            Me.mRegexCacheValid = True
        End If
        Return Me.mRegexHits
    End Function

    ' Preview uses exactly the same expansion as replacement, without an edit.
    Public Function PreviewRegex(query As String, replacement As String, matchCase As Boolean, wholeWord As Boolean, multiline As Boolean, dotAll As Boolean) As String
        Dim hits As Array Of StudioFindHit = StudioRegexHits(Me.Text, query, matchCase, wholeWord, multiline, dotAll, replacement, True)
        If Array.Count(hits) = 0 Then Return "No matches."
        Dim rows As Array Of String = []
        rows.Append(String.From(Array.Count(hits)) + " matches · Preview (first 50, no edits)")
        For i As Integer = 0 To Math.Min(49, Array.Count(hits) - 1)
            Dim hit As StudioFindHit = hits(i)
            Dim original As String = String.Substring(Me.Text, hit.Start, hit.Length)
            Dim row As String = "Line " + String.From(Me.LineOfPosition(hit.Start) + 1) + ": " + String.Left(original, 160) + " → " + String.Left(hit.Replacement, 160)
            row = String.Replace(row, "\n", "\\n", True)
            row = String.Replace(row, "\r", "\\r", True)
            row = String.Replace(row, "\t", "\\t", True)
            rows.Append(row)
        Next
        Return String.Join(rows, "\n")
    End Function

    Public Property FindQuery As String
        Get
            Return Me.mFindQuery
        End Get
    End Property

    ''' Selects the next (or previous) match after (before) the selection, optionally
    ''' wrapping. Also sets the find highlight. False when there is no match.
    Public Function FindNext(query As String, forward As Boolean = True, caseSensitive As Boolean = False, wholeWord As Boolean = False, wrap As Boolean = True, regex As Boolean = False, multiline As Boolean = True, dotAll As Boolean = False) As Boolean
        If query = "" Then Return False
        Me.SetFindHighlight(query, caseSensitive, wholeWord, regex, multiline, dotAll)
        Me.mFindWrap = wrap
        Dim hits As Array Of StudioFindHit = []
        Try
            hits = StudioFindHits(Me.Text, query, regex, caseSensitive, wholeWord, multiline, dotAll)
        Catch e As Exception
            Return False
        End Try
        Dim chosen As StudioFindHit = Nil
        Dim repeatedEmpty As Boolean = Me.mRegexSelected And Me.mRegexSelectedStart = Me.SelectionStart And Me.SelectionLength = 0 And String.Compare(Me.mRegexSelectedText, Me.Text, True) = 0
        If forward Then
            For Each hit As StudioFindHit In hits
                If hit.Start >= Me.SelectionStart + Me.SelectionLength Then
                    If repeatedEmpty And hit.Start = Me.SelectionStart And hit.Length = 0 Then Continue For
                    chosen = hit
                    Exit For
                End If
            Next
            If chosen = Nil And wrap And Array.Count(hits) > 0 Then chosen = hits(0)
        Else
            For Each hit As StudioFindHit In hits
                If hit.Start + hit.Length <= Me.SelectionStart And hit.Start < Me.SelectionStart Then chosen = hit
            Next
            If chosen = Nil And wrap And Array.Count(hits) > 0 Then chosen = hits(Array.Count(hits) - 1)
        End If
        If chosen = Nil Then Return False
        Me.RevealRange(chosen.Start, chosen.Length)
        Me.mRegexSelected = True
        Me.mRegexSelectedStart = chosen.Start
        Me.mRegexSelectedText = Me.Text
        Return True
    End Function

    Public Function CountMatches(query As String, caseSensitive As Boolean = False, wholeWord As Boolean = False, regex As Boolean = False, multiline As Boolean = True, dotAll As Boolean = False) As Integer
        If query = "" Then Return 0
        If String.Compare(query, Me.mFindQuery, True) = 0 And caseSensitive = Me.mFindCase And wholeWord = Me.mFindWord And regex = Me.mFindRegex And multiline = Me.mFindMultiline And dotAll = Me.mFindDotAll Then Return Array.Count(Me.RegexHighlights(True))
        Return Array.Count(StudioFindHits(Me.Text, query, regex, caseSensitive, wholeWord, multiline, dotAll))
    End Function

    ''' Replaces the selection when it is a match, then selects the next match. Returns
    ''' True when a replacement was made (one undo step, raises TextChanged).
    Public Function ReplaceSelection(query As String, replacement As String, caseSensitive As Boolean = False, wholeWord As Boolean = False, regex As Boolean = False, multiline As Boolean = True, dotAll As Boolean = False, wrap As Boolean = True) As Boolean
        If query = "" Or Me.IsReadOnly Then Return False
        Me.SetFindHighlight(query, caseSensitive, wholeWord, regex, multiline, dotAll)
        Dim hits As Array Of StudioFindHit = StudioFindHits(Me.Text, query, regex, caseSensitive, wholeWord, multiline, dotAll, replacement, True)
        For Each hit As StudioFindHit In hits
            If hit.Start = Me.SelectionStart And hit.Length = Me.SelectionLength Then
                If hit.Length = 0 And Not (Me.mRegexSelected And String.Compare(Me.mRegexSelectedText, Me.Text, True) = 0 And Me.mRegexSelectedStart = hit.Start) Then Exit For
                Me.EditRange(hit.Start, hit.Length, hit.Replacement, -1, -1, "replace")
                Me.mRegexSelected = hit.Length = 0
                Me.mRegexSelectedStart = Me.SelectionStart
                Me.mRegexSelectedText = Me.Text
                Me.FindNext(query, True, caseSensitive, wholeWord, wrap, regex, multiline, dotAll)
                Return True
            End If
        Next
        Me.FindNext(query, True, caseSensitive, wholeWord, wrap, regex, multiline, dotAll)
        Return False
    End Function

    ''' Replaces every match in one edit (one undo step). Returns the number replaced.
    Public Function ReplaceAll(query As String, replacement As String, caseSensitive As Boolean = False, wholeWord As Boolean = False, regex As Boolean = False, multiline As Boolean = True, dotAll As Boolean = False) As Integer
        If query = "" Or Me.IsReadOnly Then Return 0
        Dim hits As Array Of StudioFindHit = StudioFindHits(Me.Text, query, regex, caseSensitive, wholeWord, multiline, dotAll, replacement, True)
        If Array.Count(hits) = 0 Then Return 0
        Dim pieces As Array Of String = []
        Dim first As Integer = hits(0).Start
        Dim previous As Integer = first
        Dim source As String = Me.Text
        For Each hit As StudioFindHit In hits
            pieces.Append(String.Substring(source, previous, hit.Start - previous))
            pieces.Append(hit.Replacement)
            previous = hit.Start + hit.Length
        Next
        Me.EditRange(first, previous - first, String.Join(pieces, ""), first, first, "replace")
        Me.mRegexSelected = False
        Return Array.Count(hits)
    End Function

    Private Function FindAfter(text As String, query As String, from As Integer, caseSensitive As Boolean, wholeWord As Boolean) As Integer
        Dim length As Integer = String.Len(query)
        Dim total As Integer = String.Len(text)
        Dim index As Integer = Math.Max(0, from)
        While index + length <= total
            Dim hit As Integer = String.IndexOf(text, query, index, caseSensitive)
            If hit < 0 Then Return -1
            If Not wholeWord Or Me.IsWholeWordAt(text, hit, length) Then Return hit
            index = hit + 1
        Wend
        Return -1
    End Function

    Private Function FindBefore(text As String, query As String, limit As Integer, caseSensitive As Boolean, wholeWord As Boolean) As Integer
        Dim length As Integer = String.Len(query)
        Dim bound As Integer = Math.Min(limit, String.Len(text))
        While bound >= length
            Dim hit As Integer = String.LastIndexOf(String.Left(text, bound), query, caseSensitive)
            If hit < 0 Then Return -1
            If Not wholeWord Or Me.IsWholeWordAt(text, hit, length) Then Return hit
            bound = hit + length - 1
        Wend
        Return -1
    End Function

    Private Function IsWholeWordAt(text As String, index As Integer, length As Integer) As Boolean
        If index > 0 Then
            If EditorIsWordCode(String.Asc(String.Substring(text, index - 1, 1))) Then Return False
        End If
        If index + length < String.Len(text) Then
            If EditorIsWordCode(String.Asc(String.Substring(text, index + length, 1))) Then Return False
        End If
        Return True
    End Function

    ' ---- Line commands -----------------------------------------------------------------

    ''' Lines covered by the selection (a selection ending at a line start excludes it).
    Private Sub SelectedLines(ByRef first As Integer, ByRef last As Integer)
        Me.LinesOf(Me.mAnchor, Me.mCaret, first, last)
    End Sub

    ''' Lines covered by one selection (see SelectedLines).
    Private Sub LinesOf(anchor As Integer, caret As Integer, ByRef first As Integer, ByRef last As Integer)
        Dim s As Integer = Math.Min(anchor, caret)
        Dim e As Integer = Math.Max(anchor, caret)
        first = Me.LineOfPosition(s)
        last = Me.LineOfPosition(e)
        If last > first And e = Me.mStarts(last) Then last -= 1
        ' A collapsed fold counts as its whole block (header row through hidden body).
        first = Me.LineOfFoldRow(Me.FoldRowOfLine(first))
        last = Me.RowEndLine(last)
    End Sub

    ''' Comments the selected lines with `'` at their common indent, or uncomments them
    ''' (`'` or `//`) when every non-blank line is already commented. One undo step.
    Public Sub ToggleComment()
        If Me.IsReadOnly Or Not Me.IsBuoyMode() Then Return
        If Me.HasExtras() Then
            Me.ToggleCommentMulti()
            Return
        End If
        Dim first As Integer = 0
        Dim last As Integer = 0
        Me.SelectedLines(first, last)
        Dim commented As Boolean = True
        Dim anyCode As Boolean = False
        Dim minIndent As Integer = -1
        For i As Integer = first To last
            Dim line As String = Me.mLines(i)
            Dim lead As Integer = String.Len(Me.LeadingWhitespace(line))
            If lead < String.Len(line) Then
                anyCode = True
                If minIndent < 0 Or lead < minIndent Then minIndent = lead
                Dim body As String = String.Substring(line, lead)
                If Not (String.StartsWith(body, "'") Or String.StartsWith(body, "//")) Then commented = False
            End If
        Next
        If Not anyCode Then Return
        Dim pieces As Array Of String = []
        Dim columns As Array Of Integer = []
        Dim deltas As Array Of Integer = []
        For i As Integer = first To last
            Dim line As String = Me.mLines(i)
            Dim lead As Integer = String.Len(Me.LeadingWhitespace(line))
            If lead >= String.Len(line) Then
                Array.Append(pieces, line)
                Array.Append(columns, 0)
                Array.Append(deltas, 0)
            ElseIf commented Then
                Dim body As String = String.Substring(line, lead)
                Dim remove As Integer = 1
                If String.StartsWith(body, "//") Then remove = 2
                If String.Len(body) > remove Then
                    If String.Substring(body, remove, 1) = " " Then remove += 1
                End If
                Array.Append(pieces, String.Left(line, lead) + String.Substring(body, remove))
                Array.Append(columns, lead)
                Array.Append(deltas, -remove)
            Else
                Array.Append(pieces, String.Left(line, minIndent) + "' " + String.Substring(line, minIndent))
                Array.Append(columns, minIndent)
                Array.Append(deltas, 2)
            End If
        Next
        Dim blockStart As Integer = Me.mStarts(first)
        Dim blockLength As Integer = Me.mStarts(last) + String.Len(Me.mLines(last)) - blockStart
        Dim anchorAfter As Integer = Me.ShiftedPosition(Me.mAnchor, first, columns, deltas)
        Dim caretAfter As Integer = Me.ShiftedPosition(Me.mCaret, first, columns, deltas)
        Me.EditRange(blockStart, blockLength, String.Join(pieces, "\n"), anchorAfter, caretAfter, "comment")
    End Sub

    ''' Where a position lands after per-line edits at `columns` changing lengths by `deltas`.
    Private Function ShiftedPosition(position As Integer, first As Integer, columns As Array Of Integer, deltas As Array Of Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim shifted As Integer = position
        For k As Integer = 0 To Array.LastIndex(deltas)
            Dim i As Integer = first + k
            If i < lineIndex Then
                shifted += deltas(k)
            ElseIf i = lineIndex Then
                Dim column As Integer = position - Me.mStarts(i)
                ' A caret exactly at an inserted marker's column moves past it (but a line
                ' selection anchored at column 0 keeps the whole line).
                If column > columns(k) Or (column = columns(k) And columns(k) > 0 And deltas(k) > 0) Then shifted += Math.Max(deltas(k), columns(k) - column)
            End If
        Next
        Return shifted
    End Function

    ''' Moves the selected lines up or down one line, keeping the selection on them.
    Public Sub MoveLines(down As Boolean)
        If Me.IsReadOnly Then Return
        If Me.HasExtras() Then
            Me.MoveLinesMulti(down)
            Return
        End If
        Dim first As Integer = 0
        Dim last As Integer = 0
        Me.SelectedLines(first, last)
        If down And last >= Array.LastIndex(Me.mLines) Then Return
        If Not down And first = 0 Then Return
        Dim pieces As Array Of String = []
        Dim rangeFirst As Integer = first
        Dim rangeLast As Integer = last
        Dim offset As Integer = 0
        If down Then
            rangeLast = last + 1
            Array.Append(pieces, Me.mLines(last + 1))
            offset = String.Len(Me.mLines(last + 1)) + 1
        Else
            rangeFirst = first - 1
        End If
        For i As Integer = first To last
            Array.Append(pieces, Me.mLines(i))
        Next
        If Not down Then
            Array.Append(pieces, Me.mLines(first - 1))
            offset = -(String.Len(Me.mLines(first - 1)) + 1)
        End If
        Dim blockStart As Integer = Me.mStarts(rangeFirst)
        Dim blockLength As Integer = Me.mStarts(rangeLast) + String.Len(Me.mLines(rangeLast)) - blockStart
        Me.RotateLineData(rangeFirst, rangeLast, down)
        Me.EditRange(blockStart, blockLength, String.Join(pieces, "\n"), Me.mAnchor + offset, Me.mCaret + offset, "move")
    End Sub

    ''' Inserts a copy of the selected lines below them and selects the copy.
    Public Sub DuplicateLines()
        If Me.IsReadOnly Then Return
        If Me.HasExtras() Then
            Me.CopyLines(True)
            Return
        End If
        Dim first As Integer = 0
        Dim last As Integer = 0
        Me.SelectedLines(first, last)
        Dim copied As Array Of String = []
        For i As Integer = first To last
            Array.Append(copied, Me.mLines(i))
        Next
        Dim copy As String = String.Join(copied, "\n")
        Dim lineEnd As Integer = Me.mStarts(last) + String.Len(Me.mLines(last))
        Dim shift As Integer = String.Len(copy) + 1
        Me.EditRange(lineEnd, 0, "\n" + copy, Me.mAnchor + shift, Me.mCaret + shift, "duplicate")
    End Sub

    ' ---- Multi-cursor commands ------------------------------------------------------

    ''' Runs a single-selection command once per selection, back to front, as one user
    ''' action: every edit shifts the other selections (ReplaceRange), overlapping
    ''' results merge, and TextChanged/SelectionChanged are raised once. `pieces` (one
    ''' per selection in document order, or one for all) feed the @type/@paste commands.
    Private Sub RunBatch(command As String, extend As Boolean, pieces As Array Of String, broadcast As Boolean)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim primary As Integer = Me.SortedSelections(anchors, carets)
        Dim beforeKind As String = Me.mEditKind
        Dim startCarets As Array Of Integer = Array.Clone(carets)
        ' Per-cursor preferred columns survive consecutive vertical moves.
        Dim columns As Array Of Integer = []
        Dim reuse As Boolean = String.Compare(Me.mBatchColumnsKey, Me.SelectionKey(), True) = 0 And Array.Count(Me.mBatchColumns) = Array.Count(carets)
        For i As Integer = 0 To Array.LastIndex(carets)
            If reuse Then
                Array.Append(columns, Me.mBatchColumns(i))
            Else
                Array.Append(columns, -1)
            End If
        Next
        Me.ClearComposition()
        Me.mBatchAnchors = anchors
        Me.mBatchCarets = carets
        Me.mExtraAnchors = []
        Me.mExtraCarets = []
        Me.mBatch = True
        Me.mBatchEdited = False
        Me.mBatchKills = []
        Try
            For k As Integer = Array.LastIndex(carets) To 0 Step -1
                Me.mBatchIndex = k
                Me.mAnchor = Me.mBatchAnchors(k)
                Me.mCaret = Me.mBatchCarets(k)
                Me.mPreferredColumn = columns(k)
                Me.mBatchPiece = ""
                If Array.Count(pieces) > 0 Then
                    If broadcast Then
                        Me.mBatchPiece = pieces(0)
                    Else
                        Me.mBatchPiece = pieces(Math.Min(k, Array.LastIndex(pieces)))
                    End If
                End If
                Me.ExecuteCommand(command, extend)
                Me.mBatchAnchors(k) = Me.mAnchor
                Me.mBatchCarets(k) = Me.mCaret
                columns(k) = Me.mPreferredColumn
            Next
        Catch e As Exception
            ' Keep every selection and tell the host about edits already made.
            Me.mBatch = False
            Me.mBatchIndex = -1
            Me.mBatchPiece = ""
            Me.mBatchKills = []
            Me.ApplySelections(Me.mBatchAnchors, Me.mBatchCarets, primary)
            Me.NormalizeSelections()
            Me.Invalidate()
            If Me.mBatchEdited Then
                Me.mBatchEdited = False
                Me.RaiseTextChanged()
            End If
            Me.FinishInteraction()
            Throw e
        Finally
            Me.mBatch = False
            Me.mBatchIndex = -1
            Me.mBatchPiece = ""
        End Try
        Me.ApplySelections(Me.mBatchAnchors, Me.mBatchCarets, primary)
        Dim beforeMerge As Integer = Me.SelectionCount
        Me.NormalizeSelections()
        If Me.SelectionCount = beforeMerge Then
            Me.mBatchColumns = columns
            Me.mBatchColumnsKey = Me.SelectionKey()
        Else
            Me.mBatchColumns = []
            Me.mBatchColumnsKey = ""
        End If
        Me.mPreferredColumn = -1
        If Array.Count(Me.mBatchKills) > 0 Then
            ' Collected back to front.
            Dim kills As Array Of String = []
            For i As Integer = Array.LastIndex(Me.mBatchKills) To 0 Step -1
                Array.Append(kills, Me.mBatchKills(i))
            Next
            StudioCodeEditor.KillBuffer = String.Join(kills, "\n")
            Me.mBatchKills = []
        End If
        If Me.mBatchEdited Then
            Dim runKind As Boolean = String.Compare(Me.mEditKind, "typing", True) = 0 Or String.Compare(Me.mEditKind, "delete", True) = 0
            Me.mContinuesTyping = runKind And String.Compare(beforeKind, Me.mEditKind, True) = 0 And EditorSameLines(startCarets, Me.mLastBatchCarets)
            Dim after As Array Of Integer = []
            Dim afterAnchors As Array Of Integer = []
            Me.SortedSelections(afterAnchors, after)
            Me.mLastBatchCarets = after
            Me.mEditEnd = Me.mCaret
        End If
        Me.EnsureCaretVisible()
        Me.Invalidate()
        If Me.mBatchEdited Then
            If Me.mGroupDepth > 0 Then
                Me.mGroupEdited = True
            Else
                Me.RaiseTextChanged()
            End If
        End If
        Me.mBatchEdited = False
        Me.FinishInteraction()
    End Sub

    ''' True when every selection lies within one line and is not a whole line (Tab then
    ''' inserts at each cursor instead of indenting lines).
    Private Function AllSelectionsInsideLines() As Boolean
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim s As Integer = Math.Min(anchors(i), carets(i))
            Dim e As Integer = Math.Max(anchors(i), carets(i))
            Dim lineIndex As Integer = Me.LineOfPosition(s)
            If Me.LineOfPosition(e) <> lineIndex Then Return False
            If e > s And e - s >= String.Len(Me.mLines(lineIndex)) Then Return False
        Next
        Return True
    End Function

    ''' Line ranges covered by the selections as flat [first, last] pairs, sorted and
    ''' merged when they share a line (or touch, with `mergeAdjacent`).
    Private Function SelectionLineBlocks(mergeAdjacent As Boolean) As Array Of Integer
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim blocks As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim first As Integer = 0
            Dim last As Integer = 0
            Me.LinesOf(anchors(i), carets(i), first, last)
            Dim n As Integer = Array.Count(blocks)
            If n > 0 Then
                Dim limit As Integer = blocks(n - 1)
                If mergeAdjacent Then limit += 1
                If first <= limit Then
                    blocks(n - 1) = Math.Max(blocks(n - 1), last)
                    Continue For
                End If
            End If
            Array.Append(blocks, first)
            Array.Append(blocks, last)
        Next
        Return blocks
    End Function

    ''' Index of the block in SelectionLineBlocks output that contains `lineIndex`.
    Private Function BlockOfLine(blocks As Array Of Integer, lineIndex As Integer) As Integer
        Dim k As Integer = 0
        While k + 1 < Array.Count(blocks)
            If lineIndex >= blocks(k) And lineIndex <= blocks(k + 1) Then Return k \ 2
            k += 2
        Wend
        Return -1
    End Function

    ''' Ends a multi-selection edit made without RunBatch: places the selections and
    ''' raises TextChanged/SelectionChanged once.
    Private Sub FinishMultiEdit(anchors As Array Of Integer, carets As Array Of Integer, primary As Integer, kind As String)
        Me.ApplySelections(anchors, carets, primary)
        Me.NormalizeSelections()
        Me.mEditKind = kind
        Me.mContinuesTyping = False
        Me.mEditEnd = Me.mCaret
        Me.mPreferredColumn = -1
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.RaiseTextChanged()
        Me.FinishInteraction()
    End Sub

    ''' Replaces [start, start+length) without moving any selection (callers place them).
    Private Sub ReplaceQuiet(start As Integer, length As Integer, value As String)
        Me.DismissInlineCompletion()
        Me.mExtraAnchors = []
        Me.mExtraCarets = []
        Me.ReplaceRange(start, length, value)
    End Sub

    ''' Toggle Comment over the lines of every selection (one decision for all of them).
    Private Sub ToggleCommentMulti()
        If Not Me.IsBuoyMode() Then Return
        Dim blocks As Array Of Integer = Me.SelectionLineBlocks(False)
        Dim commented As Boolean = True
        Dim anyCode As Boolean = False
        Dim minIndent As Integer = -1
        Dim k As Integer = 0
        While k + 1 < Array.Count(blocks)
            For i As Integer = blocks(k) To blocks(k + 1)
                Dim line As String = Me.mLines(i)
                Dim lead As Integer = String.Len(Me.LeadingWhitespace(line))
                If lead < String.Len(line) Then
                    anyCode = True
                    If minIndent < 0 Or lead < minIndent Then minIndent = lead
                    Dim body As String = String.Substring(line, lead)
                    If Not (String.StartsWith(body, "'") Or String.StartsWith(body, "//")) Then commented = False
                End If
            Next
            k += 2
        Wend
        If Not anyCode Then Return
        Dim first As Integer = blocks(0)
        Dim last As Integer = Array.Last(blocks)
        Dim pieces As Array Of String = []
        Dim columns As Array Of Integer = []
        Dim deltas As Array Of Integer = []
        For i As Integer = first To last
            Dim line As String = Me.mLines(i)
            Dim lead As Integer = String.Len(Me.LeadingWhitespace(line))
            If Me.BlockOfLine(blocks, i) < 0 Or lead >= String.Len(line) Then
                Array.Append(pieces, line)
                Array.Append(columns, 0)
                Array.Append(deltas, 0)
            ElseIf commented Then
                Dim body As String = String.Substring(line, lead)
                Dim remove As Integer = 1
                If String.StartsWith(body, "//") Then remove = 2
                If String.Len(body) > remove Then
                    If String.Substring(body, remove, 1) = " " Then remove += 1
                End If
                Array.Append(pieces, String.Left(line, lead) + String.Substring(body, remove))
                Array.Append(columns, lead)
                Array.Append(deltas, -remove)
            Else
                Array.Append(pieces, String.Left(line, minIndent) + "' " + String.Substring(line, minIndent))
                Array.Append(columns, minIndent)
                Array.Append(deltas, 2)
            End If
        Next
        Me.ReplaceLineBlock(first, last, pieces, columns, deltas, "comment")
    End Sub

    ''' Indent / outdent the lines of every selection (each line once).
    Private Sub IndentLinesMulti(outdent As Boolean)
        Dim blocks As Array Of Integer = Me.SelectionLineBlocks(False)
        Dim first As Integer = blocks(0)
        Dim last As Integer = Array.Last(blocks)
        Dim pieces As Array Of String = []
        Dim columns As Array Of Integer = []
        Dim deltas As Array Of Integer = []
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim changed As Boolean = False
        For i As Integer = first To last
            Dim line As String = Me.mLines(i)
            Dim delta As Integer = 0
            If Me.BlockOfLine(blocks, i) >= 0 Then
                If outdent Then
                    Dim remove As Integer = 0
                    While remove < Me.IndentStep() And remove < String.Len(line)
                        Dim ch As String = String.Substring(line, remove, 1)
                        If ch = "\t" Then
                            remove += 1
                            Exit While
                        End If
                        If ch <> " " Then Exit While
                        remove += 1
                    End While
                    line = String.Substring(line, remove)
                    delta = -remove
                Else
                    Dim bareCaret As Boolean = False
                    For n As Integer = 0 To Array.LastIndex(carets)
                        If anchors(n) = carets(n) And Me.LineOfPosition(carets(n)) = i Then bareCaret = True
                    Next
                    If line = "" And Not bareCaret Then
                        Array.Append(pieces, line)
                        Array.Append(columns, 0)
                        Array.Append(deltas, 0)
                        Continue For
                    End If
                    Dim unit As String = Me.IndentUnit(Me.LeadingWhitespace(line))
                    line = unit + line
                    delta = String.Len(unit)
                End If
            End If
            If delta <> 0 Then changed = True
            Array.Append(pieces, line)
            Array.Append(columns, 0)
            Array.Append(deltas, delta)
        Next
        If Not changed Then Return
        Me.ReplaceLineBlock(first, last, pieces, columns, deltas, "indent")
    End Sub

    ''' Replaces lines [first, last] with same-count `pieces` (per-line edits at
    ''' `columns` changing lengths by `deltas`) and shifts every selection to match.
    Private Sub ReplaceLineBlock(first As Integer, last As Integer, pieces As Array Of String, columns As Array Of Integer, deltas As Array Of Integer, kind As String)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim primary As Integer = Me.SortedSelections(anchors, carets)
        For i As Integer = 0 To Array.LastIndex(carets)
            ' Keep line selections anchored at column zero, but carry a bare
            ' caret past newly inserted indentation, including on empty lines.
            Dim caretIndent As Integer = 0
            If kind = "indent" And anchors(i) = carets(i) Then
                Dim line As Integer = Me.LineOfPosition(carets(i))
                Dim k As Integer = line - first
                If k >= 0 And k < Array.Count(deltas) Then
                    If carets(i) = Me.mStarts(line) And columns(k) = 0 And deltas(k) > 0 Then caretIndent = deltas(k)
                End If
            End If
            anchors(i) = Me.ShiftedPosition(anchors(i), first, columns, deltas) + caretIndent
            carets(i) = Me.ShiftedPosition(carets(i), first, columns, deltas) + caretIndent
        Next
        Dim blockStart As Integer = Me.mStarts(first)
        Dim blockLength As Integer = Me.mStarts(last) + String.Len(Me.mLines(last)) - blockStart
        Me.ClearComposition()
        Me.ReplaceQuiet(blockStart, blockLength, String.Join(pieces, "\n"))
        Me.FinishMultiEdit(anchors, carets, primary, kind)
    End Sub

    ''' Move Lines Up/Down for every selection's lines (touching blocks move together).
    Private Sub MoveLinesMulti(down As Boolean)
        Dim blocks As Array Of Integer = Me.SelectionLineBlocks(True)
        If down And Array.Last(blocks) >= Array.LastIndex(Me.mLines) Then Return
        If Not down And blocks(0) = 0 Then Return
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim primary As Integer = Me.SortedSelections(anchors, carets)
        Dim owners As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim first As Integer = 0
            Dim last As Integer = 0
            Me.LinesOf(anchors(i), carets(i), first, last)
            Array.Append(owners, Me.BlockOfLine(blocks, first))
        Next
        Me.ClearComposition()
        Dim count As Integer = Array.Count(blocks) \ 2
        For n As Integer = 0 To count - 1
            ' Down: last block first, so each block's neighbour line is still in place.
            Dim b As Integer = n
            If down Then b = count - 1 - n
            Dim first As Integer = blocks(b * 2)
            Dim last As Integer = blocks(b * 2 + 1)
            Dim pieces As Array Of String = []
            Dim rangeFirst As Integer = first
            Dim rangeLast As Integer = last
            Dim offset As Integer = 0
            If down Then
                rangeLast = last + 1
                Array.Append(pieces, Me.mLines(last + 1))
                offset = String.Len(Me.mLines(last + 1)) + 1
            Else
                rangeFirst = first - 1
            End If
            For i As Integer = first To last
                Array.Append(pieces, Me.mLines(i))
            Next
            If Not down Then
                Array.Append(pieces, Me.mLines(first - 1))
                offset = -(String.Len(Me.mLines(first - 1)) + 1)
            End If
            Dim blockStart As Integer = Me.mStarts(rangeFirst)
            Dim blockLength As Integer = Me.mStarts(rangeLast) + String.Len(Me.mLines(rangeLast)) - blockStart
            Me.RotateLineData(rangeFirst, rangeLast, down)
            Me.ReplaceQuiet(blockStart, blockLength, String.Join(pieces, "\n"))
            For i As Integer = 0 To Array.LastIndex(carets)
                If owners(i) = b Then
                    anchors(i) += offset
                    carets(i) += offset
                End If
            Next
        Next
        Me.FinishMultiEdit(anchors, carets, primary, "move")
    End Sub

    ''' Copy Line Down (selections move to the copy) / Copy Line Up (selections stay on
    ''' the upper copy) for the lines of every selection. One undo step.
    Private Sub CopyLines(down As Boolean)
        If Me.IsReadOnly Then Return
        Dim blocks As Array Of Integer = Me.SelectionLineBlocks(False)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim primary As Integer = Me.SortedSelections(anchors, carets)
        Dim owners As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim first As Integer = 0
            Dim last As Integer = 0
            Me.LinesOf(anchors(i), carets(i), first, last)
            Array.Append(owners, Me.BlockOfLine(blocks, first))
        Next
        Me.ClearComposition()
        Dim count As Integer = Array.Count(blocks) \ 2
        For b As Integer = count - 1 To 0 Step -1
            Dim first As Integer = blocks(b * 2)
            Dim last As Integer = blocks(b * 2 + 1)
            Dim copied As Array Of String = []
            For i As Integer = first To last
                Array.Append(copied, Me.mLines(i))
            Next
            Dim copy As String = String.Join(copied, "\n")
            Dim shift As Integer = String.Len(copy) + 1
            If down Then
                Me.ReplaceQuiet(Me.mStarts(last) + String.Len(Me.mLines(last)), 0, "\n" + copy)
            Else
                Me.ReplaceQuiet(Me.mStarts(first), 0, copy + "\n")
            End If
            For i As Integer = 0 To Array.LastIndex(carets)
                If owners(i) > b Or (owners(i) = b And down) Then
                    anchors(i) += shift
                    carets(i) += shift
                End If
            Next
        Next
        Me.FinishMultiEdit(anchors, carets, primary, "duplicate")
    End Sub

    ''' Add Cursor Above/Below: a cursor on the row above the topmost (below the
    ''' bottommost) cursor at the same visual column (repeats keep the first column).
    Private Sub AddCursorVertical(down As Boolean)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim cell As Integer = Me.mAddCell
        If String.Compare(Me.mAddKey, Me.SelectionKey(), True) <> 0 Then
            Dim caretLine As Integer = Me.LineOfPosition(Me.mCaret)
            cell = Me.VisualColumn(Me.mLines(caretLine), Me.mCaret - Me.mStarts(caretLine))
        End If
        Dim edge As Integer = Me.LineOfPosition(carets(0))
        If down Then edge = Me.LineOfPosition(Array.Last(carets))
        ' Logical lines (fold rows), also while soft wrap splits them into visual rows.
        Dim row As Integer = Me.FoldRowOfLine(edge) - 1
        If down Then row = Me.FoldRowOfLine(edge) + 1
        If row < 0 Or row >= Me.FoldRowCount() Then Return
        Dim target As Integer = Me.LineOfFoldRow(row)
        Dim position As Integer = Me.mStarts(target) + Me.ColumnForVisual(Me.mLines(target), cell)
        Me.RememberCursors()
        Me.AddSelectionQuiet(position, position)
        Me.mAddCell = cell
        Me.mAddKey = Me.SelectionKey()
        Me.EnsureCaretVisible()
    End Sub

    ''' Range of the word at a position (start, length via ByRef); False when none.
    Private Function WordRangeAt(position As Integer, ByRef start As Integer, ByRef length As Integer) As Boolean
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim count As Integer = Array.Count(codes)
        ' The word at the caret, else the one just before it.
        If column >= count Then
            column = count - 1
        ElseIf Not EditorIsWordCode(String.Asc(codes(column))) Then
            column -= 1
        End If
        If column < 0 Or column >= count Then Return False
        If Not EditorIsWordCode(String.Asc(codes(column))) Then Return False
        Dim first As Integer = column
        While first > 0
            If Not EditorIsWordCode(String.Asc(codes(first - 1))) Then Exit While
            first -= 1
        Wend
        Dim last As Integer = column
        While last + 1 < count
            If Not EditorIsWordCode(String.Asc(codes(last + 1))) Then Exit While
            last += 1
        Wend
        start = Me.mStarts(lineIndex) + first
        length = last - first + 1
        Return True
    End Function

    ''' Primary+D: with only cursors, select the word at each; else add a selection at the
    ''' next occurrence (after the primary, wrapping) of the primary's text. `skip`
    ''' (Primary+K Primary+D) moves the primary selection there instead of adding.
    Private Sub AddNextOccurrence(skip As Boolean)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim allEmpty As Boolean = True
        For i As Integer = 0 To Array.LastIndex(carets)
            If anchors(i) <> carets(i) Then allEmpty = False
        Next
        If allEmpty Then
            If skip Then Return
            Me.RememberCursors()
            Dim words As Array Of StudioEditorSelection = []
            Dim primaryIndex As Integer = 0
            Dim primarySorted As Integer = Me.PrimarySelectionIndex
            For i As Integer = 0 To Array.LastIndex(carets)
                Dim start As Integer = 0
                Dim length As Integer = 0
                If Me.WordRangeAt(carets(i), start, length) Then
                    Array.Append(words, New StudioEditorSelection(start, start + length))
                Else
                    Array.Append(words, New StudioEditorSelection(carets(i), carets(i)))
                End If
                If i = primarySorted Then primaryIndex = i
            Next
            Me.SetSelectionsQuiet(words, primaryIndex)
            ' Occurrences of an auto-selected word match whole words only (VS Code).
            Me.mOccurrenceWholeWord = True
            Me.mOccurrenceKey = Me.SelectionKey()
            Return
        End If
        If String.Compare(Me.mOccurrenceKey, Me.SelectionKey(), True) <> 0 Then Me.mOccurrenceWholeWord = False
        Dim query As String = Me.SelectedText
        If query = "" Then
            ' A collapsed primary among selections: use the last non-empty one.
            For i As Integer = Array.LastIndex(carets) To 0 Step -1
                If anchors(i) <> carets(i) Then
                    query = Me.Slice(Math.Min(anchors(i), carets(i)), Math.Abs(carets(i) - anchors(i)))
                    Exit For
                End If
            Next
        End If
        If query = "" Or Me.SelectionCount >= StudioCodeEditor.MaxSelections Then Return
        Dim text As String = Me.Text
        Dim length As Integer = String.Len(query)
        Dim from As Integer = Me.SelectionStart + Me.SelectionLength
        Dim found As Integer = -1
        Dim wrapped As Boolean = False
        Dim guard As Integer = 0
        While guard < 100000
            guard += 1
            Dim hit As Integer = Me.FindAfter(text, query, from, True, Me.mOccurrenceWholeWord)
            If hit < 0 Then
                If wrapped Then Exit While
                wrapped = True
                from = 0
                Continue While
            End If
            If wrapped And hit >= Me.SelectionStart + Me.SelectionLength Then Exit While
            Dim taken As Boolean = False
            For i As Integer = 0 To Array.LastIndex(carets)
                If Math.Min(anchors(i), carets(i)) < hit + length And Math.Max(anchors(i), carets(i)) > hit Then taken = True
            Next
            If Not taken Then
                found = hit
                Exit While
            End If
            from = hit + 1
        Wend
        If found < 0 Then Return
        Dim whole As Boolean = Me.mOccurrenceWholeWord
        Me.RememberCursors()
        If skip And Me.SelectionLength > 0 Then
            Me.mAnchor = found
            Me.mCaret = found + length
            Me.NormalizeSelections()
        Else
            Me.AddSelectionQuiet(found, found + length)
        End If
        Me.mOccurrenceWholeWord = whole
        Me.mOccurrenceKey = Me.SelectionKey()
        Me.CenterIfHidden()
    End Sub

    ''' Primary+Shift+L: select every occurrence of the primary selection's text (or of the
    ''' word at the caret, whole words only).
    Private Sub SelectAllOccurrences()
        Dim query As String = Me.SelectedText
        Dim whole As Boolean = False
        If query = "" Then
            Dim start As Integer = 0
            Dim length As Integer = 0
            If Not Me.WordRangeAt(Me.mCaret, start, length) Then Return
            query = Me.Slice(start, length)
            whole = True
        ElseIf String.Compare(Me.mOccurrenceKey, Me.SelectionKey(), True) = 0 Then
            whole = Me.mOccurrenceWholeWord
        End If
        Dim text As String = Me.Text
        Dim length As Integer = String.Len(query)
        Dim origin As Integer = Me.SelectionStart
        Dim found As Array Of StudioEditorSelection = []
        Dim primaryIndex As Integer = 0
        Dim hit As Integer = Me.FindAfter(text, query, 0, True, whole)
        While hit >= 0 And Array.Count(found) < StudioCodeEditor.MaxSelections
            If hit <= origin And origin < hit + Math.Max(1, length) Then primaryIndex = Array.Count(found)
            Array.Append(found, New StudioEditorSelection(hit, hit + length))
            hit = Me.FindAfter(text, query, hit + length, True, whole)
        Wend
        If Array.Count(found) = 0 Then Return
        Me.RememberCursors()
        Me.SetSelectionsQuiet(found, primaryIndex)
        Me.mOccurrenceWholeWord = whole
        Me.mOccurrenceKey = Me.SelectionKey()
    End Sub

    ''' SetSelections without events (RunCommand finishes the interaction).
    Private Sub SetSelectionsQuiet(selections As Array Of StudioEditorSelection, primary As Integer)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        For Each item As StudioEditorSelection In selections
            Array.Append(anchors, item.Anchor)
            Array.Append(carets, item.Caret)
        Next
        Me.ClearComposition()
        Me.ApplySelections(anchors, carets, primary)
        Me.NormalizeSelections()
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.EnsureCaretVisible()
    End Sub

    ''' Scrolls the primary selection into view (centred when it was off screen).
    Private Sub CenterIfHidden()
        Me.UnfoldAround(Me.LineOfPosition(Me.mCaret))
        Me.UnfoldAround(Me.LineOfPosition(Me.mAnchor))
        Me.CenterCaret()
    End Sub

    ''' Shift+Alt+I: a cursor at the end of every line of each multi-line selection (the
    ''' last line's at the selection end); single-line selections collapse to their end.
    Private Function CursorsAtLineEnds() As Boolean
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Me.SortedSelections(anchors, carets)
        Dim picked As Array Of StudioEditorSelection = []
        Dim any As Boolean = False
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim s As Integer = Math.Min(anchors(i), carets(i))
            Dim e As Integer = Math.Max(anchors(i), carets(i))
            If s = e Then
                Array.Append(picked, New StudioEditorSelection(s, s))
                Continue For
            End If
            any = True
            Dim first As Integer = Me.LineOfPosition(s)
            Dim last As Integer = Me.LineOfPosition(e)
            If last > first And e = Me.mStarts(last) Then last -= 1
            For lineIndex As Integer = first To last
                If Me.IsLineHidden(lineIndex) Then Continue For
                Dim position As Integer = Me.NavLineEnd(lineIndex)
                If position > e Then position = e
                Array.Append(picked, New StudioEditorSelection(position, position))
            Next
        Next
        If Not any Then Return False
        Me.RememberCursors()
        Me.SetSelectionsQuiet(picked, Array.LastIndex(picked))
        Return True
    End Function

    ''' Column (box) selection by keyboard: starts at the primary caret (or continues the
    ''' current box) and grows one row/cell toward `direction` (up/down/left/right).
    Private Sub ColumnSelect(direction As String)
        If String.Compare(Me.mBoxKey, Me.SelectionKey(), True) <> 0 Then
            Dim caretLine As Integer = Me.LineOfPosition(Me.mCaret)
            Dim cell As Integer = Me.VisualColumn(Me.mLines(caretLine), Me.mCaret - Me.mStarts(caretLine))
            Dim anchorLine As Integer = Me.LineOfPosition(Me.mAnchor)
            Me.mBoxAnchorLine = anchorLine
            Me.mBoxAnchorCell = Me.VisualColumn(Me.mLines(anchorLine), Me.mAnchor - Me.mStarts(anchorLine))
            Me.mBoxCaretLine = caretLine
            Me.mBoxCaretCell = cell
            Me.RememberCursors()
        End If
        Select Case direction
        Case "up"
            Dim row As Integer = Me.FoldRowOfLine(Me.mBoxCaretLine) - 1
            If row >= 0 Then Me.mBoxCaretLine = Me.LineOfFoldRow(row)
        Case "down"
            Dim row As Integer = Me.FoldRowOfLine(Me.mBoxCaretLine) + 1
            If row < Me.FoldRowCount() Then Me.mBoxCaretLine = Me.LineOfFoldRow(row)
        Case "left"
            Me.mBoxCaretCell = Math.Max(0, Me.mBoxCaretCell - 1)
        Case "right"
            Me.mBoxCaretCell = Math.Min(Me.MaxColumns(), Me.mBoxCaretCell + 1)
        End Select
        Me.ApplyBox()
    End Sub

    ''' One selection per visible line between the box corners, in visual cells (tabs
    ''' and wide characters honoured); lines shorter than the box get a cursor at their
    ''' end. The caret corner's line is primary.
    Private Sub ApplyBox()
        ' One selection per logical line (fold rows), also while soft wrapping.
        Dim firstRow As Integer = Math.Min(Me.FoldRowOfLine(Me.mBoxAnchorLine), Me.FoldRowOfLine(Me.mBoxCaretLine))
        Dim lastRow As Integer = Math.Max(Me.FoldRowOfLine(Me.mBoxAnchorLine), Me.FoldRowOfLine(Me.mBoxCaretLine))
        Dim caretRow As Integer = Me.FoldRowOfLine(Me.mBoxCaretLine)
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim primary As Integer = 0
        For row As Integer = firstRow To lastRow
            Dim lineIndex As Integer = Me.LineOfFoldRow(row)
            Dim line As String = Me.mLines(lineIndex)
            Dim start As Integer = Me.mStarts(lineIndex)
            If row = caretRow Then primary = Array.Count(carets)
            Array.Append(anchors, start + Me.ColumnForVisual(line, Me.mBoxAnchorCell))
            Array.Append(carets, start + Me.ColumnForVisual(line, Me.mBoxCaretCell))
        Next
        Me.ClearComposition()
        Me.ApplySelections(anchors, carets, primary)
        Me.NormalizeSelections()
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.mBoxKey = Me.SelectionKey()
        Me.EnsureCaretVisible()
        Me.Invalidate()
    End Sub

    ''' Copy with several selections: their texts joined by line breaks (Paste spreads
    ''' them back one per cursor). Cut also deletes every selection (one undo step).
    Private Sub CopySelections(cut As Boolean)
        Dim texts As Array Of String = Me.SelectionTexts()
        Dim any As Boolean = False
        For Each piece As String In texts
            If piece <> "" Then any = True
        Next
        If Not any Then Return
        Dim joined As String = String.Join(texts, "\n")
        Dim clip As New Clipboard()
        clip.Text = joined
        clip.Close()
        RaiseEvent ClipboardCopied(joined)
        If cut And Not Me.IsReadOnly Then Me.RunBatch("@delete", False, Me.NoPieces(), False)
    End Sub

    ''' Paste (or yank) `value` at every selection: one line per cursor when the text has
    ''' exactly as many lines as there are cursors, else the whole text at each (VS Code).
    Private Sub PasteMulti(value As String, kind As String)
        Dim normalized As String = Me.Normalize(value)
        Dim lines As Array Of String = String.Split(normalized, "\n", True)
        If String.EndsWith(normalized, "\n") And Array.Count(lines) = Me.SelectionCount + 1 Then Array.RemoveAt(lines, Array.LastIndex(lines))
        If Array.Count(lines) = Me.SelectionCount Then
            Me.RunBatch(kind, False, lines, False)
        Else
            Me.RunBatch(kind, False, [normalized], True)
        End If
    End Sub

    ' ---- Document model --------------------------------------------------------------

    Private Function Clamp(position As Integer) As Integer
        Return Math.Max(0, Math.Min(position, Me.TotalLength()))
    End Function

    Private Function TotalLength() As Integer
        Dim last As Integer = Array.LastIndex(Me.mLines)
        Return Me.mStarts(last) + String.Len(Me.mLines(last))
    End Function

    Private Function ColumnOf(position As Integer) As Integer
        Return position - Me.mStarts(Me.LineOfPosition(position))
    End Function

    Private Function Slice(start As Integer, length As Integer) As String
        If length <= 0 Then Return ""
        Dim first As Integer = Me.LineOfPosition(start)
        Dim last As Integer = Me.LineOfPosition(start + length)
        Dim column As Integer = start - Me.mStarts(first)
        If first = last Then Return String.Substring(Me.mLines(first), column, length)
        Dim parts As Array Of String = []
        Array.Append(parts, String.Substring(Me.mLines(first), column))
        For i As Integer = first + 1 To last - 1
            Array.Append(parts, Me.mLines(i))
        Next
        Array.Append(parts, String.Left(Me.mLines(last), start + length - Me.mStarts(last)))
        Return String.Join(parts, "\n")
    End Function

    Private Function Normalize(value As String) As String
        Return String.Replace(String.Replace(value, "\r\n", "\n", True), "\r", "\n", True)
    End Function

    Private Sub RebuildStarts(fromLine As Integer)
        Array.ResizeTo(Me.mStarts, Array.Count(Me.mLines))
        Dim start As Integer = 0
        Dim first As Integer = Math.Max(0, fromLine)
        If first > 0 Then start = Me.mStarts(first - 1) + String.Len(Me.mLines(first - 1)) + 1
        For i As Integer = first To Array.LastIndex(Me.mLines)
            Me.mStarts(i) = start
            start += String.Len(Me.mLines(i)) + 1
        Next
    End Sub

    ''' Replace lines [first, first+removeCount) with `pieces`, keeping caches aligned.
    Private Sub SpliceLines(first As Integer, removeCount As Integer, pieces As Array Of String, followEnd As Boolean = False)
        Dim insertedCount As Integer = Array.Count(pieces)
        If Array.Count(Me.mLines) - removeCount + insertedCount = 0 Then insertedCount = 1
        Me.WrapSpliced(first, removeCount, Array.Count(pieces))
        Me.ShiftLineData(first, removeCount, insertedCount, followEnd)
        ' The widest-line cache survives unless the widest line shrinks (typing on it).
        Dim widestRemoved As Integer = 0
        For i As Integer = 1 To removeCount
            widestRemoved = Math.Max(widestRemoved, Me.LineCells(Me.mLines(first)))
            Array.RemoveAt(Me.mLines, first)
            Array.RemoveAt(Me.mTokens, first)
        Next
        Dim widestInserted As Integer = 0
        For i As Integer = 0 To Array.LastIndex(pieces)
            Array.Insert(Me.mLines, first + i, pieces(i))
            Array.Insert(Me.mTokens, first + i, Nil)
            widestInserted = Math.Max(widestInserted, Me.LineCells(pieces(i)))
        Next
        If Me.mMaxColumnsValid Then
            If widestInserted >= Me.mMaxColumns Then
                Me.mMaxColumns = widestInserted
            ElseIf widestRemoved >= Me.mMaxColumns Then
                Me.mMaxColumnsValid = False
            End If
        End If
        If Array.Count(Me.mLines) = 0 Then
            Array.Append(Me.mLines, "")
            Array.Append(Me.mTokens, Nil)
        End If
        Array.ResizeTo(Me.mStates, Array.Count(Me.mLines))
        Me.mStates(0) = False
        Me.mStatesValid = Math.Max(1, Math.Min(Me.mStatesValid, first + 1))
        Me.RebuildStarts(first)
        Me.mTextValid = False
    End Sub

    ''' Core edit: replace [start, start+length) with value. Caret goes after the text.
    Private Sub ReplaceRange(start As Integer, length As Integer, value As String)
        Me.DismissInlineCompletion()
        Dim s As Integer = Me.Clamp(start)
        Dim e As Integer = Me.Clamp(start + Math.Max(0, length))
        Dim inserted As String = Me.Normalize(value)
        Dim first As Integer = Me.LineOfPosition(s)
        Dim last As Integer = Me.LineOfPosition(e)
        Dim prefix As String = String.Left(Me.mLines(first), s - Me.mStarts(first))
        Dim suffix As String = String.Substring(Me.mLines(last), e - Me.mStarts(last))
        Dim pieces As Array Of String = String.Split(prefix + inserted + suffix, "\n", True)
        ' Inserting lines before a line's text carries its markers/breakpoints down with it.
        Dim followEnd As Boolean = e = s And String.Trim(prefix) = "" And String.Contains(inserted, "\n")
        Me.SpliceLines(first, last - first + 1, pieces, followEnd)
        Me.mCaret = s + String.Len(inserted)
        Me.mAnchor = Me.mCaret
        ' The selections this edit does not own move with the text around them.
        Dim newEnd As Integer = s + String.Len(inserted)
        If Me.mBatch Then
            For i As Integer = 0 To Array.LastIndex(Me.mBatchCarets)
                If i <> Me.mBatchIndex Then
                    Me.mBatchAnchors(i) = Me.MapThroughEdit(Me.mBatchAnchors(i), s, e, newEnd)
                    Me.mBatchCarets(i) = Me.MapThroughEdit(Me.mBatchCarets(i), s, e, newEnd)
                End If
            Next
        Else
            For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
                Me.mExtraAnchors(i) = Me.MapThroughEdit(Me.mExtraAnchors(i), s, e, newEnd)
                Me.mExtraCarets(i) = Me.MapThroughEdit(Me.mExtraCarets(i), s, e, newEnd)
            Next
        End If
        Me.TrackFeatureEdit(s, e - s, String.Len(inserted))
    End Sub

    ''' User edit: honours read-only, clears composition, places the selection (default:
''' caret after the inserted text), then raises TextChanged and SelectionChanged.
    Private Sub EditRange(start As Integer, length As Integer, value As String, anchorAfter As Integer = -1, caretAfter As Integer = -1, kind As String = "edit")
        If Me.IsReadOnly Then Return
        If length <= 0 And value = "" Then
            Me.ClearComposition()
            Return
        End If
        Me.ClearComposition()
        Dim s As Integer = Me.Clamp(start)
        Dim e As Integer = Me.Clamp(start + Math.Max(0, length))
        Dim sameRun As Boolean = String.Compare(kind, Me.mEditKind, True) = 0 And (s = Me.mEditEnd Or e = Me.mEditEnd)
        Me.mContinuesTyping = sameRun And (String.Compare(kind, "typing", True) = 0 Or String.Compare(kind, "delete", True) = 0)
        ' Inside a snippet field the same relative edit goes to every linked occurrence
        ' that has no selection of its own (e.g. after a click cleared the mirror cursors).
        Dim mirrors As Array Of Integer = []
        Dim mirrorOffset As Integer = 0
        If Me.InSnippet And Not Me.mSnippetMirroring Then mirrors = Me.SnippetMirrorTargets(s, e, mirrorOffset)
        Me.ReplaceRange(start, length, value)
        If caretAfter >= 0 Then
            Me.mCaret = Me.Clamp(caretAfter)
            Me.mAnchor = Me.mCaret
            If anchorAfter >= 0 Then Me.mAnchor = Me.Clamp(anchorAfter)
        End If
        If Array.Count(mirrors) > 0 Then Me.MirrorSnippetEdit(mirrors, mirrorOffset, e - s, value)
        Me.mEditKind = kind
        Me.mEditEnd = Me.mCaret
        Me.mPreferredColumn = -1
        If Me.mBatch Then
            ' One TextChanged for the whole multi-cursor command (RunBatch).
            Me.mBatchEdited = True
            Me.EnsureCaretVisible()
            Return
        End If
        If Me.mGroupDepth > 0 Then
            ' One TextChanged for the whole edit group (macro, transform, snippet).
            Me.mGroupEdited = True
            Return
        End If
        Me.NormalizeSelections()
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.RaiseTextChanged()
        Me.FinishInteraction()
    End Sub

    ''' Raise BreakpointsChanged/SelectionChanged once per interaction when they changed.
    Private Sub FinishInteraction()
        If Me.mBatch Or Me.mGroupDepth > 0 Then Return
        If Me.InSnippet Then Me.ValidateSnippetSession()
        Me.mSettledSelections = Me.SelectionsKey()
        If Me.mSettledFingerprint <> "" Then Me.RememberSelections(Me.mSettledFingerprint, Me.mSettledSelections)
        If Me.mBreakpointsMoved Then
            Me.mBreakpointsMoved = False
            RaiseEvent BreakpointsChanged()
        End If
        Dim extras As String = Me.ExtrasKey()
        If Me.mAnchor <> Me.mNotifiedAnchor Or Me.mCaret <> Me.mNotifiedCaret Or String.Compare(extras, Me.mNotifiedExtras, True) <> 0 Then
            Me.DismissInlineCompletion()
            Me.mNotifiedAnchor = Me.mAnchor
            Me.mNotifiedCaret = Me.mCaret
            Me.mNotifiedExtras = extras
            RaiseEvent SelectionChanged()
        End If
        Me.RevalidateCompletion()
    End Sub

    Private Sub ReplaceDocument(value As String)
        Me.DismissInlineCompletion()
        Dim incoming As String = Me.Normalize(value)
        If String.Compare(incoming, Me.Text, True) = 0 Then Return
        Dim pieces As Array Of String = String.Split(incoming, "\n", True)
        Dim oldCount As Integer = Array.Count(Me.mLines)
        Dim newCount As Integer = Array.Count(pieces)
        Dim limit As Integer = Math.Min(oldCount, newCount)
        Dim prefix As Integer = 0
        While prefix < limit
            If String.Compare(Me.mLines(prefix), pieces(prefix), True) <> 0 Then Exit While
            prefix += 1
        End While
        Dim suffix As Integer = 0
        While suffix < limit - prefix
            If String.Compare(Me.mLines(oldCount - 1 - suffix), pieces(newCount - 1 - suffix), True) <> 0 Then Exit While
            suffix += 1
        End While
        Dim preserve As Boolean = oldCount > 1 And (prefix + suffix) * 2 >= Math.Max(oldCount, newCount)
        Dim oldLine As String = ""
        If prefix < oldCount Then oldLine = Me.mLines(prefix)
        Me.ClearComposition()
        Me.ClearExtras()
        Me.ResetFeatureState()
        Dim middle As Array Of String = []
        For i As Integer = prefix To newCount - 1 - suffix
            Array.Append(middle, pieces(i))
        Next
        Me.SpliceLines(prefix, oldCount - prefix - suffix, middle)
        Me.mText = incoming
        Me.mTextValid = True
        Me.mPreferredColumn = -1
        If preserve Then
            ' Caret at the first changed character, like an editor's own undo.
            Dim position As Integer = Me.TotalLength()
            If prefix < newCount Then position = Me.mStarts(prefix) + EditorCommonPrefix(oldLine, pieces(prefix))
            Me.mCaret = Me.Clamp(position)
            Me.mAnchor = Me.mCaret
            Me.SetScroll(Me.mScrollX, Me.mScrollY)
            Me.EnsureCaretVisible()
            Dim detected As Integer = Me.DetectIndentStep()
            If detected <> Me.mDetectedIndent Then
                Me.mDetectedIndent = detected
                Me.mLayout = Nil
            End If
        Else
            Me.mCaret = 0
            Me.mAnchor = 0
            Me.mScrollX = 0.0
            Me.mScrollY = 0.0
            Me.mMaxColumnsValid = False
            Me.mDetectedIndent = Me.DetectIndentStep()
            Me.mLayout = Nil
        End If
        Me.mEditKind = ""
        ' Back at a text this editor has shown before (host undo/redo): restore the
        ' cursors and selections it had then instead of the single-caret guess.
        Me.mSettledFingerprint = EditorTextFingerprint(incoming)
        If Me.mSelectionMemory.ContainsKey(Me.mSettledFingerprint) Then
            Me.RestoreSelectionsKey(Me.mSelectionMemory.Get(Me.mSettledFingerprint).Value)
        End If
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Every user edit's single TextChanged goes through here: the text before the edit
    ''' keeps the selections it had, and the new text records the selections after it.
    Private Sub RaiseTextChanged()
        Me.DismissInlineCompletion()
        If Me.mSettledFingerprint <> "" And Me.mSettledSelections <> "" Then Me.RememberSelections(Me.mSettledFingerprint, Me.mSettledSelections)
        Me.mSettledFingerprint = EditorTextFingerprint(Me.Text)
        Me.mSettledSelections = Me.SelectionsKey()
        Me.RememberSelections(Me.mSettledFingerprint, Me.mSettledSelections)
        RaiseEvent TextChanged()
    End Sub

    Private Sub RememberSelections(fingerprint As String, selections As String)
        If Not Me.mSelectionMemory.ContainsKey(fingerprint) Then
            Array.Append(Me.mSelectionMemoryOrder, fingerprint)
            If Array.Count(Me.mSelectionMemoryOrder) > StudioCodeEditor.SelectionMemoryLimit Then
                Me.mSelectionMemory.Remove(Me.mSelectionMemoryOrder(0))
                Array.RemoveAt(Me.mSelectionMemoryOrder, 0)
            End If
        End If
        Me.mSelectionMemory.Set(fingerprint, selections)
    End Sub

    ''' "primary|anchor,caret|anchor,caret..." for every selection.
    Private Function SelectionsKey() As String
        Dim selections As Array Of StudioEditorSelection = Me.GetSelections()
        Dim parts As Array Of String = []
        Array.Append(parts, String.From(Me.PrimarySelectionIndex))
        For Each item As StudioEditorSelection In selections
            Array.Append(parts, String.From(item.Anchor) + "," + String.From(item.Caret))
        Next
        Return String.Join(parts, "|")
    End Function

    Private Sub RestoreSelectionsKey(key As String)
        Dim parts As Array Of String = String.Split(key, "|")
        If Array.Count(parts) < 2 Then Return
        Dim total As Integer = Me.TotalLength()
        Dim selections As Array Of StudioEditorSelection = []
        For i As Integer = 1 To Array.LastIndex(parts)
            Dim pair As Array Of String = String.Split(parts(i), ",")
            If Array.Count(pair) <> 2 Then Return
            Dim anchor As Integer = Integer.Parse(pair(0)).Or(-1)
            Dim caret As Integer = Integer.Parse(pair(1)).Or(-1)
            If anchor < 0 Or caret < 0 Or anchor > total Or caret > total Then Return
            Array.Append(selections, New StudioEditorSelection(anchor, caret))
        Next
        Me.SetSelections(selections, Integer.Parse(parts(0)).Or(-1))
    End Sub

    Private Sub ClearComposition()
        Me.mIncomplete = ""
        Me.mIncompleteCursor = 0
        Me.mCompositionStart = -1
        Me.mCompositionLength = 0
    End Sub

    Private Sub MoveCaretTo(position As Integer, extend As Boolean)
        Me.ClearComposition()
        Me.mCaret = Me.Clamp(position)
        If Not extend Then Me.mAnchor = Me.mCaret
        Me.mEditKind = ""
        If Me.mBatch Then
            Me.EnsureCaretVisible()
            Return
        End If
        ' Outside a multi-cursor command a caret placement is a single cursor again.
        Me.ClearExtras()
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    Private Sub EnsureStates(lineIndex As Integer)
        Dim target As Integer = Math.Min(lineIndex, Array.LastIndex(Me.mLines))
        While Me.mStatesValid <= target
            Dim previous As Integer = Me.mStatesValid - 1
            Dim cached As StudioSyntaxLine = Me.mTokens(previous)
            Dim state As Boolean = False
            If cached <> Nil Then
                If cached.StartsInComment = Me.mStates(previous) And String.Compare(cached.Source, Me.mLines(previous), True) = 0 Then
                    state = cached.EndsInComment
                Else
                    state = StudioLineStateAfter(Me.mLanguageMode, Me.mLines(previous), Me.mStates(previous))
                End If
            Else
                state = StudioLineStateAfter(Me.mLanguageMode, Me.mLines(previous), Me.mStates(previous))
            End If
            Me.mStates(Me.mStatesValid) = state
            Me.mStatesValid += 1
        End While
    End Sub

    ' ---- Indentation settings ----------------------------------------------------------

    ''' Display tab stop width, independent of the logical indent step when configured.
    Private Function TabSize() As Integer
        If Me.mTabWidth > 0 Then Return Me.mTabWidth
        Return Me.IndentStep()
    End Function

    Private Function IndentStep() As Integer
        If Me.mIndentStyle = "auto" And Me.mDetectIndentation And Me.mDetectedIndent > 0 Then Return Me.mDetectedIndent
        Return Me.mIndentWidth
    End Function

    Private Sub IndentChanged()
        Me.mMaxColumnsValid = False
        Me.mLayout = Nil
        Me.Invalidate()
    End Sub

    ''' The space-indent step the document already uses: the most common increase in
    ''' leading spaces between consecutive non-blank lines (2..8), or 0 when the text has
    ''' too little space indentation to tell (tab-indented text keeps IndentWidth stops).
    Private Function DetectIndentStep() As Integer
        Dim counts As Array Of Integer = [0, 0, 0, 0, 0, 0, 0, 0, 0]
        Dim previous As Integer = 0
        Dim samples As Integer = 0
        Dim limit As Integer = Math.Min(Array.LastIndex(Me.mLines), 4000)
        Me.EnsureStates(limit)
        For i As Integer = 0 To limit
            Dim line As String = Me.mLines(i)
            If String.Trim(line) = "" Then Continue For
            ' Block-comment continuation lines align text, not code.
            If Me.mStates(i) Then Continue For
            Dim lead As String = Me.LeadingWhitespace(line)
            If String.Contains(lead, "\t") Then
                previous = 0
                Continue For
            End If
            Dim width As Integer = String.Len(lead)
            Dim delta As Integer = width - previous
            If delta >= 2 And delta <= 8 Then
                counts(delta) = counts(delta) + 1
                samples += 1
            End If
            previous = width
        Next
        If samples = 0 Then Return 0
        ' Most frequent step; ties go to the conventional widths first.
        Dim best As Integer = 0
        For Each candidate As Integer In [4, 2, 8, 3, 6, 5, 7]
            If counts(candidate) > 0 Then
                If best = 0 Then
                    best = candidate
                ElseIf counts(candidate) > counts(best) Then
                    best = candidate
                End If
            End If
        Next
        Return best
    End Function

    ' ---- Geometry ----------------------------------------------------------------------

    ''' False hides the whole gutter (line numbers, lanes, fold chevrons, badges): for
    ''' read-only logs such as Studio's Messages pane.
    Public Property ShowsLineNumbers As Boolean
        Get
            Return Me.mShowsLineNumbers
        End Get
        Set
            If value = Me.mShowsLineNumbers Then Return
            Me.mShowsLineNumbers = value
            Me.RowsChanged()
            Me.SetScroll(Me.mScrollX, Me.mScrollY)
        End Set
    End Property
    Private Property mShowsLineNumbers As Boolean = True

    ''' Breakpoint lane at the gutter's left edge (only while ShowsBreakpoints).
    Private Function LaneWidth() As Double
        If (Me.mShowsBreakpoints Or Me.mExecutionLine >= 0) And Me.mShowsLineNumbers Then Return 16.0
        Return 0.0
    End Function

    ''' Lane, a diagnostics badge column, right-aligned line numbers, then the fold
    ''' chevron column (only while ShowsFolding).
    Private Function GutterWidth() As Double
        If Not Me.mShowsLineNumbers Then Return 0.0
        Dim digits As Integer = Math.Max(3, String.Len(String.From(Array.Count(Me.mLines))))
        Return Math.Round(Me.LaneWidth() + 12.0 + digits * Me.mCharWidth + 14.0 + Me.FoldColumnWidth())
    End Function

    Private Function FoldColumnWidth() As Double
        If Me.mShowsFolding Then Return 12.0
        Return 0.0
    End Function

    ''' Top of a line's row in view coordinates (a hidden line reports its fold header's row).
    Private Function LineTop(lineIndex As Integer) As Double
        Return Me.TopPadding() + Me.RowOfLine(lineIndex) * Me.LineHeight - Me.mScrollY
    End Function

    ''' Right edge of the text area: the minimap's left edge, or the view's right edge
    ''' (the vertical scrollbar overlays text when there is no minimap).
    Private Function TextRight() As Double
        If Me.mShowsMinimap Then Return Me.MinimapLeft()
        Return Me.Width
    End Function

    Private Function TextLeft() As Double
        Return Me.GutterWidth() + 8.0
    End Function

    ''' Baseline within a line box: centres the ink of mixed code text (cap height
    ''' above, descenders below) instead of sitting it on the lower half.
    Private Function BaselineOffset() As Double
        Return Math.Round(Me.LineHeight * 0.5 + Me.FontSize * 0.27)
    End Function

    ''' Extra y to add to a DrawString baseline so the glyphs land on it. macOS (Buoy
    ''' 0.72.0) draws text about 0.23 x size above the requested baseline (measured with
    ''' Menlo, SF Mono and Helvetica, 10-36pt), which left the editor's text crowding the
    ''' top of its line box; geometry drawn from the baseline (squiggles, IME underline)
    ''' uses the uncorrected value.
    Private Function DrawStringLift(size As Double) As Double
        #If TargetMac Then
            Return Math.Round(size * 0.23)
        #End If
        Return 0.0
    End Function

    ''' True when the selection ends at the very start of a line below where it began
    ''' (a gutter click, triple click or line drag): the caret then sits on a line
    ''' that is not selected, so it is hidden and the line above counts as active.
    Private Function SelectionEndsAtLineBreak() As Boolean
        Return Me.EndsAtLineBreak(Me.mAnchor, Me.mCaret)
    End Function

    ''' SelectionEndsAtLineBreak for any selection.
    Private Function EndsAtLineBreak(anchor As Integer, caret As Integer) As Boolean
        If anchor = caret Then Return False
        Dim selectionStart As Integer = Math.Min(anchor, caret)
        Dim selectionEnd As Integer = Math.Max(anchor, caret)
        If caret <> selectionEnd Then Return False
        Dim lineIndex As Integer = Me.LineOfPosition(selectionEnd)
        Return lineIndex > 0 And Me.mStarts(lineIndex) = selectionEnd And Me.LineOfPosition(selectionStart) < lineIndex
    End Function

    ''' The line drawn as current (gutter number emphasis).
    Private Function ActiveLine() As Integer
        Return Me.ActiveLineOf(Me.mAnchor, Me.mCaret)
    End Function

    ''' ActiveLine for any selection.
    Private Function ActiveLineOf(anchor As Integer, caret As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(caret)
        If Me.EndsAtLineBreak(anchor, caret) Then lineIndex -= 1
        ' A selection ending just below a collapsed fold: its header row is active.
        If Me.IsLineHidden(lineIndex) Then lineIndex = Me.LineOfFoldRow(Me.FoldRowOfLine(lineIndex))
        Return lineIndex
    End Function

    Private Function ShowsCaret() As Boolean
        If String.Len(Me.mIncomplete) > 0 Then Return True
        Return Not Me.SelectionEndsAtLineBreak()
    End Function

    Private Function TopPadding() As Double
        Return 6.0
    End Function

    Private Function ScrollbarSize() As Double
        Return 10.0
    End Function

    Private Function ViewHeight() As Double
        Return Math.Max(1.0, Me.Height - Me.TopPadding())
    End Function

    Private Function ViewWidth() As Double
        If Me.mShowsMinimap Then Return Math.Max(1.0, Me.TextRight() - Me.TextLeft())
        Return Math.Max(1.0, Me.Width - Me.TextLeft() - Me.ScrollbarSize())
    End Function

    Private Function MaxColumns() As Integer
        If Not Me.mMaxColumnsValid Then
            Dim widest As Integer = 0
            For Each line As String In Me.mLines
                Dim length As Integer = Me.LineCells(line)
                If length > widest Then widest = length
            Next
            Me.mMaxColumns = widest
            Me.mMaxColumnsValid = True
        End If
        Return Me.mMaxColumns
    End Function

    Private Function ContentHeight() As Double
        Return Me.RowCount() * Me.LineHeight + Me.LineHeight * 2.0
    End Function

    Private Function ContentWidth() As Double
        Return (Me.MaxColumns() + 4) * Me.mCharWidth + 24.0
    End Function

    Private Function MaxScrollY() As Double
        Return Math.Max(0.0, Me.ContentHeight() - Me.ViewHeight())
    End Function

    Private Function MaxScrollX() As Double
        ' Soft wrap fits every row to the view: no horizontal scrolling.
        If Me.mWordWrap Then Return 0.0
        Return Math.Max(0.0, Me.ContentWidth() - Me.ViewWidth())
    End Function

    Private Sub SetScroll(x As Double, y As Double)
        Dim nx As Double = Math.Max(0.0, Math.Min(x, Me.MaxScrollX()))
        Dim ny As Double = Math.Max(0.0, Math.Min(y, Me.MaxScrollY()))
        If nx <> Me.mScrollX Or ny <> Me.mScrollY Then
            Me.mScrollX = nx
            Me.mScrollY = ny
            Me.Invalidate()
        End If
    End Sub

    ''' True when every character of the line is one cell and one caret stop (ASCII,
    ''' no tabs): positions, columns and cells are then the same numbers.
    Private Function IsSimpleLine(line As String) As Boolean
        Return String.LenBytes(line) = String.Len(line) And Not String.Contains(line, "\t")
    End Function

    ''' Cell layout of a line; the most recent line is cached (caret work repeats it).
    Private Function LayoutOf(line As String) As StudioLineLayout
        If Me.mLayout <> Nil And Me.mLayoutIndent = Me.TabSize() Then
            If String.Compare(Me.mLayoutSource, line, True) = 0 Then Return Me.mLayout
        End If
        Me.mLayout = New StudioLineLayout(line, Me.TabSize())
        Me.mLayoutSource = line
        Me.mLayoutIndent = Me.TabSize()
        Return Me.mLayout
    End Function

    ''' Width of a line in cells.
    Private Function LineCells(line As String) As Integer
        Dim bytes As Integer = String.LenBytes(line)
        If Not String.Contains(line, "\t") Then
            If bytes = String.Len(line) Then Return bytes
        End If
        Return Me.LayoutOf(line).Width
    End Function

    ''' Visual cell of a codepoint column within a line (tabs to IndentWidth stops, wide
    ''' characters two cells, combining marks none).
    Private Function VisualColumn(line As String, column As Integer) As Integer
        If Me.IsSimpleLine(line) Then Return column
        Return Me.LayoutOf(line).CellOf(column)
    End Function

    ''' Caret stop within a line nearest to a visual cell.
    Private Function ColumnForVisual(line As String, visualTarget As Double) As Integer
        If Me.IsSimpleLine(line) Then
            Dim rounded As Integer = Math.Round(visualTarget)
            Return Math.Max(0, Math.Min(String.Len(line), rounded))
        End If
        Return Me.LayoutOf(line).ColumnAt(visualTarget)
    End Function

    ''' The neighbouring caret stop (whole character clusters; line breaks are one step).
    Private Function StepPosition(position As Integer, forward As Boolean) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim line As String = Me.mLines(lineIndex)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        If forward Then
            If column >= String.Len(line) Then Return Me.Clamp(position + 1)
            If Me.IsSimpleLine(line) Then Return position + 1
            Return Me.mStarts(lineIndex) + Me.LayoutOf(line).NextStop(column)
        End If
        If column <= 0 Then Return Me.Clamp(position - 1)
        If Me.IsSimpleLine(line) Then Return position - 1
        Return Me.mStarts(lineIndex) + Me.LayoutOf(line).PreviousStop(column)
    End Function

    ''' The caret stop at or before a position (never inside a character cluster).
    Private Function SnapPosition(position As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim line As String = Me.mLines(lineIndex)
        If Me.IsSimpleLine(line) Then Return position
        Return Me.mStarts(lineIndex) + Me.LayoutOf(line).StopBefore(position - Me.mStarts(lineIndex))
    End Function

    Private Function PositionAt(x As Double, y As Double) As Integer
        Dim row As Integer = Math.Floor((y + Me.mScrollY - Me.TopPadding()) / Me.LineHeight)
        If row < 0 Then Return 0
        If row >= Me.RowCount() Then Return Me.TotalLength()
        Dim segment As Integer = 0
        Dim lineIndex As Integer = Me.LineAndSegmentOfRow(row, segment)
        Dim visual As Double = (x - Me.TextLeft() + Me.mScrollX) / Me.mCharWidth
        Return Me.mStarts(lineIndex) + Me.ColumnInRow(lineIndex, segment, visual)
    End Function

    Private Function CaretPoint(position As Integer, ByRef x As Double, ByRef y As Double) As Boolean
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        ' Soft wrap: the segment's row, its cells shifted to the row start (+ indent).
        Dim segment As Integer = 0
        Dim cell As Integer = Me.RowCellOf(lineIndex, column, segment)
        x = Me.TextLeft() + cell * Me.mCharWidth - Me.mScrollX
        y = Me.LineTop(lineIndex) + segment * Me.LineHeight
        Return True
    End Function

    Private Sub EnsureCaretVisible()
        ' A caret (or selection end) landing in a collapsed fold's hidden body opens it.
        Me.UnfoldAround(Me.LineOfPosition(Me.mCaret))
        Me.UnfoldAround(Me.LineOfPosition(Me.mAnchor))
        ' Inside a multi-cursor command only the folds open; RunBatch scrolls once.
        If Me.mBatch Then Return
        If Array.Count(Me.mFolded) > 0 Then
            For Each other As Integer In Me.mExtraCarets
                Me.UnfoldAround(Me.LineOfPosition(other))
            Next
        End If
        If Me.Width < 1 Or Me.Height < 1 Then Return
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim top As Double = Me.RowOfPosition(Me.mCaret) * Me.LineHeight
        Dim visibleHeight As Double = Me.ViewHeight() - Me.ScrollbarSize()
        Dim y As Double = Me.mScrollY
        If top < y Then y = top
        If top + Me.LineHeight > y + visibleHeight Then y = top + Me.LineHeight - visibleHeight
        If Me.mWordWrap Then
            Me.SetScroll(0.0, y)
            Return
        End If
        Dim column As Integer = Me.mCaret - Me.mStarts(lineIndex)
        Dim left As Double = Me.VisualColumn(Me.mLines(lineIndex), column) * Me.mCharWidth
        Dim x As Double = Me.mScrollX
        Dim margin As Double = Me.mCharWidth * 4.0
        If left < x + margin Then x = left - margin
        If left > x + Me.ViewWidth() - margin Then x = left - Me.ViewWidth() + margin
        If Me.LineCells(Me.mLines(lineIndex)) > Me.mMaxColumns Then Me.mMaxColumnsValid = False
        Me.SetScroll(x, y)
    End Sub

    ' ---- Code folding ------------------------------------------------------------------
    ' Regions come from Buoy block structure (StudioClassifyBlock, cached per line): a
    ' block header folds through its closing line and each middle line (Else, Case,
    ' Catch, #Else) folds its own segment. Runs of `'`/`//` comment lines (doc comments)
    ' and multi-line /* */ comments fold as well, and a line that opens no block folds
    ' the more-indented lines below it. A collapsed region keeps its header line visible
    ' and hides (header, end]; hidden text stays in the document (copy, find, save).
    ' Rows are the lines left visible: every vertical position goes through RowOfLine /
    ' LineOfRow, which binary-search the merged hidden ranges. Regions are recomputed
    ' lazily after edits from the per-line cache (only edited lines are reclassified).

    Private Property mShowsFolding As Boolean = True
    Private Property mFolded As Array Of Integer = []
    Private Property mFoldLines As Array Of StudioFoldLine = []
    Private Property mFoldTab As Integer = -1
    Private Property mFoldEnds As Array Of Integer = []
    Private Property mFoldsValid As Boolean = False
    Private Property mHiddenFirst As Array Of Integer = []
    Private Property mHiddenLast As Array Of Integer = []
    Private Property mHiddenBefore As Array Of Integer = []
    Private Property mHiddenTotal As Integer = 0
    Private Property mRowsValid As Boolean = True
    Private Property mGutterHover As Boolean = False
    Private Property mFoldsRotating As Boolean = False

    ''' Code folding: gutter chevrons (on gutter hover, always for collapsed regions),
    ''' the "⋯" pill after a collapsed header, and Fold/Unfold/... Turning it off
    ''' expands every fold. Default on.
    Public Property ShowsFolding As Boolean
        Get
            Return Me.mShowsFolding
        End Get
        Set
            If value <> Me.mShowsFolding Then
                Me.mShowsFolding = value
                Me.mFolded = []
                Me.RowsChanged()
                Me.SetScroll(Me.mScrollX, Me.mScrollY)
            End If
        End Set
    End Property

    ''' Last line a fold starting at `lineIndex` would hide, or -1 when no region starts
    ''' there.
    Public Function FoldEnd(lineIndex As Integer) As Integer
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return -1
        Me.EnsureFoldRegions()
        Dim last As Integer = Me.mFoldEnds(lineIndex)
        If last > lineIndex Then Return last
        Return -1
    End Function

    ''' True when the region starting at `lineIndex` is collapsed.
    Public Function IsFolded(lineIndex As Integer) As Boolean
        Dim lo As Integer = 0
        Dim hi As Integer = Array.LastIndex(Me.mFolded)
        While lo <= hi
            Dim middle As Integer = (lo + hi) \ 2
            Dim header As Integer = Me.mFolded(middle)
            If header = lineIndex Then Return True
            If header < lineIndex Then
                lo = middle + 1
            Else
                hi = middle - 1
            End If
        Wend
        Return False
    End Function

    ''' Collapses the region starting at `lineIndex`, or else the innermost expanded region
    ''' containing it. A caret inside moves to the header. False when there is none.
    Public Function Fold(lineIndex As Integer) As Boolean
        If Not Me.mShowsFolding Then Return False
        Dim header As Integer = Me.RegionAround(lineIndex, False)
        If header < 0 Then Return False
        Array.Append(Me.mFolded, header)
        Me.FoldsChanged()
        Return True
    End Function

    ''' Expands the collapsed region starting at or containing `lineIndex` (innermost).
    Public Function Unfold(lineIndex As Integer) As Boolean
        Dim header As Integer = Me.RegionAround(lineIndex, True)
        If header < 0 Then Return False
        Dim kept As Array Of Integer = []
        For Each other As Integer In Me.mFolded
            If other <> header Then Array.Append(kept, other)
        Next
        Me.mFolded = kept
        Me.FoldsChanged()
        Return True
    End Function

    ''' Expands a collapsed region at `lineIndex`, else collapses the region there (or
    ''' the innermost one containing it). True when a fold changed.
    Public Function ToggleFold(lineIndex As Integer) As Boolean
        If Me.IsFolded(lineIndex) Then Return Me.Unfold(lineIndex)
        Return Me.Fold(lineIndex)
    End Function

    Public Sub FoldAll()
        If Not Me.mShowsFolding Then Return
        Me.EnsureFoldRegions()
        Dim headers As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(Me.mFoldEnds)
            If Me.mFoldEnds(i) > i Then Array.Append(headers, i)
        Next
        Me.mFolded = headers
        Me.FoldsChanged()
    End Sub

    Public Sub UnfoldAll()
        If Array.Count(Me.mFolded) = 0 Then Return
        Me.mFolded = []
        Me.FoldsChanged()
    End Sub

    ''' Collapses every region nested exactly `level` deep (1 = outermost: classes,
    ''' top-level subs, doc comments), keeping other folds.
    Public Sub FoldLevel(level As Integer)
        If Not Me.mShowsFolding Or level < 1 Then Return
        Me.EnsureFoldRegions()
        Dim open As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(Me.mFoldEnds)
            Dim last As Integer = Me.mFoldEnds(i)
            If last <= i Then Continue For
            While Array.Count(open) > 0
                If Array.Last(open) >= i Then Exit While
                Array.RemoveAt(open, Array.LastIndex(open))
            Wend
            If Array.Count(open) + 1 = level Then Array.Append(Me.mFolded, i)
            Array.Append(open, last)
        Next
        Me.FoldsChanged()
    End Sub

    ''' Sorted header lines of the collapsed regions (edit-adjusted).
    Public Function FoldedLines() As Array Of Integer
        Return Array.Clone(Me.mFolded)
    End Function

    ''' Collapses exactly these regions (header lines; lines without a region are
    ''' ignored). Restoring a view state does this too.
    Public Sub SetFoldedLines(lines As Array Of Integer)
        If Array.Count(lines) = 0 And Array.Count(Me.mFolded) = 0 Then Return
        Dim headers As Array Of Integer = []
        If Me.mShowsFolding And Array.Count(lines) > 0 Then
            Me.EnsureFoldRegions()
            For Each header As Integer In lines
                If header >= 0 And header <= Array.LastIndex(Me.mLines) Then
                    If Me.mFoldEnds(header) > header Then Array.Append(headers, header)
                End If
            Next
        End If
        If EditorSameLines(EditorUniqueSorted(headers), Me.mFolded) Then Return
        Me.mFolded = headers
        Me.FoldsChanged()
    End Sub

    ''' Lines to fold for saved (line, header text) pairs: the line itself when its
    ''' trimmed text still equals the header, else the nearest unclaimed equal line within
    ''' FoldAnchorReach lines (lines above win ties). Exact matches are taken first so a
    ''' repeated header (Try, Get, Else) can't steal another fold's line. Pairs with no
    ''' match are dropped, so a file edited elsewhere never folds the wrong code.
    Public Function AnchorFolds(lines As Array Of Integer, headers As Array Of String) As Array Of Integer
        Dim count As Integer = Math.Min(Array.Count(lines), Array.Count(headers))
        Dim last As Integer = Array.LastIndex(Me.mLines)
        Dim placed As Array Of Integer = []
        For i As Integer = 0 To count - 1
            Dim line As Integer = -1
            If headers(i) <> "" And lines(i) >= 0 And lines(i) <= last Then
                If String.Compare(String.Trim(Me.mLines(lines(i))), headers(i), True) = 0 Then line = lines(i)
            End If
            Array.Append(placed, line)
        Next
        For i As Integer = 0 To count - 1
            If placed(i) >= 0 Or headers(i) = "" Then Continue For
            For distance As Integer = 1 To StudioCodeEditor.FoldAnchorReach
                Dim above As Integer = lines(i) - distance
                If above >= 0 And above <= last And Array.IndexOf(placed, above) < 0 Then
                    If String.Compare(String.Trim(Me.mLines(above)), headers(i), True) = 0 Then
                        placed(i) = above
                        Exit For
                    End If
                End If
                Dim below As Integer = lines(i) + distance
                If below >= 0 And below <= last And Array.IndexOf(placed, below) < 0 Then
                    If String.Compare(String.Trim(Me.mLines(below)), headers(i), True) = 0 Then
                        placed(i) = below
                        Exit For
                    End If
                End If
            Next
        Next
        Dim found As Array Of Integer = []
        For Each line As Integer In placed
            If line >= 0 Then Array.Append(found, line)
        Next
        Return found
    End Function

    ''' How far (in lines) AnchorFolds looks for a moved fold header.
    Public Const FoldAnchorReach As Integer = 50

    ''' Nearest header at or above `lineIndex` whose region reaches it, collapsed or not.
    Private Function RegionAround(lineIndex As Integer, folded As Boolean) As Integer
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return -1
        If folded And Array.Count(Me.mFolded) = 0 Then Return -1
        Me.EnsureFoldRegions()
        For header As Integer = lineIndex To 0 Step -1
            Dim last As Integer = Me.mFoldEnds(header)
            If last > header And last >= lineIndex Then
                If Me.IsFolded(header) = folded Then Return header
            End If
        Next
        Return -1
    End Function

    ''' After the set of folds changed: rebuild rows, keep the selection on visible rows
    ''' and the scroll position in range.
    Private Sub FoldsChanged()
        Me.mFolded = EditorUniqueSorted(Me.mFolded)
        Me.RowsChanged()
        Dim collapsed As Boolean = Me.mAnchor = Me.mCaret
        Dim caretLine As Integer = Me.LineOfPosition(Me.mCaret)
        If Me.IsLineHidden(caretLine) Then
            Dim header As Integer = Me.LineOfFoldRow(Me.FoldRowOfLine(caretLine))
            Me.mCaret = Me.mStarts(header) + String.Len(Me.mLines(header))
            ' A plain cursor stays a cursor.
            If collapsed Then Me.mAnchor = Me.mCaret
            Me.mPreferredColumn = -1
        End If
        ' A hidden anchor moves to the edge of the collapsed block, so the selection
        ' keeps covering the fold instead of ending inside it.
        Dim anchorLine As Integer = Me.LineOfPosition(Me.mAnchor)
        If Me.IsLineHidden(anchorLine) Then
            Dim anchorHeader As Integer = Me.LineOfFoldRow(Me.FoldRowOfLine(anchorLine))
            Dim blockEnd As Integer = Me.RowEndLine(anchorHeader)
            If Me.mAnchor <= Me.mCaret Then
                Me.mAnchor = Me.mStarts(anchorHeader)
            ElseIf blockEnd < Array.LastIndex(Me.mLines) Then
                Me.mAnchor = Me.mStarts(blockEnd + 1)
            Else
                Me.mAnchor = Me.TotalLength()
            End If
        End If
        ' Secondary cursors in a collapsed body move to its header line's end.
        If Me.HasExtras() Then
            For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
                Dim otherCollapsed As Boolean = Me.mExtraAnchors(i) = Me.mExtraCarets(i)
                Dim otherLine As Integer = Me.LineOfPosition(Me.mExtraCarets(i))
                If Me.IsLineHidden(otherLine) Then
                    Dim otherHeader As Integer = Me.LineOfFoldRow(Me.FoldRowOfLine(otherLine))
                    Me.mExtraCarets(i) = Me.mStarts(otherHeader) + String.Len(Me.mLines(otherHeader))
                    If otherCollapsed Then Me.mExtraAnchors(i) = Me.mExtraCarets(i)
                End If
                Dim otherAnchorLine As Integer = Me.LineOfPosition(Me.mExtraAnchors(i))
                If Me.IsLineHidden(otherAnchorLine) Then
                    ' As for the primary: the anchor moves to the collapsed block's edge.
                    Dim anchorHeader As Integer = Me.LineOfFoldRow(Me.FoldRowOfLine(otherAnchorLine))
                    Dim blockEnd As Integer = Me.RowEndLine(anchorHeader)
                    If Me.mExtraAnchors(i) <= Me.mExtraCarets(i) Then
                        Me.mExtraAnchors(i) = Me.mStarts(anchorHeader)
                    ElseIf blockEnd < Array.LastIndex(Me.mLines) Then
                        Me.mExtraAnchors(i) = Me.mStarts(blockEnd + 1)
                    Else
                        Me.mExtraAnchors(i) = Me.TotalLength()
                    End If
                End If
            Next
            Me.NormalizeSelections()
        End If
        Me.SetScroll(Me.mScrollX, Me.mScrollY)
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    Private Sub RowsChanged()
        Me.mRowsValid = False
        Me.mWrapVersion += 1
        Me.mMinimapVersion += 1
        Me.Invalidate()
    End Sub

    ''' Reveal: expands every collapsed region whose hidden body contains `lineIndex`.
    Private Sub UnfoldAround(lineIndex As Integer)
        If Array.Count(Me.mFolded) = 0 Or Not Me.mShowsFolding Then Return
        Me.EnsureFoldRegions()
        Dim kept As Array Of Integer = []
        For Each header As Integer In Me.mFolded
            If lineIndex <= header Or lineIndex > Me.mFoldEnds(header) Then Array.Append(kept, header)
        Next
        If Array.Count(kept) = Array.Count(Me.mFolded) Then Return
        Me.mFolded = kept
        Me.RowsChanged()
    End Sub

    ''' Lines [first, first+removed) become `inserted` lines (called before the splice):
    ''' folds whose header is merged away or whose hidden body the edit touches expand,
    ''' the rest move with their header line; the per-line cache follows the splice.
    Private Sub FoldsEdited(first As Integer, removed As Integer, inserted As Integer, followEnd As Boolean)
        Dim rotating As Boolean = Me.mFoldsRotating
        Me.mFoldsRotating = False
        If Array.Count(Me.mFolded) > 0 And Not rotating Then
            Me.EnsureFoldRegions()
            Dim lastRemoved As Integer = first + removed - 1
            Dim kept As Array Of Integer = []
            For Each header As Integer In Me.mFolded
                Dim merged As Boolean = header > first And header <= lastRemoved
                Dim touched As Boolean = first <= Me.mFoldEnds(header) And lastRemoved > header
                If Not merged And Not touched Then Array.Append(kept, EditorShiftedLine(header, first, lastRemoved, first + inserted - 1, inserted - removed, followEnd))
            Next
            Me.mFolded = EditorUniqueSorted(kept)
        End If
        If Array.Count(Me.mFoldLines) = Array.Count(Me.mLines) Then
            For i As Integer = 1 To removed
                Array.RemoveAt(Me.mFoldLines, first)
            Next
            For i As Integer = 1 To inserted
                Array.Insert(Me.mFoldLines, first, Nil)
            Next
        Else
            Me.mFoldLines = []
        End If
        Me.mFoldsValid = False
        Me.mRowsValid = False
        Me.mWrapVersion += 1
        Me.Invalidate()
        ' An in-place edit of one line (typing) repaints only its minimap row; anything
        ' that can move rows redraws the minimap (EnsureRows also notices folds that
        ' opened or changed extent).
        If removed = 1 And inserted = 1 And Array.Count(Me.mMinimapPending) < 64 Then
            If Me.mShowsMinimap Then Array.Append(Me.mMinimapPending, first)
        Else
            Me.mMinimapPending = []
            Me.mMinimapVersion += 1
        End If
    End Sub

    ''' Move Lines: folds overlapping the permuted lines expand.
    ''' Folds inside the moved block travel with it; others overlapping [first, last]
    ''' expand. The rotation's own edit then keeps them (mFoldsRotating).
    Private Sub FoldsRotated(first As Integer, last As Integer, down As Boolean)
        If Array.Count(Me.mFolded) = 0 Then Return
        Me.EnsureFoldRegions()
        Dim blockFirst As Integer = first + 1
        Dim blockLast As Integer = last
        If down Then
            blockFirst = first
            blockLast = last - 1
        End If
        Dim kept As Array Of Integer = []
        For Each header As Integer In Me.mFolded
            If header > last Or Me.mFoldEnds(header) < first Then
                Array.Append(kept, header)
            ElseIf header >= blockFirst And Me.mFoldEnds(header) <= blockLast Then
                Array.Append(kept, EditorRotatedLine(header, first, last, down))
            End If
        Next
        Me.mFolded = EditorUniqueSorted(kept)
        Me.mFoldsRotating = True
        Me.RowsChanged()
    End Sub

    ''' Cached block role, indentation and comment flag of one line.
    Private Function FoldLineAt(lineIndex As Integer) As StudioFoldLine
        Dim state As Boolean = Me.mStates(lineIndex)
        Dim cached As StudioFoldLine = Me.mFoldLines(lineIndex)
        If cached <> Nil Then
            If cached.StartsInComment = state Then Return cached
        End If
        cached = New StudioFoldLine()
        cached.StartsInComment = state
        Dim line As String = Me.mLines(lineIndex)
        Dim lead As String = Me.LeadingWhitespace(line)
        If String.Len(lead) < String.Len(line) Then
            cached.Indent = Me.IndentCells(lead)
            Dim body As String = String.Substring(line, String.Len(lead))
            cached.IsComment = Not state And Me.IsBuoyMode() And (String.StartsWith(body, "'") Or String.StartsWith(body, "//"))
        End If
        If cached.Indent >= 0 And Not cached.IsComment Then
            If Me.IsBuoyMode() Then
                cached.Info = StudioClassifyBlock(line, state)
            Else
                cached.Info = New StudioBlockInfo()
            End If
        Else
            cached.Info = New StudioBlockInfo()
        End If
        Me.mFoldLines(lineIndex) = cached
        Return cached
    End Function

    ''' Recomputes every region's end line (one pass with a block stack, then indentation
    ''' for lines that open nothing) and drops folds whose region disappeared.
    Private Sub EnsureFoldRegions()
        Dim count As Integer = Array.Count(Me.mLines)
        If Me.mFoldTab <> Me.TabSize() Then
            Me.mFoldTab = Me.TabSize()
            Me.mFoldLines = []
            Me.mFoldsValid = False
        End If
        If Me.mFoldsValid And Array.Count(Me.mFoldEnds) = count Then Return
        If Array.Count(Me.mFoldLines) <> count Then
            Me.mFoldLines = []
            For i As Integer = 1 To count
                Array.Append(Me.mFoldLines, Nil)
            Next
        End If
        Me.EnsureStates(count - 1)
        Dim ends As Array Of Integer = []
        Dim kinds As Array Of String = []
        Dim facts As Array Of StudioFoldLine = []
        For i As Integer = 0 To count - 1
            Array.Append(ends, -1)
            Array.Append(kinds, "")
            Array.Append(facts, Me.FoldLineAt(i))
        Next
        Dim openLines As Array Of Integer = []
        Dim openKinds As Array Of String = []
        Dim segments As Array Of Integer = []
        Dim pendingProperty As Boolean = False
        Dim commentRun As Integer = -1
        For i As Integer = 0 To count - 1
            Dim fact As StudioFoldLine = facts(i)
            If fact.IsComment Then
                If commentRun < 0 Then commentRun = i
                Continue For
            End If
            If commentRun >= 0 And i - 1 > commentRun Then
                ends(commentRun) = i - 1
                kinds(commentRun) = "comment"
            End If
            commentRun = -1
            If fact.Indent < 0 Or fact.StartsInComment Then Continue For
            ' A /* */ comment left open on this line folds through the line closing it.
            If i + 1 < count Then
                If Me.mStates(i + 1) Then
                    Dim closing As Integer = i + 1
                    While closing + 1 < count
                        If Not Me.mStates(closing + 1) Then Exit While
                        closing += 1
                    Wend
                    ends(i) = closing
                    kinds(i) = "comment"
                    If Me.mLanguageMode = "markdown" Then kinds(i) = "fence"
                End If
            End If
            Dim info As StudioBlockInfo = fact.Info
            If pendingProperty Then
                pendingProperty = False
                Dim accessor As Boolean = info.Role = StudioBlockRole.Opens And (info.Kind = "get" Or info.Kind = "set")
                ' A property declaration without Get/Set opens nothing.
                If Not accessor Then EditorTruncateFolds(openLines, openKinds, segments, Array.Count(openLines) - 1)
            End If
            If info.Role = StudioBlockRole.Opens Then
                Array.Append(openLines, i)
                Array.Append(openKinds, info.Kind)
                Array.Append(segments, -1)
            ElseIf info.Role = StudioBlockRole.Continues Or info.Role = StudioBlockRole.Closes Then
                Dim k As Integer = Array.LastIndex(openKinds)
                While k >= 0
                    If String.Compare(openKinds(k), info.Kind, True) = 0 Then Exit While
                    k -= 1
                Wend
                If k >= 0 Then
                    Dim segment As Integer = segments(k)
                    If segment >= 0 And i - 1 > segment Then
                        ends(segment) = i - 1
                        kinds(segment) = openKinds(k)
                    End If
                    If info.Role = StudioBlockRole.Continues Then
                        segments(k) = i
                        EditorTruncateFolds(openLines, openKinds, segments, k + 1)
                    Else
                        If i - openLines(k) >= 2 Then
                            ends(openLines(k)) = i
                            kinds(openLines(k)) = openKinds(k)
                        End If
                        EditorTruncateFolds(openLines, openKinds, segments, k)
                    End If
                End If
            End If
            If info.IsPropertyHeader Then
                Array.Append(openLines, i)
                Array.Append(openKinds, "property")
                Array.Append(segments, -1)
                pendingProperty = True
            End If
        Next
        If commentRun >= 0 And count - 1 > commentRun Then
            ends(commentRun) = count - 1
            kinds(commentRun) = "comment"
        End If
        ' Markdown: a heading folds its section (to the next heading of its level or above).
        If Me.mLanguageMode = "markdown" Then
            For i As Integer = 0 To count - 1
                If Me.mStates(i) Then Continue For
                Dim level As Integer = StudioMarkdownHeadingLevel(Me.mLines(i))
                If level = 0 Then Continue For
                Dim last As Integer = count - 1
                For j As Integer = i + 1 To count - 1
                    If Not Me.mStates(j) Then
                        Dim other As Integer = StudioMarkdownHeadingLevel(Me.mLines(j))
                        If other > 0 And other <= level Then
                            last = j - 1
                            Exit For
                        End If
                    End If
                Next
                While last > i And String.Trim(Me.mLines(last)) = ""
                    last -= 1
                Wend
                If last > i Then
                    ends(i) = last
                    kinds(i) = "heading"
                End If
            Next
        End If
        ' Indentation regions where the block structure gives none.
        For i As Integer = 0 To count - 1
            If ends(i) >= 0 Then Continue For
            Dim fact As StudioFoldLine = facts(i)
            If fact.Indent < 0 Or fact.IsComment Or fact.StartsInComment Or fact.Info.Role = StudioBlockRole.Closes Then Continue For
            Dim last As Integer = -1
            Dim j As Integer = i + 1
            While j < count
                Dim below As Integer = facts(j).Indent
                If below >= 0 Then
                    If below <= fact.Indent Then Exit While
                    last = j
                End If
                j += 1
            Wend
            If last > i Then
                ends(i) = last
                kinds(i) = "indent"
            End If
        Next
        ' Innermost enclosing scope of every line (sticky headers, breadcrumbs).
        Dim inner As Array Of Integer = []
        Dim stack As Array Of Integer = []
        For i As Integer = 0 To count - 1
            While Array.Count(stack) > 0
                If ends(Array.Last(stack)) >= i Then Exit While
                Array.RemoveAt(stack, Array.LastIndex(stack))
            Wend
            If Array.Count(stack) > 0 Then
                Array.Append(inner, Array.Last(stack))
            Else
                Array.Append(inner, -1)
            End If
            If ends(i) > i And Me.IsScopeKind(kinds(i)) Then Array.Append(stack, i)
        Next
        Me.mFoldKinds = kinds
        Me.mScopeInner = inner
        Me.mFoldEnds = ends
        Me.mFoldsValid = True
        Dim kept As Array Of Integer = []
        For Each header As Integer In Me.mFolded
            If header >= 0 And header < count Then
                If ends(header) > header Then Array.Append(kept, header)
            End If
        Next
        Me.mFolded = kept
        Me.mRowsValid = False
        Me.mWrapVersion += 1
    End Sub

    ''' Merged hidden line ranges of the collapsed folds, with the hidden-line count
    ''' before each range.
    Private Sub EnsureRows()
        If Me.mRowsValid Then Return
        Dim firsts As Array Of Integer = []
        Dim lasts As Array Of Integer = []
        If Me.mShowsFolding And Array.Count(Me.mFolded) > 0 Then
            Me.EnsureFoldRegions()
            For Each header As Integer In Me.mFolded
                Dim last As Integer = Me.mFoldEnds(header)
                If last <= header Then Continue For
                Dim n As Integer = Array.Count(firsts)
                Dim nested As Boolean = False
                If n > 0 Then nested = header <= lasts(n - 1)
                If nested Then
                    lasts(n - 1) = Math.Max(lasts(n - 1), last)
                Else
                    Array.Append(firsts, header + 1)
                    Array.Append(lasts, last)
                End If
            Next
        End If
        Dim before As Array Of Integer = []
        Dim total As Integer = 0
        For k As Integer = 0 To Array.LastIndex(firsts)
            Array.Append(before, total)
            total += lasts(k) - firsts(k) + 1
        Next
        If Not EditorSameLines(firsts, Me.mHiddenFirst) Or Not EditorSameLines(lasts, Me.mHiddenLast) Then Me.mMinimapVersion += 1
        Me.mHiddenFirst = firsts
        Me.mHiddenLast = lasts
        Me.mHiddenBefore = before
        Me.mHiddenTotal = total
        Me.mRowsValid = True
    End Sub

    ''' Index of the last hidden range starting at or before `lineIndex`, or -1.
    Private Function HiddenRangeAt(lineIndex As Integer) As Integer
        Me.EnsureRows()
        Dim lo As Integer = 0
        Dim hi As Integer = Array.LastIndex(Me.mHiddenFirst)
        Dim found As Integer = -1
        While lo <= hi
            Dim middle As Integer = (lo + hi) \ 2
            If Me.mHiddenFirst(middle) <= lineIndex Then
                found = middle
                lo = middle + 1
            Else
                hi = middle - 1
            End If
        Wend
        Return found
    End Function

    Private Function IsLineHidden(lineIndex As Integer) As Boolean
        Dim k As Integer = Me.HiddenRangeAt(lineIndex)
        If k < 0 Then Return False
        Return lineIndex <= Me.mHiddenLast(k)
    End Function

    ''' Fold rows: lines minus hidden fold bodies (one per visible logical line; soft
    ''' wrap splits each into visual rows, see RowCount).
    Private Function FoldRowCount() As Integer
        Me.EnsureRows()
        Return Math.Max(1, Array.Count(Me.mLines) - Me.mHiddenTotal)
    End Function

    ''' Row of a line; a hidden line maps to its fold header's row.
    Private Function FoldRowOfLine(lineIndex As Integer) As Integer
        Dim k As Integer = Me.HiddenRangeAt(lineIndex)
        If k < 0 Then Return lineIndex
        If lineIndex <= Me.mHiddenLast(k) Then Return Me.mHiddenFirst(k) - 1 - Me.mHiddenBefore(k)
        Return lineIndex - Me.mHiddenBefore(k) - (Me.mHiddenLast(k) - Me.mHiddenFirst(k) + 1)
    End Function

    ''' Line shown on a row (rows past the end clamp to the last line).
    Private Function LineOfFoldRow(row As Integer) As Integer
        Me.EnsureRows()
        Dim lo As Integer = 0
        Dim hi As Integer = Array.LastIndex(Me.mHiddenFirst)
        Dim found As Integer = -1
        While lo <= hi
            Dim middle As Integer = (lo + hi) \ 2
            If Me.mHiddenFirst(middle) - Me.mHiddenBefore(middle) <= row Then
                found = middle
                lo = middle + 1
            Else
                hi = middle - 1
            End If
        Wend
        Dim lineIndex As Integer = row
        If found >= 0 Then lineIndex = row + Me.mHiddenBefore(found) + Me.mHiddenLast(found) - Me.mHiddenFirst(found) + 1
        Return Math.Max(0, Math.Min(lineIndex, Array.LastIndex(Me.mLines)))
    End Function

    ''' Last line covered by a line's row (a collapsed header covers its hidden body).
    Private Function RowEndLine(lineIndex As Integer) As Integer
        Dim row As Integer = Me.FoldRowOfLine(lineIndex)
        If row + 1 >= Me.FoldRowCount() Then Return Array.LastIndex(Me.mLines)
        Return Me.LineOfFoldRow(row + 1) - 1
    End Function

    ' ---- Soft wrap (view only) ---------------------------------------------------------
    ' WordWrap splits each visible logical line into visual rows with StudioWrapLayout
    ' (StudioEditorWrap.bui) at the text area's width. Text, positions, LineCount and every
    ' line-based API are unchanged; only rows, geometry, hit testing, vertical caret
    ' movement, the minimap and painting use visual rows. mWrapBefore holds, per fold row,
    ' the visual rows before it (plus a final total), so RowOfLine / LineOfRow stay binary
    ' searches. Layouts are cached per line and rebuilt lazily after edits, fold changes,
    ' a width/font/tab change (reflow keeps the top line in place) or a toggle. Horizontal
    ' scrolling is disabled while wrapping.

    Private Property mWordWrap As Boolean = False
    Private Property mWrapCache As Array Of StudioWrapLine = []
    Private Property mWrapBefore As Array Of Integer = []
    Private Property mWrapVersion As Integer = 0
    Private Property mWrapBuilt As Integer = -1
    Private Property mWrapTotal As Integer = 0
    Private Property mWrapCells As Integer = 0
    Private Property mWrapTab As Integer = 0
    Private Property mNoWrap As StudioWrapLine

    ''' Soft wrap: long lines continue on extra visual rows (breaking after spaces, never
    ''' inside a character cluster, continuation rows indented like the line) instead of
    ''' scrolling horizontally. View only: the text is never changed. Default off.
    Public Property WordWrap As Boolean
        Get
            Return Me.mWordWrap
        End Get
        Set
            If value = Me.mWordWrap Then Return
            ' Keep the logical line at the top of the view where it is, and a caret that
            ' was on screen on screen.
            Dim topLine As Integer = Me.LineOfRow(Math.Max(0, Math.Floor(Me.mScrollY / Me.LineHeight)))
            Dim caretTop As Double = Me.RowOfPosition(Me.mCaret) * Me.LineHeight
            Dim caretShown As Boolean = caretTop >= Me.mScrollY And caretTop + Me.LineHeight <= Me.mScrollY + Me.ViewHeight()
            Me.mWordWrap = value
            Me.mWrapBuilt = -1
            Me.mWrapCache = []
            Me.mPreferredColumn = -1
            Me.mBatchColumns = []
            Me.mBatchColumnsKey = ""
            Me.mMinimapVersion += 1
            If value Then Me.mScrollX = 0.0
            Me.SetScroll(Me.mScrollX, Me.RowOfLine(topLine) * Me.LineHeight)
            If caretShown Then Me.EnsureCaretVisible()
            Me.Invalidate()
        End Set
    End Property

    ''' Cells per visual row while wrapping (0 when WordWrap is off).
    Public Property WrapColumns As Integer
        Get
            If Not Me.mWordWrap Then Return 0
            Me.EnsureWrap()
            Return Me.mWrapCells
        End Get
    End Property

    ''' Rows the view lays out: visible logical lines, or their visual rows while wrapping.
    Public Property VisualRowCount As Integer
        Get
            Return Me.RowCount()
        End Get
    End Property

    ''' Visual row of a document position (0 = first row; a position in a collapsed fold
    ''' reports its header's first row).
    Public Function VisualRowOfPosition(position As Integer) As Integer
        Return Me.RowOfPosition(Me.Clamp(position))
    End Function

    ''' Visual rows of a logical line (1 unless wrapping splits it; 0 inside a collapsed
    ''' fold).
    Public Function VisualRowsOfLine(lineIndex As Integer) As Integer
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return 0
        If Me.IsLineHidden(lineIndex) Then Return 0
        Return Me.SegmentsOf(lineIndex).Count
    End Function

    ''' Visual row start columns of a logical line (codepoint columns; [0] unless wrapped).
    Public Function WrapStartsOfLine(lineIndex As Integer) As Array Of Integer
        Dim starts As Array Of Integer = []
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return starts
        For Each value As Integer In Me.SegmentsOf(lineIndex).Starts
            Array.Append(starts, value)
        Next
        Return starts
    End Function

    ''' Cells a visual row holds at the current width.
    Private Function WrapCellsNow() As Integer
        Dim cw As Double = Math.Max(0.5, Me.mCharWidth)
        Return Math.Max(8, Math.Floor((Me.ViewWidth() - cw) / cw))
    End Function

    ''' The visual rows of a line: its wrap layout while wrapping, else one segment.
    Private Function SegmentsOf(lineIndex As Integer) As StudioWrapLine
        If Me.mWordWrap Then
            Me.EnsureWrap()
            Return Me.WrapOf(lineIndex)
        End If
        If Me.mNoWrap = Nil Then Me.mNoWrap = New StudioWrapLine()
        Return Me.mNoWrap
    End Function

    ''' Cached wrap layout of a line at the built width (EnsureWrap sets the width).
    Private Function WrapOf(lineIndex As Integer) As StudioWrapLine
        Dim line As String = Me.mLines(lineIndex)
        If lineIndex < Array.Count(Me.mWrapCache) Then
            Dim cached As StudioWrapLine = Me.mWrapCache(lineIndex)
            If cached <> Nil Then
                If cached.Width = Me.mWrapCells And cached.Tab = Me.mWrapTab Then
                    If String.Compare(cached.Source, line, True) = 0 Then Return cached
                End If
            End If
        End If
        Dim wrap As StudioWrapLine = StudioWrapLayout(line, Me.mWrapCells, Me.mWrapTab)
        If lineIndex < Array.Count(Me.mWrapCache) Then Me.mWrapCache(lineIndex) = wrap
        Return wrap
    End Function

    ''' Lines [first, first+removed) are about to become `inserted` lines: the layout
    ''' cache follows the splice (unchanged lines keep their layout) and rows rebuild.
    Private Sub WrapSpliced(first As Integer, removed As Integer, inserted As Integer)
        Me.mWrapVersion += 1
        If Not Me.mWordWrap Then Return
        If Array.Count(Me.mWrapCache) <> Array.Count(Me.mLines) Then
            Me.mWrapCache = []
            Return
        End If
        For i As Integer = 1 To removed
            If first < Array.Count(Me.mWrapCache) Then Array.RemoveAt(Me.mWrapCache, first)
        Next
        For i As Integer = 1 To inserted
            Dim emptyWrap As StudioWrapLine = Nil
            Array.Insert(Me.mWrapCache, Math.Min(first, Array.Count(Me.mWrapCache)), emptyWrap)
        Next
    End Sub

    ''' Visual row search over the built table (no rebuild): the fold row holding visual
    ''' row `row` and the segment within it.
    Private Function WrapFoldRowAt(row As Integer, ByRef segment As Integer) As Integer
        Dim count As Integer = Array.Count(Me.mWrapBefore) - 1
        segment = 0
        If count <= 0 Then Return 0
        Dim target As Integer = Math.Max(0, Math.Min(row, Me.mWrapTotal - 1))
        Dim lo As Integer = 0
        Dim hi As Integer = count - 1
        While lo < hi
            Dim middle As Integer = (lo + hi + 1) \ 2
            If Me.mWrapBefore(middle) <= target Then
                lo = middle
            Else
                hi = middle - 1
            End If
        Wend
        segment = target - Me.mWrapBefore(lo)
        Return lo
    End Function

    ''' Builds the visual row table for the current width, tab size, text and folds.
    Private Sub EnsureWrap()
        If Not Me.mWordWrap Then Return
        Dim cells As Integer = Me.WrapCellsNow()
        Dim tab As Integer = Me.TabSize()
        Me.EnsureRows()
        If Me.mWrapBuilt = Me.mWrapVersion And cells = Me.mWrapCells And tab = Me.mWrapTab Then Return
        ' A pure reflow (resize, font, tab, minimap) keeps the top line and its row offset.
        Dim reflow As Boolean = Me.mWrapBuilt = Me.mWrapVersion And Array.Count(Me.mWrapBefore) > 1
        Dim topLine As Integer = -1
        Dim topSegment As Integer = 0
        Dim topFraction As Double = 0.0
        If reflow Then
            Dim topRow As Integer = Math.Max(0, Math.Floor(Me.mScrollY / Me.LineHeight))
            topFraction = Me.mScrollY - topRow * Me.LineHeight
            Dim foldRow As Integer = Me.WrapFoldRowAt(topRow, topSegment)
            topLine = Me.LineOfFoldRow(foldRow)
        End If
        Me.mWrapCells = cells
        Me.mWrapTab = tab
        If Array.Count(Me.mWrapCache) <> Array.Count(Me.mLines) Then
            Me.mWrapCache = []
            For i As Integer = 0 To Array.LastIndex(Me.mLines)
                Dim emptyWrap As StudioWrapLine = Nil
                Array.Append(Me.mWrapCache, emptyWrap)
            Next
        End If
        Dim before As Array Of Integer = []
        Dim total As Integer = 0
        Dim rows As Integer = Me.FoldRowCount()
        Dim lineIndex As Integer = 0
        Dim k As Integer = 0
        For r As Integer = 0 To rows - 1
            ' Walk lines in order, stepping over hidden fold bodies.
            While k < Array.Count(Me.mHiddenFirst)
                If lineIndex < Me.mHiddenFirst(k) Then Exit While
                If lineIndex <= Me.mHiddenLast(k) Then lineIndex = Me.mHiddenLast(k) + 1
                k += 1
            Wend
            Array.Append(before, total)
            If lineIndex <= Array.LastIndex(Me.mLines) Then
                total += Me.WrapOf(lineIndex).Count
            Else
                total += 1
            End If
            lineIndex += 1
        Next
        Array.Append(before, total)
        Me.mWrapBefore = before
        Me.mWrapTotal = Math.Max(1, total)
        Me.mWrapBuilt = Me.mWrapVersion
        Me.mMinimapVersion += 1
        If topLine >= 0 Then
            Dim segments As Integer = Me.WrapOf(topLine).Count
            Dim row As Integer = Me.mWrapBefore(Me.FoldRowOfLine(topLine)) + Math.Min(topSegment, segments - 1)
            Me.mScrollY = Math.Max(0.0, Math.Min(row * Me.LineHeight + topFraction, Me.MaxScrollY()))
        End If
    End Sub

    ''' Rows the view lays out (visual rows while wrapping, else fold rows).
    Private Function RowCount() As Integer
        If Not Me.mWordWrap Then Return Me.FoldRowCount()
        Me.EnsureWrap()
        Return Me.mWrapTotal
    End Function

    ''' First visual row of a line; a hidden line maps to its fold header's first row.
    Private Function RowOfLine(lineIndex As Integer) As Integer
        Dim foldRow As Integer = Me.FoldRowOfLine(lineIndex)
        If Not Me.mWordWrap Then Return foldRow
        Me.EnsureWrap()
        Return Me.mWrapBefore(Math.Max(0, Math.Min(foldRow, Array.Count(Me.mWrapBefore) - 2)))
    End Function

    ''' Line shown on a visual row (rows past the end clamp to the last row).
    Private Function LineOfRow(row As Integer) As Integer
        Dim segment As Integer = 0
        Return Me.LineAndSegmentOfRow(row, segment)
    End Function

    ''' Line shown on a visual row and the wrap segment drawn there.
    Private Function LineAndSegmentOfRow(row As Integer, ByRef segment As Integer) As Integer
        segment = 0
        If Not Me.mWordWrap Then Return Me.LineOfFoldRow(row)
        Me.EnsureWrap()
        Dim foldRow As Integer = Me.WrapFoldRowAt(row, segment)
        Return Me.LineOfFoldRow(foldRow)
    End Function

    ''' Visual row of a position (its segment's row within its line's rows).
    Private Function RowOfPosition(position As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim first As Integer = Me.RowOfLine(lineIndex)
        If Not Me.mWordWrap Then Return first
        If Me.IsLineHidden(lineIndex) Then Return first
        Return first + Me.WrapOf(lineIndex).SegmentOf(position - Me.mStarts(lineIndex))
    End Function

    ''' Cell of `column` within its visual row (the segment's start cell subtracted, the
    ''' continuation indent added), and that segment.
    Private Function RowCellOf(lineIndex As Integer, column As Integer, ByRef segment As Integer) As Integer
        Dim line As String = Me.mLines(lineIndex)
        Dim cell As Integer = Me.VisualColumn(line, column)
        segment = 0
        If Not Me.mWordWrap Then Return cell
        If Me.IsLineHidden(lineIndex) Then Return cell
        Dim wrap As StudioWrapLine = Me.SegmentsOf(lineIndex)
        If wrap.Count = 1 Then Return cell
        segment = wrap.SegmentOf(column)
        Return cell - Me.VisualColumn(line, wrap.Starts(segment)) + wrap.SegmentIndent(segment)
    End Function

    ''' View x of a segment's cell 0 (where its first character is drawn).
    Private Function SegmentOriginX(lineIndex As Integer, wrap As StudioWrapLine, segment As Integer) As Double
        If segment = 0 Then Return Me.TextLeft() - Me.mScrollX
        Dim line As String = Me.mLines(lineIndex)
        Return Me.TextLeft() - Me.mScrollX + (wrap.SegmentIndent(segment) - Me.VisualColumn(line, wrap.Starts(segment))) * Me.mCharWidth
    End Function

    ''' Caret stop on a visual row nearest to a row-relative cell. A non-final row never
    ''' returns its end column (that position is drawn at the next row's start).
    Private Function ColumnInRow(lineIndex As Integer, segment As Integer, visual As Double) As Integer
        Dim line As String = Me.mLines(lineIndex)
        If Not Me.mWordWrap Then Return Me.ColumnForVisual(line, visual)
        Dim wrap As StudioWrapLine = Me.SegmentsOf(lineIndex)
        If wrap.Count = 1 Then Return Me.ColumnForVisual(line, visual)
        Dim k As Integer = Math.Max(0, Math.Min(segment, wrap.Count - 1))
        Dim first As Integer = wrap.Starts(k)
        Dim length As Integer = String.Len(line)
        Dim last As Integer = wrap.SegmentEnd(k, length)
        Dim target As Double = Me.VisualColumn(line, first) + Math.Max(0.0, visual - wrap.SegmentIndent(k))
        Dim column As Integer = Math.Max(first, Me.ColumnForVisual(line, target))
        If k < wrap.Count - 1 And column >= last Then
            If Me.IsSimpleLine(line) Then
                column = last - 1
            Else
                column = Me.LayoutOf(line).PreviousStop(last)
            End If
            column = Math.Max(first, column)
        End If
        Return Math.Min(column, last)
    End Function

    ''' Highlight boxes for columns [fromColumn, toColumn) of a line: one (x1, x2, y)
    ''' triple per visual row the range touches (one row when not wrapping; an empty range
    ''' gives one zero-width box where its column is drawn).
    Private Function ColumnRects(lineIndex As Integer, fromColumn As Integer, toColumn As Integer) As Array Of Double
        Dim rects As Array Of Double = []
        Dim line As String = Me.mLines(lineIndex)
        Dim cw As Double = Me.mCharWidth
        Dim top As Double = Me.LineTop(lineIndex)
        Dim wrap As StudioWrapLine = Me.SegmentsOf(lineIndex)
        If wrap.Count = 1 Or Me.IsLineHidden(lineIndex) Then
            Array.Append(rects, Me.TextLeft() + Me.VisualColumn(line, fromColumn) * cw - Me.mScrollX)
            Array.Append(rects, Me.TextLeft() + Me.VisualColumn(line, toColumn) * cw - Me.mScrollX)
            Array.Append(rects, top)
            Return rects
        End If
        Dim length As Integer = String.Len(line)
        If toColumn <= fromColumn Then
            Dim segment As Integer = 0
            Dim cell As Integer = Me.RowCellOf(lineIndex, fromColumn, segment)
            Array.Append(rects, Me.TextLeft() + cell * cw - Me.mScrollX)
            Array.Append(rects, Me.TextLeft() + cell * cw - Me.mScrollX)
            Array.Append(rects, top + segment * Me.LineHeight)
            Return rects
        End If
        For k As Integer = 0 To wrap.Count - 1
            Dim first As Integer = wrap.Starts(k)
            Dim last As Integer = wrap.SegmentEnd(k, length)
            Dim a As Integer = Math.Max(fromColumn, first)
            Dim b As Integer = Math.Min(toColumn, last)
            If b <= a Then Continue For
            Dim origin As Double = Me.SegmentOriginX(lineIndex, wrap, k)
            Array.Append(rects, origin + Me.VisualColumn(line, a) * cw)
            Array.Append(rects, origin + Me.VisualColumn(line, b) * cw)
            Array.Append(rects, top + k * Me.LineHeight)
        Next
        Return rects
    End Function

    ''' Visual rows a line occupies on screen (1 when not wrapped or inside a fold).
    Private Function LineRowSpan(lineIndex As Integer) As Integer
        If Not Me.mWordWrap Then Return 1
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return 1
        If Me.IsLineHidden(lineIndex) Then Return 1
        Return Me.SegmentsOf(lineIndex).Count
    End Function

    ''' Left edge of the "⋯" pill drawn after a collapsed header's text.
    Private Function FoldPillLeft(lineIndex As Integer) As Double
        If Me.mWordWrap Then
            Dim segment As Integer = 0
            Dim cell As Integer = Me.RowCellOf(lineIndex, String.Len(Me.mLines(lineIndex)), segment)
            Return Me.TextLeft() + (cell + 1) * Me.mCharWidth - Me.mScrollX
        End If
        Return Me.TextLeft() + (Me.LineCells(Me.mLines(lineIndex)) + 1) * Me.mCharWidth - Me.mScrollX
    End Function

    ''' Top of the row the pill sits on (a wrapped header's last row).
    Private Function FoldPillTop(lineIndex As Integer) As Double
        Return Me.LineTop(lineIndex) + (Me.LineRowSpan(lineIndex) - 1) * Me.LineHeight
    End Function

    Private Function FoldPillWidth() As Double
        Return Math.Round(Math.Max(22.0, Me.mCharWidth * 3.0 + 6.0))
    End Function

    ''' Centre of the fold chevron column.
    Private Function FoldChevronX() As Double
        Return Me.GutterWidth() - 9.0
    End Function

    ''' Line whose fold chevron (gutter) or "⋯" pill is at a point, or -1. The chevron
    ''' column answers only for lines that start a region.
    Private Function FoldHitAt(x As Double, y As Double, ByRef onPill As Boolean) As Integer
        onPill = False
        If Not Me.mShowsFolding Then Return -1
        Dim row As Integer = Math.Floor((y + Me.mScrollY - Me.TopPadding()) / Me.LineHeight)
        If row < 0 Or row >= Me.RowCount() Then Return -1
        Dim segment As Integer = 0
        Dim lineIndex As Integer = Me.LineAndSegmentOfRow(row, segment)
        Dim gutter As Double = Me.GutterWidth()
        If x >= gutter - Me.FoldColumnWidth() - 6.0 And x < gutter Then
            ' The chevron sits on a wrapped line's first row only.
            If segment = 0 And Me.FoldEnd(lineIndex) > lineIndex Then Return lineIndex
            Return -1
        End If
        If x >= gutter And Me.IsFolded(lineIndex) And segment = Me.LineRowSpan(lineIndex) - 1 Then
            Dim left As Double = Me.FoldPillLeft(lineIndex)
            If x >= left And x <= left + Me.FoldPillWidth() Then
                onPill = True
                Return lineIndex
            End If
        End If
        Return -1
    End Function

    Private Sub DrawFoldChevron(g As Graphics, centreX As Double, centreY As Double, collapsed As Boolean, tint As Color)
        g.BeginPath()
        If collapsed Then
            g.MoveTo(centreX - 1.5, centreY - 3.5)
            g.LineTo(centreX + 2.0, centreY)
            g.LineTo(centreX - 1.5, centreY + 3.5)
        Else
            g.MoveTo(centreX - 3.5, centreY - 1.5)
            g.LineTo(centreX, centreY + 2.0)
            g.LineTo(centreX + 3.5, centreY - 1.5)
        End If
        g.StrokePath(1.4, tint)
    End Sub

    Private Sub DrawFoldPill(g As Graphics, lineIndex As Integer, lineHeight As Double, baseline As Double, theme As StudioCodeEditorTheme)
        Dim x As Double = Me.FoldPillLeft(lineIndex)
        Dim y As Double = Me.FoldPillTop(lineIndex)
        Dim width As Double = Me.FoldPillWidth()
        g.FillRoundedRect(x, y + 3.0, width, lineHeight - 6.0, 4, theme.FoldPill)
        ' Three dots, centred (a font's "⋯" glyph sits differently on every platform).
        Dim mid As Double = y + lineHeight / 2.0
        Dim gap As Double = Math.Max(3.5, Me.FontSize * 0.33)
        Dim dot As Double = Math.Max(2.0, Me.FontSize * 0.2)
        For k As Integer = -1 To 1
            g.FillOval(x + width / 2.0 + k * gap - dot / 2.0, mid - dot / 2.0, dot, dot, theme.FoldPillInk)
        Next
    End Sub

    ' ---- Minimap -----------------------------------------------------------------------
    ' A scaled overview left of the vertical scrollbar: each visible row is two points
    ' tall and each cell one point wide, tokens drawn as blocks in their theme colours
    ' (hidden fold bodies are skipped). The token layer is cached as a Picture covering
    ' a window of rows and redrawn only after an edit, fold, theme, width or find change,
    ' or when scrolling leaves the window; selection, markers and the viewport slider
    ' are drawn live. A document taller than the minimap scrolls it proportionally with
    ' the editor (VS Code).

    Private Property mShowsMinimap As Boolean = False
    Private Property mMinimapWidth As Double = 96.0
    Private Property mMinimapPicture As Picture
    Private Property mMinimapKey As String = ""
    Private Property mMinimapFirstRow As Integer = 0
    Private Property mMinimapRowSpan As Integer = 0
    Private Property mMinimapVersion As Integer = 0
    Private Property mMinimapBuilt As Integer = -1
    Private Property mMinimapPending As Array Of Integer = []
    Private Property mMinimapStates As Array Of Boolean = []
    Private Property mMinimapHover As Boolean = False

    ''' Minimap at the right edge: click to centre a spot, drag the viewport slider to
    ''' scroll. Default off.
    Public Property ShowsMinimap As Boolean
        Get
            Return Me.mShowsMinimap
        End Get
        Set
            If value = Me.mShowsMinimap Then Return
            Me.mShowsMinimap = value
            Me.mMinimapPicture = Nil
            Me.mMinimapKey = ""
            Me.mMinimapHover = False
            Me.SetScroll(Me.mScrollX, Me.mScrollY)
            Me.Invalidate()
        End Set
    End Property

    ''' Minimap width in points (40-240, default 96).
    Public Property MinimapWidth As Double
        Get
            Return Me.mMinimapWidth
        End Get
        Set
            Dim clamped As Double = Math.Max(40.0, Math.Min(240.0, value))
            If clamped = Me.mMinimapWidth Then Return
            Me.mMinimapWidth = clamped
            Me.mMinimapKey = ""
            Me.SetScroll(Me.mScrollX, Me.mScrollY)
            Me.Invalidate()
        End Set
    End Property

    Private Function MinimapRowHeight() As Double
        Return 2.0
    End Function

    ''' Pixels per point in the cached minimap picture.
    Private Function MinimapScale() As Double
        Return 1.0
    End Function

    Private Function MinimapLeft() As Double
        Return Math.Round(Me.Width - Me.ScrollbarSize() - Me.mMinimapWidth)
    End Function

    ''' True when a point is over the minimap (not its scrollbar).
    Private Function IsOverMinimap(x As Double) As Boolean
        If Not Me.mShowsMinimap Then Return False
        Return x >= Me.MinimapLeft() And x < Me.Width - Me.ScrollbarSize()
    End Function

    ''' How far the minimap itself is scrolled for an editor scroll position.
    Private Function MinimapOffset(scrollY As Double) As Double
        Dim total As Double = Me.RowCount() * Me.MinimapRowHeight()
        If total <= Me.Height Then Return 0.0
        Dim maxScroll As Double = Me.MaxScrollY()
        If maxScroll <= 0.0 Then Return 0.0
        Return (total - Me.Height) * Math.Max(0.0, Math.Min(1.0, scrollY / maxScroll))
    End Function

    Private Function MinimapSliderTop(scrollY As Double) As Double
        Return scrollY / Me.LineHeight * Me.MinimapRowHeight() - Me.MinimapOffset(scrollY)
    End Function

    Private Function MinimapSliderHeight() As Double
        Return Math.Max(8.0, Me.ViewHeight() / Me.LineHeight * Me.MinimapRowHeight())
    End Function

    ''' Editor scroll that puts the slider's top at `sliderTop` (the slider position is
    ''' linear in the scroll position).
    Private Function MinimapScrollFor(sliderTop As Double) As Double
        Dim maxScroll As Double = Me.MaxScrollY()
        If maxScroll <= 0.0 Then Return 0.0
        Dim travel As Double = Me.MinimapSliderTop(maxScroll)
        If travel <= 0.0 Then Return 0.0
        Return sliderTop / travel * maxScroll
    End Function

    ''' Press on the minimap: on the slider it grabs it, elsewhere it centres that row
    ''' in the editor and then drags from there.
    Private Sub MinimapPress(y As Double)
        Dim top As Double = Me.MinimapSliderTop(Me.mScrollY)
        If y < top Or y > top + Me.MinimapSliderHeight() Then
            Dim row As Integer = Math.Floor((y + Me.MinimapOffset(Me.mScrollY)) / Me.MinimapRowHeight())
            row = Math.Max(0, Math.Min(row, Me.RowCount() - 1))
            Me.SetScroll(Me.mScrollX, row * Me.LineHeight - (Me.ViewHeight() - Me.LineHeight) / 2.0)
            top = Me.MinimapSliderTop(Me.mScrollY)
        End If
        Me.mDragGrab = y - top
        Me.mDragMode = 4
        Me.Invalidate()
    End Sub

    Private Sub MinimapDrag(y As Double)
        Me.SetScroll(Me.mScrollX, Me.MinimapScrollFor(y - Me.mDragGrab))
    End Sub

    Private Sub DrawMinimap(g As Graphics, theme As StudioCodeEditorTheme, dark As Boolean)
        Dim left As Double = Me.MinimapLeft()
        Dim width As Double = Me.mMinimapWidth
        Dim h As Double = Me.Height
        Dim rowHeight As Double = Me.MinimapRowHeight()
        Dim offset As Double = Me.MinimapOffset(Me.mScrollY)
        g.FillRect(left, 0, Me.Width - left, h, theme.Background)
        Dim shownRows As Integer = Math.Ceiling(h / rowHeight) + 1
        Dim firstRow As Integer = Math.Max(0, Math.Floor(offset / rowHeight))
        Me.EnsureMinimapPicture(theme, dark, firstRow, shownRows)
        g.Save()
        g.ClipToRect(left, 0, width, h)
        If Me.mMinimapPicture <> Nil Then
            g.DrawPicture(Me.mMinimapPicture, Math.Round(left), Math.Round(Me.mMinimapFirstRow * rowHeight - offset), width, Me.mMinimapRowSpan * rowHeight)
        End If
        ' Selection and diagnostics, live over the cached token layer.
        If Me.SelectionLength > 0 Then
            Dim firstSelected As Integer = Me.RowOfPosition(Me.SelectionStart)
            Dim lastSelected As Integer = Me.RowOfPosition(Me.SelectionStart + Me.SelectionLength)
            Dim tint As Color = Color.RGBA(theme.Selection.R, theme.Selection.G, theme.Selection.B, 0.55)
            g.FillRect(left, firstSelected * rowHeight - offset, width, (lastSelected - firstSelected + 1) * rowHeight, tint)
        End If
        For Each marker As StudioEditorMarker In Me.mMarkers
            If marker.Severity = StudioMarkerSeverity.Note Or marker.Severity = StudioMarkerSeverity.Hint Then Continue For
            Dim y As Double = Me.RowOfLine(marker.Line) * rowHeight - offset
            If y < -rowHeight Or y > h Then Continue For
            Dim ink As Color = theme.ForSeverity(marker.Severity)
            g.FillRect(left, y - 0.5, width, rowHeight + 1.0, Color.RGBA(ink.R, ink.G, ink.B, 0.3))
            g.FillRect(left + width - 3.0, y - 1.0, 3.0, rowHeight + 2.0, ink)
        Next
        ' Viewport slider (stronger while hovered or dragged).
        Dim slider As Color = theme.MinimapSlider
        If Me.mMinimapHover Or Me.mDragMode = 4 Then slider = theme.MinimapSliderActive
        g.FillRect(left, Me.MinimapSliderTop(Me.mScrollY), width, Me.MinimapSliderHeight(), slider)
        g.Restore()
        g.DrawLine(left - 0.5, 0, left - 0.5, h, 1, theme.GutterLine)
    End Sub

    ''' Makes sure the cached token picture covers rows [firstRow, firstRow+shownRows)
    ''' and reflects the text: single-line edits repaint just their row.
    Private Sub EnsureMinimapPicture(theme As StudioCodeEditorTheme, dark As Boolean, firstRow As Integer, shownRows As Integer)
        Dim rows As Integer = Me.RowCount()
        Dim key As String = String.From(Me.mMinimapWidth) + "|" + String.From(Me.TabSize()) + "|" + String.From(dark) + "|" + String.From(Me.mFindCase) + String.From(Me.mFindWord) + String.From(Me.mFindRegex) + String.From(Me.mFindMultiline) + String.From(Me.mFindDotAll) + "|" + Me.mFindQuery
        Dim lastNeeded As Integer = Math.Min(rows, firstRow + shownRows)
        Dim sameKey As Boolean = String.Compare(key, Me.mMinimapKey, True) = 0
        If Me.mMinimapPicture <> Nil And sameKey And Me.mMinimapBuilt = Me.mMinimapVersion Then
            If firstRow >= Me.mMinimapFirstRow And lastNeeded <= Me.mMinimapFirstRow + Me.mMinimapRowSpan Then
                If Me.RepaintMinimapRows(theme) Then Return
            End If
        End If
        ' The visible part plus a margin either way: blitting the picture every paint
        ' costs in proportion to its size, so it stays about one screen tall.
        Dim margin As Integer = Math.Max(48, shownRows \ 2)
        Dim start As Integer = 0
        Dim span As Integer = rows
        If rows > shownRows + margin * 2 Then
            start = Math.Max(0, Math.Min(firstRow - margin, rows - shownRows - margin * 2))
            span = shownRows + margin * 2
        End If
        Me.RenderMinimap(theme, start, span)
        Me.mMinimapKey = key
        Me.mMinimapBuilt = Me.mMinimapVersion
    End Sub

    ''' Repaints the rows of lines edited in place since the last paint. False when a
    ''' full render is needed (an edit changed the block-comment state below it).
    Private Function RepaintMinimapRows(theme As StudioCodeEditorTheme) As Boolean
        If Array.Count(Me.mMinimapPending) = 0 Then Return True
        ' Soft wrap: an edit can change how many rows its line takes.
        If Me.mWordWrap Then Return False
        ' Regex highlights are drawn per document, not per row.
        If Me.mFindRegex And Me.mFindQuery <> "" Then Return False
        Dim pending As Array Of Integer = Me.mMinimapPending
        Me.mMinimapPending = []
        Dim rowHeight As Double = Me.MinimapRowHeight() * Me.MinimapScale()
        Dim pg As Graphics = Me.mMinimapPicture.Graphics
        For Each lineIndex As Integer In pending
            If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return False
            Dim r As Integer = Me.RowOfLine(lineIndex) - Me.mMinimapFirstRow
            ' An edit above the window that opens or closes /* */ restyles rows in it.
            If r < 0 Then Return False
            If r >= Me.mMinimapRowSpan Then Continue For
            If r + 1 < Me.mMinimapRowSpan Then
                Dim below As Integer = Me.LineOfRow(Me.mMinimapFirstRow + r + 1)
                Me.EnsureStates(below)
                If Me.mStates(below) <> Me.mMinimapStates(r + 1) Then Return False
            End If
            pg.FillRect(0, r * rowHeight, Me.mMinimapPicture.Width, rowHeight, theme.Background)
            Me.DrawMinimapRow(pg, theme, lineIndex, r * rowHeight)
        Next
        Return True
    End Function

    ''' Draws rows [start, start+span) into the cached picture (MinimapScale pixels per
    ''' point; 1x keeps the per-paint blit cheap and the blocks pixel-aligned).
    Private Sub RenderMinimap(theme As StudioCodeEditorTheme, start As Integer, span As Integer)
        Dim rowHeight As Double = Me.MinimapRowHeight() * Me.MinimapScale()
        Dim pixelWidth As Integer = Math.Max(1, Math.Round(Me.mMinimapWidth * Me.MinimapScale()))
        Dim pixelHeight As Integer = Math.Max(1, Math.Round(Math.Max(1, span) * rowHeight))
        Dim picture As Picture = Me.mMinimapPicture
        If picture <> Nil Then
            If picture.Width <> pixelWidth Or picture.Height <> pixelHeight Then picture = Nil
        End If
        If picture = Nil Then picture = New Picture(pixelWidth, pixelHeight)
        Dim pg As Graphics = picture.Graphics
        pg.FillRect(0, 0, pixelWidth, pixelHeight, theme.Background)
        If Me.mFindRegex And Me.mFindQuery <> "" Then
            ' Regex matches, tinted on their first line's row behind the blocks.
            Dim rowPixels As Double = Me.MinimapRowHeight() * Me.MinimapScale()
            For Each hit As StudioFindHit In Me.RegexHighlights()
                Dim hitLine As Integer = Me.LineOfPosition(hit.Start)
                If Me.IsLineHidden(hitLine) Then Continue For
                Dim r As Integer = Me.RowOfPosition(hit.Start) - start
                If r < 0 Or r >= span Then Continue For
                Dim line As String = Me.mLines(hitLine)
                Dim column As Integer = hit.Start - Me.mStarts(hitLine)
                Dim hitSegment As Integer = 0
                Dim c1 As Integer = Me.RowCellOf(hitLine, column, hitSegment)
                Dim c2 As Integer = c1 + Me.VisualColumn(line, Math.Min(String.Len(line), column + Math.Max(1, hit.Length))) - Me.VisualColumn(line, column)
                pg.FillRect(c1 * Me.MinimapScale(), r * rowPixels, Math.Max(1, c2 - c1) * Me.MinimapScale(), rowPixels, theme.FindMatch)
            Next
        End If
        Dim states As Array Of Boolean = []
        For r As Integer = 0 To span - 1
            Dim segment As Integer = 0
            Dim lineIndex As Integer = Me.LineAndSegmentOfRow(start + r, segment)
            Me.EnsureStates(lineIndex)
            Array.Append(states, Me.mStates(lineIndex))
            Me.DrawMinimapRow(pg, theme, lineIndex, r * rowHeight, segment)
        Next
        Me.mMinimapPicture = picture
        Me.mMinimapFirstRow = start
        Me.mMinimapRowSpan = Math.Max(1, span)
        Me.mMinimapStates = states
        Me.mMinimapPending = []
    End Sub

    ''' One line as token blocks (one point per cell, two per row with a one-pixel gap),
    ''' with literal find matches tinted behind.
    Private Sub DrawMinimapRow(pg As Graphics, theme As StudioCodeEditorTheme, lineIndex As Integer, y As Double, segment As Integer = 0)
        Dim line As String = Me.mLines(lineIndex)
        If line = "" Then Return
        Dim cell As Double = Me.MinimapScale()
        Dim rowHeight As Double = Me.MinimapRowHeight() * Me.MinimapScale()
        Dim columns As Integer = Math.Floor(Me.mMinimapWidth)
        Dim simple As Boolean = Me.IsSimpleLine(line)
        Dim layout As StudioLineLayout = Nil
        If Not simple Then layout = Me.LayoutOf(line)
        ' Soft wrap: only this visual row's columns, shifted to the row start.
        Dim wrap As StudioWrapLine = Me.SegmentsOf(lineIndex)
        Dim seg As Integer = Math.Max(0, Math.Min(segment, wrap.Count - 1))
        Dim segmentFirst As Integer = wrap.Starts(seg)
        Dim segmentEnd As Integer = wrap.SegmentEnd(seg, String.Len(line))
        Dim shift As Integer = 0
        If seg > 0 Then shift = wrap.SegmentIndent(seg) - Me.VisualColumn(line, segmentFirst)
        If Not Me.mFindRegex And Me.mFindQuery <> "" Then
            For Each hit As StudioFindHit In Me.FindHitsOnLine(lineIndex)
                Dim hitFirst As Integer = Math.Max(hit.Start - Me.mStarts(lineIndex), segmentFirst)
                Dim hitEnd As Integer = Math.Min(hit.Start + hit.Length - Me.mStarts(lineIndex), segmentEnd)
                If hitEnd <= hitFirst Then Continue For
                Dim c1 As Integer = Me.VisualColumn(line, hitFirst) + shift
                Dim c2 As Integer = Me.VisualColumn(line, hitEnd) + shift
                pg.FillRect(c1 * cell, y, Math.Max(1, c2 - c1) * cell, rowHeight, theme.FindMatch)
            Next
        End If
        Dim chars As Array Of String = String.Chars(line)
        For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
            Dim ink As Color = theme.ForKind(token.Kind)
            Dim tint As Color = Color.RGBA(ink.R, ink.G, ink.B, 0.9)
            Dim k As Integer = Math.Max(token.Start, segmentFirst)
            Dim stopAt As Integer = Math.Min(Math.Min(token.Start + token.Length, Array.Count(chars)), segmentEnd)
            While k < stopAt
                If chars(k) = " " Or chars(k) = "\t" Then
                    k += 1
                    Continue While
                End If
                Dim runStart As Integer = k
                While k < stopAt
                    If chars(k) = " " Or chars(k) = "\t" Then Exit While
                    k += 1
                Wend
                Dim c1 As Integer = runStart
                Dim c2 As Integer = k
                If Not simple Then
                    c1 = layout.CellOf(runStart)
                    c2 = layout.CellOf(k)
                End If
                c1 += shift
                c2 += shift
                If c1 >= columns Then Exit While
                pg.FillRect(c1 * cell, y, (Math.Min(c2, columns) - c1) * cell, Math.Max(1.0, rowHeight - Me.MinimapScale()), tint)
            Wend
        Next
    End Sub

    ' ---- Editing commands --------------------------------------------------------------

    Private Function LeadingWhitespace(line As String) As String
        Dim count As Integer = 0
        For Each ch As String In String.Chars(line)
            If ch <> " " And ch <> "\t" Then Exit For
            count += 1
        Next
        Return String.Left(line, count)
    End Function

    ''' Enter. Copies the indentation; with AutoIndentBlocks also re-aligns a closing or
    ''' middle line (End If, Else, Case, Next, ...) to its opener, indents a block body,
    ''' and with AutoCloseBlocks adds the missing closing line (Xojo style). One edit.
    Private Sub InsertNewline()
        Dim s As Integer = Me.SelectionStart
        Dim selectionEnd As Integer = s + Me.SelectionLength
        Dim lineIndex As Integer = Me.LineOfPosition(s)
        Dim line As String = Me.mLines(lineIndex)
        Dim lineStart As Integer = Me.mStarts(lineIndex)
        Dim column As Integer = s - lineStart
        Dim lead As String = Me.LeadingWhitespace(line)
        ' Enter between an auto-inserted bracket pair opens an indented line inside it.
        If Me.SelectionLength = 0 And column > 0 And column < String.Len(line) Then
            Dim opener As String = String.Substring(line, column - 1, 1)
            Dim closer As String = String.Substring(line, column, 1)
            If (opener = "(" Or opener = "[" Or opener = "{") And Me.PairCloser(opener) = closer Then
                Dim inside As String = Me.PolicyIndent(lead) + Me.IndentUnit(lead)
                Dim caretInside As Integer = s + 1 + String.Len(inside)
                Me.EditRange(s, 0, "\n" + inside + "\n" + Me.PolicyIndent(lead), caretInside, caretInside, "newline")
                Return
            End If
        End If
        If Not Me.AutoIndentBlocks Or Not Me.IsBuoyMode() Or String.Len(lead) >= column Then
            Dim indent As String = lead
            If String.Len(indent) > column Then indent = String.Left(indent, column)
            Me.EditRange(s, Me.SelectionLength, "\n" + Me.PolicyIndent(indent), -1, -1, "newline")
            Return
        End If
        Dim before As String = String.Left(line, column)
        Dim lastLine As Integer = Me.LineOfPosition(selectionEnd)
        Dim lastText As String = Me.mLines(lastLine)
        Dim after As String = String.Substring(lastText, selectionEnd - Me.mStarts(lastLine))
        Me.EnsureStates(lineIndex)
        Dim info As StudioBlockInfo = StudioClassifyBlock(before, Me.mStates(lineIndex))
        Dim aligned As String = lead
        If info.Role = StudioBlockRole.Continues Or info.Role = StudioBlockRole.Closes Then
            aligned = Me.OpenerIndent(lineIndex, info, lead)
        ElseIf info.Role = StudioBlockRole.Opens And (info.Kind = "get" Or info.Kind = "set") Then
            aligned = Me.AccessorIndent(lineIndex, lead)
        End If
        Dim opensBody As Boolean = info.Role = StudioBlockRole.Opens Or info.Role = StudioBlockRole.Continues
        If opensBody And info.IsMember Then
            If Me.InsideInterface(lineIndex) Then opensBody = False
        End If
        If aligned <> lead Then aligned = Me.PolicyIndent(aligned)
        Dim generatedLead As String = Me.PolicyIndent(aligned)
        Dim inner As String = generatedLead
        If opensBody Then inner = generatedLead + Me.IndentUnit(aligned)
        Dim insertion As String = aligned + String.Substring(before, String.Len(lead)) + "\n" + inner
        Dim caretAfter As Integer = lineStart + String.Len(insertion)
        Dim replaceEnd As Integer = selectionEnd
        If opensBody And info.Role = StudioBlockRole.Opens And Me.AutoCloseBlocks And info.Closer <> "" And String.Trim(after) = "" Then
            If Not Me.BlockIsClosed(lastLine, aligned, info) Then
                insertion += "\n" + generatedLead + info.Closer
                replaceEnd = Me.mStarts(lastLine) + String.Len(lastText)
            End If
        End If
        ' Other cursors earlier on this line (multi-cursor Enter) move with the text the
        ' re-indent shifts instead of collapsing into the rewritten range.
        Dim shifted As Array Of Integer = []
        If Me.mBatch Then
            Dim delta As Integer = String.Len(aligned) - String.Len(lead)
            For i As Integer = 0 To Array.LastIndex(Me.mBatchCarets)
                If i = Me.mBatchIndex Then Continue For
                For Each which As Integer In [0, 1]
                    Dim p As Integer = Me.mBatchAnchors(i)
                    If which = 1 Then p = Me.mBatchCarets(i)
                    If p > lineStart And p < s Then
                        Dim column As Integer = p - lineStart
                        Dim moved As Integer = lineStart + Math.Min(column, String.Len(aligned))
                        If column >= String.Len(lead) Then moved = p + delta
                        Array.Append(shifted, i * 2 + which)
                        Array.Append(shifted, Math.Max(lineStart, moved))
                    End If
                Next
            Next
        End If
        Me.EditRange(lineStart, replaceEnd - lineStart, insertion, caretAfter, caretAfter, "newline")
        Dim k As Integer = 0
        While k + 1 < Array.Count(shifted)
            Dim slot As Integer = shifted(k) \ 2
            If shifted(k) Mod 2 = 0 Then
                Me.mBatchAnchors(slot) = shifted(k + 1)
            Else
                Me.mBatchCarets(slot) = shifted(k + 1)
            End If
            k += 2
        Wend
    End Sub

    Private Function IndentUnit(indent As String) As String
        If Me.mIndentStyle = "tab" Then Return "\t"
        If Me.mIndentStyle = "auto" And String.Contains(indent, "\t") And Not String.Contains(indent, " ") Then Return "\t"
        Return String.Space(Me.IndentStep())
    End Function

    ' Snippet template spaces describe logical levels; tab_width only controls display.
    ' Only leading whitespace of continuation lines is passed here, never body literals.
    Private Function TemplateIndent(indent As String) As String
        Dim cells As Integer = 0
        For Each ch As String In String.Chars(indent)
            If ch = "\t" Then
                cells += Me.IndentStep() - (cells Mod Me.IndentStep())
            Else
                cells += 1
            End If
        Next
        If Me.mIndentStyle = "space" Then Return String.Space(cells)
        Dim indentText As String = ""
        For i As Integer = 1 To cells \ Me.IndentStep()
            indentText += "\t"
        Next
        Return indentText + String.Space(cells Mod Me.IndentStep())
    End Function

    Private Function PolicyIndent(indent As String) As String
        If Me.mIndentStyle = "auto" Then Return indent
        Dim cells As Integer = Me.IndentCells(indent)
        If Me.mIndentStyle = "space" Then Return String.Space(cells)
        Dim indentText As String = ""
        For i As Integer = 1 To cells \ Me.TabSize()
            indentText += "\t"
        Next
        Return indentText + String.Space(cells Mod Me.TabSize())
    End Function

    Private Function IndentCells(indent As String) As Integer
        Return Me.VisualColumn(indent, String.Len(indent))
    End Function

    Private Function Outdented(indent As String) As String
        If String.EndsWith(indent, "\t") Then Return String.Left(indent, String.Len(indent) - 1)
        Dim count As Integer = 0
        While count < Me.IndentStep() And count < String.Len(indent)
            If String.Substring(indent, String.Len(indent) - 1 - count, 1) <> " " Then Exit While
            count += 1
        Wend
        Return String.Left(indent, String.Len(indent) - count)
    End Function

    ''' Indentation of the opener that a middle/closing line belongs to (nesting-aware),
    ''' or, for an unmatched closer, one level out from the previous line's body.
    Private Function OpenerIndent(lineIndex As Integer, info As StudioBlockInfo, fallback As String) As String
        Dim depth As Integer = 0
        Dim previousLead As String = ""
        Dim previousInfo As StudioBlockInfo = Nil
        For i As Integer = lineIndex - 1 To Math.Max(0, lineIndex - 4000) Step -1
            Dim text As String = Me.mLines(i)
            If String.Trim(text) = "" Then Continue For
            Dim other As StudioBlockInfo = StudioClassifyBlock(text, Me.mStates(i))
            If previousInfo = Nil Then
                previousInfo = other
                previousLead = Me.LeadingWhitespace(text)
            End If
            If String.Compare(other.Kind, info.Kind, True) = 0 Then
                If other.Role = StudioBlockRole.Closes Then
                    depth += 1
                ElseIf other.Role = StudioBlockRole.Opens Then
                    If depth = 0 Then Return Me.LeadingWhitespace(text)
                    depth -= 1
                End If
            End If
        Next
        If info.Role = StudioBlockRole.Closes And previousInfo <> Nil Then
            If previousInfo.Role = StudioBlockRole.Opens Then Return previousLead
            Return Me.Outdented(previousLead)
        End If
        Return fallback
    End Function

    ''' Get/Set directly under a Property declaration belong one level inside it.
    Private Function AccessorIndent(lineIndex As Integer, lead As String) As String
        For i As Integer = lineIndex - 1 To 0 Step -1
            Dim text As String = Me.mLines(i)
            If String.Trim(text) = "" Then Continue For
            Dim previousLead As String = Me.LeadingWhitespace(text)
            If StudioClassifyBlock(text, Me.mStates(i)).IsPropertyHeader And Me.IndentCells(previousLead) >= Me.IndentCells(lead) Then Return previousLead + Me.IndentUnit(previousLead)
            Return lead
        Next
        Return lead
    End Function

    ''' Interface members are signatures only: they open no body.
    Private Function InsideInterface(lineIndex As Integer) As Boolean
        For i As Integer = lineIndex - 1 To Math.Max(0, lineIndex - 4000) Step -1
            Dim text As String = Me.mLines(i)
            If String.Trim(text) = "" Then Continue For
            Dim other As StudioBlockInfo = StudioClassifyBlock(text, Me.mStates(i))
            Select Case other.Kind
            Case "interface"
                Return other.Role = StudioBlockRole.Opens
            Case "class", "structure", "enum", "flags enum", "namespace"
                Return False
            End Select
        Next
        Return False
    End Function

    ''' True when the line after an opener already continues its block: an indented body,
    ''' or its own middle/closing line at the opener's indentation.
    Private Function BlockIsClosed(lineIndex As Integer, indent As String, info As StudioBlockInfo) As Boolean
        Dim openerCells As Integer = Me.IndentCells(indent)
        For i As Integer = lineIndex + 1 To Math.Min(Array.LastIndex(Me.mLines), lineIndex + 4000)
            Dim text As String = Me.mLines(i)
            If String.Trim(text) = "" Then Continue For
            Dim cells As Integer = Me.IndentCells(Me.LeadingWhitespace(text))
            If cells > openerCells Then Return True
            If cells < openerCells Then Return False
            Me.EnsureStates(i)
            Dim other As StudioBlockInfo = StudioClassifyBlock(text, Me.mStates(i))
            If String.Compare(other.Kind, info.Kind, True) <> 0 Then Return False
            Return other.Role = StudioBlockRole.Closes Or other.Role = StudioBlockRole.Continues
        Next
        Return False
    End Function

    ''' Tab: indent the selected lines, or insert spaces to the next indent stop.
    ''' Shift+Tab: outdent the selected (or current) lines. `wholeLines` (the
    ''' Indent/Outdent Lines commands, Primary+] / Primary+[) always shifts the lines of
    ''' every selection and caret, never inserting spaces at the caret.
    Public Sub Indent(outdent As Boolean, wholeLines As Boolean = False)
        If Me.IsReadOnly Then Return
        If Me.HasExtras() Then
            If Not outdent And Not wholeLines And Me.AllSelectionsInsideLines() Then
                Me.RunBatch("insertTab", False, Me.NoPieces(), False)
            Else
                Me.IndentLinesMulti(outdent)
            End If
            Return
        End If
        Dim s As Integer = Me.SelectionStart
        Dim e As Integer = s + Me.SelectionLength
        Dim first As Integer = Me.LineOfPosition(s)
        Dim last As Integer = Me.LineOfPosition(e)
        If last > first And e = Me.mStarts(last) Then last -= 1
        If Not outdent And Not wholeLines And first = last Then
            If Me.SelectionLength = 0 Then
                Dim column As Integer = Me.VisualColumn(Me.mLines(first), s - Me.mStarts(first))
                Dim unit As String = Me.IndentUnit(Me.LeadingWhitespace(Me.mLines(first)))
                If unit <> "\t" Then unit = String.Space(Me.IndentStep() - (column Mod Me.IndentStep()))
                Me.EditRange(s, 0, unit, -1, -1, "indent")
                Return
            End If
            ' A selection inside one line is replaced like typing.
            If Me.SelectionLength < String.Len(Me.mLines(first)) Then
                Me.EditRange(s, Me.SelectionLength, Me.IndentUnit(Me.LeadingWhitespace(Me.mLines(first))), -1, -1, "indent")
                Return
            End If
        End If
        Dim pieces As Array Of String = []
        Dim firstDelta As Integer = 0
        Dim totalDelta As Integer = 0
        For i As Integer = first To last
            Dim line As String = Me.mLines(i)
            Dim delta As Integer = 0
            If outdent Then
                Dim remove As Integer = 0
                While remove < Me.IndentStep() And remove < String.Len(line)
                    Dim ch As String = String.Substring(line, remove, 1)
                    If ch = "\t" Then
                        remove += 1
                        Exit While
                    End If
                    If ch <> " " Then Exit While
                    remove += 1
                End While
                line = String.Substring(line, remove)
                delta = -remove
            ElseIf line <> "" Or Me.SelectionLength = 0 Then
                Dim unit As String = Me.IndentUnit(Me.LeadingWhitespace(line))
                line = unit + line
                delta = String.Len(unit)
            End If
            If i = first Then firstDelta = delta
            totalDelta += delta
            Array.Append(pieces, line)
        Next
        If totalDelta = 0 Then Return
        Dim blockStart As Integer = Me.mStarts(first)
        Dim blockLength As Integer = Me.mStarts(last) + String.Len(Me.mLines(last)) - blockStart
        Dim newStart As Integer = Math.Max(blockStart, s + firstDelta)
        Dim newEnd As Integer = Math.Max(newStart, e + totalDelta)
        If Me.mAnchor <= Me.mCaret Then
            Me.EditRange(blockStart, blockLength, String.Join(pieces, "\n"), newStart, newEnd, "indent")
        Else
            Me.EditRange(blockStart, blockLength, String.Join(pieces, "\n"), newEnd, newStart, "indent")
        End If
    End Sub

    Private Sub DeleteBackwardSmart()
        If Me.DeletePair() Then Return
        If Me.SelectionLength > 0 Then
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "delete")
            Return
        End If
        If Me.mCaret = 0 Then Return
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim column As Integer = Me.mCaret - Me.mStarts(lineIndex)
        Dim line As String = Me.mLines(lineIndex)
        If column > 0 And String.Trim(String.Left(line, column)) = "" Then
            ' Delete whole whitespace characters back to a logical indent stop. Never
            ' split a tab; its display width may differ from the logical indent step.
            Dim cells As Integer = Me.VisualColumn(line, column)
            Dim targetCell As Integer = ((cells - 1) \ Me.IndentStep()) * Me.IndentStep()
            Dim targetColumn As Integer = column - 1
            While targetColumn > 0 And Me.VisualColumn(line, targetColumn) > targetCell
                targetColumn -= 1
            Wend
            Dim remove As Integer = column - targetColumn
            Me.EditRange(Me.mCaret - remove, remove, "", -1, -1, "delete")
            Return
        End If
        Dim target As Integer = Me.StepPosition(Me.mCaret, False)
        Me.EditRange(target, Me.mCaret - target, "", -1, -1, "delete")
    End Sub

    Private Function WordBoundary(position As Integer, forward As Boolean) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim line As String = Me.mLines(lineIndex)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim codes As Array Of String = String.Chars(line)
        If forward Then
            If column >= Array.Count(codes) Then Return Me.Clamp(position + 1)
            While column < Array.Count(codes)
                If EditorIsWordCode(String.Asc(codes(column))) Then Exit While
                column += 1
            End While
            While column < Array.Count(codes)
                If Not EditorIsWordCode(String.Asc(codes(column))) Then Exit While
                column += 1
            End While
        Else
            If column = 0 Then Return Me.Clamp(position - 1)
            While column > 0
                If EditorIsWordCode(String.Asc(codes(column - 1))) Then Exit While
                column -= 1
            End While
            While column > 0
                If Not EditorIsWordCode(String.Asc(codes(column - 1))) Then Exit While
                column -= 1
            End While
        End If
        Return Me.mStarts(lineIndex) + column
    End Function

    Private Sub SelectWordAt(position As Integer)
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim startColumn As Integer = column
        Dim endColumn As Integer = column
        While startColumn > 0
            If Not EditorIsWordCode(String.Asc(codes(startColumn - 1))) Then Exit While
            startColumn -= 1
        End While
        While endColumn < Array.Count(codes)
            If Not EditorIsWordCode(String.Asc(codes(endColumn))) Then Exit While
            endColumn += 1
        End While
        If startColumn = endColumn And endColumn < Array.Count(codes) Then endColumn += 1
        Me.mAnchor = Me.mStarts(lineIndex) + startColumn
        Me.mCaret = Me.mStarts(lineIndex) + endColumn
    End Sub

    Private Sub SelectLineAt(position As Integer)
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Me.mAnchor = Me.mStarts(lineIndex)
        ' A collapsed fold's header selects its hidden body too.
        Dim lastLine As Integer = Me.RowEndLine(lineIndex)
        If lastLine < Array.LastIndex(Me.mLines) Then
            Me.mCaret = Me.mStarts(lastLine + 1)
        Else
            Me.mCaret = Me.TotalLength()
        End If
    End Sub

    Private Function VisibleLineCount() As Integer
        Dim count As Integer = Math.Floor((Me.ViewHeight() - Me.ScrollbarSize()) / Me.LineHeight)
        Return Math.Max(1, count)
    End Function

    Private Sub MoveVertical(lines As Integer, extend As Boolean)
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        If Not extend And Me.SelectionLength > 0 Then
            If lines < 0 Then
                lineIndex = Me.LineOfPosition(Me.SelectionStart)
            Else
                lineIndex = Me.LineOfPosition(Me.SelectionStart + Me.SelectionLength)
            End If
        End If
        If Me.mWordWrap Then
            Me.MoveVerticalWrapped(lines, extend)
            Return
        End If
        If Me.mPreferredColumn < 0 Then Me.mPreferredColumn = Me.VisualColumn(Me.mLines(lineIndex), Me.mCaret - Me.mStarts(lineIndex))
        ' Rows, not lines: collapsed fold bodies are stepped over.
        Dim targetRow As Integer = Me.RowOfLine(lineIndex) + lines
        Dim keep As Integer = Me.mPreferredColumn
        If targetRow < 0 Then
            Me.MoveCaretTo(0, extend)
        ElseIf targetRow >= Me.RowCount() Then
            ' Document end, or the end of a collapsed fold's header that hides it.
            Dim lastShown As Integer = Me.LineOfRow(Me.RowCount() - 1)
            If Me.IsLineHidden(Array.LastIndex(Me.mLines)) Then
                Me.MoveCaretTo(Me.mStarts(lastShown) + String.Len(Me.mLines(lastShown)), extend)
            Else
                Me.MoveCaretTo(Me.TotalLength(), extend)
            End If
        Else
            Dim target As Integer = Me.LineOfRow(targetRow)
            Me.MoveCaretTo(Me.mStarts(target) + Me.ColumnForVisual(Me.mLines(target), keep), extend)
        End If
        Me.mPreferredColumn = keep
    End Sub

    ''' MoveVertical while soft wrapping: by visual rows, keeping the row-relative cell
    ''' (continuation indent included) as the preferred column.
    Private Sub MoveVerticalWrapped(lines As Integer, extend As Boolean)
        Dim origin As Integer = Me.mCaret
        If Not extend And Me.SelectionLength > 0 Then
            If lines < 0 Then
                origin = Me.SelectionStart
            Else
                origin = Me.SelectionStart + Me.SelectionLength
            End If
        End If
        Dim originLine As Integer = Me.LineOfPosition(origin)
        If Me.mPreferredColumn < 0 Then
            Dim segment As Integer = 0
            Me.mPreferredColumn = Me.RowCellOf(originLine, origin - Me.mStarts(originLine), segment)
        End If
        Dim keep As Integer = Me.mPreferredColumn
        Dim targetRow As Integer = Me.RowOfPosition(origin) + lines
        If targetRow < 0 Then
            Me.MoveCaretTo(0, extend)
        ElseIf targetRow >= Me.RowCount() Then
            Dim lastShown As Integer = Me.LineOfRow(Me.RowCount() - 1)
            If Me.IsLineHidden(Array.LastIndex(Me.mLines)) Then
                Me.MoveCaretTo(Me.mStarts(lastShown) + String.Len(Me.mLines(lastShown)), extend)
            Else
                Me.MoveCaretTo(Me.TotalLength(), extend)
            End If
        Else
            Dim segment As Integer = 0
            Dim target As Integer = Me.LineAndSegmentOfRow(targetRow, segment)
            Me.MoveCaretTo(Me.mStarts(target) + Me.ColumnInRow(target, segment, keep), extend)
        End If
        Me.mPreferredColumn = keep
    End Sub

    Private Sub MoveHome(extend As Boolean)
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim indent As Integer = String.Len(Me.LeadingWhitespace(Me.mLines(lineIndex)))
        Dim target As Integer = Me.mStarts(lineIndex) + indent
        If Me.mCaret = target Then target = Me.mStarts(lineIndex)
        Me.MoveCaretTo(target, extend)
    End Sub

    Private Sub MoveEnd(extend As Boolean)
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Me.MoveCaretTo(Me.mStarts(lineIndex) + String.Len(Me.mLines(lineIndex)), extend)
    End Sub

    Private Sub CopySelection(cut As Boolean)
        If Me.SelectionLength = 0 Then Return
        Dim copied As String = Me.SelectedText
        Dim clip As New Clipboard()
        clip.Text = copied
        clip.Close()
        RaiseEvent ClipboardCopied(copied)
        If cut Then Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "cut")
    End Sub

    Private Sub PasteClipboard()
        Dim clip As New Clipboard()
        If clip.HasText Then
            Dim value As String = clip.Text
            clip.Close()
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, value, -1, -1, "paste")
        Else
            clip.Close()
        End If
    End Sub

    ' ---- Navigation commands -----------------------------------------------------------
    ' Helpers for the TextInputCanvas command vocabulary (documented in
    ' containers/integrations/textinput/README.md) and the per-OS key binding tables.

    ''' Text removed by deleteToLineStart / deleteToLineEnd (the AppKit/Emacs kill
    ''' commands), shared by every editor; `yank` inserts it. Consecutive kills at the same
    ''' place accumulate, as in NSTextView.
    Public Shared Property KillBuffer As String = ""
    ''' Upper bound on selections made by Select All Occurrences / Add Next Occurrence.
    Public Shared Property MaxSelections As Integer = 10000
    Private Property mKillEnd As Integer = -1

    ''' Position just before the line break of a 0-based line.
    Private Function NavLineEnd(lineIndex As Integer) As Integer
        Return Me.mStarts(lineIndex) + String.Len(Me.mLines(lineIndex))
    End Function

    ''' Start of the next word (Windows Ctrl+Right): past the word or punctuation run at
    ''' the position, then past spaces and tabs. At a line end, the next line's start.
    Private Function NextWordStart(position As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = position - Me.mStarts(lineIndex)
        If column >= Array.Count(codes) Then Return Me.Clamp(position + 1)
        Dim code As Integer = String.Asc(codes(column))
        If EditorIsWordCode(code) Then
            While column < Array.Count(codes)
                If Not EditorIsWordCode(String.Asc(codes(column))) Then Exit While
                column += 1
            End While
        ElseIf code <> 32 And code <> 9 Then
            While column < Array.Count(codes)
                code = String.Asc(codes(column))
                If EditorIsWordCode(code) Or code = 32 Or code = 9 Then Exit While
                column += 1
            End While
        End If
        While column < Array.Count(codes)
            code = String.Asc(codes(column))
            If code <> 32 And code <> 9 Then Exit While
            column += 1
        End While
        Return Me.mStarts(lineIndex) + column
    End Function

    ''' Start of the previous word (Windows Ctrl+Left): back over spaces and tabs, then
    ''' over one word or punctuation run. At a line start, the previous line's end.
    Private Function PreviousWordStart(position As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = position - Me.mStarts(lineIndex)
        If column <= 0 Then Return Me.Clamp(position - 1)
        Dim code As Integer = 0
        While column > 0
            code = String.Asc(codes(column - 1))
            If code <> 32 And code <> 9 Then Exit While
            column -= 1
        End While
        If column > 0 Then
            Dim word As Boolean = EditorIsWordCode(String.Asc(codes(column - 1)))
            While column > 0
                code = String.Asc(codes(column - 1))
                If code = 32 Or code = 9 Or EditorIsWordCode(code) <> word Then Exit While
                column -= 1
            End While
        End If
        Return Me.mStarts(lineIndex) + column
    End Function

    ''' Backward word stop: Windows stops at punctuation runs too; AppKit and GTK skip them.
    Private Function WordBackwardTarget(position As Integer) As Integer
        #If TargetWindows Then
            Return Me.PreviousWordStart(position)
        #Else
            Return Me.WordBoundary(position, False)
        #End If
    End Function

    ''' Forward word stop: the next word's start on Windows, the end of the word on
    ''' macOS (NSTextView) and Linux (GtkTextView).
    Private Function WordForwardTarget(position As Integer) As Integer
        #If TargetWindows Then
            Return Me.NextWordStart(position)
        #Else
            Return Me.WordBoundary(position, True)
        #End If
    End Function

    ''' moveWordLeft / moveWordRight. Without extend, AppKit starts from the selection
    ''' edge in the direction of travel; Windows and GTK start from the caret.
    Private Sub MoveWord(forward As Boolean, extend As Boolean)
        Dim origin As Integer = Me.mCaret
        #If TargetMac Then
            If Not extend And Me.SelectionLength > 0 Then
                origin = Me.SelectionStart
                If forward Then origin = Me.SelectionStart + Me.SelectionLength
            End If
        #End If
        Me.mPreferredColumn = -1
        If forward Then
            Me.MoveCaretTo(Me.WordForwardTarget(origin), extend)
        Else
            Me.MoveCaretTo(Me.WordBackwardTarget(origin), extend)
        End If
    End Sub

    ''' Paragraph (= logical line) motion: to this line's start/end, or, when already
    ''' there, to the previous line's start / next line's end (GtkTextView Ctrl+Up/Down,
    ''' AppKit moveParagraphBackward:/moveParagraphForward:).
    Private Sub MoveParagraph(forward As Boolean, extend As Boolean)
        If Not extend Then Me.mAnchor = Me.mCaret
        Me.mPreferredColumn = -1
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        If forward Then
            If Me.mCaret < Me.NavLineEnd(lineIndex) Or lineIndex >= Array.LastIndex(Me.mLines) Then
                Me.MoveCaretTo(Me.NavLineEnd(lineIndex), extend)
            Else
                Me.MoveVertical(1, extend)
                Me.MoveCaretTo(Me.NavLineEnd(Me.LineOfPosition(Me.mCaret)), extend)
            End If
        ElseIf Me.mCaret > Me.mStarts(lineIndex) Or lineIndex = 0 Then
            Me.MoveCaretTo(Me.mStarts(lineIndex), extend)
        Else
            Me.MoveVertical(-1, extend)
            Me.MoveCaretTo(Me.mStarts(Me.LineOfPosition(Me.mCaret)), extend)
        End If
        Me.mPreferredColumn = -1
    End Sub

    ''' pageUp / pageDown: scroll one view and move the caret the same number of lines.
    Private Sub MovePage(down As Boolean, extend As Boolean)
        Dim count As Integer = Me.VisibleLineCount()
        If Not down Then count = -count
        If Not Me.mBatch Or Me.mBatchIndex = 0 Then Me.ScrollLines(count)
        Me.MoveVertical(count, extend)
    End Sub

    ''' View-only scrolling by whole lines; the caret and selection stay put.
    Private Sub ScrollLines(count As Integer)
        Me.SetScroll(Me.mScrollX, Me.mScrollY + count * Me.LineHeight)
    End Sub

    ''' Scroll so the caret line is vertically centred (AppKit centerSelectionInVisibleArea:).
    Private Sub CenterSelectionInView()
        Dim x As Double = 0.0
        Dim y As Double = 0.0
        Me.CaretPoint(Me.mCaret, x, y)
        Dim visible As Double = Me.ViewHeight() - Me.ScrollbarSize()
        Me.SetScroll(Me.mScrollX, Me.mScrollY + y - Me.TopPadding() - (visible - Me.LineHeight) / 2.0)
    End Sub

    Private Sub DeleteWordForward()
        If Me.SelectionLength > 0 Then
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "delete")
        ElseIf Me.mCaret < Me.TotalLength() Then
            Dim target As Integer = Me.WordForwardTarget(Me.mCaret)
            Me.EditRange(Me.mCaret, target - Me.mCaret, "", -1, -1, "delete")
        End If
    End Sub

    ''' Delete a range into KillBuffer (appending/prepending when it continues the
    ''' previous kill at the caret).
    Private Sub KillRange(start As Integer, length As Integer, backward As Boolean)
        If length <= 0 Or Me.IsReadOnly Then Return
        Dim removed As String = Me.Slice(start, length)
        If Me.mBatch Then
            ' Multi-cursor kill: RunBatch joins the pieces into KillBuffer.
            Array.Append(Me.mBatchKills, removed)
            Me.EditRange(start, length, "", -1, -1, "delete")
            Return
        End If
        Dim continues As Boolean = Me.mKillEnd = Me.mCaret And String.Compare(Me.mEditKind, "delete", True) = 0
        If Not continues Then
            StudioCodeEditor.KillBuffer = removed
        ElseIf backward Then
            StudioCodeEditor.KillBuffer = removed + StudioCodeEditor.KillBuffer
        Else
            StudioCodeEditor.KillBuffer = StudioCodeEditor.KillBuffer + removed
        End If
        Me.EditRange(start, length, "", -1, -1, "delete")
        Me.mKillEnd = Me.mCaret
    End Sub

    ''' deleteToLineStart / deleteToLineEnd: kill the selection, else to the line
    ''' boundary; at the boundary itself, the line break (joining lines).
    Private Sub KillToLineBoundary(forward As Boolean)
        If Me.SelectionLength > 0 Then
            Me.KillRange(Me.SelectionStart, Me.SelectionLength, Not forward)
            Return
        End If
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        If forward Then
            Dim finish As Integer = Me.NavLineEnd(lineIndex)
            If finish = Me.mCaret Then finish = Me.Clamp(Me.mCaret + 1)
            Me.KillRange(Me.mCaret, finish - Me.mCaret, False)
        Else
            Dim start As Integer = Me.mStarts(lineIndex)
            If start = Me.mCaret Then start = Me.Clamp(Me.mCaret - 1)
            Me.KillRange(start, Me.mCaret - start, True)
        End If
    End Sub

    ''' Swap the characters around the caret, or the last two of the line at its end, and
    ''' leave the caret after them (AppKit transpose:, Emacs Ctrl+T).
    Private Sub TransposeCharacters()
        If Me.SelectionLength > 0 Or Me.IsReadOnly Then Return
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim start As Integer = Me.mStarts(lineIndex)
        Dim finish As Integer = Me.NavLineEnd(lineIndex)
        Dim middle As Integer = Me.mCaret
        If middle = finish Then middle = Me.StepPosition(middle, False)
        If middle <= start Or middle >= finish Then Return
        Dim first As Integer = Me.StepPosition(middle, False)
        Dim last As Integer = Me.StepPosition(middle, True)
        Dim swapped As String = Me.Slice(middle, last - middle) + Me.Slice(first, middle - first)
        Me.EditRange(first, last - first, swapped, -1, last, "edit")
    End Sub

    ''' GTK key binding for keys the Canvas KeyDown event cannot see: Tab/Shift+Tab (GTK
    ''' reports Shift+Tab as ISO_Left_Tab with no character) and the GtkTextView
    ''' Insert-key clipboard bindings (Insert has no KeyName). "" = leave the key native.
    ''' `state` is a GdkModifierType: Shift 1, Control 4, Alt 8.
    Public Shared Function GtkKeyCommand(keyval As Integer, state As Integer) As String
        If (state And 8) <> 0 Then Return ""
        Dim shift As Boolean = (state And 1) <> 0
        Dim control As Boolean = (state And 4) <> 0
        Select Case keyval
        Case 65289, 65056 ' GDK_KEY_Tab, GDK_KEY_ISO_Left_Tab; Ctrl+Tab moves focus
            If control Then Return ""
            If keyval = 65056 Or shift Then Return "insertBacktab"
            Return "insertTab"
        Case 65379, 65438 ' GDK_KEY_Insert, GDK_KEY_KP_Insert
            If control And Not shift Then Return "copy"
            If shift And Not control Then Return "paste"
        End Select
        Return ""
    End Function

    ''' Key binding table for keys that reach the Canvas KeyDown event: every key on
    ''' Linux (GtkTextView/GNOME conventions plus the editor's shortcuts); Ctrl shortcuts
    ''' and non-character keys on Windows (the IMM adapter binds navigation first); on
    ''' macOS only Command+A/C/X/V/Z/Y while the AppKit adapter is attached (it delivers
    ''' every other key as a selector), so the macOS table is the no-adapter fallback.
    ''' "" = no command. Shift is passed to the command as extendSelection.
    Private Function KeyCommand(e As KeyEvent) As String
        Dim primary As Boolean = e.Modifiers.Primary
        Dim shift As Boolean = e.Modifiers.Shift
        Dim letter As String = ""
        If e.Character > 0 Then
            Dim code As Integer = e.Character
            ' Some backends report Ctrl+letter as its control character (Ctrl+A = 1).
            If code <= 26 And e.Modifiers.Control Then code += 96
            letter = String.LCase(String.Chr(code))
        End If
        If primary And letter <> "" Then
            Select Case letter
            Case "a"
                #If TargetLinux Then
                    If shift Then Return "selectNone"
                #End If
                Return "selectAll"
            Case "c"
                Return "copy"
            Case "x"
                Return "cut"
            Case "v"
                Return "paste"
            Case "z"
                If shift Then Return "redo"
                Return "undo"
            Case "y"
                Return "redo"
            Case "/"
                Return "toggleComment"
            Case "]"
                Return "indent"
            Case "["
                Return "outdent"
            Case "d"
                If Not shift Then Return "addNextOccurrence"
            Case "k"
                Return "chordPrefix"
            Case "l"
                If shift Then Return "selectAllOccurrences"
            Case "g"
                If shift Then Return "findPrevious"
                Return "findNext"
            Case "e"
                Return "useSelectionForFind"
            Case "\\"
                #If TargetLinux Then
                    Return "selectNone"
                #End If
            End Select
        End If
        #If TargetMac Then
            Dim command As Boolean = e.Modifiers.Command
            Dim alternate As Boolean = e.Modifiers.Option
            Dim control As Boolean = e.Modifiers.Control
            If control And Not command And letter <> "" Then
                ' Emacs bindings from AppKit's StandardKeyBinding.dict.
                Select Case letter
                Case "a"
                    Return "moveLineStart"
                Case "e"
                    Return "moveLineEnd"
                Case "b"
                    Return "moveLeft"
                Case "f"
                    Return "moveRight"
                Case "p"
                    Return "moveUp"
                Case "n"
                    Return "moveDown"
                Case "d"
                    Return "deleteForward"
                Case "h"
                    Return "deleteBackward"
                Case "k"
                    Return "deleteToLineEnd"
                Case "t"
                    Return "transpose"
                Case "o"
                    Return "openLine"
                Case "l"
                    Return "centerSelection"
                Case "y"
                    Return "yank"
                Case "v"
                    Return "pageDown"
                End Select
            End If
            Select Case e.Key
            Case KeyName.Left
                If command And alternate And shift Then Return "columnSelectLeft"
                If command Or control Then Return "moveHome"
                If alternate Then Return "moveWordLeft"
                Return "moveLeft"
            Case KeyName.Right
                If command And alternate And shift Then Return "columnSelectRight"
                If command Or control Then Return "moveEnd"
                If alternate Then Return "moveWordRight"
                Return "moveRight"
            Case KeyName.Up
                If command And alternate Then
                    If shift Then Return "columnSelectUp"
                    Return "addCursorAbove"
                End If
                If command Then Return "moveDocumentStart"
                If alternate And shift Then Return "copyLinesUp"
                If alternate Then Return "moveParagraphBackward"
                Return "moveUp"
            Case KeyName.Down
                If command And alternate Then
                    If shift Then Return "columnSelectDown"
                    Return "addCursorBelow"
                End If
                If command Then Return "moveDocumentEnd"
                If alternate And shift Then Return "copyLinesDown"
                If alternate Then Return "moveParagraphForward"
                Return "moveDown"
            Case KeyName.I
                If alternate And shift And Not command Then Return "cursorsAtLineEnds"
            Case KeyName.Escape
                If Me.HasExtras() Then Return "collapseSelections"
            Case KeyName.Home
                If shift Then Return "moveDocumentStart"
                Return "scrollDocumentStart"
            Case KeyName.EndKey
                If shift Then Return "moveDocumentEnd"
                Return "scrollDocumentEnd"
            Case KeyName.PageUp
                If shift Or alternate Then Return "pageUp"
                Return "scrollPageUp"
            Case KeyName.PageDown
                If shift Or alternate Then Return "pageDown"
                Return "scrollPageDown"
            Case KeyName.Backspace
                If command Then Return "deleteToLineStart"
                If alternate Then Return "deleteWordBackward"
                Return "deleteBackward"
            Case KeyName.Delete
                If command Then Return "deleteToLineEnd"
                If alternate Then Return "deleteWordForward"
                Return "deleteForward"
            End Select
        #Else
            Dim control As Boolean = e.Modifiers.Control
            Dim alternate As Boolean = e.Modifiers.Option And Not control
            ' VS Code multi-cursor chords. Windows: Ctrl+Alt+Up/Down add a cursor,
            ' Ctrl+Shift+Alt+arrows column-select, Shift+Alt+Up/Down copy lines.
            ' Linux follows VS Code's Linux defaults instead, leaving Ctrl+Alt+Up/Down to
            ' the desktop (GNOME and others switch workspaces with it): Shift+Alt+Up/Down
            ' and Ctrl+Shift+Up/Down add a cursor, Ctrl+Shift+Alt+Up/Down copy lines,
            ' Ctrl+Shift+Alt+Left/Right column-select. Shift+Alt+I: cursors at line ends.
            Dim controlAlt As Boolean = control And e.Modifiers.Option
            Select Case e.Key
            Case KeyName.Left
                If controlAlt And shift Then Return "columnSelectLeft"
                If control Then Return "moveWordLeft"
                Return "moveLeft"
            Case KeyName.Right
                If controlAlt And shift Then Return "columnSelectRight"
                If control Then Return "moveWordRight"
                Return "moveRight"
            Case KeyName.Up
                #If TargetLinux Then
                    If controlAlt And shift Then Return "copyLinesUp"
                    If controlAlt Then Return ""
                    If alternate And shift Then Return "addCursorAbove"
                    If control And shift Then Return "addCursorAbove"
                #Else
                    If controlAlt And shift Then Return "columnSelectUp"
                    If controlAlt Then Return "addCursorAbove"
                    If alternate And shift Then Return "copyLinesUp"
                #End If
                If alternate Then Return "moveLinesUp"
                If control Then
                    #If TargetWindows Then
                        Return "scrollLineUp"
                    #Else
                        Return "moveParagraphBackward"
                    #End If
                End If
                Return "moveUp"
            Case KeyName.Down
                #If TargetLinux Then
                    If controlAlt And shift Then Return "copyLinesDown"
                    If controlAlt Then Return ""
                    If alternate And shift Then Return "addCursorBelow"
                    If control And shift Then Return "addCursorBelow"
                #Else
                    If controlAlt And shift Then Return "columnSelectDown"
                    If controlAlt Then Return "addCursorBelow"
                    If alternate And shift Then Return "copyLinesDown"
                #End If
                If alternate Then Return "moveLinesDown"
                If control Then
                    #If TargetWindows Then
                        Return "scrollLineDown"
                    #Else
                        Return "moveParagraphForward"
                    #End If
                End If
                Return "moveDown"
            Case KeyName.Home
                If control Then Return "moveDocumentStart"
                Return "moveHome"
            Case KeyName.EndKey
                If control Then Return "moveDocumentEnd"
                Return "moveEnd"
            Case KeyName.PageUp
                If Not control Then Return "pageUp"
            Case KeyName.PageDown
                If Not control Then Return "pageDown"
            Case KeyName.Backspace
                #If TargetLinux Then
                    If control And shift Then Return "deleteToLineStart"
                #End If
                If control Then Return "deleteWordBackward"
                Return "deleteBackward"
            Case KeyName.Delete
                If shift And Not control Then Return "cut"
                #If TargetLinux Then
                    If control And shift Then Return "deleteToLineEnd"
                #End If
                If control Then Return "deleteWordForward"
                Return "deleteForward"
            Case KeyName.F3
                If shift Then Return "findPrevious"
                Return "findNext"
            Case KeyName.I
                If alternate And shift Then Return "cursorsAtLineEnds"
            Case KeyName.Escape
                If Me.HasExtras() Then Return "collapseSelections"
            End Select
        #End If
        Return ""
    End Function

    ' ---- TextInputCanvas contract ------------------------------------------------------

    Handle IsEditable() As Boolean
        Return Not Me.IsReadOnly
    End Handle

    Handle InsertText(text As String, range As TextRange)
        If Me.IsReadOnly Then Return
        If text = "\n" And range = Nil And Me.AcceptCompletion() Then Return
        ' IME "primary" policy: a composed commit goes to the primary caret only.
        If Me.HasExtras() And Me.ImeMultiCaretPolicy = "primary" And (String.Len(Me.mIncomplete) > 0 Or Me.mCompositionStart >= 0) Then Me.ClearExtras()
        Me.CommitInsertText(text, range)
        Me.AfterCommit(text)
    End Handle

    ''' The InsertText contract: typing at every cursor, IME replacement ranges at the
    ''' primary one (see ImeMultiCaretPolicy).
    Private Sub CommitInsertText(text As String, range As TextRange)
        Me.mChordPending = False
        If Me.HasExtras() And (Me.mCompositionStart < 0 Or Me.mCompositionLength = 0) Then
            ' A commit (also of a composition, e.g. a dead key) types at every cursor.
            Dim plain As Boolean = range = Nil
            ' An explicit replacement is primary-only. The exception is a native
            ' composition's empty marked range at the unchanged primary caret.
            If Not plain Then plain = Me.mCompositionStart >= 0 And Me.mCompositionLength = 0 And range.Location = Me.SelectionStart And range.Length = 0 And Me.SelectionLength = 0
            If plain Then
                ' Typing at every cursor; Return is the smart newline at each.
                If text = "\n" Then
                    Me.RunBatch("insertNewline", False, Me.NoPieces(), False)
                Else
                    Me.RunBatch("@typeText", False, [text], True)
                End If
                Return
            End If
        End If
        ' Input-method edits with their own range work on the primary cursor only.
        If range <> Nil Or Me.mCompositionStart >= 0 Then Me.ClearExtras()
        If range <> Nil Then
            Me.EditRange(range.Location, range.Length, text, -1, -1, "typing")
        ElseIf Me.mCompositionStart >= 0 Then
            Me.EditRange(Me.mCompositionStart, Me.mCompositionLength, text, -1, -1, "typing")
        Else
            Me.TypeText(text)
        End If
    End Sub

    Handle SetIncompleteText(text As String, replacementRange As TextRange, relativeSelection As TextRange)
        Me.DismissInlineCompletion()
        If Me.IsReadOnly Then Return
        ' A composition that replaces document text (reconversion) works on the primary
        ' cursor only; ordinary pre-edit text is shown there and committed at every cursor.
        If Me.HasExtras() And replacementRange <> Nil Then
            If replacementRange.Length > 0 Then
                Me.ClearExtras()
                Me.FinishInteraction()
            End If
        End If
        If replacementRange <> Nil Then
            Me.mCompositionStart = Me.Clamp(replacementRange.Location)
            Me.mCompositionLength = Math.Min(Math.Max(0, replacementRange.Length), Me.TotalLength() - Me.mCompositionStart)
        End If
        Me.mIncomplete = text
        Dim cursor As Integer = 0
        If relativeSelection <> Nil Then cursor = relativeSelection.Location
        Me.mIncompleteCursor = Math.Max(0, Math.Min(cursor, String.Len(text)))
        Me.Invalidate()
    End Handle

    Handle DiscardIncompleteText()
        Me.ClearComposition()
        Me.Invalidate()
    End Handle

    Handle SelectedRange() As TextRange
        Return New TextRange(Me.SelectionStart, Me.SelectionLength)
    End Handle

    Handle CaretIndex() As Integer
        Return Me.mCaret
    End Handle

    Handle TextLength() As Integer
        Return Me.TotalLength()
    End Handle

    Handle TextForRange(range As TextRange) As String
        Dim start As Integer = Me.Clamp(range.Location)
        Return Me.Slice(start, Math.Min(Math.Max(0, range.Length), Me.TotalLength() - start))
    End Handle

    Handle RectForRange(range As TextRange) As TextInputRect
        Dim rect As New TextInputRect()
        Dim x As Double = 0.0
        Dim y As Double = 0.0
        If range <> Nil Then
            Me.CaretPoint(Me.Clamp(range.Location), x, y)
        Else
            Me.CaretPoint(Me.mCaret, x, y)
        End If
        If String.Len(Me.mIncomplete) > 0 Then
            x = Me.mCaretX
            y = Me.mCaretY
        End If
        rect.X = Math.Round(x)
        rect.Y = Math.Round(y)
        rect.Height = Me.LineHeight
        Return rect
    End Handle

    Handle CharacterAtPoint(x As Double, y As Double) As Integer
        Return Me.PositionAt(x, y)
    End Handle

    Handle SelectionRequested(position As Integer, extendSelection As Boolean)
        Me.MoveCaretTo(position, extendSelection)
    End Handle

    Handle GotFocus()
        Me.mFocused = True
        Me.mHadFocus = True
        Me.mBlinkIdle = False
        Me.Invalidate()
    End Handle

    Handle LostFocus()
        Me.DismissInlineCompletion()
        Me.CloseCompletionPopup()
        Me.ShowCompletionHint("")
        Me.mChordPending = False
        Me.mFocused = False
        ' A drag whose mouse-up went elsewhere (alert, app switch) ends here.
        Select Case Me.mDragMode
        Case 1, 5, 6, 7, 8
            Me.mDragMode = 0
            Me.mDropPosition = -1
        End Select
        Me.StopEdgeScroll()
        Me.Invalidate()
    End Handle

    Handle DoCommand(command As String, extendSelection As Boolean) As Boolean
        If Not extendSelection And Me.InlineCompletionCommand(command) Then Return True
        If Not extendSelection And Me.CompletionCommand(command) Then
            Me.Invalidate()
            Return True
        End If
        Me.RecordMacroCommand(command, extendSelection)
        Return Me.RunCommand(command, extendSelection)
    End Handle

    ''' The editor's command dispatcher: multi-cursor commands, then (with several
    ''' selections) per-cursor routing, else the single-selection command.
    Private Function RunCommand(command As String, extendSelection As Boolean) As Boolean
        ' Primary+K starts a chord: Primary+K Primary+D skips to the next occurrence.
        Dim chord As Boolean = Me.mChordPending
        Me.mChordPending = False
        If Me.RunEditorFeatureCommand(command, extendSelection) Then
            Me.mKillEnd = -1
            Me.FinishInteraction()
            Return True
        End If
        Dim killing As Boolean = False
        Select Case command
        Case "chordPrefix"
            Me.mChordPending = True
            Return True
        Case "addNextOccurrence"
            Me.AddNextOccurrence(chord)
        Case "skipOccurrence"
            Me.AddNextOccurrence(True)
        Case "selectAllOccurrences"
            Me.SelectAllOccurrences()
        Case "addCursorAbove"
            Me.AddCursorVertical(False)
        Case "addCursorBelow"
            Me.AddCursorVertical(True)
        Case "columnSelectUp"
            Me.ColumnSelect("up")
        Case "columnSelectDown"
            Me.ColumnSelect("down")
        Case "columnSelectLeft"
            Me.ColumnSelect("left")
        Case "columnSelectRight"
            Me.ColumnSelect("right")
        Case "collapseSelections"
            If Not Me.HasExtras() Then Return False
            Me.ClearExtras()
        Case "undoCursor"
            Me.UndoCursorOperation()
        Case "cursorsAtLineEnds"
            ' Nothing to split: leave the key alone (Option+Shift+I types a character).
            If Not Me.CursorsAtLineEnds() Then Return False
        Case "copyLinesDown", "duplicateLines"
            If Me.IsReadOnly Then Return True
            Me.CopyLines(True)
        Case "copyLinesUp"
            If Me.IsReadOnly Then Return True
            Me.CopyLines(False)
        Case Else
            Dim done As Boolean = False
            If Me.HasExtras() Then
                done = True
                Select Case command
                Case "moveLeft", "moveRight", "moveUp", "moveDown", "moveWordLeft", "moveWordRight", "moveParagraphBackward", "moveParagraphForward", "pageUp", "pageDown", "moveHome", "moveEnd", "moveLineEnd", "moveLineStart", "moveDocumentStart", "moveDocumentEnd", "selectLine", "selectWord", "transpose"
                    Me.RunBatch(command, extendSelection, Me.NoPieces(), False)
                Case "deleteBackward", "deleteForward", "deleteWordBackward", "deleteWordForward", "insertNewline", "insertLineBreak", "openLine"
                    If Me.IsReadOnly Then Return True
                    Me.RunBatch(command, extendSelection, Me.NoPieces(), False)
                Case "deleteToLineStart", "deleteToLineEnd"
                    If Me.IsReadOnly Then Return True
                    Me.RunBatch(command, extendSelection, Me.NoPieces(), False)
                Case "copy"
                    Me.CopySelections(False)
                Case "cut"
                    If Me.IsReadOnly Then Return True
                    Me.CopySelections(True)
                Case "paste"
                    If Me.IsReadOnly Then Return True
                    Dim clip As New Clipboard()
                    Dim value As String = ""
                    Dim has As Boolean = clip.HasText
                    If has Then value = clip.Text
                    clip.Close()
                    If has Then Me.PasteMulti(value, "@paste")
                Case "yank"
                    If Me.IsReadOnly Or StudioCodeEditor.KillBuffer = "" Then Return True
                    Me.PasteMulti(StudioCodeEditor.KillBuffer, "@paste")
                Case "selectAll"
                    Me.ClearExtras()
                    done = False
                Case Else
                    done = False
                End Select
            End If
            If Not done Then
                If Not Me.ExecuteCommand(command, extendSelection) Then Return False
                killing = command = "deleteToLineStart" Or command = "deleteToLineEnd"
            End If
        End Select
        If Not killing Then Me.mKillEnd = -1
        Me.Invalidate()
        Me.FinishInteraction()
        Return True
    End Function

    ''' One command for the primary selection (or, inside RunBatch, for the selection
    ''' being processed). False when the command is unknown.
    Private Function ExecuteCommand(command As String, extendSelection As Boolean) As Boolean
        If Me.ExecuteFeatureCommand(command) Then Return True
        Select Case command
        Case "@type"
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, Me.mBatchPiece, -1, -1, "typing")
        Case "@paste"
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, Me.mBatchPiece, -1, -1, "paste")
        Case "@delete"
            If Me.SelectionLength > 0 Then Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "cut")
        Case "selectAll"
            Me.SelectAll()
        Case "selectNone"
            Me.MoveCaretTo(Me.mCaret, False)
        Case "selectLine"
            Me.ClearComposition()
            Me.SelectLineAt(Me.mCaret)
            Me.mPreferredColumn = -1
            Me.EnsureCaretVisible()
        Case "selectWord"
            Me.ClearComposition()
            Me.SelectWordAt(Me.mCaret)
            Me.mPreferredColumn = -1
            Me.EnsureCaretVisible()
        Case "copy"
            Me.CopySelection(False)
        Case "cut"
            If Me.IsReadOnly Then Return True
            Me.CopySelection(True)
        Case "paste"
            If Me.IsReadOnly Then Return True
            Me.PasteClipboard()
        Case "yank"
            If Me.IsReadOnly Or StudioCodeEditor.KillBuffer = "" Then Return True
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, StudioCodeEditor.KillBuffer, -1, -1, "paste")
        Case "undo"
            RaiseEvent UndoRequested(False)
        Case "redo"
            RaiseEvent UndoRequested(True)
        Case "deleteBackward"
            Me.DeleteBackwardSmart()
        Case "deleteForward"
            If Me.SelectionLength > 0 Then
                Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "delete")
            ElseIf Me.mCaret < Me.TotalLength() Then
                Dim target As Integer = Me.StepPosition(Me.mCaret, True)
                Me.EditRange(Me.mCaret, target - Me.mCaret, "", -1, -1, "delete")
            End If
        Case "deleteWordBackward"
            If Me.SelectionLength > 0 Then
                Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "delete")
            Else
                Dim target As Integer = Me.WordBackwardTarget(Me.mCaret)
                Me.EditRange(target, Me.mCaret - target, "", -1, -1, "delete")
            End If
        Case "deleteWordForward"
            Me.DeleteWordForward()
        Case "deleteToLineStart"
            Me.KillToLineBoundary(False)
        Case "deleteToLineEnd"
            Me.KillToLineBoundary(True)
        Case "transpose"
            Me.TransposeCharacters()
        Case "moveLeft"
            Me.mPreferredColumn = -1
            If Not extendSelection And Me.SelectionLength > 0 Then
                Me.MoveCaretTo(Me.SelectionStart, False)
            Else
                Me.MoveCaretTo(Me.StepPosition(Me.mCaret, False), extendSelection)
            End If
        Case "moveRight"
            Me.mPreferredColumn = -1
            If Not extendSelection And Me.SelectionLength > 0 Then
                Me.MoveCaretTo(Me.SelectionStart + Me.SelectionLength, False)
            Else
                Me.MoveCaretTo(Me.StepPosition(Me.mCaret, True), extendSelection)
            End If
        Case "moveWordLeft"
            Me.MoveWord(False, extendSelection)
        Case "moveWordRight"
            Me.MoveWord(True, extendSelection)
        Case "moveUp"
            Me.MoveVertical(-1, extendSelection)
        Case "moveDown"
            Me.MoveVertical(1, extendSelection)
        Case "moveParagraphBackward"
            Me.MoveParagraph(False, extendSelection)
        Case "moveParagraphForward"
            Me.MoveParagraph(True, extendSelection)
        Case "pageUp"
            Me.MovePage(False, extendSelection)
        Case "pageDown"
            Me.MovePage(True, extendSelection)
        Case "moveHome"
            Me.mPreferredColumn = -1
            Me.MoveHome(extendSelection)
        Case "moveEnd", "moveLineEnd"
            Me.mPreferredColumn = -1
            Me.MoveEnd(extendSelection)
        Case "moveLineStart"
            Me.mPreferredColumn = -1
            Me.MoveCaretTo(Me.mStarts(Me.LineOfPosition(Me.mCaret)), extendSelection)
        Case "moveDocumentStart"
            Me.mPreferredColumn = -1
            Me.MoveCaretTo(0, extendSelection)
        Case "moveDocumentEnd"
            Me.mPreferredColumn = -1
            Me.MoveCaretTo(Me.TotalLength(), extendSelection)
        Case "scrollPageUp"
            Me.ScrollLines(-Me.VisibleLineCount())
        Case "scrollPageDown"
            Me.ScrollLines(Me.VisibleLineCount())
        Case "scrollLineUp"
            Me.ScrollLines(-1)
        Case "scrollLineDown"
            Me.ScrollLines(1)
        Case "scrollDocumentStart"
            Me.SetScroll(Me.mScrollX, 0.0)
        Case "scrollDocumentEnd"
            Me.SetScroll(Me.mScrollX, Me.MaxScrollY())
        Case "centerSelection"
            Me.CenterSelectionInView()
        Case "indent", "insertTab"
            ' Read-only: leave Tab to focus traversal (as NSTextView does when not editable).
            If Me.IsReadOnly And command = "insertTab" Then Return False
            Me.Indent(False, command = "indent")
        Case "outdent", "insertBacktab"
            If Me.IsReadOnly And command = "insertBacktab" Then Return False
            Me.Indent(True, command = "outdent")
        Case "insertNewline"
            If Me.IsReadOnly Then Return True
            Me.InsertNewline()
        Case "insertLineBreak"
            ' A bare line break: no auto-indent or block completion.
            If Me.IsReadOnly Then Return True
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, "\n", -1, -1, "newline")
        Case "openLine"
            If Me.IsReadOnly Then Return True
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, "\n", -1, Me.SelectionStart, "newline")
        Case "toggleComment"
            Me.ToggleComment()
        Case "moveLinesUp"
            Me.MoveLines(False)
        Case "moveLinesDown"
            Me.MoveLines(True)
        Case "findNext"
            Me.FindNext(Me.mFindQuery, True, Me.mFindCase, Me.mFindWord, Me.mFindWrap, Me.mFindRegex, Me.mFindMultiline, Me.mFindDotAll)
        Case "findPrevious"
            Me.FindNext(Me.mFindQuery, False, Me.mFindCase, Me.mFindWord, Me.mFindWrap, Me.mFindRegex, Me.mFindMultiline, Me.mFindDotAll)
        Case "useSelectionForFind"
            If Me.SelectionLength > 0 Then
                Dim selectedQuery As String = Me.SelectedText
                If Me.mFindRegex Then selectedQuery = StudioFindPattern(selectedQuery, False)
                Me.SetFindHighlight(selectedQuery, Me.mFindCase, Me.mFindWord, Me.mFindRegex, Me.mFindMultiline, Me.mFindDotAll)
            End If
        Case "goToNextMarker"
            Me.GoToNextMarker(True)
        Case "goToPreviousMarker"
            Me.GoToNextMarker(False)
        Case "fold"
            Me.Fold(Me.CaretLine)
        Case "unfold"
            Me.Unfold(Me.CaretLine)
        Case "toggleFold"
            Me.ToggleFold(Me.CaretLine)
        Case "foldAll"
            Me.FoldAll()
        Case "unfoldAll"
            Me.UnfoldAll()
        Case Else
            Return False
        End Select
        Return True
    End Function

    ' ---- Input (shadows TextInputCanvas's simple handlers) ---------------------------

    ' Refresh a resting in-editor drag as soon as the copy modifier changes.
    ' UpdateEdgeScroll retains coordinates even when its timer is stopped.
    Private Sub RefreshSelectionDragModifiers()
        If Me.mDragMode <> 8 Then Return
        ' GTK event modifiers (and the GDK snapshot on key release) can still
        ' contain the pre-transition state. Query the keys themselves instead.
        Dim alt As Boolean = Keyboard.IsKeyDown(KeyName.OptionKey)
        Dim primary As Boolean = Keyboard.IsKeyDown(KeyName.ControlKey)
        #If TargetMac Then
            primary = Keyboard.IsKeyDown(KeyName.CommandKey)
        #End If
        Me.PointerDrag(Me.mEdgeX, Me.mEdgeY, alt, primary)
    End Sub

    Handle KeyUp(e As KeyEvent)
        Me.RefreshSelectionDragModifiers()
    End Handle

    Handle KeyDown(e As KeyEvent)
        Me.RefreshSelectionDragModifiers()
        Dim primary As Boolean = e.Modifiers.Primary
        If Not primary And Not e.Modifiers.Control And Not e.Modifiers.Shift And Not e.Modifiers.Option Then
            Dim inlineCommand As String = ""
            If e.Key = KeyName.Tab Then inlineCommand = "insertTab"
            If e.Key = KeyName.Escape Then inlineCommand = "cancelOperation"
            If e.Key = KeyName.PageDown Then inlineCommand = "pageDown"
            If e.Key = KeyName.PageUp Then inlineCommand = "pageUp"
            If Me.InlineCompletionCommand(inlineCommand) Then
                e.Handled = True
                Return
            End If
        End If
        ' The completion popup owns navigation, accept and dismiss keys while open.
        If (Me.IsCompletionPopupShown() Or Me.mHintLine >= 0) And Not primary And Not e.Modifiers.Control And Not e.Modifiers.Shift And Not e.Modifiers.Option And Not Me.CompletionComposing() Then
            Dim popupCommand As String = ""
            Select Case e.Key
            Case KeyName.Up
                popupCommand = "moveUp"
            Case KeyName.Down
                popupCommand = "moveDown"
            Case KeyName.PageUp
                popupCommand = "pageUp"
            Case KeyName.PageDown
                popupCommand = "pageDown"
            Case KeyName.Return
                popupCommand = "insertNewline"
            Case KeyName.Tab
                popupCommand = "insertTab"
            Case KeyName.Escape
                popupCommand = "cancelOperation"
            End Select
            If popupCommand <> "" Then
                If Me.CompletionCommand(popupCommand) Then
                    e.Handled = True
                    Me.Invalidate()
                    Return
                End If
            End If
        End If
        ' Host key bindings first (StudioCommands resolver); once per key press.
        If Me.AskShortcut(Me.KeyChord(e), False) Then
            e.Handled = True
            Return
        End If
        Dim command As String = Me.KeyCommand(e)
        If command = "" Then
            Select Case e.Key
            Case KeyName.Tab
                If Not primary And Not e.Modifiers.Control Then
                    command = "insertTab"
                    If e.Modifiers.Shift Then command = "insertBacktab"
                End If
            Case KeyName.Return
                #If TargetWindows Then
                    If Me.NativeIMESupported Then Return
                #End If
                Me.CommitText("\n", Nil)
                e.Handled = True
            Case KeyName.Escape
                If Me.mDragMode = 7 Or Me.mDragMode = 8 Then
                    Me.CancelSelectionDrag()
                    e.Handled = True
                    Return
                End If
                Dim composing As Boolean = String.Len(Me.mIncomplete) > 0
                Me.CancelComposition()
                If Not composing Then Me.EscapeEditorState()
                e.Handled = True
            Case KeyName.Space
                If primary Then
                    command = "triggerCompletion"
                    If e.Modifiers.Shift Then command = "triggerParameterHints"
                Else
                    #If TargetWindows Then
                        If Me.NativeIMESupported Then Return
                    #End If
                    Me.CommitText(" ", Nil)
                    e.Handled = True
                End If
            Case Else
                If e.Character >= 32 And Not primary And Not e.Modifiers.Control Then
                    #If TargetWindows Then
                        If Me.NativeIMESupported Then Return
                    #End If
                    Me.CommitText(String.Chr(e.Character), Nil)
                    e.Handled = True
                End If
            End Select
        End If
        If command <> "" Then
            Me.CancelComposition()
            e.Handled = Me.PerformCommand(command, e.Modifiers.Shift)
        End If
        Me.Invalidate()
    End Handle

    Private Function VerticalThumb(ByRef top As Double, ByRef size As Double) As Boolean
        Dim track As Double = Me.Height - Me.ScrollbarSize()
        Dim content As Double = Me.ContentHeight()
        If content <= Me.ViewHeight() Or track <= 0 Then Return False
        size = Math.Max(24.0, track * Me.ViewHeight() / content)
        top = (track - size) * Me.mScrollY / Math.Max(1.0, Me.MaxScrollY())
        Return True
    End Function

    Private Function HorizontalThumb(ByRef left As Double, ByRef size As Double) As Boolean
        Dim origin As Double = Me.TextLeft()
        Dim track As Double = Me.HorizontalTrack()
        Dim content As Double = Me.ContentWidth()
        If Me.mWordWrap Then Return False
        If content <= Me.ViewWidth() Or track <= 0 Then Return False
        size = Math.Max(24.0, track * Me.ViewWidth() / content)
        left = origin + (track - size) * Me.mScrollX / Math.Max(1.0, Me.MaxScrollX())
        Return True
    End Function

    ''' Width of the horizontal scrollbar's track (text area, short of the corner or the
    ''' minimap).
    Private Function HorizontalTrack() As Double
        If Me.mShowsMinimap Then Return Me.TextRight() - Me.TextLeft()
        Return Me.Width - Me.TextLeft() - Me.ScrollbarSize()
    End Function

    ''' Drives the editor's mouse handling without a native event ("down", "drag", "up",
    ''' "move", "exit"; view coordinates) — for tests and automation. `alt` is Option on
    ''' macOS, `primary` Command on macOS and Ctrl elsewhere, `middle` the middle button.
    Public Sub SimulatePointer(phase As String, x As Double, y As Double, clickCount As Integer = 1, shift As Boolean = False, alt As Boolean = False, primary As Boolean = False, middle As Boolean = False)
        Select Case phase
        Case "down"
            Me.PointerDown(x, y, clickCount, shift, alt, primary, middle)
        Case "drag"
            Me.PointerDrag(x, y, alt, primary)
        Case "up"
            Me.PointerUp(x, y, alt, primary)
        Case "move"
            Me.PointerMove(x, y)
        Case "exit"
            Me.PointerExit()
        End Select
    End Sub

    ''' View point of a document position (top-left of its cell; a position inside a
    ''' collapsed fold reports its header row).
    Public Function PointOfPosition(position As Integer) As Point
        Dim x As Double = 0.0
        Dim y As Double = 0.0
        Me.CaretPoint(Me.Clamp(position), x, y)
        Dim point As Point = { X: x, Y: y }
        Return point
    End Function

    ''' Document position under a view point (as a click would place the caret).
    Public Function PositionAtPoint(x As Double, y As Double) As Integer
        Return Me.PositionAt(Math.Max(x, Me.TextLeft()), y)
    End Function

    ''' Where dragged text would land (-1 while no drag is over the editor).
    Public Property DropPosition As Integer
        Get
            Return Me.mDropPosition
        End Get
    End Property

    Handle MouseDown(e As MouseEvent)
        Me.DismissInlineCompletion()
        Dim middle As Boolean = False
        #If TargetLinux Then
            middle = e.Button = MouseButton.Middle
        #End If
        If e.Button <> MouseButton.Left And Not middle Then Return
        e.Handled = True
        If Me.CompletionMouseDown(e.X, e.Y) Then Return
        Me.PointerDown(e.X, e.Y, e.ClickCount, e.Modifiers.Shift, e.Modifiers.Option, e.Modifiers.Primary, middle)
    End Handle

    ''' Visual cell under a view x (unclamped to any line; box selection).
    Private Function CellAt(x As Double) As Integer
        Dim cell As Integer = Math.Round((Math.Max(x, Me.TextLeft()) - Me.TextLeft() + Me.mScrollX) / Me.mCharWidth)
        Return Math.Max(0, cell)
    End Function

    ''' Logical visual cell under a view point (box selection): CellAt, or while soft
    ''' wrapping the cell within the line of the row under `y` (segment start + offset,
    ''' less the continuation indent).
    Private Function CellAtPoint(x As Double, y As Double) As Integer
        If Not Me.mWordWrap Then Return Me.CellAt(x)
        Dim segment As Integer = 0
        Dim lineIndex As Integer = Me.LineAndSegmentOfRow(Me.RowAt(y), segment)
        If segment = 0 Then Return Me.CellAt(x)
        Dim wrap As StudioWrapLine = Me.SegmentsOf(lineIndex)
        Dim base As Integer = Me.VisualColumn(Me.mLines(lineIndex), wrap.Starts(segment))
        Return Math.Max(base, base + Me.CellAt(x) - wrap.SegmentIndent(segment))
    End Function

    ''' Row under a view y, clamped to the document.
    Private Function RowAt(y As Double) As Integer
        Dim row As Integer = Math.Floor((y + Me.mScrollY - Me.TopPadding()) / Me.LineHeight)
        Return Math.Max(0, Math.Min(row, Me.RowCount() - 1))
    End Function

    ''' True when a view point is over the selected text (not just beside its edges).
    Private Function IsOverSelection(x As Double, y As Double) As Boolean
        If Me.SelectionLength = 0 Or x < Me.TextLeft() Or x >= Me.TextRight() Then Return False
        Dim position As Integer = Me.PositionAt(x, y)
        Dim cx As Double = 0.0
        Dim cy As Double = 0.0
        Me.CaretPoint(position, cx, cy)
        Dim hit As Integer = position
        If x < cx And position > 0 Then hit = Me.StepPosition(position, False)
        Return hit >= Me.SelectionStart And hit < Me.SelectionStart + Me.SelectionLength
    End Function

    ''' The copy modifier while dropping dragged text: Option on macOS, Ctrl elsewhere.
    Private Function CopyModifier(alt As Boolean, primary As Boolean) As Boolean
        #If TargetMac Then
            Return alt
        #Else
            Return primary
        #End If
    End Function

    ''' Alt/Option+click: adds a cursor, or removes the selection under the pointer when
    ''' there are several.
    Private Function ToggleCursorAt(position As Integer) As Boolean
        Me.ClearComposition()
        If Me.HasExtras() Then
            Dim anchors As Array Of Integer = []
            Dim carets As Array Of Integer = []
            Dim primary As Integer = Me.SortedSelections(anchors, carets)
            For i As Integer = 0 To Array.LastIndex(carets)
                If position >= Math.Min(anchors(i), carets(i)) And position <= Math.Max(anchors(i), carets(i)) Then
                    Array.RemoveAt(anchors, i)
                    Array.RemoveAt(carets, i)
                    ' Removing the primary promotes the last selection.
                    Dim chosen As Integer = primary
                    If i = primary Then
                        chosen = Array.LastIndex(carets)
                    ElseIf i < primary Then
                        chosen = primary - 1
                    End If
                    Me.ApplySelections(anchors, carets, chosen)
                    Return False
                End If
            Next
        ElseIf position = Me.mCaret And Me.SelectionLength = 0 Then
            Return False
        End If
        Me.AddSelectionQuiet(position, position)
        Return True
    End Function

    Private Sub PointerDown(x As Double, y As Double, clickCount As Integer, shift As Boolean, alt As Boolean, primary As Boolean, middle As Boolean)
        Me.StopEdgeScroll()
        Me.mChordPending = False
        Me.CancelComposition()
        Me.Focus()
        Me.mDropPosition = -1
        Dim top As Double = 0.0
        Dim size As Double = 0.0
        If Not middle Then
            If x >= Me.Width - Me.ScrollbarSize() And Me.VerticalThumb(top, size) Then
                If y >= top And y <= top + size Then
                    Me.mDragGrab = y - top
                Else
                    Me.mDragGrab = size / 2.0
                    Me.DragVertical(y)
                End If
                Me.mDragMode = 2
                Return
            End If
            If Me.IsOverMinimap(x) Then
                Me.MinimapPress(y)
                Return
            End If
            ' A sticky scope header: go to its line (never a click into the text below).
            Dim stickyLine As Integer = Me.StickyLineAtPoint(x, y)
            If stickyLine >= 0 Then
                Me.RevealStickyScope(stickyLine)
                Return
            End If
            If y >= Me.Height - Me.ScrollbarSize() And x >= Me.TextLeft() And x < Me.TextRight() And Me.HorizontalThumb(top, size) Then
                If x >= top And x <= top + size Then
                    Me.mDragGrab = x - top
                Else
                    Me.mDragGrab = size / 2.0
                    Me.DragHorizontal(x)
                End If
                Me.mDragMode = 3
                Return
            End If
            If Me.mShowsBreakpoints And x < Me.LaneWidth() Then
                Dim row As Integer = Math.Floor((y + Me.mScrollY - Me.TopPadding()) / Me.LineHeight)
                If row >= 0 And row < Me.RowCount() Then Me.ToggleBreakpoint(Me.LineOfRow(row))
                Return
            End If
            If Me.mShowsLineNumbers And x >= Me.LaneWidth() And x < Me.LaneWidth() + 14.0 Then
                Dim row As Integer = Math.Floor((y + Me.mScrollY - Me.TopPadding()) / Me.LineHeight)
                If row >= 0 And row < Me.RowCount() Then
                    If Me.ActivateGutterProblem(Me.LineOfRow(row)) Then Return
                End If
            End If
            ' Fold chevron in the gutter, or the "⋯" pill after a collapsed header.
            Dim onPill As Boolean = False
            Dim foldLine As Integer = Me.FoldHitAt(x, y, onPill)
            If foldLine >= 0 Then
                If onPill Then
                    Me.Unfold(foldLine)
                Else
                    Me.ToggleFold(foldLine)
                End If
                Return
            End If
        End If
        ' A middle press on a sticky header must not start a box selection below it.
        If middle And Me.StickyLineAtPoint(x, y) >= 0 Then Return
        Dim position As Integer = Me.PositionAt(Math.Max(x, Me.TextLeft()), y)
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        Me.mPressX = x
        Me.mPressY = y
        Me.mPressPosition = position
        Dim inText As Boolean = x >= Me.GutterWidth()
        ' Column (box) selection: Shift+Alt+drag (Shift+Option on macOS) or a middle-button
        ' drag (Linux) start a box here; plain Option+drag on macOS becomes one on its
        ' first move (PointerDrag).
        If inText And (middle Or (alt And shift)) Then
            Me.RememberCursors()
            Me.mBoxAnchorLine = Me.LineOfPosition(position)
            Me.mBoxAnchorCell = Me.CellAtPoint(x, y)
            Me.mBoxCaretLine = Me.mBoxAnchorLine
            Me.mBoxCaretCell = Me.mBoxAnchorCell
            Me.ApplyBox()
            Me.mDragMode = 5
            Me.FinishInteraction()
            Return
        End If
        If middle Then Return
        If inText And alt And clickCount = 1 Then
            Me.mPressSaved = Me.SelectionKey()
            Me.RememberCursors()
            Dim added As Boolean = Me.ToggleCursorAt(position)
            #If TargetMac Then
                Me.mDragMode = 9
            #Else
                ' Dragging extends the new cursor; a removed one leaves nothing to drag.
                Me.mDragMode = 0
                If added Then Me.mDragMode = 6
            #End If
            Me.Invalidate()
            Me.FinishInteraction()
            Return
        End If
        ' A press on the selected text may start dragging it (decided on the first move).
        If inText And clickCount = 1 And Not shift And Not Me.HasExtras() And Me.IsOverSelection(x, y) Then
            Me.mDragMode = 7
            Me.Invalidate()
            Return
        End If
        If x < Me.GutterWidth() Then
            ' Gutter: select whole lines.
            Me.ClearExtras()
            Dim lineIndex As Integer = Me.LineOfPosition(position)
            If shift Then
                ' Extend by whole lines from the line holding the anchor.
                Me.ClearComposition()
                Dim anchorLine As Integer = Me.LineOfPosition(Me.mAnchor)
                If Me.SelectionLength > 0 And Me.mAnchor > Me.mCaret Then anchorLine = Me.LineOfPosition(Me.mAnchor - 1)
                If Me.IsLineHidden(anchorLine) Then anchorLine = Me.LineOfFoldRow(Me.FoldRowOfLine(anchorLine))
                If lineIndex >= anchorLine Then
                    Me.SelectLineAt(Me.mStarts(lineIndex))
                    Me.mAnchor = Me.mStarts(anchorLine)
                Else
                    Me.SelectLineAt(Me.mStarts(anchorLine))
                    Me.mAnchor = Me.mCaret
                    Me.mCaret = Me.mStarts(lineIndex)
                End If
            Else
                Me.SelectLineAt(Me.mStarts(lineIndex))
            End If
            Me.mDragUnit = 2
            Me.mDragOrigin = Me.mStarts(lineIndex)
        ElseIf clickCount >= 3 Then
            Me.ClearComposition()
            Me.ClearExtras()
            Me.SelectLineAt(position)
            Me.mDragUnit = 2
            Me.mDragOrigin = position
        ElseIf clickCount = 2 Then
            Me.ClearComposition()
            Me.ClearExtras()
            Me.SelectWordAt(position)
            Me.mDragUnit = 1
            Me.mDragOrigin = position
        Else
            Me.MoveCaretTo(position, shift)
            Me.mDragUnit = 0
        End If
        Me.mDragMode = 1
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    Private Sub DragVertical(y As Double)
        Dim top As Double = 0.0
        Dim size As Double = 0.0
        If Not Me.VerticalThumb(top, size) Then Return
        Dim track As Double = Me.Height - Me.ScrollbarSize() - size
        If track <= 0 Then Return
        Me.SetScroll(Me.mScrollX, (y - Me.mDragGrab) / track * Me.MaxScrollY())
    End Sub

    Private Sub DragHorizontal(x As Double)
        Dim left As Double = 0.0
        Dim size As Double = 0.0
        If Not Me.HorizontalThumb(left, size) Then Return
        Dim track As Double = Me.HorizontalTrack() - size
        If track <= 0 Then Return
        Me.SetScroll((x - Me.TextLeft() - Me.mDragGrab) / track * Me.MaxScrollX(), Me.mScrollY)
    End Sub

    Handle MouseDrag(e As MouseEvent)
        Me.PointerDrag(e.X, e.Y, e.Modifiers.Option, e.Modifiers.Primary)
    End Handle

    Private Sub PointerDrag(x As Double, y As Double, alt As Boolean, primary As Boolean)
        Select Case Me.mDragMode
        Case 1, 5, 6, 8
            Me.UpdateEdgeScroll(x, y, False, alt, primary)
        End Select
        Select Case Me.mDragMode
        Case 2
            Me.DragVertical(y)
        Case 3
            Me.DragHorizontal(x)
        Case 4
            Me.MinimapDrag(y)
        Case 9
            ' macOS Option+drag: the click's cursor toggle gives way to a box selection.
            If Math.Abs(x - Me.mPressX) + Math.Abs(y - Me.mPressY) < 3.0 Then Return
            Me.ApplySelectionKey(Me.mPressSaved)
            Me.mBoxAnchorLine = Me.LineOfPosition(Me.mPressPosition)
            Me.mBoxAnchorCell = Me.CellAtPoint(Me.mPressX, Me.mPressY)
            Me.mDragMode = 5
            Me.mBoxCaretLine = Me.LineOfRow(Me.RowAt(y))
            Me.mBoxCaretCell = Me.CellAtPoint(x, y)
            Me.ApplyBox()
            Me.FinishInteraction()
        Case 5
            Me.mBoxCaretLine = Me.LineOfRow(Me.RowAt(y))
            Me.mBoxCaretCell = Me.CellAtPoint(x, y)
            Me.ApplyBox()
            Me.FinishInteraction()
        Case 6
            ' Alt+drag (Windows/Linux): the new cursor's selection follows the pointer.
            Me.mCaret = Me.PositionAt(Math.Max(x, Me.TextLeft()), y)
            Me.EnsureCaretVisible()
            Me.Invalidate()
            Me.FinishInteraction()
        Case 7, 8
            If Me.mDragMode = 7 And Math.Abs(x - Me.mPressX) + Math.Abs(y - Me.mPressY) < 3.0 Then Return
            If Me.mDragMode = 7 Then Me.UpdateEdgeScroll(x, y, False, alt, primary)
            Me.mDragMode = 8
            Me.mDropPosition = Me.SnapPosition(Me.PositionAt(Math.Max(x, Me.TextLeft()), y))
            Me.mDropCopy = Me.CopyModifier(alt, primary)
            If Me.mDropCopy Then
                Me.SetPointerShape(3)
            Else
                Me.SetPointerShape(1)
            End If
            Me.Invalidate()
        Case 1
            Dim position As Integer = Me.PositionAt(Math.Max(x, Me.TextLeft()), y)
            If Me.mDragUnit = 0 Then
                Me.mCaret = position
            Else
                Dim origin As Integer = Me.mDragOrigin
                If Me.mDragUnit = 1 Then
                    Me.SelectWordAt(origin)
                Else
                    Me.SelectLineAt(origin)
                End If
                Dim originStart As Integer = Me.mAnchor
                Dim originEnd As Integer = Me.mCaret
                If Me.mDragUnit = 1 Then
                    Me.SelectWordAt(position)
                Else
                    Me.SelectLineAt(position)
                End If
                If position < originStart Then
                    Me.mCaret = Me.mAnchor
                    Me.mAnchor = originEnd
                Else
                    Me.mAnchor = originStart
                End If
            End If
            Me.EnsureCaretVisible()
            Me.Invalidate()
            Me.FinishInteraction()
        End Select
    End Sub

    Handle MouseUp(e As MouseEvent)
        Me.PointerUp(e.X, e.Y, e.Modifiers.Option, e.Modifiers.Primary)
    End Handle

    Private Sub PointerUp(x As Double, y As Double, alt As Boolean, primary As Boolean)
        Dim mode As Integer = Me.mDragMode
        Me.mDragMode = 0
        Me.StopEdgeScroll()
        Select Case mode
        Case 7
            ' Clicked the selection without dragging: place the caret there.
            Me.MoveCaretTo(Me.mPressPosition, False)
        Case 8
            Dim target As Integer = Me.mDropPosition
            If target < 0 Then target = Me.SnapPosition(Me.PositionAt(Math.Max(x, Me.TextLeft()), y))
            Me.mDropPosition = -1
            Me.DropText(target, Me.CopyModifier(alt, primary))
        Case 5, 6, 9
            Me.NormalizeSelections()
            Me.FinishInteraction()
        End Select
        Me.Invalidate()
        Me.PointerMove(x, y)
    End Sub

    ''' Moves (or copies) the single selection's text to `position` as one edit and
    ''' selects it there. Dropping inside the selection cancels. False when nothing moved.
    Private Function DropText(position As Integer, copy As Boolean) As Boolean
        Me.Invalidate()
        If Me.IsReadOnly Or Me.SelectionLength = 0 Then Return False
        Dim s As Integer = Me.SelectionStart
        Dim e As Integer = s + Me.SelectionLength
        Dim target As Integer = Me.Clamp(position)
        If target >= s And target <= e Then Return False
        Dim moved As String = Me.SelectedText
        Dim length As Integer = String.Len(moved)
        Me.ClearExtras()
        If copy Then
            Me.EditRange(target, 0, moved, target, target + length, "drop")
        ElseIf target > e Then
            Me.EditRange(s, target - s, Me.Slice(e, target - e) + moved, target - length, target, "drop")
        Else
            Me.EditRange(target, e - target, moved + Me.Slice(target, s - target), target, target + length, "drop")
        End If
        Return True
    End Function

    ' ---- Native drag and drop (StudioEditorDragSource / StudioEditorDropTarget) ----------

    ''' Drag source: offers the selection only while a press on it is pending.
    Public Function NativeDragActions() As DragAction
        If (Me.mDragMode = 7 Or Me.mDragMode = 8) And Me.SelectionLength > 0 Then
            If Me.IsReadOnly Then Return DragAction.Copy
            Return DragAction.Copy Or DragAction.Move
        End If
        Return DragAction.None
    End Function

    Public Function NativeDragItems() As Array Of DragItem
        Dim items As Array Of DragItem = []
        If Me.NativeDragActions() = DragAction.None Then Return items
        Array.Append(items, DragItem.FromText(Me.SelectedText))
        ' What a Move removes when the drop lands elsewhere (NativeDragEnded): the
        ' range, its text and the document it came from.
        Me.mDragSourceStart = Me.SelectionStart
        Me.mDragSourceText = Me.SelectedText
        Me.mDragSourceDocument = Me.Text
        ' The platform drag owns the pointer now (no further MouseDrag/MouseUp).
        Me.mNativeDragActive = True
        StudioCodeEditor.StudioDragActive = True
        Me.mNativeDropHandled = False
        Me.mDragMode = 10
        Return items
    End Function

    Public Sub NativeDragEnded(action As DragAction, accepted As Boolean)
        If Not Me.mNativeDragActive Then Return
        Me.mNativeDragActive = False
        StudioCodeEditor.StudioDragActive = False
        Dim handled As Boolean = Me.mNativeDropHandled
        Me.mNativeDropHandled = False
        Me.mDragMode = 0
        Me.mDropPosition = -1
        Me.StopEdgeScroll()
        If accepted And action = DragAction.Move And Not handled And Not Me.IsReadOnly Then
            ' Moved into another editor or application: remove the original text.
            Dim start As Integer = Me.DragSourceNow()
            If start >= 0 Then Me.EditRange(start, String.Len(Me.mDragSourceText), "", -1, -1, "drop")
        End If
        Me.mDragSourceText = ""
        Me.mDragSourceDocument = ""
        Me.SetPointerShape(0)
        Me.Invalidate()
    End Sub

    ''' Where the dragged text is now, or -1. A drop into a split pane of the same
    ''' document reaches this editor as a replaced Text (its selection collapsed), so
    ''' the range is shifted past an edit made before it and checked against the text.
    Private Function DragSourceNow() As Integer
        Dim length As Integer = String.Len(Me.mDragSourceText)
        If length = 0 Then Return -1
        Dim start As Integer = Me.mDragSourceStart
        Dim current As String = Me.Text
        Dim original As String = Me.mDragSourceDocument
        If String.Compare(current, original, True) <> 0 Then
            ' Only one change is understood: the dragged text inserted once, outside the
            ' source range (anything else, e.g. another document, keeps the text).
            Dim grown As Integer = String.Len(current) - String.Len(original)
            If grown <> length Then Return -1
            Dim prefix As Integer = EditorCommonPrefix(original, current)
            If String.Compare(String.Substring(current, prefix + length), String.Substring(original, prefix), True) <> 0 Then Return -1
            If String.Compare(String.Substring(current, prefix, length), Me.mDragSourceText, True) <> 0 Then Return -1
            If prefix > start And prefix < start + length Then Return -1
            If prefix <= start Then start += length
        End If
        If start < 0 Or start + length > Me.TotalLength() Then Return -1
        If String.Compare(Me.Slice(start, length), Me.mDragSourceText, True) <> 0 Then Return -1
        Return start
    End Function

    ''' Supply NativeDragImage as the platform drag image. Off by default: in Buoy
    ''' 0.72's Linux runtime any non-Nil IDragSource.DragImage stops the GTK drag
    ''' (no DragOver/drop ever arrives; verified with a 40x20 solid Picture), and it is
    ''' not yet verified on macOS or Windows.
    Public Property ShowsDragImage As Boolean = False

    ''' Card image of the dragged text (first lines, editor font and colours), or Nil
    ''' unless ShowsDragImage.
    Public Function NativeDragImage() As Picture
        If Not Me.ShowsDragImage Then Return Nil
        Dim value As String = Me.mDragSourceText
        If value = "" Then value = Me.SelectedText
        If value = "" Then Return Nil
        Dim lines As Array Of String = String.Split(value, "\n")
        Dim shown As Array Of String = []
        For Each line As String In lines
            If Array.Count(shown) = 12 Then
                Array.Append(shown, "…")
                Exit For
            End If
            Dim piece As String = String.Replace(line, "\t", String.Space(Me.TabSize()))
            If String.Len(piece) > 72 Then piece = String.Left(piece, 71) + "…"
            Array.Append(shown, piece)
        Next
        Dim columns As Integer = 1
        For Each piece As String In shown
            columns = Math.Max(columns, String.Len(piece))
        Next
        Dim lineHeight As Double = Me.LineHeight
        Dim width As Double = Math.Min(560.0, columns * Me.mCharWidth + 16.0)
        Dim height As Double = Array.Count(shown) * lineHeight + 8.0
        Dim scale As Double = Me.BackingScale()
        Dim picture As New Picture(Math.Max(1, Math.Round(width * scale + 0.49)), Math.Max(1, Math.Round(height * scale + 0.49)), scale)
        Dim pg As Graphics = picture.Graphics
        pg.Scale(scale, scale)
        Dim theme As New StudioCodeEditorTheme(Me.IsDark)
        Dim back As Color = theme.Background
        pg.FillRoundedRect(0, 0, width, height, 6, Color.RGBA(back.R, back.G, back.B, 0.9))
        pg.StrokeRoundedRect(0.5, 0.5, width - 1.0, height - 1.0, 6, 1.0, theme.GutterLine)
        pg.Save()
        pg.ClipToRect(4.0, 0, width - 8.0, height)
        Dim textBaseline As Double = Me.BaselineOffset() + Me.DrawStringLift(Me.FontSize)
        For i As Integer = 0 To Array.LastIndex(shown)
            Me.DrawRun(pg, shown(i), 8.0, 4.0 + i * lineHeight + textBaseline, theme.Ink)
        Next
        pg.Restore()
        Return picture
    End Function

    ''' Drop target: text and files; the editor's own text moves unless the platform's
    ''' copy modifier turned the drag into a copy.
    Public Function NativeDropAction(payload As DragItem, requested As DragAction) As DragAction
        If Me.IsReadOnly Or payload = Nil Then Return DragAction.None
        If Not (payload.HasType(DragType.Text) Or payload.HasType(DragType.FileList)) Then Return DragAction.None
        ' Text dragged from any Studio editor (this one, a split pane, another window)
        ' moves unless the copy modifier is held; drags from other applications copy.
        If (Me.mNativeDragActive Or StudioCodeEditor.StudioDragActive) And requested = DragAction.Move Then Return DragAction.Move
        Return DragAction.Copy
    End Function

    ''' A native drag that started in some StudioCodeEditor of this process is in flight.
    Public Shared Property StudioDragActive As Boolean = False

    Public Function NativeDragOver(payload As DragItem, requested As DragAction, pt As Point) As DragAction
        Dim action As DragAction = Me.NativeDropAction(payload, requested)
        If action = DragAction.None Then
            Me.NativeDragLeft()
            Return action
        End If
        Dim position As Integer = Me.SnapPosition(Me.PositionAt(Math.Max(pt.X, Me.TextLeft()), pt.Y))
        Dim copy As Boolean = action <> DragAction.Move
        Me.UpdateEdgeScroll(pt.X, pt.Y, True, False, False)
        ' Windows repeats DragOver while the pointer rests: repaint only on a change.
        If position <> Me.mDropPosition Or copy <> Me.mDropCopy Then
            Me.mDropPosition = position
            Me.mDropCopy = copy
            Me.Invalidate()
        End If
        Return action
    End Function

    Public Sub NativeDragLeft()
        Me.StopEdgeScroll()
        If Me.mDropPosition < 0 Then Return
        Me.mDropPosition = -1
        Me.Invalidate()
    End Sub

    Public Function NativeDrop(payload As DragItem, action As DragAction, pt As Point) As Boolean
        Me.mDropPosition = -1
        Me.StopEdgeScroll()
        Me.Invalidate()
        If Me.IsReadOnly Or payload = Nil Then Return False
        Dim position As Integer = Me.SnapPosition(Me.PositionAt(Math.Max(pt.X, Me.TextLeft()), pt.Y))
        If Me.mNativeDragActive Then
            ' Our own selection dropped back here: an internal move/copy.
            Me.mNativeDropHandled = True
            Me.DropText(position, action <> DragAction.Move)
            Return True
        End If
        Dim value As String = ""
        If payload.HasType(DragType.FileList) Then
            Dim files As Array Of FileSystemItem = payload.AsFiles()
            If Array.Count(files) > 0 Then
                If RaiseEvent FilesDropped(files) Then Return True
                Dim paths As Array Of String = []
                For Each item As FileSystemItem In files
                    Array.Append(paths, item.FullPath())
                Next
                value = String.Join(paths, "\n")
            End If
        End If
        If value = "" And payload.HasType(DragType.Text) Then value = payload.AsText()
        If value = "" Then Return False
        Me.ClearComposition()
        Me.ClearExtras()
        Dim length As Integer = String.Len(Me.Normalize(value))
        Me.EditRange(position, 0, value, position, position + length, "drop")
        Me.Focus()
        Return True
    End Function

    ''' Registers the native drag source and drop target (after the editor is in a
    ''' window). Failures are kept in DragDropError; mouse-driven moves still work.
    Private Sub AttachDragDrop()
        If Me.mDropTarget <> Nil Then Return
        Try
            Dim source As New StudioEditorDragSource()
            source.Editor = Me
            Dim target As New StudioEditorDropTarget()
            target.Editor = Me
            Me.RegisterDragSource(source)
            Me.RegisterDropTarget(target, [DragType.Text, DragType.FileList])
            Me.mDragSource = source
            Me.mDropTarget = target
            Me.mDragDropError = ""
        Catch e As Exception
            Me.mDragDropError = e.Message
        End Try
    End Sub

    Private Sub DetachDragDrop()
        If Me.mDropTarget = Nil Then Return
        Try
            Me.UnregisterDragSource()
            Me.UnregisterDropTarget()
        Catch e As Exception
            Me.mDragDropError = e.Message
        End Try
        Me.mDragSource = Nil
        Me.mDropTarget = Nil
    End Sub

    ''' Why native drag and drop could not be attached ("" when it is).
    Public Property DragDropError As String
        Get
            Return Me.mDragDropError
        End Get
    End Property

    Handle MouseMove(e As MouseEvent)
        Me.PointerMove(e.X, e.Y)
    End Handle

    Handle MouseExit(e As MouseEvent)
        Me.PointerExit()
    End Handle

    Private Sub PointerExit()
        If Me.mGutterHover Or Me.mMinimapHover Then
            Me.mGutterHover = False
            Me.mMinimapHover = False
            Me.Invalidate()
        End If
    End Sub

    Private Sub PointerMove(x As Double, y As Double)
        If Me.mEdgeNative Then Me.StopEdgeScroll()
        ' Hover: fold chevrons appear over the gutter, the minimap slider brightens.
        Dim overGutter As Boolean = Me.mShowsFolding And x < Me.GutterWidth()
        Dim overMinimap As Boolean = Me.IsOverMinimap(x)
        If overGutter <> Me.mGutterHover Or overMinimap <> Me.mMinimapHover Then
            Me.mGutterHover = overGutter
            Me.mMinimapHover = overMinimap
            Me.Invalidate()
        End If
        Dim shape As Integer = 0
        If x < Me.GutterWidth() Or x >= Me.TextRight() Or x >= Me.Width - Me.ScrollbarSize() Or y >= Me.Height - Me.ScrollbarSize() Then shape = 1
        If shape = 0 And Me.mShowsFolding Then
            Dim onPill As Boolean = False
            If Me.FoldHitAt(x, y, onPill) >= 0 Then shape = 1
        End If
        ' Sticky scope headers are links to their lines.
        If Me.StickyLineAtPoint(x, y) >= 0 Then shape = 2
        ' Selected text can be dragged: an arrow over it, as in VS Code.
        If shape = 0 And Me.SelectionLength > 0 And Not Me.HasExtras() And Me.IsOverSelection(x, y) Then shape = 1
        Me.SetPointerShape(shape)
    End Sub

    ''' Escape while dragging the selection: no drop; the rest of the press does nothing.
    Private Sub CancelSelectionDrag()
        Me.mDragMode = 11
        Me.mDropPosition = -1
        Me.StopEdgeScroll()
        Me.SetPointerShape(1)
        Me.Invalidate()
    End Sub

    ''' 0 I-beam, 1 arrow, 2 hand (links), 3 drag-copy.
    Private Sub SetPointerShape(shape As Integer)
        If shape = Me.mCursorShape Then Return
        Me.mCursorShape = shape
        If shape = 1 Then
            Me.Cursor = CursorType.Arrow
        ElseIf shape = 2 Then
            Me.Cursor = CursorType.Hand
        ElseIf shape = 3 Then
            Me.Cursor = CursorType.Copy
        Else
            Me.Cursor = CursorType.IBeam
        End If
    End Sub

    Handle ConstructContextualMenu(base As MenuItem, location As Point)
        Me.BuildContextualMenu(base, location)
    End Handle

    ''' Populates the editor menu with current selection and host history state.
    Public Sub BuildContextualMenu(base As MenuItem, location As Point)
        Me.mContextSymbol = Nil
        Dim spellingPosition As Integer = Me.mCaret
        If location.X >= Me.TextLeft() And location.X < Me.TextRight() Then
            ' Right-click outside the selection moves the caret there first (VS Code).
            Dim clicked As Integer = Me.PositionAt(location.X, location.Y)
            spellingPosition = clicked
            Dim inside As Boolean = Me.SelectionLength > 0 And clicked >= Me.SelectionStart And clicked <= Me.SelectionStart + Me.SelectionLength
            If Not inside Then Me.MoveCaretTo(clicked, False)
            If Me.ShowsSymbolActions Then Me.mContextSymbol = Me.SymbolAt(clicked)
        ElseIf Me.ShowsSymbolActions Then
            Me.mContextSymbol = Me.SymbolAt(Me.mCaret)
        End If
        Me.mContextSpelling = Nil
        Me.mContextSpellingLine = Me.LineOfPosition(spellingPosition)
        Me.mContextSpellingSource = Me.mLines(Me.mContextSpellingLine)
        Dim spellingColumn As Integer = spellingPosition - Me.LineStartPosition(Me.mContextSpellingLine)
        For Each word As StudioSpellingWord In Me.SpellingOnLine(Me.mContextSpellingLine)
            If spellingColumn >= word.Start And spellingColumn <= word.Start + word.Length Then
                Me.mContextSpelling = word
                For Each suggestion As String In Me.mSpelling.Suggestions(word.Word)
                    Me.ContextItem(base, "Spelling: " + suggestion, "spelling:replace:" + suggestion, Not Me.IsReadOnly And Me.SelectionCount = 1)
                Next
                Me.ContextItem(base, "Ignore “" + word.Word + "” in This Editor", "spelling:ignore", True)
                base.AddSeparator()
                Exit For
            End If
        Next
        Dim symbol As StudioEditorSymbol = Me.mContextSymbol
        If symbol <> Nil Then
            Dim label As String = symbol.QualifiedName
            If String.Len(label) > 40 Then label = String.Left(label, 39) + "…"
            If symbol.IsKeyword() Then
                Me.ContextItem(base, "Documentation for “" + label + "”", "symbol:documentation", True)
            Else
                Me.ContextItem(base, "Go to Definition", "symbol:definition", True)
                Me.ContextItem(base, "Find All References", "symbol:references", True)
                Me.ContextItem(base, "Show Type Info", "symbol:info", True)
                Me.ContextItem(base, "Documentation for “" + label + "”", "symbol:documentation", True)
                Me.ContextItem(base, "Rename Symbol…", "symbol:rename", Not Me.IsReadOnly)
                Me.ContextItem(base, "Find “" + symbol.Name + "” in Project", "symbol:findInProject", True)
            End If
            base.AddSeparator()
        End If
        If Me.SnippetProvider <> Nil And Not Me.IsReadOnly Then
            Dim names As Array Of String = Me.SnippetProvider.Choices(Me.mLanguageMode)
            If Array.Count(names) > 0 Then
                Dim snippets As New MenuItem()
                snippets.Caption = "Insert Snippet"
                snippets.Tag = "snippet:menu"
                For n As Integer = 0 To Math.Min(Array.LastIndex(names), 99)
                    Me.ContextItem(snippets, names(n), "snippet:" + String.From(n), True)
                Next
                base.AddMenuItem(snippets)
                base.AddSeparator()
            End If
        End If
        Me.mContextUndo = Me.ContextItem(base, "Undo", "undo", Not Me.IsReadOnly And RaiseEvent HistoryAvailable(False))
        Me.mContextRedo = Me.ContextItem(base, "Redo", "redo", Not Me.IsReadOnly And RaiseEvent HistoryAvailable(True))
        base.AddSeparator()
        Me.mContextCut = Me.ContextItem(base, "Cut", "cut", Me.SelectionLength > 0 And Not Me.IsReadOnly)
        Me.mContextCopy = Me.ContextItem(base, "Copy", "copy", Me.SelectionLength > 0)
        Me.mContextPaste = Me.ContextItem(base, "Paste", "paste", Not Me.IsReadOnly)
        base.AddSeparator()
        Me.mContextComment = Me.ContextItem(base, "Toggle Comment", "toggleComment", Not Me.IsReadOnly)
        Me.mContextAll = Me.ContextItem(base, "Select All", "selectAll", True)
    End Sub

    Private Function ContextItem(base As MenuItem, caption As String, tag As String, enabled As Boolean) As MenuItem
        Dim item As New MenuItem()
        item.Caption = caption
        item.Tag = tag
        item.Enabled = enabled
        base.AddMenuItem(item)
        Return item
    End Function

    Handle ContextualMenuAction(hitItem As MenuItem)
        If hitItem = Nil Then Return
        If String.StartsWith(hitItem.Tag, "spelling:") Then
            Dim word As StudioSpellingWord = Me.mContextSpelling
            If word = Nil Then Return
            If hitItem.Tag = "spelling:ignore" Then
                Me.IgnoreSpelling(word.Word)
            ElseIf Not Me.IsReadOnly And Me.SelectionCount = 1 And Me.mContextSpellingLine >= 0 And Me.mContextSpellingLine < Me.LineCount Then
                ' Refuse a stale menu after another edit.
                If Me.mLines(Me.mContextSpellingLine) <> Me.mContextSpellingSource Then Return
                Dim replacement As String = String.Substring(hitItem.Tag, 17)
                If word.Word = String.UCase(word.Word) Then
                    replacement = String.UCase(replacement)
                ElseIf String.Left(word.Word, 1) = String.UCase(String.Left(word.Word, 1)) Then
                    replacement = String.UCase(String.Left(replacement, 1)) + String.Substring(replacement, 1)
                End If
                Me.EditRange(Me.LineStartPosition(Me.mContextSpellingLine) + word.Start, word.Length, replacement, -1, -1, "spelling")
            End If
            Return
        End If
        If String.StartsWith(hitItem.Tag, "snippet:") Then
            Dim index As Integer = Integer.Parse(String.Substring(hitItem.Tag, 8)).Or(-1)
            If index >= 0 And Me.SnippetProvider <> Nil Then
                Dim expansion As StudioSnippetExpansion = Me.SnippetProvider.ExpandChoice(index, Me.mLanguageMode)
                If expansion <> Nil Then Me.InsertSnippetExpansion(expansion.Text, expansion.Indexes, expansion.Starts, expansion.Lengths, expansion.FinalCaret)
            End If
            Return
        End If
        If String.StartsWith(hitItem.Tag, "symbol:") Then
            Dim symbol As StudioEditorSymbol = Me.mContextSymbol
            If symbol = Nil Then symbol = Me.SymbolAt(Me.mCaret)
            If symbol <> Nil Then RaiseEvent SymbolAction(String.Substring(hitItem.Tag, 7), symbol)
            Return
        End If
        Me.PerformCommand(hitItem.Tag, False)
    End Handle

    ''' Raise SymbolAction for the symbol at the caret (keyboard shortcuts such as F12).
    ''' Returns False when the caret is not on an identifier or keyword.
    Public Function RequestSymbolAction(action As String) As Boolean
        Dim symbol As StudioEditorSymbol = Me.SymbolAt(Me.mCaret)
        If symbol = Nil Then Return False
        If symbol.IsKeyword() And action <> "documentation" Then action = "documentation"
        RaiseEvent SymbolAction(action, symbol)
        Return True
    End Function

    ''' The identifier or keyword touching a position (at or just before it), or Nil
    ''' inside strings, comments, numbers, punctuation and whitespace.
    Public Function SymbolAt(position As Integer) As StudioEditorSymbol
        Dim lineIndex As Integer = Me.LineOfPosition(Me.Clamp(position))
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = Me.Clamp(position) - Me.mStarts(lineIndex)
        Dim count As Integer = Array.Count(codes)
        If column >= count Or Not EditorIsWordCode(String.Asc(codes(Math.Min(column, count - 1)))) Then
            ' Caret just after a word: use that word.
            If column > 0 And column <= count Then
                If EditorIsWordCode(String.Asc(codes(column - 1))) Then column -= 1
            End If
        End If
        If column >= count Or column < 0 Then Return Nil
        If Not EditorIsWordCode(String.Asc(codes(column))) Then Return Nil
        Dim first As Integer = column
        While first > 0
            If Not EditorIsWordCode(String.Asc(codes(first - 1))) Then Exit While
            first -= 1
        End While
        Dim last As Integer = column
        While last + 1 < count
            If Not EditorIsWordCode(String.Asc(codes(last + 1))) Then Exit While
            last += 1
        End While
        Dim kind As StudioTokenKind = StudioTokenKind.Plain
        For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
            If first >= token.Start And first < token.Start + token.Length Then
                kind = token.Kind
                Exit For
            End If
        Next
        Select Case kind
        Case StudioTokenKind.Comment, StudioTokenKind.Text, StudioTokenKind.Number, StudioTokenKind.ColorLiteral
            Return Nil
        End Select
        Dim name As String = ""
        For i As Integer = first To last
            name += codes(i)
        Next
        If String.Asc(codes(first)) >= 48 And String.Asc(codes(first)) <= 57 Then Return Nil
        ' Qualifier: preceding ".word" segments (String.Trim, Me.Editor.Text).
        Dim qualified As String = name
        Dim cursor As Integer = first
        While cursor >= 2
            If codes(cursor - 1) <> "." Then Exit While
            Dim segmentEnd As Integer = cursor - 2
            If Not EditorIsWordCode(String.Asc(codes(segmentEnd))) Then Exit While
            Dim segmentStart As Integer = segmentEnd
            While segmentStart > 0
                If Not EditorIsWordCode(String.Asc(codes(segmentStart - 1))) Then Exit While
                segmentStart -= 1
            End While
            Dim segment As String = ""
            For i As Integer = segmentStart To segmentEnd
                segment += codes(i)
            Next
            qualified = segment + "." + qualified
            cursor = segmentStart
        End While
        Dim symbol As New StudioEditorSymbol()
        symbol.Name = name
        symbol.QualifiedName = qualified
        symbol.Kind = kind
        symbol.Line = lineIndex
        symbol.Column = first
        symbol.Position = Me.mStarts(lineIndex) + first
        Return symbol
    End Function

    ' ---- Drawing -----------------------------------------------------------------------

    ''' The whole editor frame. Carets are recorded (RecordCaret) and drawn last as a
    ''' layer (DrawCaretLayer), except while rendering the cached blink underlay.
    Private Sub RenderFrame(g As Graphics)
        Me.ClearCaretRecords()
        Dim font As String = Me.FontName
        Dim size As Double = Me.FontSize
        Dim measureKey As String = font + "/" + String.From(size)
        If Me.mMeasuredFor <> measureKey Then
            Dim measured As Double = g.MeasureStringWidth("MMMMMMMMMMMMMMMMMMMM", font, size) / 20.0
            If measured > 0.5 Then Me.mCharWidth = measured
            Me.mMeasuredFor = measureKey
            Me.SetScroll(Me.mScrollX, Me.mScrollY)
        End If
        Dim dark As Boolean = Me.IsDark
        Dim theme As New StudioCodeEditorTheme(dark)
        Dim w As Double = Me.Width
        Dim h As Double = Me.Height
        ' Right edge of the text area (the minimap's left edge when it is shown).
        Dim right As Double = Me.TextRight()
        Dim lineHeight As Double = Me.LineHeight
        Dim gutter As Double = Me.GutterWidth()
        Dim left As Double = Me.TextLeft()
        Dim cw As Double = Me.mCharWidth
        Dim baseline As Double = Me.BaselineOffset()
        ' Where DrawString is asked to put text so its ink sits on `baseline`.
        Dim textBaseline As Double = baseline + Me.DrawStringLift(size)
        g.FillRect(0, 0, w, h, theme.Background)
        ' Visible rows and the lines they show (collapsed fold bodies are skipped).
        Dim lastRow As Integer = Me.RowCount() - 1
        Dim firstRow As Integer = Math.Floor((Me.mScrollY - Me.TopPadding()) / lineHeight)
        firstRow = Math.Max(0, Math.Min(firstRow, lastRow))
        Dim lastShownRow As Integer = Math.Floor((Me.mScrollY + h) / lineHeight)
        lastShownRow = Math.Min(lastRow, lastShownRow + 1)
        ' One entry per logical line (soft wrap draws a line's rows together).
        Dim visible As Array Of Integer = []
        For row As Integer = firstRow To lastShownRow
            Dim rowLine As Integer = Me.LineOfRow(row)
            If Array.Count(visible) = 0 Then
                Array.Append(visible, rowLine)
            ElseIf Array.Last(visible) <> rowLine Then
                Array.Append(visible, rowLine)
            End If
        Next
        Dim firstVisible As Integer = visible(0)
        Dim lastVisible As Integer = Array.Last(visible)
        ' Every selection (multi-cursor); only those reaching the visible lines are drawn.
        Dim selAnchors As Array Of Integer = []
        Dim selCarets As Array Of Integer = []
        Dim primaryIndex As Integer = Me.SortedSelections(selAnchors, selCarets)
        Dim viewStart As Integer = Me.mStarts(firstVisible)
        Dim viewEnd As Integer = Me.NavLineEnd(Me.RowEndLine(lastVisible))
        Dim shown As Array Of Integer = []
        Dim activeLines As Array Of Integer = []
        For k As Integer = 0 To Array.LastIndex(selCarets)
            If Math.Max(selAnchors(k), selCarets(k)) < viewStart Or Math.Min(selAnchors(k), selCarets(k)) > viewEnd Then Continue For
            Array.Append(shown, k)
            Array.Append(activeLines, Me.ActiveLineOf(selAnchors(k), selCarets(k)))
        Next
        activeLines = EditorUniqueSorted(activeLines)
        ' Line backgrounds: current lines, lines with problems, the debugger's stop.
        Dim lastBand As Integer = -1
        For Each k As Integer In shown
            If selAnchors(k) <> selCarets(k) Then Continue For
            Dim bandLine As Integer = Me.ActiveLineOf(selAnchors(k), selCarets(k))
            If bandLine <> lastBand And Me.IsLineDrawn(bandLine, firstVisible, lastVisible) Then
                g.FillRect(gutter, Me.LineTop(bandLine), right - gutter, lineHeight * Me.LineRowSpan(bandLine), theme.CurrentLine)
            End If
            lastBand = bandLine
        Next
        For Each marker As StudioEditorMarker In Me.mMarkers
            If Me.IsLineDrawn(marker.Line, firstVisible, lastVisible) Then
                If marker.Severity = StudioMarkerSeverity.Failure Then
                    g.FillRect(gutter, Me.LineTop(marker.Line), right - gutter, lineHeight * Me.LineRowSpan(marker.Line), theme.FailureLine)
                ElseIf marker.Severity = StudioMarkerSeverity.Warning Then
                    g.FillRect(gutter, Me.LineTop(marker.Line), right - gutter, lineHeight * Me.LineRowSpan(marker.Line), theme.WarningLine)
                End If
            End If
        Next
        If Me.IsLineDrawn(Me.mExecutionLine, firstVisible, lastVisible) Then
            g.FillRect(gutter, Me.LineTop(Me.mExecutionLine), right - gutter, lineHeight * Me.LineRowSpan(Me.mExecutionLine), theme.ExecutionLine)
        End If
        ' Find matches, then the selection over them.
        If Me.mFindQuery <> "" Then
            For Each i As Integer In visible
                Me.DrawFindMatches(g, i, left, lineHeight, theme)
            Next
        End If
        If Me.HighlightsWordOccurrences And Me.SelectionLength = 0 And String.Len(Me.mIncomplete) = 0 Then
            Me.DrawWordOccurrences(g, visible, left, lineHeight, theme)
        End If
        For Each k As Integer In shown
            Dim selStart As Integer = Math.Min(selAnchors(k), selCarets(k))
            Dim selEnd As Integer = Math.Max(selAnchors(k), selCarets(k))
            If selStart = selEnd Then Continue For
            For Each i As Integer In visible
                Dim lineStart As Integer = Me.mStarts(i)
                Dim lineEnd As Integer = lineStart + String.Len(Me.mLines(i))
                If selEnd < lineStart Or selStart > lineEnd Then Continue For
                If selEnd = lineStart And i > 0 And selStart < lineStart Then Continue For
                Dim fromColumn As Integer = Math.Max(selStart, lineStart) - lineStart
                Dim toColumn As Integer = Math.Min(selEnd, lineEnd) - lineStart
                ' One band per visual row (one row unless soft wrap splits the line).
                Dim wrap As StudioWrapLine = Me.SegmentsOf(i)
                Dim lineLength As Integer = lineEnd - lineStart
                For seg As Integer = 0 To wrap.Count - 1
                    Dim segFirst As Integer = wrap.Starts(seg)
                    Dim segEnd As Integer = wrap.SegmentEnd(seg, lineLength)
                    Dim lastSeg As Boolean = seg = wrap.Count - 1
                    If toColumn < segFirst Or fromColumn > segEnd Then Continue For
                    ' Ends where this row starts, or starts at a break (drawn on the next row).
                    If seg > 0 And toColumn = segFirst Then Continue For
                    If Not lastSeg And fromColumn = segEnd Then Continue For
                    Dim origin As Double = Me.SegmentOriginX(i, wrap, seg)
                    Dim x1 As Double = origin + Me.VisualColumn(Me.mLines(i), Math.Max(fromColumn, segFirst)) * cw
                    Dim x2 As Double = origin + Me.VisualColumn(Me.mLines(i), Math.Min(toColumn, segEnd)) * cw
                    ' A selected line break runs the band to the right edge, and a selection
                    ' continuing from the line above starts at the gutter, so whole-line and
                    ' multi-line selections read as one solid block (TextEdit/Xcode style).
                    ' A selection running on past a wrapped row does the same.
                    If lastSeg Then
                        If selEnd > lineEnd Then x2 = right
                    ElseIf toColumn > segEnd Or selEnd > lineEnd Then
                        x2 = right
                    End If
                    If seg = 0 Then
                        If fromColumn = 0 And (selStart < lineStart Or selEnd > lineEnd) Then x1 = gutter
                    ElseIf fromColumn <= segFirst Then
                        x1 = gutter
                    End If
                    x1 = Math.Max(gutter, x1)
                    x2 = Math.Min(right, x2)
                    If x2 > x1 Then g.FillRect(x1, Me.LineTop(i) + seg * lineHeight, Math.Max(1.0, x2 - x1), lineHeight, theme.Selection)
                Next
            Next
        Next
        g.Save()
        g.ClipToRect(gutter, 0, Math.Max(1.0, right - gutter), h)
        ' Matching bracket pair around the caret (code only, not strings or comments).
        If Me.SelectionLength = 0 And String.Len(Me.mIncomplete) = 0 Then
            Dim origin As Integer = -1
            Dim partner As Integer = Me.BracketPair(Me.mCaret, origin)
            If partner >= 0 Then
                If Not Me.IsLineHidden(Me.LineOfPosition(origin)) Then Me.DrawBracketBox(g, origin, left, lineHeight, theme)
                If Not Me.IsLineHidden(Me.LineOfPosition(partner)) Then Me.DrawBracketBox(g, partner, left, lineHeight, theme)
            End If
        End If
        If Me.mShowsIndentGuides Then Me.DrawIndentGuides(g, visible, left, theme)
        For Each i As Integer In visible
            Me.DrawSnippetRanges(g, i, left, theme)
        Next
        ' Highlighted text, visible lines only, on the cell grid.
        For Each i As Integer In visible
            Dim line As String = Me.mLines(i)
            If line = "" Then Continue For
            Dim y As Double = Me.LineTop(i)
            Dim info As StudioSyntaxLine = Me.LineTokens(i)
            Dim simple As Boolean = Me.IsSimpleLine(line)
            Dim layout As StudioLineLayout = Nil
            Dim chars As Array Of String = []
            If Not simple Then
                layout = Me.LayoutOf(line)
                chars = String.Chars(line)
            End If
            ' Each visual row draws its segment's columns from its own origin (one row
            ' at the scroll origin unless soft wrap splits the line).
            Dim wrap As StudioWrapLine = Me.SegmentsOf(i)
            Dim lineLength As Integer = String.Len(line)
            For seg As Integer = 0 To wrap.Count - 1
                Dim rowY As Double = y + seg * lineHeight
                If rowY > h Then Exit For
                If rowY + lineHeight < 0 Then Continue For
                Dim segFirst As Integer = wrap.Starts(seg)
                Dim segEnd As Integer = wrap.SegmentEnd(seg, lineLength)
                Dim origin As Double = Me.SegmentOriginX(i, wrap, seg)
                For Each token As StudioSyntaxToken In info.Tokens
                    If token.Start >= segEnd Then Exit For
                    Dim a As Integer = Math.Max(token.Start, segFirst)
                    Dim b As Integer = Math.Min(token.Start + token.Length, segEnd)
                    If b <= a Then Continue For
                    Dim firstCell As Integer = a
                    Dim endCell As Integer = b
                    If Not simple Then
                        firstCell = layout.CellOf(a)
                        endCell = layout.CellOf(b)
                    End If
                    Dim x As Double = origin + firstCell * cw
                    If x > right Then Exit For
                    If origin + endCell * cw < gutter Then Continue For
                    Dim tint As Color = theme.ForKind(token.Kind)
                    Dim whole As Boolean = a = token.Start And b = token.Start + token.Length
                    If token.Kind = StudioTokenKind.ColorLiteral And whole Then
                        Me.DrawColorLiteral(g, String.Substring(line, token.Start, token.Length), x, rowY, textBaseline, theme)
                    ElseIf token.Kind = StudioTokenKind.Punctuation And token.Length > 1 And Not Me.mFontLigatures Then
                        ' One cell per call: the shaper never sees "!=" or "=>" together.
                        For k As Integer = a To b - 1
                            If simple Then
                                g.DrawString(String.Substring(line, k, 1), origin + k * cw, rowY + textBaseline, font, size, tint)
                            Else
                                Me.DrawClusters(g, chars, layout, k, 1, origin, rowY + textBaseline, tint)
                            End If
                        Next
                    ElseIf simple Then
                        g.DrawString(String.Substring(line, a, b - a), x, rowY + textBaseline, font, size, tint)
                    Else
                        Me.DrawClusters(g, chars, layout, a, b - a, origin, rowY + textBaseline, tint)
                    End If
                Next
            Next
        Next
        If Me.mRenderWhitespace <> "none" Then
            Dim spaceAnchors As Array Of Integer = Me.AllAnchors()
            Dim spaceCarets As Array Of Integer = Me.AllCarets()
            For Each i As Integer In visible
                Dim wrap As StudioWrapLine = Me.SegmentsOf(i)
                For seg As Integer = 0 To wrap.Count - 1
                    Dim segEnd As Integer = wrap.SegmentEnd(seg, String.Len(Me.mLines(i)))
                    Me.DrawWhitespace(g, i, seg, wrap.Starts(seg), segEnd, Me.LineTop(i) + seg * lineHeight, Me.SegmentOriginX(i, wrap, seg), spaceAnchors, spaceCarets, theme)
                Next
            Next
        End If
        ' Collapsed folds: a "⋯" pill after the header's text.
        If Array.Count(Me.mFolded) > 0 And Me.mShowsFolding Then
            For Each i As Integer In visible
                If Me.IsFolded(i) Then Me.DrawFoldPill(g, i, lineHeight, baseline, theme)
            Next
        End If
        If Me.SpellCheckEnabled And Me.AllowsSpellCheck Then
            For Each i As Integer In visible
                For Each word As StudioSpellingWord In Me.PaintedSpelling(i)
                    Dim rects As Array Of Double = Me.ColumnRects(i, word.Start, word.Start + word.Length)
                    For r As Integer = 0 To Array.Count(rects) \ 3 - 1
                        Me.DrawSquiggle(g, rects(r * 3), rects(r * 3 + 1), rects(r * 3 + 2) + baseline + 2.0, theme.ForSeverity(StudioMarkerSeverity.Hint))
                    Next
                Next
            Next
        End If
        Me.DrawMarkerDetails(g, firstVisible, lastVisible, left, lineHeight, baseline, theme)
        ' Pending input-method text, underlined, at the composition origin.
        Dim caretX As Double = 0.0
        Dim caretY As Double = 0.0
        Me.CaretPoint(Me.mCaret, caretX, caretY)
        If String.Len(Me.mIncomplete) > 0 Then
            Dim origin As Integer = Me.SelectionStart
            If Me.mCompositionStart >= 0 Then origin = Me.mCompositionStart
            Me.CaretPoint(origin, caretX, caretY)
            Dim width As Double = g.MeasureStringWidth(Me.mIncomplete, font, size)
            g.FillRect(caretX, caretY, width + 2, lineHeight, theme.Background)
            g.DrawString(Me.mIncomplete, caretX, caretY + textBaseline, font, size, theme.Ink)
            g.DrawLine(caretX, caretY + baseline + 3, caretX + width, caretY + baseline + 3, 1, theme.Caret)
            caretX += g.MeasureStringWidth(String.Left(Me.mIncomplete, Me.mIncompleteCursor), font, size)
        End If
        Me.mCaretX = caretX
        Me.mCaretY = caretY
        Me.mCaretTheme = theme
        Me.mCaretLineHeight = lineHeight
        Me.mCaretTextBaseline = textBaseline
        If caretX >= gutter - 1 And Me.ShowsCaret() Then
            Dim caretColor As Color = theme.Caret
            If Not Me.mFocused Then caretColor = theme.GutterText
            Dim caretAt As Integer = Me.mCaret
            If String.Len(Me.mIncomplete) > 0 Then caretAt = -1
            Me.RecordCaret(caretAt, caretX, caretY, caretColor)
        End If
        ' Secondary cursors (hidden like the primary when their selection ends at a
        ' line break, or inside a collapsed fold).
        For Each k As Integer In shown
            If k = primaryIndex Or Me.EndsAtLineBreak(selAnchors(k), selCarets(k)) Then Continue For
            If Not Me.IsLineDrawn(Me.LineOfPosition(selCarets(k)), firstVisible, lastVisible) Then Continue For
            Dim otherX As Double = 0.0
            Dim otherY As Double = 0.0
            Me.CaretPoint(selCarets(k), otherX, otherY)
            If otherX < gutter - 1 Then Continue For
            Dim otherColor As Color = theme.SecondaryCaret
            If Not Me.mFocused Then otherColor = theme.GutterText
            Me.RecordCaret(selCarets(k), otherX, otherY, otherColor)
        Next
        ' Where dragged text would land: a caret with serifs.
        If Me.mDropPosition >= 0 And Not Me.DropIsNoOp() Then
            Dim dropLine As Integer = Me.LineOfPosition(Me.mDropPosition)
            If Me.IsLineDrawn(dropLine, firstVisible, lastVisible) Then
                Dim dropX As Double = 0.0
                Dim dropY As Double = 0.0
                Me.CaretPoint(Me.mDropPosition, dropX, dropY)
                ' Full line height like the caret, with serifs at both ends.
                g.FillRect(dropX - 1.0, dropY, 2, lineHeight, theme.Caret)
                g.FillRect(dropX - 3.0, dropY, 6, 1.5, theme.Caret)
                g.FillRect(dropX - 3.0, dropY + lineHeight - 1.5, 6, 1.5, theme.Caret)
                If Me.mDropCopy Then
                    ' Copy: a small plus beside the indicator.
                    g.FillRect(dropX + 4.0, dropY + 5.0, 6, 1.5, theme.Caret)
                    g.FillRect(dropX + 6.25, dropY + 2.75, 1.5, 6, theme.Caret)
                End If
            End If
        End If
        g.Restore()
        ' Gutter: breakpoint lane, execution arrow, problem badges, line numbers, folds.
        If gutter > 0 Then
            g.FillRect(0, 0, gutter, h, theme.GutterBackground)
            g.DrawLine(gutter - 0.5, 0, gutter - 0.5, h, 1, theme.GutterLine)
        End If
        Dim lane As Double = Me.LaneWidth()
        Dim numberSize As Double = Math.Max(8.0, size - 1.0)
        Dim numberRight As Double = gutter - 10.0
        If Me.mShowsFolding Then numberRight = gutter - 18.0
        ' Chevrons: every foldable line while the pointer is over the gutter, collapsed
        ' regions always (VS Code's "mouseover").
        Dim chevrons As Boolean = Me.mShowsFolding And (Me.mGutterHover Or Array.Count(Me.mFolded) > 0)
        Dim gutterRows As Array Of Integer = visible
        If gutter <= 0 Then gutterRows = []
        For Each i As Integer In gutterRows
            Dim label As String = String.From(i + 1)
            Dim y As Double = Me.LineTop(i)
            If Me.mShowsBreakpoints And Me.HasBreakpoint(i) Then
                g.FillRoundedRect(2, y + lineHeight / 2.0 - 5.0, lane - 4, 10, 3, theme.Breakpoint)
            End If
            If i = Me.mExecutionLine Then
                Dim mid As Double = y + lineHeight / 2.0
                g.BeginPath()
                g.MoveTo(2, mid - 4)
                g.LineTo(8, mid - 4)
                g.LineTo(13, mid)
                g.LineTo(8, mid + 4)
                g.LineTo(2, mid + 4)
                g.ClosePath()
                g.FillPath(theme.ExecutionArrow)
            End If
            Dim tint As Color = theme.GutterText
            If EditorContainsSorted(activeLines, i) Then tint = theme.Ink
            Dim labelWidth As Double = String.Len(label) * cw * numberSize / size
            g.DrawString(label, numberRight - labelWidth, y + baseline + Me.DrawStringLift(numberSize), font, numberSize, tint)
            If chevrons Then
                If Me.IsFolded(i) Then
                    Me.DrawFoldChevron(g, Me.FoldChevronX(), y + lineHeight / 2.0, True, theme.Ink)
                ElseIf Me.mGutterHover Then
                    If Me.FoldEnd(i) > i Then Me.DrawFoldChevron(g, Me.FoldChevronX(), y + lineHeight / 2.0, False, theme.FoldMarker)
                End If
            End If
        Next
        For Each i As Integer In gutterRows
            Dim marker As StudioEditorMarker = Me.GutterMarker(i)
            If marker <> Nil Then
                Me.DrawProblemGlyph(g, lane + 7.0, Me.LineTop(i) + lineHeight / 2.0, marker.Severity, theme)
            End If
        Next
        Me.DrawStickyScopes(g, gutter, right, left, numberRight, numberSize, baseline, theme)
        If Me.mMacroRecording Then g.FillOval(right - 14.0, 6.0, 8, 8, theme.FailureInk)
        If Me.mShowsMinimap Then Me.DrawMinimap(g, theme, dark)
        ' Overlay scrollbars.
        Dim thumb As Double = 0.0
        Dim extent As Double = 0.0
        If Me.VerticalThumb(thumb, extent) Then
            g.FillRoundedRect(w - Me.ScrollbarSize() + 2, thumb + 2, Me.ScrollbarSize() - 4, extent - 4, 3, theme.Scrollbar)
        End If
        If Me.HorizontalThumb(thumb, extent) Then
            g.FillRoundedRect(thumb + 2, h - Me.ScrollbarSize() + 2, extent - 4, Me.ScrollbarSize() - 4, 3, theme.Scrollbar)
        End If
        ' Caret layer: above everything in the text area, below the sticky scope headers.
        Me.mCaretClipLeft = gutter
        Me.mCaretClipRight = right
        Me.mCaretClipTop = 0.0
        If Me.mShowsStickyScopes And Array.Count(Me.mStickyLines) > 0 Then Me.mCaretClipTop = Array.Count(Me.mStickyLines) * lineHeight + 2.0
        If Not Me.mSuppressCarets Then Me.DrawCaretLayer(g)
        Me.DrawInlineCompletion(g, theme)
        Me.DrawCompletionOverlay(g, theme)
    End Sub

    ''' True when a line is on screen in this paint (not hidden in a collapsed fold).
    Private Function IsLineDrawn(lineIndex As Integer, firstVisible As Integer, lastVisible As Integer) As Boolean
        If lineIndex < firstVisible Or lineIndex > lastVisible Then Return False
        Return Not Me.IsLineHidden(lineIndex)
    End Function

    ''' Draws codepoints [first, first+count) of a non-simple line at their cells: ASCII
    ''' runs in one call, every other cluster (base + marks, ZWJ/flag sequence) as one
    ''' string at its cluster's first cell.
    Private Sub DrawClusters(g As Graphics, chars As Array Of String, layout As StudioLineLayout, first As Integer, count As Integer, originX As Double, baselineY As Double, tint As Color)
        Dim cw As Double = Me.mCharWidth
        Dim limit As Integer = Math.Min(first + count, layout.Count)
        Dim run As String = ""
        Dim runCell As Integer = 0
        Dim i As Integer = first
        While i < limit
            Dim code As Integer = String.Asc(chars(i))
            If code < 128 And code <> 9 And layout.Boundary(i + 1) Then
                If run = "" Then runCell = layout.Visual(i)
                run += chars(i)
                i += 1
            Else
                If String.Trim(run) <> "" Then g.DrawString(run, originX + runCell * cw, baselineY, Me.FontName, Me.FontSize, tint)
                run = ""
                Dim cluster As String = chars(i)
                Dim j As Integer = i + 1
                While j < limit And Not layout.Boundary(j)
                    cluster += chars(j)
                    j += 1
                Wend
                If code <> 9 And code <> 32 Then g.DrawString(cluster, originX + layout.Visual(layout.StopBefore(i)) * cw, baselineY, Me.FontName, Me.FontSize, tint)
                i = j
            End If
        Wend
        If String.Trim(run) <> "" Then g.DrawString(run, originX + runCell * cw, baselineY, Me.FontName, Me.FontSize, tint)
    End Sub

    ''' Word highlight: a soft box behind every visible whole-word, case-sensitive
    ''' occurrence of the identifier at the caret (not keywords, strings or comments).
    Private Sub DrawWordOccurrences(g As Graphics, visible As Array Of Integer, left As Double, lineHeight As Double, theme As StudioCodeEditorTheme)
        Dim symbol As StudioEditorSymbol = Me.SymbolAt(Me.mCaret)
        If symbol = Nil Then Return
        If symbol.IsKeyword() Then Return
        Dim name As String = symbol.Name
        Dim length As Integer = String.Len(name)
        If length = 0 Then Return
        Dim count As Integer = 0
        For Each i As Integer In visible
            Dim line As String = Me.mLines(i)
            If Not String.Contains(line, name) Then Continue For
            Dim hit As Integer = String.IndexOf(line, name, 0, True)
            While hit >= 0
                If Me.IsWholeWordAt(line, hit, length) Then
                    Dim rects As Array Of Double = Me.ColumnRects(i, hit, hit + length)
                    For r As Integer = 0 To Array.Count(rects) \ 3 - 1
                        g.FillRoundedRect(rects(r * 3), rects(r * 3 + 2) + 1.5, rects(r * 3 + 1) - rects(r * 3), lineHeight - 3.0, 2, theme.WordHighlight)
                    Next
                    count += 1
                End If
                hit = String.IndexOf(line, name, hit + length, True)
            Wend
            If count > 400 Then Exit For
        Next
    End Sub

    Private Function FindHitsOnLine(lineIndex As Integer) As Array Of StudioFindHit
        Dim hits As Array Of StudioFindHit = Me.RegexHighlights()
        Dim visible As Array Of StudioFindHit = []
        Dim first As Integer = Me.mStarts(lineIndex)
        Dim last As Integer = first + String.Len(Me.mLines(lineIndex))
        Dim lo As Integer = 0
        Dim hi As Integer = Array.Count(hits)
        While lo < hi
            Dim mid As Integer = (lo + hi) \ 2
            If hits(mid).Start + hits(mid).Length < first Then
                lo = mid + 1
            Else
                hi = mid
            End If
        Wend
        For i As Integer = lo To Array.Count(hits) - 1
            If hits(i).Start > last Then Exit For
            visible.Append(hits(i))
        Next
        Return visible
    End Function

    Private Sub DrawFindMatches(g As Graphics, lineIndex As Integer, left As Double, lineHeight As Double, theme As StudioCodeEditorTheme)
        Dim line As String = Me.mLines(lineIndex)
        For Each hit As StudioFindHit In Me.FindHitsOnLine(lineIndex)
            Dim first As Integer = Math.Max(hit.Start, Me.mStarts(lineIndex)) - Me.mStarts(lineIndex)
            Dim last As Integer = Math.Min(hit.Start + hit.Length, Me.mStarts(lineIndex) + String.Len(line)) - Me.mStarts(lineIndex)
            Dim rects As Array Of Double = Me.ColumnRects(lineIndex, first, last)
            For r As Integer = 0 To Array.Count(rects) \ 3 - 1
                g.FillRoundedRect(rects(r * 3) - 1, rects(r * 3 + 2) + 2, Math.Max(2, rects(r * 3 + 1) - rects(r * 3) + 2), lineHeight - 4, 3, theme.FindMatch)
            Next
        Next
    End Sub

    ''' Squiggles under marked ranges and one inline message per line (Xcode style),
    ''' truncated to the visible width.
    Private Sub DrawProblemGlyph(g As Graphics, x As Double, y As Double, severity As StudioMarkerSeverity, theme As StudioCodeEditorTheme)
        Dim ink As Color = theme.ForSeverity(severity)
        Select Case severity
            Case StudioMarkerSeverity.Failure
                ' Octagonal stop sign with an X, independent of colour perception.
                g.BeginPath()
                g.MoveTo(x - 2, y - 5)
                g.LineTo(x + 2, y - 5)
                g.LineTo(x + 5, y - 2)
                g.LineTo(x + 5, y + 2)
                g.LineTo(x + 2, y + 5)
                g.LineTo(x - 2, y + 5)
                g.LineTo(x - 5, y + 2)
                g.LineTo(x - 5, y - 2)
                g.ClosePath()
                g.FillPath(ink)
                g.DrawLine(x - 2, y - 2, x + 2, y + 2, 1.2, theme.GutterBackground)
                g.DrawLine(x + 2, y - 2, x - 2, y + 2, 1.2, theme.GutterBackground)
            Case StudioMarkerSeverity.Warning
                g.BeginPath()
                g.MoveTo(x, y - 5)
                g.LineTo(x + 5.5, y + 5)
                g.LineTo(x - 5.5, y + 5)
                g.ClosePath()
                g.FillPath(ink)
                g.DrawLine(x, y - 1.5, x, y + 1.5, 1.3, theme.GutterBackground)
                g.FillOval(x - 0.7, y + 2.8, 1.4, 1.4, theme.GutterBackground)
            Case StudioMarkerSeverity.Hint
                ' Light bulb and base.
                g.StrokeOval(x - 3.5, y - 5, 7, 7, 1.2, ink)
                g.DrawLine(x - 2, y + 2, x - 2, y + 3.5, 1.2, ink)
                g.DrawLine(x + 2, y + 2, x + 2, y + 3.5, 1.2, ink)
                g.DrawLine(x - 2, y + 3.5, x + 2, y + 3.5, 1.2, ink)
                g.DrawLine(x - 1, y + 5, x + 1, y + 5, 1.2, ink)
            Case Else
                g.StrokeOval(x - 5, y - 5, 10, 10, 1.2, ink)
                g.FillOval(x - 0.8, y - 3, 1.6, 1.6, ink)
                g.DrawLine(x, y - 0.5, x, y + 3, 1.4, ink)
        End Select
    End Sub

    Private Sub DrawMarkerDetails(g As Graphics, firstVisible As Integer, lastVisible As Integer, left As Double, lineHeight As Double, baseline As Double, theme As StudioCodeEditorTheme)
        If Array.Count(Me.mMarkers) = 0 Then Return
        Dim cw As Double = Me.mCharWidth
        Dim shownLines As Array Of Integer = []
        For Each marker As StudioEditorMarker In Me.mMarkers
            If Not Me.IsLineDrawn(marker.Line, firstVisible, lastVisible) Then Continue For
            Dim line As String = Me.mLines(marker.Line)
            Dim fromColumn As Integer = Math.Min(marker.Column, String.Len(line))
            Dim toColumn As Integer = Math.Min(String.Len(line), fromColumn + marker.Length)
            If marker.Length <= 0 Then
                fromColumn = String.Len(Me.LeadingWhitespace(line))
                toColumn = String.Len(line)
            End If
            Dim ink As Color = theme.ForSeverity(marker.Severity)
            Dim rects As Array Of Double = Me.ColumnRects(marker.Line, fromColumn, toColumn)
            For r As Integer = 0 To Array.Count(rects) \ 3 - 1
                Dim x1 As Double = rects(r * 3)
                Dim x2 As Double = rects(r * 3 + 1)
                If x2 - x1 < cw Then x2 = x1 + cw
                Me.DrawSquiggle(g, x1, x2, rects(r * 3 + 2) + baseline + 3.0, ink)
            Next
            Dim seen As Boolean = False
            For Each shown As Integer In shownLines
                If shown = marker.Line Then seen = True
            Next
            If seen Then Continue For
            Array.Append(shownLines, marker.Line)
            Dim others As Integer = Array.Count(Me.MarkersOnLine(marker.Line)) - 1
            Dim message As String = marker.Message
            Dim newline As Integer = String.IndexOf(message, "\n")
            If newline >= 0 Then message = String.Left(message, newline)
            If others > 0 Then message += "  (+" + String.From(others) + ")"
            ' After the line's end (its last visual row while soft wrapping).
            Dim x As Double = 0.0
            Dim y As Double = 0.0
            Me.CaretPoint(Me.mStarts(marker.Line) + String.Len(line), x, y)
            x += 3 * cw
            If Me.IsFolded(marker.Line) And Me.mShowsFolding Then x += Me.FoldPillWidth()
            ' Messages stop short of the scrollbar, or of the minimap when it is shown.
            Dim limit As Double = Me.Width - Me.ScrollbarSize() - 14.0
            If Me.mShowsMinimap Then limit = Me.TextRight() - 10.0
            Dim available As Double = limit - x
            If available < 48.0 Or message = "" Then Continue For
            Dim messageSize As Double = Math.Max(8.0, Me.FontSize - 1.0)
            Dim fitted As String = Me.FitText(g, message, available, messageSize)
            Dim width As Double = g.MeasureStringWidth(fitted, Me.FontName, messageSize)
            Dim pill As Color = theme.CurrentLine
            If marker.Severity = StudioMarkerSeverity.Failure Then pill = theme.FailureLine
            If marker.Severity = StudioMarkerSeverity.Warning Then pill = theme.WarningLine
            g.FillRoundedRect(x - 6.0, y + 3.0, width + 12.0, lineHeight - 6.0, 4, pill)
            g.DrawString(fitted, x, y + baseline - 0.5 + Me.DrawStringLift(messageSize), Me.FontName, messageSize, ink)
        Next
    End Sub

    Private Function FitText(g As Graphics, text As String, available As Double, size As Double) As String
        If g.MeasureStringWidth(text, Me.FontName, size) <= available Then Return text
        Dim low As Integer = 0
        Dim high As Integer = String.Len(text)
        While low < high
            Dim middle As Integer = (low + high + 1) \ 2
            If g.MeasureStringWidth(String.Left(text, middle) + "…", Me.FontName, size) <= available Then
                low = middle
            Else
                high = middle - 1
            End If
        Wend
        If low = 0 Then Return ""
        Return String.RTrim(String.Left(text, low)) + "…"
    End Function

    Private Sub DrawSquiggle(g As Graphics, x1 As Double, x2 As Double, y As Double, tint As Color)
        g.BeginPath()
        g.MoveTo(x1, y)
        Dim x As Double = x1
        Dim raised As Boolean = True
        While x < x2
            x = Math.Min(x2, x + 2.0)
            If raised Then
                g.LineTo(x, y - 1.5)
            Else
                g.LineTo(x, y + 0.5)
            End If
            raised = Not raised
        Wend
        g.StrokePath(1.0, tint)
    End Sub

    Private Sub DrawBracketBox(g As Graphics, position As Integer, left As Double, lineHeight As Double, theme As StudioCodeEditorTheme)
        Dim x As Double = 0.0
        Dim y As Double = 0.0
        Me.CaretPoint(position, x, y)
        g.StrokeRoundedRect(x - 0.5, y + 2.5, Me.mCharWidth + 1.0, lineHeight - 5.0, 2, 1, theme.BracketMatch)
    End Sub

    ''' The bracket adjacent to the caret (before it, then after it) and its partner's
    ''' position, or -1. Only brackets in code count; scanning stops 400 lines away.
    Private Function BracketPair(position As Integer, ByRef origin As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim brackets As Array Of Integer = Me.BracketColumns(lineIndex)
        For Each candidate As Integer In [column - 1, column]
            Dim k As Integer = 0
            While k + 1 < Array.Count(brackets)
                If brackets(k) = candidate Then
                    origin = Me.mStarts(lineIndex) + candidate
                    Return Me.MatchBracket(lineIndex, candidate, brackets(k + 1))
                End If
                k += 2
            Wend
        Next
        Return -1
    End Function

    ''' (column, code) pairs of brackets inside punctuation tokens of a line.
    Private Function BracketColumns(lineIndex As Integer) As Array Of Integer
        Dim found As Array Of Integer = []
        Dim line As String = Me.mLines(lineIndex)
        If Not (String.Contains(line, "(") Or String.Contains(line, ")") Or String.Contains(line, "[") Or String.Contains(line, "]") Or String.Contains(line, "{") Or String.Contains(line, "}")) Then Return found
        Dim chars As Array Of String = String.Chars(line)
        For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
            If token.Kind = StudioTokenKind.Punctuation Then
                For c As Integer = token.Start To token.Start + token.Length - 1
                    Select Case String.Asc(chars(c))
                    Case 40, 41, 91, 93, 123, 125
                        Array.Append(found, c)
                        Array.Append(found, String.Asc(chars(c)))
                    End Select
                Next
            End If
        Next
        Return found
    End Function

    Private Function MatchBracket(lineIndex As Integer, column As Integer, code As Integer) As Integer
        Dim partner As Integer = 0
        Dim forward As Boolean = True
        Select Case code
        Case 40
            partner = 41
        Case 91
            partner = 93
        Case 123
            partner = 125
        Case 41
            partner = 40
            forward = False
        Case 93
            partner = 91
            forward = False
        Case 125
            partner = 123
            forward = False
        End Select
        Dim depth As Integer = 0
        Dim i As Integer = lineIndex
        While i >= 0 And i <= Array.LastIndex(Me.mLines) And Math.Abs(i - lineIndex) <= 400
            Dim brackets As Array Of Integer = Me.BracketColumns(i)
            Dim count As Integer = Array.Count(brackets) \ 2
            For n As Integer = 0 To count - 1
                Dim k As Integer = n
                If Not forward Then k = count - 1 - n
                Dim c As Integer = brackets(k * 2)
                Dim found As Integer = brackets(k * 2 + 1)
                If i = lineIndex And forward And c <= column Then Continue For
                If i = lineIndex And Not forward And c >= column Then Continue For
                If found = code Then
                    depth += 1
                ElseIf found = partner Then
                    If depth = 0 Then Return Me.mStarts(i) + c
                    depth -= 1
                End If
            Next
            If forward Then
                i += 1
            Else
                i -= 1
            End If
        Wend
        Return -1
    End Function

    ''' Draw a run on the column grid. ASCII runs draw in one call; other text draws per
    ''' character so the caret, selection and hit-testing stay aligned.
    Private Sub DrawRun(g As Graphics, piece As String, x As Double, baselineY As Double, tint As Color)
        Dim value As String = piece
        If String.Contains(value, "\t") Then value = String.Replace(value, "\t", String.Space(Me.TabSize()))
        If String.LenBytes(value) = String.Len(value) Then
            g.DrawString(value, x, baselineY, Me.FontName, Me.FontSize, tint)
            Return
        End If
        Dim offset As Double = x
        For Each ch As String In String.Chars(value)
            If ch <> " " Then g.DrawString(ch, offset, baselineY, Me.FontName, Me.FontSize, tint)
            offset += Me.mCharWidth
        Next
    End Sub

    ''' `&cRRGGBB[AA]`, coloured per channel like the documentation viewer, with a swatch
    ''' bar under the literal.
    Private Sub DrawColorLiteral(g As Graphics, piece As String, x As Double, y As Double, baseline As Double, theme As StudioCodeEditorTheme)
        Dim cw As Double = Me.mCharWidth
        Me.DrawRun(g, String.Left(piece, 2), x, y + baseline, theme.Ink)
        Dim tints As Array Of Color = [theme.ChannelRed, theme.ChannelGreen, theme.ChannelBlue, theme.Muted]
        Dim channel As Integer = 0
        While 2 + channel * 2 < String.Len(piece) And channel < 4
            Me.DrawRun(g, String.Substring(piece, 2 + channel * 2, 2), x + (2 + channel * 2) * cw, y + baseline, tints(channel))
            channel += 1
        End While
        Dim codes As Array Of String = String.Chars(piece)
        If Array.Count(codes) >= 8 Then
            Dim r As Integer = EditorHexDigit(String.Asc(codes(2))) * 16 + EditorHexDigit(String.Asc(codes(3)))
            Dim gr As Integer = EditorHexDigit(String.Asc(codes(4))) * 16 + EditorHexDigit(String.Asc(codes(5)))
            Dim b As Integer = EditorHexDigit(String.Asc(codes(6))) * 16 + EditorHexDigit(String.Asc(codes(7)))
            g.FillRect(x + 2 * cw, y + Me.LineHeight - 3, (String.Len(piece) - 2) * cw, 2, Color.FromBytes(r, gr, b))
        End If
    End Sub

    ' ---- Native wheel / key hooks -----------------------------------------------------

    ''' Apply a native wheel delta. Line units (notches) scroll three lines.
    Public Sub NativeWheel(dx As Double, dy As Double, pixels As Boolean)
        If pixels Then
            Me.ScrollBy(dx, dy)
        Else
            Me.ScrollBy(dx * Me.mCharWidth * 6.0, dy * Me.LineHeight * 3.0)
        End If
    End Sub

    ''' Native key hook for shortcuts that bypass the input adapters (macOS Command
    ''' shortcuts without an AppKit selector, GTK Tab/Insert, Windows Ctrl shortcuts):
    ''' runs an editor command ("tab" = insertTab/insertBacktab). False while an input
    ''' method is composing or when the command is unknown, so the key stays native.
    Public Function NativeKey(key As String, shift As Boolean) As Boolean
        If String.Len(Me.mIncomplete) > 0 Then Return False
        Dim command As String = key
        If key = "tab" Then
            command = "insertTab"
            If shift Then command = "insertBacktab"
        End If
        If Not Me.PerformCommand(command, shift) Then Return False
        Me.Invalidate()
        Return True
    End Function

    Private Sub AttachWheel()
        #If TargetLinux Then
            If Me.mScrollController <> Nil Or Me.NativeWidget = Nil Then Return
            Dim controller As Ptr = EditorScrollNew(3)
            If controller = Nil Then Throw New RuntimeException("Could not create GTK scroll controller")
            EditorConnectScroll(controller, "scroll", AddressOf EditorGtkScroll, CType(Me.mSlot + 1, Ptr), Nil, 0)
            EditorAddController(Me.NativeWidget, controller)
            Me.mScrollController = controller
            ' Learn when GTK destroys the view so a late Close() never touches freed controllers.
            Me.mDestroyedWidget = Nil
            Me.mAttachedWidget = Me.NativeWidget
            Me.mDestroyHandler = EditorConnectWidget(Me.NativeWidget, "destroy", AddressOf EditorGtkDestroyed, CType(Me.mSlot + 1, Ptr), Nil, 0)
            ' GTK turns Shift+Tab into ISO_Left_Tab (reported as a plain key with no
            ' character); a capture-phase key controller sees Tab/Shift+Tab first.
            Dim keys As Ptr = EditorKeyNew()
            If keys <> Nil Then
                EditorKeyPhase(keys, 1)
                EditorConnectKey(keys, "key-pressed", AddressOf EditorGtkKey, CType(Me.mSlot + 1, Ptr), Nil, 0)
                EditorAddController(Me.NativeWidget, keys)
                Me.mTabController = keys
            End If
        #ElseIf TargetWindows Then
            If Me.mWheelWindow <> Nil Or Me.NativeWidget = Nil Then Return
            Dim slot As UInt64 = Me.mSlot + 1
            If EditorSetSubclass(Me.NativeWidget, AddressOf EditorWindowsProcedure, 21328 + slot, slot) = 0 Then Throw New RuntimeException("SetWindowSubclass failed")
            Me.mWheelWindow = Me.NativeWidget
        #ElseIf TargetMac Then
            EditorInstallMacMonitor()
        #End If
    End Sub

    Private Sub DetachWheel()
        #If TargetLinux Then
            Dim widget As Ptr = Me.mAttachedWidget
            Me.mAttachedWidget = Nil
            Dim alive As Boolean = widget <> Nil And widget <> Me.mDestroyedWidget
            If Me.mDestroyHandler <> 0 And alive Then EditorHandlerDisconnect(widget, Me.mDestroyHandler)
            Me.mDestroyHandler = 0
            Dim controller As Ptr = Me.mScrollController
            Me.mScrollController = Nil
            If controller <> Nil And alive Then
                EditorDisconnect(controller, 16, 0, 0, Nil, Nil, CType(Me.mSlot + 1, Ptr))
                EditorRemoveController(widget, controller)
            End If
            Dim keys As Ptr = Me.mTabController
            Me.mTabController = Nil
            If keys <> Nil And alive Then
                EditorDisconnect(keys, 16, 0, 0, Nil, Nil, CType(Me.mSlot + 1, Ptr))
                EditorRemoveController(widget, keys)
            End If
        #ElseIf TargetWindows Then
            Me.WindowsWheelDetached(True)
        #End If
    End Sub

    ' ---- Editor-track glue ---------------------------------------------------------------
    ' Edit groups (macro replay, transforms, snippets, column paste) raise TextChanged
    ' once; TrackFeatureEdit keeps snippet placeholders, auto-closed brackets and the
    ' expand-selection history aligned with every edit (called from ReplaceRange).

    Private Property mGroupDepth As Integer = 0
    Private Property mGroupEdited As Boolean = False

    Private Sub BeginEditGroup()
        Me.mGroupDepth += 1
    End Sub

    Private Sub EndEditGroup(kind As String)
        Me.mGroupDepth = Math.Max(0, Me.mGroupDepth - 1)
        If Me.mGroupDepth > 0 Then Return
        Dim changed As Boolean = Me.mGroupEdited
        Me.mGroupEdited = False
        Me.NormalizeSelections()
        If changed Then
            If kind <> "" Then Me.mEditKind = kind
            Me.mEditEnd = Me.mCaret
            Me.mContinuesTyping = False
        End If
        Me.EnsureCaretVisible()
        Me.Invalidate()
        If changed Then Me.RaiseTextChanged()
        Me.FinishInteraction()
    End Sub

    ''' Anchors of every selection, primary first (then secondary in their order).
    Private Function AllAnchors() As Array Of Integer
        Dim values As Array Of Integer = []
        Array.Append(values, Me.mAnchor)
        For Each value As Integer In Me.mExtraAnchors
            Array.Append(values, value)
        Next
        Return values
    End Function

    Private Function AllCarets() As Array Of Integer
        Dim values As Array Of Integer = []
        Array.Append(values, Me.mCaret)
        For Each value As Integer In Me.mExtraCarets
            Array.Append(values, value)
        Next
        Return values
    End Function

    ''' SetSelections from parallel arrays (index 0 primary).
    Private Sub SetSelectionArrays(anchors As Array Of Integer, carets As Array Of Integer)
        Dim picked As Array Of StudioEditorSelection = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Array.Append(picked, New StudioEditorSelection(anchors(i), carets(i)))
        Next
        Me.SetSelections(picked, 0)
    End Sub

    ''' Where a position moves when [start, start+removed) becomes `inserted` codepoints.
    ''' A position exactly at a pure insertion stays before it when `stickLeft`.
    Private Function MapPosition(position As Integer, start As Integer, removed As Integer, inserted As Integer, stickLeft As Boolean) As Integer
        If position < start Then Return position
        If position = start And removed = 0 Then
            If stickLeft Then Return position
            Return position + inserted
        End If
        If position >= start + removed Then Return position + inserted - removed
        Return start + Math.Min(position - start, inserted)
    End Function

    Private Sub TrackFeatureEdit(start As Integer, removed As Integer, inserted As Integer)
        For i As Integer = 0 To Array.LastIndex(Me.mSnippetStarts)
            Dim active As Boolean = Me.mSnippetIndexes(i) = Me.mSnippetActive
            Me.mSnippetStarts(i) = Me.MapPosition(Me.mSnippetStarts(i), start, removed, inserted, active)
            Me.mSnippetEnds(i) = Math.Max(Me.mSnippetStarts(i), Me.MapPosition(Me.mSnippetEnds(i), start, removed, inserted, Not active))
        Next
        If Me.mSnippetFinal >= 0 Then Me.mSnippetFinal = Me.MapPosition(Me.mSnippetFinal, start, removed, inserted, False)
        If Array.Count(Me.mAutoClosed) > 0 Then
            Dim kept As Array Of Integer = []
            For Each closer As Integer In Me.mAutoClosed
                If closer >= start And closer < start + removed Then Continue For
                Array.Append(kept, Me.MapPosition(closer, start, removed, inserted, False))
            Next
            Me.mAutoClosed = kept
        End If
        If Array.Count(Me.mExpandCounts) > 0 And Not Me.mExpanding Then
            Me.mExpandAnchors = []
            Me.mExpandCarets = []
            Me.mExpandCounts = []
        End If
    End Sub

    ''' Host text replacement (undo/redo, reload) ends editor-side edit state.
    Private Sub ResetFeatureState()
        Me.CloseCompletionPopup()
        Me.ShowCompletionHint("")
        If Me.InSnippet Then Me.EndSnippet()
        Me.mAutoClosed = []
        Me.mExpandAnchors = []
        Me.mExpandCarets = []
        Me.mExpandCounts = []
    End Sub

    ''' Typed text after a commit: macro recording, TextCommitted, completion triggers.
    Private Sub AfterCommit(value As String)
        Me.RecordMacroText(value)
        RaiseEvent TextCommitted(value, Me.mCaret)
        Me.NotifyCompletionTyping(value)
    End Sub

    ''' ExecuteCommand cases for the editor-track batch pseudo commands.
    Private Function ExecuteFeatureCommand(command As String) As Boolean
        Select Case command
        Case "@typeText"
            Me.TypeText(Me.mBatchPiece)
        Case "@replace"
            Me.EditRange(Me.SelectionStart, Me.SelectionLength, Me.mBatchPiece, -1, -1, "completion")
        Case "@expand"
            Me.ExpandOne()
        Case "@transformCase"
            Me.TransformCaseOne(Me.mBatchPiece)
        Case Else
            Return False
        End Select
        Return True
    End Function

    ''' Line text drawing for sticky headers (unwrapped, no selection), at row top `y`.
    Private Sub DrawLineTextAt(g As Graphics, lineIndex As Integer, y As Double, originX As Double, gutter As Double, right As Double, baseline As Double, theme As StudioCodeEditorTheme)
        Dim line As String = Me.mLines(lineIndex)
        If line = "" Then Return
        Dim font As String = Me.FontName
        Dim size As Double = Me.FontSize
        Dim cw As Double = Me.mCharWidth
        Dim simple As Boolean = Me.IsSimpleLine(line)
        Dim layout As StudioLineLayout = Nil
        Dim chars As Array Of String = []
        If Not simple Then
            layout = Me.LayoutOf(line)
            chars = String.Chars(line)
        End If
        For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
            Dim firstCell As Integer = token.Start
            If Not simple Then firstCell = layout.CellOf(token.Start)
            Dim x As Double = originX + firstCell * cw
            If x > right Then Exit For
            Dim tint As Color = theme.ForKind(token.Kind)
            If simple Then
                g.DrawString(String.Substring(line, token.Start, token.Length), x, y + baseline, font, size, tint)
            Else
                Me.DrawClusters(g, chars, layout, token.Start, token.Length, originX, y + baseline, tint)
            End If
        Next
    End Sub

    ''' Snippet placeholder outlines on one line (active index brighter).
    Private Sub DrawSnippetRanges(g As Graphics, lineIndex As Integer, left As Double, theme As StudioCodeEditorTheme)
        If Array.Count(Me.mSnippetIndexes) = 0 Then Return
        Dim lineStart As Integer = Me.mStarts(lineIndex)
        Dim line As String = Me.mLines(lineIndex)
        For k As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            Dim a As Integer = Me.mSnippetStarts(k) - lineStart
            Dim b As Integer = Me.mSnippetEnds(k) - lineStart
            If b < 0 Or a > String.Len(line) Then Continue For
            a = Math.Max(0, a)
            b = Math.Min(String.Len(line), b)
            Dim tint As Color = theme.SnippetRange
            If Me.mSnippetIndexes(k) = Me.mSnippetActive Then tint = theme.SnippetActive
            Dim rects As Array Of Double = Me.ColumnRects(lineIndex, a, b)
            For r As Integer = 0 To Array.Count(rects) \ 3 - 1
                Dim x1 As Double = rects(r * 3)
                Dim x2 As Double = rects(r * 3 + 1)
                g.StrokeRoundedRect(x1 - 1, rects(r * 3 + 2) + 1.5, Math.Max(2.0, x2 - x1 + 2), Me.LineHeight - 3, 3, 1, tint)
            Next
        Next
    End Sub

    ' ---- Snippet sessions ---------------------------------------------------------------
    ' An inserted snippet keeps its placeholders as document ranges (mapped through every
    ' edit). Tab / Shift+Tab select the next / previous placeholder index: all ranges of
    ' that index at once (linked mirrors become a multi-selection, so typing edits them
    ' together). Escape, reaching $0, or leaving the snippet ends the session.

    Private Property mSnippetIndexes As Array Of Integer = []
    Private Property mSnippetStarts As Array Of Integer = []
    Private Property mSnippetEnds As Array Of Integer = []
    Private Property mSnippetOrder As Array Of Integer = []
    Private Property mSnippetActive As Integer = -1
    Private Property mSnippetFinal As Integer = -1
    ''' Snippet source for Tab expansion and the context menu's Insert Snippet submenu.
    Public Property SnippetProvider As IStudioSnippetProvider
    ''' Tab after a snippet prefix (with no selection) expands it via SnippetProvider.
    Public Property SnippetTabTrigger As Boolean = False

    ''' True while a snippet's placeholders are being visited.
    Public Property InSnippet As Boolean
        Get
            Return Array.Count(Me.mSnippetOrder) > 0 Or Me.mSnippetFinal >= 0
        End Get
    End Property

    ''' Index of the placeholder being edited (-1 outside a session).
    Public Property SnippetPlaceholder As Integer
        Get
            Return Me.mSnippetActive
        End Get
    End Property

    ''' Inserts an expanded snippet at every selection as one undo step. `indexes`,
    ''' `starts`, `lengths` describe placeholder occurrences in `text` (codepoints; equal
    ''' indexes are linked); `finalCaret` is $0 (-1 = end of text). Lines after the first
    ''' get the insertion line's indentation. Starts the placeholder session.
    Public Sub InsertSnippetExpansion(text As String, indexes As Array Of Integer, starts As Array Of Integer, lengths As Array Of Integer, finalCaret As Integer = -1)
        If Me.IsReadOnly Then Return
        If Array.Count(indexes) <> Array.Count(starts) Or Array.Count(starts) <> Array.Count(lengths) Then Throw New InvalidArgumentException("Snippet placeholder arrays differ in length")
        ' Offsets describe `text` as given (a shared-grammar expansion keeps CRLF/CR line
        ' breaks); they are validated against it and then mapped through the CRLF/CR -> LF
        ' normalization before indentation. Only CR and LF are line breaks here.
        Dim rawLength As Integer = String.Len(text)
        For i As Integer = 0 To Array.LastIndex(starts)
            If starts(i) < 0 Or lengths(i) < 0 Or starts(i) + lengths(i) > rawLength Then Throw New InvalidArgumentException("Snippet placeholder outside the text")
        Next
        Dim normalOf As Array Of Integer = EditorLineBreakOffsetMap(text)
        Dim body As String = Me.Normalize(text)
        Dim bodyLength As Integer = String.Len(body)
        Dim mappedStarts As Array Of Integer = []
        Dim mappedLengths As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(starts)
            Dim mappedStart As Integer = normalOf(starts(i))
            Array.Append(mappedStarts, mappedStart)
            Array.Append(mappedLengths, normalOf(starts(i) + lengths(i)) - mappedStart)
        Next
        Dim finalCaretAt As Integer = bodyLength
        If finalCaret >= 0 And finalCaret <= rawLength Then finalCaretAt = normalOf(finalCaret)
        Me.EndSnippet()
        Me.ClearComposition()
        Dim anchors As Array Of Integer = Me.AllAnchors()
        Dim carets As Array Of Integer = Me.AllCarets()
        Dim order As Array Of Integer = []
        Dim selStarts As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(carets)
            Array.Append(selStarts, Math.Min(anchors(i), carets(i)))
        Next
        order = Array.Reversed(Array.SortOrder(selStarts))
        Me.ClearExtras()
        ' Insert at the last selection first; earlier insertions shift recorded ranges.
        Me.mSnippetIndexes = []
        Me.mSnippetStarts = []
        Me.mSnippetEnds = []
        Dim finals As Array Of Integer = []
        Me.BeginEditGroup()
        For Each k As Integer In order
            Dim s As Integer = selStarts(k)
            Dim e As Integer = Math.Max(anchors(k), carets(k))
            Dim lineIndex As Integer = Me.LineOfPosition(s)
            Dim lead As String = Me.LeadingWhitespace(Me.mLines(lineIndex))
            If String.Len(lead) > s - Me.mStarts(lineIndex) Then lead = String.Left(lead, s - Me.mStarts(lineIndex))
            lead = Me.PolicyIndent(lead)
            ' Re-indent continuation lines, and map offsets through the added indentation.
            Dim chars As Array Of String = String.Chars(body)
            Dim shifted As Array Of Integer = []
            Dim built As String = ""
            Dim c As Integer = 0
            Dim lineStart As Integer = 0
            Dim inComment As Boolean = False
            While c < Array.Count(chars)
                Array.Append(shifted, String.Len(built))
                If c = lineStart And c > 0 And Me.mIndentStyle <> "auto" And Not inComment Then
                    Dim endLead As Integer = c
                    While endLead < Array.Count(chars)
                        If chars(endLead) <> " " And chars(endLead) <> "\t" Then Exit While
                        endLead += 1
                    Wend
                    If endLead > c Then
                        Dim prefix As String = String.Substring(body, c, endLead - c)
                        Dim normalized As String = Me.TemplateIndent(prefix)
                        Dim base As Integer = String.Len(built)
                        For offset As Integer = 1 To endLead - c - 1
                            Array.Append(shifted, base + Math.Min(offset, String.Len(normalized)))
                        Next
                        built += normalized
                        c = endLead
                        Continue While
                    End If
                End If
                built += chars(c)
                If chars(c) = "\n" Then
                    inComment = StudioLineStateAfter(Me.mLanguageMode, String.Substring(body, lineStart, c - lineStart), inComment)
                    built += lead
                    lineStart = c + 1
                End If
                c += 1
            Wend
            Array.Append(shifted, String.Len(built))
            Me.EditRange(s, e - s, built, -1, -1, "snippet")
            For i As Integer = 0 To Array.LastIndex(mappedStarts)
                Array.Append(Me.mSnippetIndexes, indexes(i))
                Array.Append(Me.mSnippetStarts, s + shifted(mappedStarts(i)))
                Array.Append(Me.mSnippetEnds, s + shifted(mappedStarts(i) + mappedLengths(i)))
            Next
            Array.Append(finals, s + shifted(finalCaretAt))
            ' Earlier finals shift with the text inserted before them.
            For f As Integer = 0 To Array.LastIndex(finals) - 1
                finals(f) = finals(f) + String.Len(built) - (e - s)
            Next
        Next
        Dim positive As Array Of Integer = []
        For Each index As Integer In indexes
            If index > 0 Then
                If Array.IndexOf(positive, index) < 0 Then Array.Append(positive, index)
            End If
        Next
        Array.Sort(positive)
        Me.mSnippetOrder = positive
        ' $0 (or the end) of the first insertion in document order is the finalCaretAt caret.
        Me.mSnippetFinal = finals(Array.LastIndex(finals))
        If Array.Count(positive) = 0 Then
            Me.mAnchor = Me.mSnippetFinal
            Me.mCaret = Me.mSnippetFinal
            Dim extras As Array Of Integer = []
            For f As Integer = 0 To Array.LastIndex(finals) - 1
                Array.Append(extras, finals(f))
            Next
            Me.mExtraAnchors = Array.Clone(extras)
            Me.mExtraCarets = extras
            Me.EndSnippet()
        Else
            Me.SelectPlaceholder(positive(0))
        End If
        Me.EndEditGroup("snippet")
    End Sub

    ''' Selects every range of placeholder `index` (the first in document order primary).
    Private Sub SelectPlaceholder(index As Integer)
        Me.mSnippetActive = index
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim firstStart As Integer = -1
        For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            If Me.mSnippetIndexes(i) <> index Then Continue For
            Array.Append(anchors, Me.mSnippetStarts(i))
            Array.Append(carets, Me.mSnippetEnds(i))
        Next
        If Array.Count(carets) = 0 Then Return
        Dim order As Array Of Integer = Array.SortOrder(anchors)
        Me.mAnchor = anchors(order(0))
        Me.mCaret = carets(order(0))
        Me.mExtraAnchors = []
        Me.mExtraCarets = []
        For n As Integer = 1 To Array.LastIndex(order)
            Array.Append(Me.mExtraAnchors, anchors(order(n)))
            Array.Append(Me.mExtraCarets, carets(order(n)))
        Next
        Me.mPreferredColumn = -1
        Me.NormalizeSelections()
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Tab in a session: the next placeholder, or the finalCaretAt caret (ending the session).
    Private Sub NextPlaceholder(forward As Boolean)
        Dim position As Integer = Array.IndexOf(Me.mSnippetOrder, Me.mSnippetActive)
        If forward Then
            If position < Array.LastIndex(Me.mSnippetOrder) Then
                Me.SelectPlaceholder(Me.mSnippetOrder(position + 1))
                Return
            End If
            Dim finalCaretAt As Integer = Me.mSnippetFinal
            Me.EndSnippet()
            Me.ClearExtras()
            If finalCaretAt >= 0 Then
                Me.mAnchor = Me.Clamp(finalCaretAt)
                Me.mCaret = Me.mAnchor
            End If
            Me.EnsureCaretVisible()
            Me.Invalidate()
            Me.FinishInteraction()
        ElseIf position > 0 Then
            Me.SelectPlaceholder(Me.mSnippetOrder(position - 1))
        End If
    End Sub

    Private Sub EndSnippet()
        Me.mSnippetIndexes = []
        Me.mSnippetStarts = []
        Me.mSnippetEnds = []
        Me.mSnippetOrder = []
        Me.mSnippetActive = -1
        Me.mSnippetFinal = -1
        Me.Invalidate()
    End Sub

    ' ---- Linked placeholder mirroring ----
    ' Equal-index occurrences always hold the same text. Tab selects them all (each edits
    ' its own range); any other edit inside one occurrence (a click, drag or arrow keys
    ' left a single cursor there) is repeated at the same relative offset in every linked
    ' occurrence that has no selection of its own, within the same undo step. Edits across
    ' a field boundary, or linked occurrences that diverge, end the session explicitly.

    Private Property mSnippetMirroring As Boolean = False

    ''' True when a selection other than the one being edited lies within [a, b].
    Private Function OtherSelectionWithin(a As Integer, b As Integer) As Boolean
        If Me.mBatch Then
            For k As Integer = 0 To Array.LastIndex(Me.mBatchCarets)
                If k = Me.mBatchIndex Then Continue For
                If Math.Min(Me.mBatchAnchors(k), Me.mBatchCarets(k)) >= a And Math.Max(Me.mBatchAnchors(k), Me.mBatchCarets(k)) <= b Then Return True
            Next
            Return False
        End If
        For k As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
            If Math.Min(Me.mExtraAnchors(k), Me.mExtraCarets(k)) >= a And Math.Max(Me.mExtraAnchors(k), Me.mExtraCarets(k)) <= b Then Return True
        Next
        Return False
    End Function

    Private Function SnippetOccurrenceText(i As Integer) As String
        Return Me.Slice(Me.mSnippetStarts(i), Me.mSnippetEnds(i) - Me.mSnippetStarts(i))
    End Function

    ''' Before an edit of [s, e): the linked occurrences that must receive the same edit
    ''' (`offset` = s relative to the edited occurrence). Ends the session when the edit
    ''' crosses a field boundary or the mirrors cannot be kept consistent.
    Private Function SnippetMirrorTargets(s As Integer, e As Integer, ByRef offset As Integer) As Array Of Integer
        Dim targets As Array Of Integer = []
        offset = 0
        If Array.Count(Me.mSnippetOrder) = 0 Then Return targets
        Dim owner As Integer = -1
        For pass As Integer = 0 To 1
            For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
                If (Me.mSnippetIndexes(i) = Me.mSnippetActive) <> (pass = 0) Then Continue For
                If s >= Me.mSnippetStarts(i) And e <= Me.mSnippetEnds(i) Then
                    owner = i
                    Exit For
                End If
            Next
            If owner >= 0 Then Exit For
        Next
        If owner < 0 Then
            For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
                If s < Me.mSnippetEnds(i) And e > Me.mSnippetStarts(i) Then
                    Me.EndSnippet()
                    Return targets
                End If
            Next
            Return targets
        End If
        Dim index As Integer = Me.mSnippetIndexes(owner)
        If index > 0 Then Me.mSnippetActive = index
        Dim ownerText As String = Me.SnippetOccurrenceText(owner)
        For j As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            If j = owner Or Me.mSnippetIndexes(j) <> index Then Continue For
            If Me.OtherSelectionWithin(Me.mSnippetStarts(j), Me.mSnippetEnds(j)) Then Continue For
            ' Touching linked occurrences cannot be told apart; diverged ones are invalid.
            Dim touching As Boolean = Me.mSnippetStarts(j) <= Me.mSnippetEnds(owner) And Me.mSnippetEnds(j) >= Me.mSnippetStarts(owner)
            If touching Or String.Compare(Me.SnippetOccurrenceText(j), ownerText, True) <> 0 Then
                Me.EndSnippet()
                Return []
            End If
            Array.Append(targets, j)
        Next
        offset = s - Me.mSnippetStarts(owner)
        Return targets
    End Function

    ''' Repeats an edit (relative `offset`, `removed` codepoints, `value`) in each target
    ''' occurrence; the selection being edited moves with the text.
    Private Sub MirrorSnippetEdit(targets As Array Of Integer, offset As Integer, removed As Integer, value As String)
        Dim insertedLength As Integer = String.Len(Me.Normalize(value))
        Me.mSnippetMirroring = True
        Try
            For Each j As Integer In targets
                If j > Array.LastIndex(Me.mSnippetStarts) Then Exit For
                Dim at As Integer = Me.mSnippetStarts(j) + offset
                Dim anchor As Integer = Me.mAnchor
                Dim caret As Integer = Me.mCaret
                Me.ReplaceRange(at, removed, value)
                Me.mAnchor = Me.MapThroughEdit(anchor, at, at + removed, at + insertedLength)
                Me.mCaret = Me.MapThroughEdit(caret, at, at + removed, at + insertedLength)
            Next
        Finally
            Me.mSnippetMirroring = False
        End Try
    End Sub

    ''' After every interaction: linked occurrences must agree, and the caret must stay in
    ''' a field (entering another field makes it the active one); otherwise the session
    ''' ends.
    Private Sub ValidateSnippetSession()
        If Array.Count(Me.mSnippetOrder) = 0 Then Return
        For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            For j As Integer = i + 1 To Array.LastIndex(Me.mSnippetIndexes)
                If Me.mSnippetIndexes(i) <> Me.mSnippetIndexes(j) Then Continue For
                If String.Compare(Me.SnippetOccurrenceText(i), Me.SnippetOccurrenceText(j), True) <> 0 Then
                    Me.EndSnippet()
                    Return
                End If
            Next
        Next
        Dim inActive As Boolean = False
        Dim inField As Boolean = False
        Dim other As Integer = -1
        For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            If Me.mCaret < Me.mSnippetStarts(i) Or Me.mCaret > Me.mSnippetEnds(i) Then Continue For
            inField = True
            If Me.mSnippetIndexes(i) = Me.mSnippetActive Then
                inActive = True
            ElseIf other < 0 And Me.mSnippetIndexes(i) > 0 Then
                other = Me.mSnippetIndexes(i)
            End If
        Next
        If Not inField Then
            Me.EndSnippet()
        ElseIf Not inActive And other > 0 Then
            Me.mSnippetActive = other
            Me.Invalidate()
        End If
    End Sub

    ''' Ends a session the caret has left (outside every range of the active index).
    Private Function SnippetStillActive() As Boolean
        If Array.Count(Me.mSnippetOrder) = 0 Then Return False
        For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            If Me.mCaret >= Me.mSnippetStarts(i) And Me.mCaret <= Me.mSnippetEnds(i) Then Return True
        Next
        Me.EndSnippet()
        Return False
    End Function

    ''' Placeholder ranges of the session as (index, start, length) triples.
    Public Function SnippetRanges() As Array Of Integer
        Dim values As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(Me.mSnippetIndexes)
            Array.Append(values, Me.mSnippetIndexes(i))
            Array.Append(values, Me.mSnippetStarts(i))
            Array.Append(values, Me.mSnippetEnds(i) - Me.mSnippetStarts(i))
        Next
        Return values
    End Function

    ''' The identifier-ish prefix before the caret that Tab may expand ("" = none).
    Public Function SnippetPrefixAtCaret() As String
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = Me.mCaret - Me.mStarts(lineIndex)
        Dim first As Integer = column
        While first > 0
            Dim code As Integer = String.Asc(codes(first - 1))
            If Not (EditorIsWordCode(code) Or code = 35 Or code = 45) Then Exit While
            first -= 1
        Wend
        If first = column Then Return ""
        Dim prefix As String = ""
        For i As Integer = first To column - 1
            prefix += codes(i)
        Next
        Return prefix
    End Function

    ''' Tab trigger: replaces the prefix before every caret with the provider's expansion.
    Private Function TryExpandSnippet() As Boolean
        If Me.SnippetProvider = Nil Or Me.IsReadOnly Then Return False
        If Me.SelectionLength > 0 Then Return False
        Dim prefix As String = Me.SnippetPrefixAtCaret()
        If prefix = "" Then Return False
        Dim expansion As StudioSnippetExpansion = Me.SnippetProvider.ExpandPrefix(prefix, Me.mLanguageMode)
        If expansion = Nil Then Return False
        ' Select the prefix at every caret (where it is present) and insert there.
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        Dim length As Integer = String.Len(prefix)
        For Each caret As Integer In Me.AllCarets()
            Dim start As Integer = Math.Max(0, caret - length)
            If String.Compare(Me.Slice(start, caret - start), prefix, True) = 0 Then
                Array.Append(anchors, start)
            Else
                Array.Append(anchors, caret)
            End If
            Array.Append(carets, caret)
        Next
        Me.mAnchor = anchors(0)
        For i As Integer = 1 To Array.LastIndex(anchors)
            Me.mExtraAnchors(i - 1) = anchors(i)
        Next
        Me.InsertSnippetExpansion(expansion.Text, expansion.Indexes, expansion.Starts, expansion.Lengths, expansion.FinalCaret)
        Return True
    End Function

    ' ---- Inline completion popup and signature hint ---------------------------------------

    Private Property mPopupItems As Array Of StudioEditorCompletionItem = []
    Private Property mPopupShown As Array Of Integer = []
    Private Property mPopupIndex As Integer = 0
    Private Property mPopupFirst As Integer = 0
    ' Start of the identifier being completed; -1 while the popup is closed.
    Private Property mPopupAnchor As Integer = -1
    Private Property mPopupLine As Integer = -1
    Private Property mPopupX As Double = 0.0
    Private Property mPopupY As Double = 0.0
    Private Property mPopupW As Double = 0.0
    Private Property mPopupH As Double = 0.0
    ' False after refiltering: the next paint re-measures the width (hit-testing keeps
    ' the last painted geometry until then).
    Private Property mPopupMeasured As Boolean = False
    Private Property mHintText As String = ""
    Private Property mHintLine As Integer = -1

    ''' Shows host-supplied completions under the identifier at the caret. The list
    ''' filters as the user types and closes on accept (Return, Tab, click), Esc, focus
    ''' loss, or when the caret leaves the identifier. False when nothing is shown.
    Public Function ShowCompletionItems(items As Array Of StudioEditorCompletionItem) As Boolean
        Me.DismissInlineCompletion()
        Me.CloseCompletionPopup()
        If Me.IsReadOnly Or Me.SelectionCount > 1 Or Me.SelectionLength > 0 Or Array.Count(items) = 0 Then Return False
        Me.mPopupItems = items
        Me.mPopupAnchor = Me.CompletionPrefixStart()
        Me.mPopupLine = Me.LineOfPosition(Me.mCaret)
        Me.FilterCompletionPopup()
        Me.Invalidate()
        Return Me.IsCompletionPopupShown()
    End Function

    Public Function IsCompletionPopupShown() As Boolean
        Return Me.mPopupAnchor >= 0 And Array.Count(Me.mPopupShown) > 0
    End Function

    ''' Number of entries matching the typed prefix (0 while closed).
    Public Function CompletionPopupCount() As Integer
        If Me.mPopupAnchor < 0 Then Return 0
        Return Array.Count(Me.mPopupShown)
    End Function

    ''' Label of the highlighted entry ("" while closed).
    Public Function SelectedCompletionLabel() As String
        If Not Me.IsCompletionPopupShown() Then Return ""
        Return Me.mPopupItems(Me.mPopupShown(Me.mPopupIndex)).Label
    End Function

    Public Sub CloseCompletionPopup()
        If Me.mPopupAnchor < 0 And Array.Count(Me.mPopupItems) = 0 Then Return
        Me.mPopupAnchor = -1
        Me.mPopupLine = -1
        Me.mPopupItems = []
        Me.mPopupShown = []
        Me.mPopupIndex = 0
        Me.mPopupFirst = 0
        Me.mPopupW = 0.0
        Me.mPopupH = 0.0
        Me.Invalidate()
    End Sub

    ''' One-line signature help drawn above the caret line until the caret leaves the
    ''' line, ")" is typed or Esc is pressed. An empty text hides it.
    Public Sub ShowCompletionHint(text As String)
        Me.mHintText = text
        Me.mHintLine = -1
        If text <> "" Then Me.mHintLine = Me.LineOfPosition(Me.mCaret)
        Me.Invalidate()
    End Sub

    Public Function CompletionHintText() As String
        Return Me.mHintText
    End Function

    ''' Keyboard commands while the popup (or hint) is open. True when consumed.
    Public Function CompletionCommand(command As String) As Boolean
        If Me.CompletionComposing() Then Return False
        If Not Me.IsCompletionPopupShown() Then
            If command = "cancelOperation" And Me.mHintLine >= 0 Then
                Me.ShowCompletionHint("")
                Return True
            End If
            Return False
        End If
        Select Case command
        Case "moveUp"
            Me.MoveCompletion(-1)
        Case "moveDown"
            Me.MoveCompletion(1)
        Case "pageUp"
            Me.MoveCompletion(-Me.CompletionRows())
        Case "pageDown"
            Me.MoveCompletion(Me.CompletionRows())
        Case "insertNewline", "insertTab"
            Return Me.AcceptCompletion()
        Case "cancelOperation"
            Me.CloseCompletionPopup()
        Case Else
            Return False
        End Select
        Return True
    End Function

    ''' Replaces the typed identifier with the highlighted entry. When the entry is the
    ''' typed word itself (ignoring case) only its case is fixed and False is returned,
    ''' so Return or Tab after a complete keyword still ends the line or indents.
    Public Function AcceptCompletion() As Boolean
        If Not Me.IsCompletionPopupShown() Or Me.CompletionComposing() Then Return False
        Dim item As StudioEditorCompletionItem = Me.mPopupItems(Me.mPopupShown(Me.mPopupIndex))
        Dim start As Integer = Me.mPopupAnchor
        Dim length As Integer = Me.mCaret - start
        Dim typed As String = Me.Slice(start, length)
        Dim text As String = item.InsertText
        If text = "" Then text = item.Label
        Me.CloseCompletionPopup()
        If text = typed Then
            If String.Compare(text, typed, True) <> 0 Then Me.ApplyCompletion(start, length, text)
            Return False
        End If
        Return Me.ApplyCompletion(start, length, text)
    End Function

    ''' An input-method composition owns Return, Tab, Esc and the arrows.
    Private Function CompletionComposing() As Boolean
        Return String.Len(Me.mIncomplete) > 0 Or Me.mCompositionStart >= 0
    End Function

    Private Function CompletionRows() As Integer
        Return 8
    End Function

    Private Sub MoveCompletion(delta As Integer)
        Dim count As Integer = Array.Count(Me.mPopupShown)
        If count = 0 Then Return
        Dim index As Integer = Me.mPopupIndex + delta
        If delta = 1 Or delta = -1 Then
            index = (index + count) Mod count
        Else
            index = Math.Max(0, Math.Min(count - 1, index))
        End If
        Me.mPopupIndex = index
        Me.KeepCompletionVisible()
        Me.Invalidate()
    End Sub

    Private Sub KeepCompletionVisible()
        Dim rows As Integer = Me.CompletionRows()
        If Me.mPopupIndex < Me.mPopupFirst Then Me.mPopupFirst = Me.mPopupIndex
        If Me.mPopupIndex >= Me.mPopupFirst + rows Then Me.mPopupFirst = Me.mPopupIndex - rows + 1
        Me.mPopupFirst = Math.Max(0, Math.Min(Me.mPopupFirst, Array.Count(Me.mPopupShown) - rows))
    End Sub

    ''' Narrows the list to the typed prefix: prefix matches (symbols before keywords),
    ''' then, from two typed characters, labels containing it. Keeps the highlighted
    ''' entry when it still matches.
    Private Sub FilterCompletionPopup()
        If Me.mPopupAnchor < 0 Then Return
        Dim typed As String = Me.Slice(Me.mPopupAnchor, Me.mCaret - Me.mPopupAnchor)
        Dim previous As String = Me.SelectedCompletionLabel()
        Dim exact As Array Of Integer = []
        Dim symbols As Array Of Integer = []
        Dim keywords As Array Of Integer = []
        Dim inner As Array Of Integer = []
        For i As Integer = 0 To Array.LastIndex(Me.mPopupItems)
            Dim label As String = Me.mPopupItems(i).Label
            If typed <> "" And label = typed Then
                exact.Append(i)
            ElseIf String.StartsWith(label, typed) Then
                If Me.mPopupItems(i).Kind = 14 Then
                    keywords.Append(i)
                Else
                    symbols.Append(i)
                End If
            ElseIf String.Len(typed) >= 2 And String.Contains(label, typed) Then
                inner.Append(i)
            End If
        Next
        Dim shown As Array Of Integer = exact
        For Each i As Integer In symbols
            shown.Append(i)
        Next
        For Each i As Integer In keywords
            shown.Append(i)
        Next
        For Each i As Integer In inner
            shown.Append(i)
        Next
        ' Nothing left to offer: no match, or the only match is exactly what is typed.
        Dim finished As Boolean = Array.Count(shown) = 0
        If Array.Count(shown) = 1 Then finished = String.Compare(Me.mPopupItems(shown(0)).Label, typed, True) = 0
        If finished Then
            Me.CloseCompletionPopup()
            Return
        End If
        Me.mPopupShown = shown
        Me.mPopupIndex = 0
        ' What is already typed stays highlighted, so Return/Tab never swap a finished
        ' word for a longer one; otherwise keep the user's highlight while it matches.
        If Array.Count(exact) = 0 Then
            For k As Integer = 0 To Array.LastIndex(shown)
                If previous <> "" And String.Compare(Me.mPopupItems(shown(k)).Label, previous, True) = 0 Then
                    Me.mPopupIndex = k
                    Exit For
                End If
            Next
        End If
        Me.mPopupMeasured = False
        Me.KeepCompletionVisible()
    End Sub

    ''' After every edit or caret move: close what no longer applies, refilter the rest.
    Private Sub RevalidateCompletion()
        If Me.mHintLine >= 0 Then
            If Me.SelectionCount > 1 Or Me.LineOfPosition(Me.mCaret) <> Me.mHintLine Then Me.ShowCompletionHint("")
        End If
        If Me.mPopupAnchor < 0 Then Return
        If Me.SelectionCount > 1 Or Me.SelectionLength > 0 Or Me.mCaret < Me.mPopupAnchor Or Me.LineOfPosition(Me.mCaret) <> Me.mPopupLine Then
            Me.CloseCompletionPopup()
            Return
        End If
        For Each ch As String In String.Chars(Me.Slice(Me.mPopupAnchor, Me.mCaret - Me.mPopupAnchor))
            If Not EditorIsWordCode(String.Asc(ch)) Then
                Me.CloseCompletionPopup()
                Return
            End If
        Next
        Me.FilterCompletionPopup()
        Me.Invalidate()
    End Sub

    ''' Mouse press: a click on an entry accepts it; anywhere else closes the popup.
    ''' True when the press was consumed by the popup.
    Private Function CompletionMouseDown(x As Double, y As Double) As Boolean
        If Not Me.IsCompletionPopupShown() Then Return False
        If x >= Me.mPopupX And x < Me.mPopupX + Me.mPopupW And y >= Me.mPopupY And y < Me.mPopupY + Me.mPopupH Then
            Dim rows As Integer = Math.Min(Me.CompletionRows(), Array.Count(Me.mPopupShown))
            Dim row As Integer = Math.Floor((y - Me.mPopupY - 2.0) / Me.LineHeight)
            row = Math.Max(0, Math.Min(rows - 1, row))
            Dim index As Integer = Me.mPopupFirst + row
            If index < Array.Count(Me.mPopupShown) And x < Me.mPopupX + Me.mPopupW - 8.0 Then
                Me.mPopupIndex = index
                Me.AcceptCompletion()
            End If
            Me.Invalidate()
            Return True
        End If
        Me.CloseCompletionPopup()
        Return False
    End Function

    Private Function CompletionDetailLine(item As StudioEditorCompletionItem) As String
        If item.Detail = "" Then Return ""
        Return String.Trim(String.Split(item.Detail, "\n")(0))
    End Function

    ''' Paints the signature hint and the completion popup over the text area.
    Private Sub DrawCompletionOverlay(g As Graphics, theme As StudioCodeEditorTheme)
        Dim font As String = Me.FontName
        Dim size As Double = Me.FontSize
        Dim detailSize As Double = size * 0.9
        Dim rowHeight As Double = Me.LineHeight
        Dim lift As Double = Me.BaselineOffset() + Me.DrawStringLift(size)
        Dim detailLift As Double = Me.BaselineOffset() + Me.DrawStringLift(detailSize)
        If Me.mHintLine >= 0 And Me.mHintText <> "" Then
            Dim caretPoint As Point = Me.PointOfPosition(Me.mCaret)
            Dim hintW As Double = Math.Min(g.MeasureStringWidth(Me.mHintText, font, size) + 16.0, Math.Max(80.0, Me.Width - 8.0))
            Dim hintH As Double = rowHeight + 4.0
            Dim hx As Double = Math.Max(2.0, Math.Min(caretPoint.X - 8.0, Me.Width - hintW - 4.0))
            Dim hy As Double = caretPoint.Y - hintH - 2.0
            If hy < 0.0 Then hy = caretPoint.Y + rowHeight + 2.0
            g.FillRoundedRect(hx, hy, hintW, hintH, 4, theme.GutterBackground)
            g.StrokeRoundedRect(hx + 0.5, hy + 0.5, hintW - 1.0, hintH - 1.0, 4, 1.0, theme.GutterLine)
            g.Save()
            g.ClipToRect(hx + 1.0, hy + 1.0, hintW - 2.0, hintH - 2.0)
            g.DrawString(Me.mHintText, hx + 8.0, hy + 2.0 + lift, font, size, theme.Ink)
            g.Restore()
        End If
        If Not Me.IsCompletionPopupShown() Then Return
        Dim count As Integer = Array.Count(Me.mPopupShown)
        Dim rows As Integer = Math.Min(Me.CompletionRows(), count)
        If Not Me.mPopupMeasured Or Me.mPopupW <= 0.0 Then
            Me.mPopupMeasured = True
            Dim labelW As Double = 120.0
            Dim detailW As Double = 0.0
            For Each index As Integer In Me.mPopupShown
                Dim item As StudioEditorCompletionItem = Me.mPopupItems(index)
                labelW = Math.Max(labelW, g.MeasureStringWidth(item.Label, font, size))
                detailW = Math.Max(detailW, g.MeasureStringWidth(Me.CompletionDetailLine(item), font, detailSize))
            Next
            Me.mPopupW = Math.Min(labelW + Math.Min(detailW, 320.0) + 40.0, Math.Max(160.0, Me.Width - 16.0))
        End If
        Dim w As Double = Me.mPopupW
        Dim h As Double = rows * rowHeight + 4.0
        Dim p As Point = Me.PointOfPosition(Me.mPopupAnchor)
        Dim x As Double = Math.Max(2.0, Math.Min(p.X - 6.0, Me.Width - w - 4.0))
        Dim y As Double = p.Y + rowHeight + 2.0
        ' Flip above the line when the list would run past the bottom edge.
        If y + h > Me.Height - Me.ScrollbarSize() And p.Y - h - 2.0 >= 0.0 Then y = p.Y - h - 2.0
        Me.mPopupX = x
        Me.mPopupY = y
        Me.mPopupH = h
        g.FillRoundedRect(x, y, w, h, 6, theme.GutterBackground)
        g.StrokeRoundedRect(x + 0.5, y + 0.5, w - 1.0, h - 1.0, 6, 1.0, theme.GutterLine)
        g.Save()
        g.ClipToRect(x + 1.0, y + 1.0, w - 2.0, h - 2.0)
        For r As Integer = 0 To rows - 1
            Dim k As Integer = Me.mPopupFirst + r
            If k >= count Then Exit For
            Dim item As StudioEditorCompletionItem = Me.mPopupItems(Me.mPopupShown(k))
            Dim ry As Double = y + 2.0 + r * rowHeight
            If k = Me.mPopupIndex Then g.FillRect(x + 2.0, ry, w - 4.0, rowHeight, theme.Selection)
            Dim ink As Color = theme.Ink
            If item.Kind = 14 Then ink = theme.Keyword
            g.DrawString(item.Label, x + 8.0, ry + lift, font, size, ink)
            Dim detail As String = Me.CompletionDetailLine(item)
            If detail <> "" Then
                Dim labelEnd As Double = x + 8.0 + g.MeasureStringWidth(item.Label, font, size) + 16.0
                Dim dx As Double = Math.Max(labelEnd, x + w - 8.0 - g.MeasureStringWidth(detail, font, detailSize))
                If dx < x + w - 24.0 Then g.DrawString(detail, dx, ry + detailLift, font, detailSize, theme.Muted)
            End If
        Next
        If count > rows Then
            Dim track As Double = h - 6.0
            Dim thumb As Double = Math.Max(12.0, track * rows / count)
            Dim top As Double = y + 3.0 + (track - thumb) * Me.mPopupFirst / Math.Max(1, count - rows)
            g.FillRoundedRect(x + w - 6.0, top, 3.0, thumb, 1.5, theme.Scrollbar)
        End If
        g.Restore()
    End Sub

    ' ---- Completion hooks -----------------------------------------------------------------

    ''' Ask the host for completion: "invoke" (triggerCompletion), "character" (typed a
    ''' trigger such as "." or an identifier character, see CompletionOnType),
    ''' "parameters" ("(", "," or triggerParameterHints). `position` is the primary caret,
    ''' `prefix` the identifier before it. The host shows its own overlay at
    ''' CompletionAnchor() and applies a choice with ApplyCompletion.
    Public Property InlineFeedback As StudioCompletionFeedback
    Private Property mGhost As String = ""
    Private Property mGhostTicket As Integer = 0
    Private Property mGhostPosition As Integer = -1
    Private Property mGhostEdits As Array Of StudioInlineEdit = []
    Private Property mGhostPreviewFirst As Integer = 0

    Public Property InlineCompletionTicket As Integer
        Get
            Return Me.mGhostTicket
        End Get
    End Property

    Public Property HasInlineEdits As Boolean
        Get
            Return Array.Count(Me.mGhostEdits) > 0
        End Get
    End Property

    Public Function BeginInlineCompletion() As Integer
        Me.DismissInlineCompletion()
        If Me.IsReadOnly Or Me.SelectionLength > 0 Or Me.SelectionCount > 1 Or Me.CompletionComposing() Then Return -1
        Me.CloseCompletionPopup()
        Me.mGhostPosition = Me.mCaret
        Return Me.mGhostTicket
    End Function

    Public Function ShowInlineCompletion(ticket As Integer, text As String) As Boolean
        text = Me.Normalize(text)
        If String.Len(text) > 8192 Then Return False
        text = StudioInlineInsertion(text, Me.Slice(Me.mCaret, Me.TotalLength() - Me.mCaret))
        If text = "" Then Return False
        Return Me.ShowInlineEdits(ticket, [New StudioInlineEdit(Me.mCaret, 0, text)])
    End Function

    Public Function ShowInlineResponse(ticket As Integer, response As String) As Boolean
        If String.StartsWith(String.Trim(response), "{", True) Then
            Return Me.ShowInlineEdits(ticket, StudioInlineResponse(Me.Text, response))
        End If
        Return Me.ShowInlineCompletion(ticket, response)
    End Function

    Public Function ShowInlineEdits(ticket As Integer, edits As Array Of StudioInlineEdit) As Boolean
        If ticket < 0 Or ticket <> Me.mGhostTicket Or Me.mCaret <> Me.mGhostPosition Then Return False
        If Me.IsReadOnly Or Me.SelectionLength > 0 Or Me.SelectionCount > 1 Or Me.CompletionComposing() Then Return False
        If Not StudioInlineValidate(Me.Text, edits) Then Return False
        Me.CloseCompletionPopup()
        Me.RestoreInlineEdits(edits)
        If Me.InlineFeedback <> Nil Then Me.InlineFeedback.CompletionShown()
        Return True
    End Function

    Private Sub RestoreInlineEdits(edits As Array Of StudioInlineEdit)
        Me.mGhostEdits = []
        For Each edit As StudioInlineEdit In edits
            Me.mGhostEdits.Append(New StudioInlineEdit(edit.Start, edit.Length, edit.Text))
        Next
        Me.mGhost = Me.mGhostEdits(0).Text
        Me.mGhostPosition = Me.mCaret
        Me.mGhostPreviewFirst = 0
        Me.Invalidate()
    End Sub

    Public Sub DismissInlineCompletion()
        Me.mGhostTicket += 1
        Me.mGhost = ""
        Me.mGhostEdits = []
        Me.mGhostPosition = -1
        Me.mGhostPreviewFirst = 0
        Me.Invalidate()
    End Sub

    ' Tab jumps to an edit elsewhere first. A separate Tab accepts that edit only.
    Public Function AcceptInlineCompletion() As Boolean
        If Not Me.HasInlineEdits Then Return False
        If Me.IsReadOnly Or Me.SelectionLength > 0 Or Me.SelectionCount > 1 Or Me.CompletionComposing() Or Me.mCaret <> Me.mGhostPosition Then
            Me.DismissInlineCompletion()
            Return False
        End If
        Dim edits As Array Of StudioInlineEdit = Me.mGhostEdits
        If Not StudioInlineValidate(Me.Text, edits) Then
            Me.DismissInlineCompletion()
            Return False
        End If
        Dim edit As StudioInlineEdit = edits(0)
        If edit.Start <> Me.mCaret Then
            Me.SelectRange(edit.Start, 0)
            Me.RestoreInlineEdits(edits)
            Me.EnsureCaretVisible()
            Return True
        End If
        Dim remaining As Array Of StudioInlineEdit = []
        Dim delta As Integer = String.Len(edit.Text) - edit.Length
        For i As Integer = 1 To Array.LastIndex(edits)
            remaining.Append(New StudioInlineEdit(edits(i).Start + delta, edits(i).Length, edits(i).Text))
        Next
        Dim expected As String = String.Left(Me.Text, edit.Start) + edit.Text + String.Substring(Me.Text, edit.Start + edit.Length)
        Dim feedback As StudioCompletionFeedback = Me.InlineFeedback
        Me.DismissInlineCompletion()
        Dim applied As Boolean = Me.ApplyCompletion(edit.Start, edit.Length, edit.Text)
        applied = applied And String.Compare(Me.Text, expected, True) = 0
        If applied And feedback <> Nil Then feedback.CompletionAccepted()
        If applied And StudioInlineValidate(Me.Text, remaining) Then Me.RestoreInlineEdits(remaining)
        Return applied
    End Function

    Private Function InlineCompletionCommand(command As String) As Boolean
        If command = "insertTab" Then Return Me.AcceptInlineCompletion()
        If command = "cancelOperation" And Me.mGhostPosition >= 0 Then
            Me.DismissInlineCompletion()
            Return True
        End If
        If Me.HasInlineEdits And (command = "pageDown" Or command = "pageUp") Then
            Dim amount As Integer = If(command = "pageDown", 6, -6)
            Me.mGhostPreviewFirst = Math.Max(0, Me.mGhostPreviewFirst + amount)
            Me.Invalidate()
            Return True
        End If
        Return False
    End Function

    Public Function InlinePreviewText() As String
        If Not Me.HasInlineEdits Then Return ""
        Dim edit As StudioInlineEdit = Me.mGhostEdits(0)
        Dim preview As String = ""
        If edit.Length > 0 Then preview = "- " + String.Replace(Me.Slice(edit.Start, edit.Length), "\n", "\n- ", True) + "\n"
        Return preview + "+ " + String.Replace(edit.Text, "\n", "\n+ ", True)
    End Function

    Private Sub DrawInlineCompletion(g As Graphics, theme As StudioCodeEditorTheme)
        If Not Me.HasInlineEdits Or Me.mCaret <> Me.mGhostPosition Or Me.CompletionComposing() Then Return
        Dim edit As StudioInlineEdit = Me.mGhostEdits(0)
        Dim point As Point = Me.PointOfPosition(Me.mCaret)
        Dim atEnd As Boolean = Me.mCaret = Me.LineStartPosition(Me.CaretLine) + String.Len(Me.LineText(Me.CaretLine))
        If edit.Start = Me.mCaret And edit.Length = 0 And Not String.Contains(edit.Text, "\n") And atEnd Then
            g.Save()
            g.ClipToRect(Me.mCaretClipLeft, Me.mCaretClipTop, Math.Max(1.0, Me.mCaretClipRight - Me.mCaretClipLeft), Math.Max(1.0, Me.Height - Me.ScrollbarSize() - Me.mCaretClipTop))
            g.DrawString(edit.Text, point.X, point.Y + Me.BaselineOffset() + Me.DrawStringLift(Me.FontSize), Me.FontName, Me.FontSize, theme.GutterText)
            g.Restore()
        End If
        ' A separate, opaque diff panel keeps source suffixes and subsequent lines
        ' readable. Wrap long rows and page vertically so every character is reviewable.
        Dim width As Double = Math.Max(80.0, Math.Min(700.0, Me.mCaretClipRight - Me.mCaretClipLeft - 8.0))
        Dim rows As Array Of String = []
        Dim row As String = ""
        For Each line As String In String.Split(Me.InlinePreviewText(), "\n", True)
            row = ""
            For Each character As String In String.Chars(line)
                If g.MeasureStringWidth(row + character, Me.FontName, Me.FontSize) > width - 20.0 And row <> "" Then
                    rows.Append(row)
                    row = ""
                End If
                row += character
            Next
            rows.Append(row)
        Next
        Dim available As Integer = Math.Max(1, Math.Floor((Me.Height - Me.mCaretClipTop - Me.ScrollbarSize()) / Me.LineHeight) - 3)
        Dim count As Integer = Math.Min(Array.Count(rows), Math.Min(10, available))
        Me.mGhostPreviewFirst = Math.Min(Me.mGhostPreviewFirst, Math.Max(0, Array.Count(rows) - count))
        Dim height As Double = (count + 2) * Me.LineHeight + 8.0
        Dim x As Double = Math.Max(Me.mCaretClipLeft, Math.Min(point.X, Me.mCaretClipRight - width))
        Dim y As Double = point.Y + Me.LineHeight + 2.0
        If y + height > Me.Height - Me.ScrollbarSize() Then y = Math.Max(Me.mCaretClipTop, point.Y - height - 2.0)
        g.FillRoundedRect(x, y, width, height, 4, theme.GutterBackground)
        g.StrokeRoundedRect(x + 0.5, y + 0.5, width - 1.0, height - 1.0, 4, 1.0, theme.GutterLine)
        g.Save()
        g.ClipToRect(x + 2.0, y + 2.0, width - 4.0, height - 4.0)
        Dim action As String = If(edit.Start = Me.mCaret, "Tab: accept", "Tab: jump to line " + String.From(Me.LineOfPosition(edit.Start) + 1))
        Dim caption As String = action + " · Escape: dismiss · " + String.From(Array.Count(Me.mGhostEdits)) + " edit(s) remaining"
        g.DrawString(caption, x + 8.0, y + Me.BaselineOffset(), Me.FontName, Me.FontSize, theme.Ink)
        For i As Integer = 0 To count - 1
            Dim value As String = rows(Me.mGhostPreviewFirst + i)
            Dim tint As Color = theme.GutterText
            If String.StartsWith(value, "- ", True) Then tint = theme.FailureInk
            g.DrawString(value, x + 8.0, y + (i + 1) * Me.LineHeight + Me.BaselineOffset(), Me.FontName, Me.FontSize, tint)
        Next
        Dim footer As String = "Preview " + String.From(Me.mGhostPreviewFirst + 1) + "–" + String.From(Me.mGhostPreviewFirst + count) + " / " + String.From(Array.Count(rows)) + " · PageUp/PageDown"
        g.DrawString(footer, x + 8.0, y + (count + 1) * Me.LineHeight + Me.BaselineOffset(), Me.FontName, Me.FontSize, theme.GutterText)
        g.Restore()
    End Sub

    Event CompletionRequested(trigger As String, position As Integer, prefix As String)
    ''' Raise CompletionRequested("character") while typing identifiers and after ".".
    Public Property CompletionOnType As Boolean = False

    ''' Start of the identifier the caret is completing (the caret when none).
    Public Function CompletionPrefixStart() As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        Dim column As Integer = Me.mCaret - Me.mStarts(lineIndex)
        While column > 0
            If Not EditorIsWordCode(String.Asc(codes(column - 1))) Then Exit While
            column -= 1
        Wend
        Return Me.mStarts(lineIndex) + column
    End Function

    ''' View point just below the start of the completion prefix (for overlays).
    Public Function CompletionAnchor() As Point
        Dim p As Point = Me.PointOfPosition(Me.CompletionPrefixStart())
        Dim anchor As Point = { X: p.X, Y: p.Y + Me.LineHeight }
        Return anchor
    End Function

    ''' Applies a completion: replaces [start, start+length) at the primary caret (and the
    ''' same prefix span before every secondary caret) with `text`, as one undo step.
    ''' `isSnippet` runs `text` through SnippetProvider.ExpandBody for placeholders.
    Public Function ApplyCompletion(start As Integer, length As Integer, text As String, isSnippet As Boolean = False) As Boolean
        If Me.IsReadOnly Then Return False
        Dim s As Integer = Me.Clamp(start)
        Dim e As Integer = Me.Clamp(start + Math.Max(0, length))
        If Me.mCaret < s Or Me.mCaret > e Then Return False
        Dim before As Integer = Me.mCaret - s
        Dim after As Integer = e - Me.mCaret
        Me.mAnchor = Me.Clamp(Me.mCaret - before)
        Me.mCaret = Me.Clamp(Me.mCaret + after)
        For i As Integer = 0 To Array.LastIndex(Me.mExtraCarets)
            Dim c As Integer = Me.mExtraCarets(i)
            Me.mExtraAnchors(i) = Me.Clamp(c - before)
            Me.mExtraCarets(i) = Me.Clamp(c + after)
        Next
        Me.NormalizeSelections()
        If isSnippet And Me.SnippetProvider <> Nil Then
            Dim expansion As StudioSnippetExpansion = Me.SnippetProvider.ExpandBody(text)
            If expansion <> Nil Then
                Me.InsertSnippetExpansion(expansion.Text, expansion.Indexes, expansion.Starts, expansion.Lengths, expansion.FinalCaret)
                Return True
            End If
        End If
        Me.RunBatch("@replace", False, [text], True)
        Return True
    End Function

    Private Sub NotifyCompletionTyping(typed As String)
        Me.RevalidateCompletion()
        If typed = ")" And Me.mHintLine >= 0 Then Me.ShowCompletionHint("")
        If Not Me.CompletionOnType Or Me.SelectionCount > 1 Or String.Len(typed) <> 1 Then Return
        Dim code As Integer = String.Asc(typed)
        Dim start As Integer = Me.CompletionPrefixStart()
        Dim prefix As String = Me.Slice(start, Me.mCaret - start)
        ' An open popup filters locally; only "." or a fresh identifier asks again.
        If Me.IsCompletionPopupShown() And EditorIsWordCode(code) Then Return
        If typed = "." Then
            RaiseEvent CompletionRequested("character", Me.mCaret, "")
        ElseIf typed = "(" Or typed = "," Then
            RaiseEvent CompletionRequested("parameters", Me.mCaret, "")
        ElseIf EditorIsWordCode(code) And String.Len(prefix) >= 2 Then
            RaiseEvent CompletionRequested("character", Me.mCaret, prefix)
        End If
    End Sub
    ''' Rectangular (column) paste at the primary caret: line k of `value` goes to line
    ''' caret+k at the caret's cell, padding short lines with spaces and adding lines at
    ''' the end of the document. Leaves a caret after every pasted piece. One undo step.
    Public Sub PasteColumn(value As String)
        If Me.IsReadOnly Then Return
        Dim lines As Array Of String = String.Split(Me.Normalize(value), "\n", True)
        If Array.Count(lines) > 1 And Array.Last(lines) = "" Then Array.RemoveAt(lines, Array.LastIndex(lines))
        Me.ClearExtras()
        If Me.SelectionLength > 0 Then Me.EditRange(Me.SelectionStart, Me.SelectionLength, "", -1, -1, "paste")
        Dim firstLine As Integer = Me.LineOfPosition(Me.mCaret)
        Dim cell As Integer = Me.VisualColumn(Me.mLines(firstLine), Me.mCaret - Me.mStarts(firstLine))
        Dim carets As Array Of Integer = []
        Me.BeginEditGroup()
        For k As Integer = 0 To Array.LastIndex(lines)
            Dim lineIndex As Integer = firstLine + k
            If lineIndex > Array.LastIndex(Me.mLines) Then
                Me.EditRange(Me.TotalLength(), 0, "\n", -1, -1, "paste")
                lineIndex = Array.LastIndex(Me.mLines)
            End If
            Dim line As String = Me.mLines(lineIndex)
            Dim width As Integer = Me.LineCells(line)
            Dim insertAt As Integer = 0
            Dim padding As String = ""
            If width < cell Then
                insertAt = Me.NavLineEnd(lineIndex)
                padding = String.Space(cell - width)
            Else
                insertAt = Me.mStarts(lineIndex) + Me.ColumnForVisual(line, cell)
            End If
            Me.EditRange(insertAt, 0, padding + lines(k), -1, -1, "paste")
            Array.Append(carets, Me.mCaret)
        Next
        ' The edits ran top to bottom; later ones never moved earlier carets.
        Dim anchors As Array Of Integer = Array.Clone(carets)
        Me.mAnchor = carets(0)
        Me.mCaret = carets(0)
        Me.mExtraAnchors = []
        Me.mExtraCarets = []
        For i As Integer = 1 To Array.LastIndex(carets)
            Array.Append(Me.mExtraAnchors, anchors(i))
            Array.Append(Me.mExtraCarets, carets(i))
        Next
        Me.EndEditGroup("paste")
    End Sub

    ' ---- Language mode ----------------------------------------------------------------

    Private Property mLanguageMode As String = "buoy"

    ''' "buoy" (default), "plain", "json" or "markdown" (StudioLanguageModeName). Selects
    ''' highlighting and folding; Buoy auto-indent, block closing, on-type dedent and
    ''' comment toggling run in "buoy" mode only. Changing it keeps the text.
    Public Property LanguageMode As String
        Get
            Return Me.mLanguageMode
        End Get
        Set
            Dim mode As String = StudioLanguageModeName(value)
            If mode = Me.mLanguageMode Then Return
            Me.mLanguageMode = mode
            For i As Integer = 0 To Array.LastIndex(Me.mTokens)
                Me.mTokens(i) = Nil
            Next
            Me.mStatesValid = 1
            Me.mFoldLines = []
            Me.mFoldsValid = False
            Me.mFolded = []
            Me.mRowsValid = False
            Me.mWrapVersion += 1
            Me.mMinimapVersion += 1
            Me.Invalidate()
        End Set
    End Property

    Private Function IsBuoyMode() As Boolean
        Return Me.mLanguageMode = "buoy"
    End Function

    ' ---- Shortcuts, clipboard and typing events ------------------------------------------

    ''' Raised before the editor's own key handling for chords holding Primary and/or Alt
    ''' (and F1-F12): "Primary+Alt+Shift+KEY" (StudioCanonicalShortcut form). Return True
    ''' to consume the key. Raised at most once per key press across native paths.
    Event ShortcutRequested(chord As String) As Boolean
    ''' Raised after a successful copy or cut with the text placed on the clipboard.
    Event ClipboardCopied(text As String)
    ''' Raised once per typed or IME-committed insertion (never for preedit text).
    Event TextCommitted(text As String, position As Integer)


    ''' IME with several carets: "replicate" (default) commits a composition at every
    ''' caret (one undo step); "primary" commits it at the primary selection only and
    ''' drops the others. Composition is always shown at the primary caret; a commit or
    ''' composition with an explicit replacement range is always primary-only.
    Public Property ImeMultiCaretPolicy As String = "replicate"

    ''' Shortcut key name for a Windows virtual key ("" = not a chord key).
    Public Shared Function ChordKeyForVirtualKey(virtualKey As Integer) As String
        If virtualKey >= 65 And virtualKey <= 90 Then Return String.Chr(virtualKey)
        If virtualKey >= 48 And virtualKey <= 57 Then Return String.Chr(virtualKey)
        If virtualKey >= 112 And virtualKey <= 123 Then Return "F" + String.From(virtualKey - 111)
        Select Case virtualKey
        Case 8
            Return "BACKSPACE"
        Case 9
            Return "TAB"
        Case 13
            Return "RETURN"
        Case 27
            Return "ESCAPE"
        Case 32
            Return "SPACE"
        Case 33
            Return "PAGEUP"
        Case 34
            Return "PAGEDOWN"
        Case 35
            Return "END"
        Case 36
            Return "HOME"
        Case 37
            Return "LEFT"
        Case 38
            Return "UP"
        Case 39
            Return "RIGHT"
        Case 40
            Return "DOWN"
        Case 46
            Return "DELETE"
        Case 186
            Return ";"
        Case 187
            Return "="
        Case 188
            Return ","
        Case 189
            Return "-"
        Case 190
            Return "."
        Case 191
            Return "/"
        Case 192
            Return "`"
        Case 219
            Return "["
        Case 220
            Return "\\"
        Case 221
            Return "]"
        Case 222
            Return "'"
        End Select
        Return ""
    End Function

    ''' Shortcut key name for AppKit charactersIgnoringModifiers ("" = none).
    Public Shared Function ChordKeyForMacCharacters(characters As String) As String
        If characters = "" Then Return ""
        Dim code As Integer = String.Asc(characters)
        If code >= 63236 And code <= 63247 Then Return "F" + String.From(code - 63235)
        Select Case code
        Case 63232
            Return "UP"
        Case 63233
            Return "DOWN"
        Case 63234
            Return "LEFT"
        Case 63235
            Return "RIGHT"
        Case 63273
            Return "HOME"
        Case 63275
            Return "END"
        Case 63276
            Return "PAGEUP"
        Case 63277
            Return "PAGEDOWN"
        Case 63272
            Return "DELETE"
        Case 127, 8
            Return "BACKSPACE"
        Case 13, 3
            Return "RETURN"
        Case 9, 25
            Return "TAB"
        Case 27
            Return "ESCAPE"
        Case 32
            Return "SPACE"
        End Select
        If code < 32 Then Return ""
        Return String.Left(characters, 1)
    End Function

    Private Property mAskedChord As String = ""
    Private Property mAskedAt As Integer = 0

    ''' Builds a chord in StudioCanonicalShortcut form.
    Public Shared Function ChordFor(primary As Boolean, alt As Boolean, shift As Boolean, key As String) As String
        If key = "" Then Return ""
        ' Shifted US punctuation names its unshifted key (Primary+Shift+\, not |).
        Dim shifted As String = "|{}?:\"<>_+~!@#$%^&*()"
        Dim plain As String = "\\[]/;',.-=`1234567890"
        Dim at As Integer = -1
        If String.Len(key) = 1 Then at = String.IndexOf(shifted, key, 0, True)
        Dim shiftHeld As Boolean = shift
        If at >= 0 Then
            key = String.Substring(plain, at, 1)
            shiftHeld = True
        End If
        Dim chord As String = ""
        If primary Then chord += "Primary+"
        If alt Then chord += "Alt+"
        If shiftHeld Then chord += "Shift+"
        Return chord + String.UCase(key)
    End Function

    ''' Raises ShortcutRequested once per key press (a native path that asked marks the
    ''' chord so the Canvas KeyDown fallback for the same press does not ask again).
    Public Function AskShortcut(chord As String, fromNative As Boolean) As Boolean
        If chord = "" Or String.Len(Me.mIncomplete) > 0 Then Return False
        If (Me.mDragMode = 7 Or Me.mDragMode = 8) And String.Compare(chord, "ESCAPE", True) = 0 Then
            Me.CancelSelectionDrag()
            Return True
        End If
        Dim now As Integer = System.Microseconds()
        If Not fromNative And chord = Me.mAskedChord And now - Me.mAskedAt < 300000 Then
            Me.mAskedChord = ""
            Return False
        End If
        If fromNative Then
            Me.mAskedChord = chord
            Me.mAskedAt = now
        Else
            Me.mAskedChord = ""
        End If
        Return RaiseEvent ShortcutRequested(chord)
    End Function

    ''' Chord of a Canvas key event, "" when it is not a shortcut chord.
    Private Function KeyChord(e As KeyEvent) As String
        Dim primary As Boolean = e.Modifiers.Primary
        Dim alt As Boolean = e.Modifiers.Option And Not e.Modifiers.Control
        Dim key As String = ""
        Dim functionKey As Boolean = False
        Select Case e.Key
        Case KeyName.Up
            key = "UP"
        Case KeyName.Down
            key = "DOWN"
        Case KeyName.Left
            key = "LEFT"
        Case KeyName.Right
            key = "RIGHT"
        Case KeyName.Home
            key = "HOME"
        Case KeyName.EndKey
            key = "END"
        Case KeyName.PageUp
            key = "PAGEUP"
        Case KeyName.PageDown
            key = "PAGEDOWN"
        Case KeyName.Tab
            key = "TAB"
        Case KeyName.Return
            key = "RETURN"
        Case KeyName.Escape
            key = "ESCAPE"
        Case KeyName.Backspace
            key = "BACKSPACE"
        Case KeyName.Delete
            key = "DELETE"
        Case KeyName.Space
            key = "SPACE"
        Case KeyName.F1
            key = "F1"
            functionKey = True
        Case KeyName.F2
            key = "F2"
            functionKey = True
        Case KeyName.F3
            key = "F3"
            functionKey = True
        Case KeyName.F4
            key = "F4"
            functionKey = True
        Case KeyName.F5
            key = "F5"
            functionKey = True
        Case KeyName.F6
            key = "F6"
            functionKey = True
        Case KeyName.F7
            key = "F7"
            functionKey = True
        Case KeyName.F8
            key = "F8"
            functionKey = True
        Case KeyName.F9
            key = "F9"
            functionKey = True
        Case KeyName.F10
            key = "F10"
            functionKey = True
        Case KeyName.F11
            key = "F11"
            functionKey = True
        Case KeyName.F12
            key = "F12"
            functionKey = True
        Case Else
            If e.Character > 0 Then
                Dim code As Integer = e.Character
                If code <= 26 And e.Modifiers.Control Then code += 96
                If code > 32 Then key = String.Chr(code)
            End If
        End Select
        If key = "" Then Return ""
        If Not primary And Not alt And Not functionKey Then Return ""
        Return StudioCodeEditor.ChordFor(primary, alt, e.Modifiers.Shift, key)
    End Function

    ' ---- Delimiter pairs and on-type dedent -----------------------------------------------

    ''' Typing an opening bracket or quote also inserts its closer (before whitespace, a
    ''' closer or the line end; not inside strings or comments); typing the closer again
    ''' steps over it; Backspace between an untouched pair removes both.
    Public Property AutoClosePairs As Boolean = False
    ''' Typing an opener (or Markdown `*`, `_`, `` ` ``) with a selection wraps it.
    Public Property WrapSelectionInPairs As Boolean = False
    ''' Typing completes a closing or middle line (End If, Next , Case , Else , Catch )
    ''' re-aligns it to its opener (Buoy mode).
    Public Property DedentOnType As Boolean = False
    Private Property mAutoClosed As Array Of Integer = []

    Private Function PairCloser(opener As String) As String
        Select Case opener
        Case "("
            If Me.mLanguageMode = "json" Then Return ""
            Return ")"
        Case "["
            Return "]"
        Case "{"
            If Me.mLanguageMode = "markdown" Then Return ""
            Return "}"
        Case "\""
            If Me.mLanguageMode = "markdown" Then Return ""
            Return "\""
        Case "`"
            If Me.mLanguageMode = "markdown" Then Return "`"
        End Select
        Return ""
    End Function

    Private Function IsPairCloser(value As String) As Boolean
        Return value = ")" Or value = "]" Or value = "}" Or value = "\"" Or value = "`"
    End Function

    ''' Token kind at a codepoint column of a line (Plain when none).
    Private Function TokenKindAt(lineIndex As Integer, column As Integer) As StudioTokenKind
        For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
            If column >= token.Start And column < token.Start + token.Length Then Return token.Kind
        Next
        Return StudioTokenKind.Plain
    End Function

    ''' The typed-character path for one selection: pairs, dedent, then plain insertion.
    Private Sub TypeText(value As String)
        If value = "\n" Then
            Me.InsertNewline()
            Return
        End If
        If String.Len(value) = 1 Then
            If Me.TypePairCharacter(value) Then Return
            If Me.TypeDedented(value) Then Return
        End If
        Me.EditRange(Me.SelectionStart, Me.SelectionLength, value, -1, -1, "typing")
    End Sub

    Private Function TypePairCharacter(value As String) As Boolean
        Dim closer As String = Me.PairCloser(value)
        If Me.SelectionLength > 0 Then
            If Not Me.WrapSelectionInPairs Then Return False
            Dim wrapCloser As String = closer
            If Me.mLanguageMode = "markdown" And (value = "*" Or value = "_") Then wrapCloser = value
            If wrapCloser = "" Then Return False
            Dim s As Integer = Me.SelectionStart
            Dim inner As String = Me.SelectedText
            Dim forward As Boolean = Me.mCaret >= Me.mAnchor
            Dim innerEnd As Integer = s + 1 + String.Len(inner)
            If forward Then
                Me.EditRange(s, String.Len(inner), value + inner + wrapCloser, s + 1, innerEnd, "typing")
            Else
                Me.EditRange(s, String.Len(inner), value + inner + wrapCloser, innerEnd, s + 1, "typing")
            End If
            Return True
        End If
        If Not Me.AutoClosePairs Then Return False
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim line As String = Me.mLines(lineIndex)
        Dim column As Integer = Me.mCaret - Me.mStarts(lineIndex)
        Dim nextChar As String = ""
        If column < String.Len(line) Then nextChar = String.Substring(line, column, 1)
        ' Step over a closer this editor inserted.
        If Me.IsPairCloser(value) And nextChar = value And Array.IndexOf(Me.mAutoClosed, Me.mCaret) >= 0 Then
            Array.RemoveValue(Me.mAutoClosed, Me.mCaret)
            Me.mCaret += 1
            Me.mAnchor = Me.mCaret
            Me.mEditKind = ""
            Me.Invalidate()
            Me.FinishInteraction()
            Return True
        End If
        If closer = "" Then Return False
        If nextChar <> "" And nextChar <> " " And nextChar <> "\t" And Not Me.IsPairCloser(nextChar) And nextChar <> "," And nextChar <> ";" And nextChar <> ":" Then Return False
        If Me.IsBuoyMode() Or Me.mLanguageMode = "json" Then
            Me.EnsureStates(lineIndex)
            If column > 0 Then
                Dim kind As StudioTokenKind = Me.TokenKindAt(lineIndex, column - 1)
                If kind = StudioTokenKind.Comment Then Return False
                ' Inside a string a quote closes it; brackets there are literal text.
                If kind = StudioTokenKind.Text And Not String.EndsWith(String.Left(line, column), "\"") Then Return False
            End If
        End If
        If value = "\"" Or value = "`" Then
            ' No pair right after a word character (it's more likely a closing quote).
            If column > 0 Then
                If EditorIsWordCode(String.Asc(String.Substring(line, column - 1, 1))) Then Return False
            End If
        End If
        Dim at As Integer = Me.mCaret
        Me.EditRange(at, 0, value + closer, at + 1, at + 1, "typing")
        Array.Append(Me.mAutoClosed, at + 1)
        Return True
    End Function

    ''' Backspace between an auto-inserted pair deletes both halves.
    Private Function DeletePair() As Boolean
        If Me.SelectionLength > 0 Or Me.mCaret = 0 Then Return False
        If Array.IndexOf(Me.mAutoClosed, Me.mCaret) < 0 Then Return False
        Dim before As String = Me.Slice(Me.mCaret - 1, 1)
        Dim after As String = Me.Slice(Me.mCaret, 1)
        If after = "" Or Me.PairCloser(before) <> after Then Return False
        Array.RemoveValue(Me.mAutoClosed, Me.mCaret)
        Me.EditRange(Me.mCaret - 1, 2, "", -1, -1, "delete")
        Return True
    End Function

    ''' On-type dedent: typing the last letter of a closing line ("End If") or the space
    ''' after a middle keyword ("Case ", "Else ", "Catch ") re-aligns the line to its
    ''' opener in the same edit. Buoy mode, single caret, caret at the end of the code.
    Private Function TypeDedented(value As String) As Boolean
        If Not Me.DedentOnType Or Not Me.IsBuoyMode() Or Me.SelectionLength > 0 Then Return False
        Dim lineIndex As Integer = Me.LineOfPosition(Me.mCaret)
        Dim line As String = Me.mLines(lineIndex)
        Dim lineStart As Integer = Me.mStarts(lineIndex)
        Dim column As Integer = Me.mCaret - lineStart
        If String.Trim(String.Substring(line, column)) <> "" Then Return False
        Dim lead As String = Me.LeadingWhitespace(line)
        If String.Len(lead) >= column And value = " " Then Return False
        Dim before As String = String.Left(line, column) + value
        Dim candidate As String = String.Trim(before)
        Me.EnsureStates(lineIndex)
        If Me.mStates(lineIndex) Then Return False
        Dim info As StudioBlockInfo = StudioClassifyBlock(before, False)
        Dim triggers As Boolean = False
        If info.Role = StudioBlockRole.Closes And value <> " " Then
            triggers = String.Compare(candidate, StudioBlockCloser(info.Kind), False) = 0
        ElseIf (info.Role = StudioBlockRole.Continues Or info.Role = StudioBlockRole.Closes) And value = " " Then
            triggers = Not String.Contains(candidate, " ")
        End If
        If Not triggers Then Return False
        Dim aligned As String = Me.PolicyIndent(Me.OpenerIndent(lineIndex, info, lead))
        If aligned = lead Then Return False
        Dim replacement As String = aligned + String.Substring(before, String.Len(lead))
        Dim caretAfter As Integer = lineStart + String.Len(replacement)
        Me.EditRange(lineStart, column, replacement, caretAfter, caretAfter, "typing")
        Return True
    End Function

    ' ---- Brackets and block partners -----------------------------------------------------

    ''' Position of the nearest unmatched opening bracket before `position` (code only,
    ''' within 400 lines), or -1.
    Private Function EnclosingOpener(position As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim depth As Integer = 0
        Dim i As Integer = lineIndex
        While i >= 0 And lineIndex - i <= 400
            Dim brackets As Array Of Integer = Me.BracketColumns(i)
            Dim count As Integer = Array.Count(brackets) \ 2
            For n As Integer = count - 1 To 0 Step -1
                Dim c As Integer = brackets(n * 2)
                If i = lineIndex And c >= column Then Continue For
                Dim code As Integer = brackets(n * 2 + 1)
                If code = 41 Or code = 93 Or code = 125 Then
                    depth += 1
                ElseIf depth = 0 Then
                    Return Me.mStarts(i) + c
                Else
                    depth -= 1
                End If
            Next
            i -= 1
        Wend
        Return -1
    End Function

    ''' Partner of the bracket at a position (exactly there), or -1.
    Private Function PartnerAt(position As Integer) As Integer
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim brackets As Array Of Integer = Me.BracketColumns(lineIndex)
        Dim k As Integer = 0
        While k + 1 < Array.Count(brackets)
            If brackets(k) = column Then Return Me.MatchBracket(lineIndex, column, brackets(k + 1))
            k += 2
        Wend
        Return -1
    End Function

    ''' Go to (or select through) the matching bracket: the bracket beside the caret's
    ''' partner, else the closer of the innermost enclosing pair.
    Private Sub JumpToBracket(selectThrough As Boolean)
        Dim origin As Integer = -1
        Dim partner As Integer = Me.BracketPair(Me.mCaret, origin)
        If partner < 0 Then
            origin = Me.EnclosingOpener(Me.mCaret)
            If origin < 0 Then Return
            partner = Me.PartnerAt(origin)
            If partner < 0 Then Return
        End If
        Me.ClearComposition()
        If selectThrough Then
            Me.mAnchor = Math.Min(origin, partner)
            Me.mCaret = Math.Max(origin, partner) + 1
        ElseIf partner > origin Then
            Me.mCaret = partner + 1
            Me.mAnchor = Me.mCaret
        Else
            Me.mCaret = partner
            Me.mAnchor = Me.mCaret
        End If
        Me.mPreferredColumn = -1
        Me.EnsureCaretVisible()
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Opener <-> closing line: from a block header to its last line, from a closing line
    ''' to its header, else to the header of the innermost enclosing block.
    Private Sub JumpToBlockPartner()
        Dim lineIndex As Integer = Me.CaretLine
        Me.EnsureFoldRegions()
        Dim target As Integer = -1
        If Me.mFoldEnds(lineIndex) > lineIndex And Me.mFoldKinds(lineIndex) <> "comment" Then
            target = Me.mFoldEnds(lineIndex)
        Else
            For header As Integer = lineIndex - 1 To Math.Max(0, lineIndex - 20000) Step -1
                If Me.mFoldEnds(header) = lineIndex And Me.mFoldKinds(header) <> "comment" Then
                    target = header
                    Exit For
                End If
            Next
            If target < 0 Then target = Me.mScopeInner(lineIndex)
        End If
        If target < 0 Then Return
        Me.UnfoldAround(target)
        Dim column As Integer = String.Len(Me.LeadingWhitespace(Me.mLines(target)))
        Me.MoveCaretTo(Me.mStarts(target) + column, False)
    End Sub

    ' ---- Expand / shrink selection ---------------------------------------------------------

    Private Property mExpandAnchors As Array Of Integer = []
    Private Property mExpandCarets As Array Of Integer = []
    Private Property mExpandCounts As Array Of Integer = []
    Private Property mExpandResult As String = ""
    Private Property mExpanding As Boolean = False

    Private Function SelectionSignature() As String
        Dim parts As Array Of String = []
        Dim anchors As Array Of Integer = Me.AllAnchors()
        Dim carets As Array Of Integer = Me.AllCarets()
        For i As Integer = 0 To Array.LastIndex(carets)
            Array.Append(parts, String.From(anchors(i)) + ":" + String.From(carets(i)))
        Next
        Return String.Join(parts, ",")
    End Function

    ''' Grows every selection to the next enclosing unit: word, qualified name, string,
    ''' bracket contents, brackets, line text, whole lines, block body, block, document.
    Private Sub ExpandSelections()
        If Me.mSelectionSignatureMismatch() Then
            Me.mExpandAnchors = []
            Me.mExpandCarets = []
            Me.mExpandCounts = []
        End If
        Dim anchors As Array Of Integer = Me.AllAnchors()
        Dim carets As Array Of Integer = Me.AllCarets()
        Dim before As String = Me.SelectionSignature()
        For i As Integer = 0 To Array.LastIndex(carets)
            Array.Append(Me.mExpandAnchors, anchors(i))
            Array.Append(Me.mExpandCarets, carets(i))
        Next
        Array.Append(Me.mExpandCounts, Array.Count(carets))
        Me.mExpanding = True
        If Me.SelectionCount > 1 Then
            Me.RunBatch("@expand", False, Me.NoPieces(), False)
        Else
            Me.ExpandOne()
            Me.EnsureCaretVisible()
            Me.Invalidate()
            Me.FinishInteraction()
        End If
        Me.mExpanding = False
        If Me.SelectionSignature() = before Then
            ' Nothing larger: drop the pushed state.
            For i As Integer = 1 To Array.Last(Me.mExpandCounts)
                Array.RemoveAt(Me.mExpandAnchors, Array.LastIndex(Me.mExpandAnchors))
                Array.RemoveAt(Me.mExpandCarets, Array.LastIndex(Me.mExpandCarets))
            Next
            Array.RemoveAt(Me.mExpandCounts, Array.LastIndex(Me.mExpandCounts))
        End If
        Me.mExpandResult = Me.SelectionSignature()
    End Sub

    Private Function mSelectionSignatureMismatch() As Boolean
        Return Array.Count(Me.mExpandCounts) = 0 Or Me.mExpandResult <> Me.SelectionSignature()
    End Function

    ''' Restores the selections from before the last expansion (only right after it).
    Private Sub ShrinkSelections()
        If Me.mSelectionSignatureMismatch() Then
            Me.mExpandAnchors = []
            Me.mExpandCarets = []
            Me.mExpandCounts = []
            Return
        End If
        Dim count As Integer = Array.Last(Me.mExpandCounts)
        Array.RemoveAt(Me.mExpandCounts, Array.LastIndex(Me.mExpandCounts))
        Dim first As Integer = Array.Count(Me.mExpandCarets) - count
        Dim anchors As Array Of Integer = Array.Slice(Me.mExpandAnchors, first, count)
        Dim carets As Array Of Integer = Array.Slice(Me.mExpandCarets, first, count)
        For i As Integer = 1 To count
            Array.RemoveAt(Me.mExpandAnchors, Array.LastIndex(Me.mExpandAnchors))
            Array.RemoveAt(Me.mExpandCarets, Array.LastIndex(Me.mExpandCarets))
        Next
        Me.mExpanding = True
        Me.SetSelectionArrays(anchors, carets)
        Me.mExpanding = False
        Me.mExpandResult = Me.SelectionSignature()
    End Sub

    Private Sub ConsiderRange(ByRef bestStart As Integer, ByRef bestEnd As Integer, s As Integer, e As Integer, candidateStart As Integer, candidateEnd As Integer)
        If candidateStart > s Or candidateEnd < e Then Return
        If candidateEnd - candidateStart <= e - s Then Return
        If bestStart < 0 Or candidateEnd - candidateStart < bestEnd - bestStart Then
            bestStart = candidateStart
            bestEnd = candidateEnd
        End If
    End Sub

    ''' Expands the primary selection one step (smallest strictly larger candidate).
    Private Sub ExpandOne()
        Dim s As Integer = Me.SelectionStart
        Dim e As Integer = s + Me.SelectionLength
        Dim bestStart As Integer = -1
        Dim bestEnd As Integer = -1
        Dim lineIndex As Integer = Me.LineOfPosition(s)
        Dim lastLine As Integer = Me.LineOfPosition(e)
        Dim lineStart As Integer = Me.mStarts(lineIndex)
        Dim codes As Array Of String = String.Chars(Me.mLines(lineIndex))
        ' Word and dotted name around the selection (same line).
        If lineIndex = lastLine Then
            Dim a As Integer = s - lineStart
            Dim b As Integer = e - lineStart
            While a > 0
                If Not EditorIsWordCode(String.Asc(codes(a - 1))) Then Exit While
                a -= 1
            Wend
            While b < Array.Count(codes)
                If Not EditorIsWordCode(String.Asc(codes(b))) Then Exit While
                b += 1
            Wend
            Me.ConsiderRange(bestStart, bestEnd, s, e, lineStart + a, lineStart + b)
            Dim qa As Integer = a
            Dim qb As Integer = b
            While qa > 0
                Dim code As Integer = String.Asc(codes(qa - 1))
                If Not (EditorIsWordCode(code) Or code = 46) Then Exit While
                qa -= 1
            Wend
            While qb < Array.Count(codes)
                Dim code As Integer = String.Asc(codes(qb))
                If Not (EditorIsWordCode(code) Or code = 46) Then Exit While
                qb += 1
            Wend
            Me.ConsiderRange(bestStart, bestEnd, s, e, lineStart + qa, lineStart + qb)
            ' String literal: contents, then with quotes.
            For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
                If token.Kind <> StudioTokenKind.Text And token.Kind <> StudioTokenKind.Comment Then Continue For
                Dim ts As Integer = lineStart + token.Start
                Dim te As Integer = ts + token.Length
                If token.Kind = StudioTokenKind.Text And token.Length >= 2 Then Me.ConsiderRange(bestStart, bestEnd, s, e, ts + 1, te - 1)
                Me.ConsiderRange(bestStart, bestEnd, s, e, ts, te)
            Next
            ' Line text without indentation and trailing spaces.
            Dim lead As Integer = String.Len(Me.LeadingWhitespace(Me.mLines(lineIndex)))
            Dim trimmedEnd As Integer = String.Len(String.RTrim(Me.mLines(lineIndex)))
            If trimmedEnd > lead Then Me.ConsiderRange(bestStart, bestEnd, s, e, lineStart + lead, lineStart + trimmedEnd)
        End If
        ' Enclosing bracket pairs (a few levels out).
        Dim probe As Integer = s
        For level As Integer = 1 To 6
            Dim opener As Integer = Me.EnclosingOpener(probe)
            If opener < 0 Then Exit For
            Dim closer As Integer = Me.PartnerAt(opener)
            If closer < 0 Then Exit For
            If closer >= e Then
                Me.ConsiderRange(bestStart, bestEnd, s, e, opener + 1, closer)
                Me.ConsiderRange(bestStart, bestEnd, s, e, opener, closer + 1)
            End If
            probe = opener
        Next
        ' Whole lines, then enclosing blocks.
        Dim fullEnd As Integer = Me.NavLineEnd(lastLine)
        If lastLine > lineIndex And e = Me.mStarts(lastLine) Then fullEnd = Me.NavLineEnd(lastLine - 1)
        Me.ConsiderRange(bestStart, bestEnd, s, e, lineStart, fullEnd)
        For Each scope As StudioEditorScope In Array.Reversed(Me.ScopeChain(lineIndex))
            If scope.EndLine > scope.Line + 1 Then Me.ConsiderRange(bestStart, bestEnd, s, e, Me.mStarts(scope.Line + 1), Me.NavLineEnd(scope.EndLine - 1))
            Me.ConsiderRange(bestStart, bestEnd, s, e, Me.mStarts(scope.Line), Me.NavLineEnd(scope.EndLine))
        Next
        Me.ConsiderRange(bestStart, bestEnd, s, e, 0, Me.TotalLength())
        If bestStart < 0 Then Return
        Me.mAnchor = bestStart
        Me.mCaret = bestEnd
        Me.mPreferredColumn = -1
    End Sub

    ' ---- Line and case transforms ---------------------------------------------------------

    ''' Blocks of consecutive lines covered by the selections, as (first, last) pairs from
    ''' the top. An empty single selection covers the whole document when `wholeIfEmpty`.
    Private Function LineBlocks(wholeIfEmpty As Boolean) As Array Of Integer
        Dim blocks As Array Of Integer = []
        If wholeIfEmpty And Me.SelectionCount = 1 And Me.SelectionLength = 0 Then
            Array.Append(blocks, 0)
            Array.Append(blocks, Array.LastIndex(Me.mLines))
            Return blocks
        End If
        Dim lines As Array Of Integer = []
        Dim anchors As Array Of Integer = Me.AllAnchors()
        Dim carets As Array Of Integer = Me.AllCarets()
        For i As Integer = 0 To Array.LastIndex(carets)
            Dim s As Integer = Math.Min(anchors(i), carets(i))
            Dim e As Integer = Math.Max(anchors(i), carets(i))
            Dim first As Integer = Me.LineOfPosition(s)
            Dim last As Integer = Me.LineOfPosition(e)
            If last > first And e = Me.mStarts(last) Then last -= 1
            last = Me.RowEndLine(last)
            For lineIndex As Integer = first To last
                Array.Append(lines, lineIndex)
            Next
        Next
        Dim unique As Array Of Integer = EditorUniqueSorted(lines)
        For Each lineIndex As Integer In unique
            Dim n As Integer = Array.Count(blocks)
            If n > 0 Then
                If blocks(n - 1) = lineIndex - 1 Then
                    blocks(n - 1) = lineIndex
                    Continue For
                End If
            End If
            Array.Append(blocks, lineIndex)
            Array.Append(blocks, lineIndex)
        Next
        Return blocks
    End Function

    ''' Applies a line transform to every selected block as one undo step and selects
    ''' the transformed blocks.
    Private Sub TransformLines(mode As String)
        If Me.IsReadOnly Then Return
        Dim blocks As Array Of Integer = Me.LineBlocks(mode <> "join")
        If Array.Count(blocks) = 0 Then Return
        Me.ClearComposition()
        Dim newFirsts As Array Of Integer = []
        Dim newLasts As Array Of Integer = []
        Me.BeginEditGroup()
        Dim k As Integer = Array.Count(blocks) - 2
        While k >= 0
            Dim first As Integer = blocks(k)
            Dim last As Integer = blocks(k + 1)
            If mode = "join" And first = last Then last = Math.Min(Array.LastIndex(Me.mLines), first + 1)
            Dim lines As Array Of String = []
            For i As Integer = first To last
                Array.Append(lines, Me.mLines(i))
            Next
            Dim transformed As Array Of String = lines
            Select Case mode
            Case "ascending", "descending", "caseInsensitive", "natural"
                transformed = StudioSortLines(lines, mode)
            Case "reverse"
                transformed = StudioReverseLines(lines)
            Case "unique"
                transformed = StudioUniqueLines(lines)
            Case "trim"
                transformed = []
                For Each line As String In lines
                    Array.Append(transformed, StudioTrimTrailing(line))
                Next
            Case "join"
                transformed = [StudioJoinLines(lines)]
            End Select
            Dim blockStart As Integer = Me.mStarts(first)
            Dim blockEnd As Integer = Me.NavLineEnd(last)
            Dim replacement As String = String.Join(transformed, "\n")
            If String.Compare(replacement, Me.Slice(blockStart, blockEnd - blockStart), True) <> 0 Then
                Me.EditRange(blockStart, blockEnd - blockStart, replacement, -1, -1, "transform")
            End If
            Array.Insert(newFirsts, 0, blockStart)
            Array.Insert(newLasts, 0, blockStart + String.Len(replacement))
            ' Blocks below shift with this edit.
            Dim delta As Integer = String.Len(replacement) - (blockEnd - blockStart)
            For n As Integer = 1 To Array.LastIndex(newFirsts)
                newFirsts(n) = newFirsts(n) + delta
                newLasts(n) = newLasts(n) + delta
            Next
            k -= 2
        Wend
        Dim anchors As Array Of Integer = []
        Dim carets As Array Of Integer = []
        For n As Integer = 0 To Array.LastIndex(newFirsts)
            If mode = "join" Or mode = "trim" Then
                Array.Append(anchors, newLasts(n))
            Else
                Array.Append(anchors, newFirsts(n))
            End If
            Array.Append(carets, newLasts(n))
        Next
        Me.mAnchor = anchors(0)
        Me.mCaret = carets(0)
        Me.mExtraAnchors = []
        Me.mExtraCarets = []
        For n As Integer = 1 To Array.LastIndex(carets)
            Array.Append(Me.mExtraAnchors, anchors(n))
            Array.Append(Me.mExtraCarets, carets(n))
        Next
        Me.EndEditGroup("transform")
    End Sub

    ''' Case transform of the selection (or the word at the caret), keeping it selected.
    Private Sub TransformCaseOne(mode As String)
        If Me.IsReadOnly Then Return
        If Me.SelectionLength = 0 Then Me.SelectWordAt(Me.mCaret)
        If Me.SelectionLength = 0 Then Return
        Dim s As Integer = Me.SelectionStart
        Dim original As String = Me.SelectedText
        Dim changed As String = StudioTransformCase(original, mode)
        If String.Compare(changed, original, True) = 0 Then Return
        Dim forward As Boolean = Me.mCaret >= Me.mAnchor
        Dim finish As Integer = s + String.Len(changed)
        If forward Then
            Me.EditRange(s, String.Len(original), changed, s, finish, "transform")
        Else
            Me.EditRange(s, String.Len(original), changed, finish, s, "transform")
        End If
    End Sub

    ' ---- Macros ----------------------------------------------------------------------------
    ' Recording captures editor commands (keyboard, menus, PerformCommand) and committed
    ' text (typing and IME commits) as steps "cmd:<0|1 extend>:<command>" and
    ' "text:<text>". Mouse actions, host undo/redo and the macro commands themselves are
    ' not recorded. Replay runs the steps as one edit group (one undo step).

    Private Property mMacroRecording As Boolean = False
    Private Property mMacroReplaying As Boolean = False
    Private Property mMacroSteps As Array Of String = []
    Private Property mMacroPending As Array Of String = []

    Public Property IsRecordingMacro As Boolean
        Get
            Return Me.mMacroRecording
        End Get
    End Property

    Public Sub StartMacroRecording()
        Me.mMacroRecording = True
        Me.mMacroPending = []
        Me.Invalidate()
    End Sub

    ''' Stops recording; the recorded steps replace the macro (an empty recording keeps
    ''' the previous macro).
    Public Sub StopMacroRecording()
        If Not Me.mMacroRecording Then Return
        Me.mMacroRecording = False
        If Array.Count(Me.mMacroPending) > 0 Then Me.mMacroSteps = Me.mMacroPending
        Me.mMacroPending = []
        Me.Invalidate()
    End Sub

    Public Function MacroSteps() As Array Of String
        Return Array.Clone(Me.mMacroSteps)
    End Function

    ''' Replaces the macro (validated: only cmd:/text: steps).
    Public Sub SetMacroSteps(steps As Array Of String)
        Dim kept As Array Of String = []
        For Each stepValue As String In steps
            If String.StartsWith(stepValue, "text:") Or String.StartsWith(stepValue, "cmd:0:") Or String.StartsWith(stepValue, "cmd:1:") Then Array.Append(kept, stepValue)
        Next
        Me.mMacroSteps = kept
    End Sub

    Private Sub RecordMacroCommand(command As String, extend As Boolean)
        If Not Me.mMacroRecording Or Me.mMacroReplaying Then Return
        Select Case command
        Case "toggleMacroRecording", "replayMacro", "undo", "redo"
            Return
        End Select
        Dim flag As String = "0"
        If extend Then flag = "1"
        Array.Append(Me.mMacroPending, "cmd:" + flag + ":" + command)
    End Sub

    Private Sub RecordMacroText(value As String)
        If Not Me.mMacroRecording Or Me.mMacroReplaying Then Return
        ' One step per commit, never merged: replay feeds each commit back through the same
        ' typed-text path (auto-close pairs, closer step-over, on-type dedent, newline
        ' indent), and a multi-character IME commit stays one step.
        If value = "" Then Return
        Array.Append(Me.mMacroPending, "text:" + value)
    End Sub

    ''' Replays the macro `times` times as one undo step. False when there is none or the
    ''' editor is read-only.
    Public Function ReplayMacro(times As Integer = 1) As Boolean
        If Array.Count(Me.mMacroSteps) = 0 Or Me.mMacroRecording Then Return False
        Me.mMacroReplaying = True
        Me.BeginEditGroup()
        Try
            For n As Integer = 1 To Math.Max(1, Math.Min(times, 10000))
                For Each stepValue As String In Me.mMacroSteps
                    If String.StartsWith(stepValue, "text:") Then
                        Me.CommitTyped(String.Substring(stepValue, 5))
                    Else
                        Me.RunCommand(String.Substring(stepValue, 6), String.Substring(stepValue, 4, 1) = "1")
                    End If
                Next
            Next
        Finally
            Me.mMacroReplaying = False
            Me.EndEditGroup("macro")
        End Try
        Return True
    End Function

    ' ---- Scopes, breadcrumbs and sticky scope headers --------------------------------------

    Private Property mFoldKinds As Array Of String = []
    Private Property mScopeInner As Array Of Integer = []
    Private Property mShowsStickyScopes As Boolean = False
    Private Property mStickyLines As Array Of Integer = []
    ''' Most header lines stuck at the top (1-10, default 5).
    Public Property MaxStickyLines As Integer = 5

    ''' Pin the headers of the blocks enclosing the top line above the text (VS Code
    ''' sticky scroll); clicking one goes to it.
    Public Property ShowsStickyScopes As Boolean
        Get
            Return Me.mShowsStickyScopes
        End Get
        Set
            Me.mShowsStickyScopes = value
            Me.Invalidate()
        End Set
    End Property

    Private Function IsScopeKind(kind As String) As Boolean
        Return kind <> "" And kind <> "comment"
    End Function

    ''' Scopes (blocks, indentation regions, Markdown sections) containing a line,
    ''' outermost first; a scope whose header is the line itself is included.
    Public Function ScopeChain(lineIndex As Integer) As Array Of StudioEditorScope
        Dim chain As Array Of StudioEditorScope = []
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return chain
        Me.EnsureFoldRegions()
        Dim header As Integer = Me.mScopeInner(lineIndex)
        If Me.mFoldEnds(lineIndex) > lineIndex And Me.IsScopeKind(Me.mFoldKinds(lineIndex)) Then header = lineIndex
        Dim guard As Integer = 0
        While header >= 0 And guard < 256
            Array.Insert(chain, 0, Me.ScopeOf(header))
            header = Me.mScopeInner(header)
            guard += 1
        Wend
        Return chain
    End Function

    Private Function ScopeOf(header As Integer) As StudioEditorScope
        Dim scope As New StudioEditorScope()
        scope.Line = header
        scope.EndLine = Me.mFoldEnds(header)
        scope.Kind = Me.mFoldKinds(header)
        scope.Text = String.Trim(Me.mLines(header))
        scope.Name = StudioScopeName(scope.Text, scope.Kind, Me.mLanguageMode)
        Return scope
    End Function

    ''' Header lines pinned at the top for the current scroll position (outermost first;
    ''' empty while ShowsStickyScopes is off).
    Public Function StickyScopeLines() As Array Of Integer
        Return Me.StickyHeaders()
    End Function

    ''' Header line of the sticky scope row under a view point (gutter or text area, left
    ''' of the minimap and scrollbar), or -1 when no sticky row is there.
    Public Function StickyLineAtPoint(x As Double, y As Double) As Integer
        If Not Me.mShowsStickyScopes Or y < 0 Or x < 0 Then Return -1
        If x >= Me.TextRight() Or x >= Me.Width - Me.ScrollbarSize() Then Return -1
        Dim headers As Array Of Integer = Me.StickyHeaders()
        Dim k As Integer = Math.Floor(y / Me.LineHeight)
        If k < 0 Or k >= Array.Count(headers) Then Return -1
        Return headers(k)
    End Function

    ''' Goes to a scope header line (a sticky row click): a single caret at its first
    ''' non-blank character, the line scrolled up to just below the headers that stay
    ''' pinned above it (so it shows as itself, not as a sticky row). The text is not
    ''' changed; a collapsed fold hiding the line opens.
    Public Sub RevealStickyScope(lineIndex As Integer)
        If lineIndex < 0 Or lineIndex > Array.LastIndex(Me.mLines) Then Return
        Me.mDragMode = 0
        Me.mDropPosition = -1
        Me.ClearComposition()
        Me.ClearExtras()
        Me.UnfoldAround(lineIndex)
        Dim target As Integer = Me.mStarts(lineIndex) + String.Len(Me.LeadingWhitespace(Me.mLines(lineIndex)))
        Me.mAnchor = target
        Me.mCaret = target
        Me.mPreferredColumn = -1
        Me.mEditKind = ""
        ' Lowest scroll that shows the header below the sticky rows pinned for it.
        Dim headerRow As Integer = Me.RowOfLine(lineIndex)
        Dim limit As Integer = Math.Max(1, Math.Min(10, Me.MaxStickyLines))
        For k As Integer = 0 To limit
            Me.SetScroll(Me.mScrollX, Math.Max(0, headerRow - k) * Me.LineHeight)
            Dim topRow As Integer = Math.Max(0, Math.Floor(Me.mScrollY / Me.LineHeight))
            Dim pinned As Array Of Integer = Me.StickyHeaders()
            Dim covered As Boolean = headerRow - topRow < Array.Count(pinned)
            For Each pinnedLine As Integer In pinned
                If pinnedLine = lineIndex Then covered = True
            Next
            If Not covered Then Exit For
        Next
        Me.Invalidate()
        Me.FinishInteraction()
    End Sub

    ''' Sticky header lines for the current scroll position (outermost first).
    Private Function StickyHeaders() As Array Of Integer
        Dim headers As Array Of Integer = []
        If Not Me.mShowsStickyScopes Then Return headers
        Dim limit As Integer = Math.Max(1, Math.Min(10, Me.MaxStickyLines))
        Dim topRow As Integer = Math.Max(0, Math.Floor(Me.mScrollY / Me.LineHeight))
        If topRow = 0 And Me.mScrollY < Me.LineHeight / 2.0 Then Return headers
        For pass As Integer = 0 To limit
            Dim lineIndex As Integer = Me.LineOfRow(topRow + Array.Count(headers))
            Dim chain As Array Of StudioEditorScope = Me.ScopeChain(lineIndex)
            Dim candidate As Array Of Integer = []
            For Each scope As StudioEditorScope In chain
                If Me.RowOfLine(scope.Line) < topRow + Array.Count(candidate) And Array.Count(candidate) < limit Then Array.Append(candidate, scope.Line)
            Next
            If Array.Count(candidate) <= Array.Count(headers) Then
                If Array.Count(candidate) < Array.Count(headers) Then headers = candidate
                Exit For
            End If
            headers = candidate
        Next
        Return headers
    End Function

    ' ---- Drag auto-scroll ----------------------------------------------------------------------

    Private Property mEdgeTimer As StudioCodeEditorScrollTimer
    Private Property mEdgeRunning As Boolean = False
    Private Property mEdgeX As Double = 0.0
    Private Property mEdgeY As Double = 0.0
    Private Property mEdgeNative As Boolean = False
    Private Property mEdgeAlt As Boolean = False
    Private Property mEdgePrimary As Boolean = False
    Private Property mDragSourceStart As Integer = 0
    Private Property mDragSourceText As String = ""
    Private Property mDragSourceDocument As String = ""

    ''' A drop that would not change anything: the editor's own selection dropped
    ''' inside itself.
    Private Function DropIsNoOp() As Boolean
        If Not (Me.mDragMode = 8 Or Me.mNativeDragActive) Then Return False
        If Me.SelectionLength = 0 Then Return False
        Return Me.mDropPosition >= Me.SelectionStart And Me.mDropPosition <= Me.SelectionStart + Me.SelectionLength
    End Function

    ''' Scroll step (view points per tick) for a pointer at x, y: near or past an edge of
    ''' the text area (the top edge is below the sticky scope headers), faster further out.
    Private Function EdgeScrollStep(x As Double, y As Double, ByRef dx As Double, ByRef dy As Double) As Boolean
        dx = 0.0
        dy = 0.0
        Dim lineHeight As Double = Me.LineHeight
        Dim zone As Double = lineHeight * 0.75
        Dim top As Double = Me.TopPadding()
        If Me.mShowsStickyScopes Then top = Math.Max(top, Array.Count(Me.mStickyLines) * lineHeight)
        Dim bottom As Double = Me.Height - Me.ScrollbarSize()
        If y < top + zone Then
            dy = -Math.Min(lineHeight * 3.0, 2.0 + (top + zone - y) * 0.5)
        ElseIf y > bottom - zone Then
            dy = Math.Min(lineHeight * 3.0, 2.0 + (y - (bottom - zone)) * 0.5)
        End If
        If Not Me.mWordWrap Then
            Dim cw As Double = Me.mCharWidth
            If x < Me.TextLeft() + cw And Me.mScrollX > 0.0 Then
                dx = -Math.Min(cw * 6.0, 2.0 + (Me.TextLeft() + cw - x) * 0.5)
            ElseIf x > Me.TextRight() - cw * 2.0 Then
                dx = Math.Min(cw * 6.0, 2.0 + (x - (Me.TextRight() - cw * 2.0)) * 0.5)
            End If
        End If
        If dy < 0.0 And Me.mScrollY <= 0.0 Then dy = 0.0
        If dy > 0.0 And Me.mScrollY >= Me.MaxScrollY() Then dy = 0.0
        If dx > 0.0 And Me.mScrollX >= Me.MaxScrollX() Then dx = 0.0
        Return dx <> 0.0 Or dy <> 0.0
    End Function

    ''' Remembers the drag pointer and runs the auto-scroll timer while it is at an edge.
    Private Sub UpdateEdgeScroll(x As Double, y As Double, native As Boolean, alt As Boolean, primary As Boolean)
        Me.mEdgeX = x
        Me.mEdgeY = y
        Me.mEdgeNative = native
        Me.mEdgeAlt = alt
        Me.mEdgePrimary = primary
        Dim dx As Double = 0.0
        Dim dy As Double = 0.0
        If Not Me.EdgeScrollStep(x, y, dx, dy) Then
            Me.StopEdgeScroll()
            Return
        End If
        If Me.mEdgeRunning Then Return
        If Me.mEdgeTimer = Nil Then
            Me.mEdgeTimer = New StudioCodeEditorScrollTimer()
            Me.mEdgeTimer.Owner = Me
            Me.mEdgeTimer.Period = 40
        End If
        Me.mEdgeTimer.Start()
        Me.mEdgeRunning = True
    End Sub

    Private Sub StopEdgeScroll()
        If Me.mEdgeTimer <> Nil And Me.mEdgeRunning Then Me.mEdgeTimer.Stop()
        Me.mEdgeRunning = False
    End Sub

    ''' Auto-scroll tick: scroll, then re-apply the drag at the resting pointer (the
    ''' selection extends, or the drop indicator follows the text under it).
    Public Sub EdgeScrollTick()
        Dim dragging As Boolean = Me.mDragMode = 1 Or Me.mDragMode = 5 Or Me.mDragMode = 6 Or Me.mDragMode = 8
        If Not Me.mEdgeNative And Not dragging Then
            Me.StopEdgeScroll()
            Return
        End If
        Dim dx As Double = 0.0
        Dim dy As Double = 0.0
        If Not Me.EdgeScrollStep(Me.mEdgeX, Me.mEdgeY, dx, dy) Then
            Me.StopEdgeScroll()
            Return
        End If
        Me.SetScroll(Me.mScrollX + dx, Me.mScrollY + dy)
        If Me.mEdgeNative Then
            If Me.mDropPosition >= 0 Then Me.mDropPosition = Me.SnapPosition(Me.PositionAt(Math.Max(Me.mEdgeX, Me.TextLeft()), Me.mEdgeY))
            Me.Invalidate()
        Else
            Me.PointerDrag(Me.mEdgeX, Me.mEdgeY, Me.mEdgeAlt, Me.mEdgePrimary)
        End If
    End Sub

    ' ---- Caret style and blinking -----------------------------------------------------------

    Public Const CaretBlinkPeriod As Integer = 530
    Private Property mCaretStyle As String = "line"
    Private Property mCaretBlinks As Boolean = True
    Private Property mBlinkTimer As StudioCodeEditorBlinkTimer
    Private Property mBlinkRunning As Boolean = False
    Private Property mBlinkVisible As Boolean = True
    Private Property mBlinkKey As String = ""
    ' Set by GotFocus: an editor that was never focused (a split pane painted before it
    ' is clicked) keeps a steady caret instead of running a blink timer.
    Private Property mHadFocus As Boolean = False

    ''' A valid CaretStyle ("line" for anything else).
    Public Shared Function CaretStyleName(value As String) As String
        Select Case value
        Case "line", "line-thin", "block", "block-outline", "underline", "underline-thin"
            Return value
        End Select
        Return "line"
    End Function

    ''' "line" (2px bar), "line-thin" (1px bar), "block" (filled cell, the character
    ''' drawn in the background colour), "block-outline", "underline" or
    ''' "underline-thin". Bars span the full line height; the others the whole cell.
    Public Property CaretStyle As String
        Get
            Return Me.mCaretStyle
        End Get
        Set
            Me.mCaretStyle = StudioCodeEditor.CaretStyleName(value)
            Me.Invalidate()
        End Set
    End Property

    ''' The focused caret blinks; it is shown again at once whenever it moves or the
    ''' text changes.
    Public Property CaretBlinks As Boolean
        Get
            Return Me.mCaretBlinks
        End Get
        Set
            If Me.mCaretBlinks = value Then Return
            Me.mCaretBlinks = value
            Me.mBlinkVisible = True
            Me.mBlinkIdle = False
            If Not value Then Me.StopBlinking()
            Me.Invalidate()
        End Set
    End Property

    ' Blinking repaints only the carets: the first tick after a full paint renders the
    ' frame without carets into mFrame (HiDPI), later ticks draw that picture plus the
    ' caret layer (the cursor-layer split of xterm.js and GTK's GtkText). Any
    ' Invalidate() means the content changed and drops back to a full paint.
    Public Const CaretBlinkIdleTicks As Integer = 19
    Private Property mBlinkIdle As Boolean = False
    Private Property mBlinkTicks As Integer = 0
    Private Property mBlinkOnly As Boolean = False
    Private Property mFullPending As Boolean = True
    Private Property mInvalidations As Integer = 0
    Private Property mSuppressCarets As Boolean = False
    Private Property mFrame As Picture
    Private Property mFrameKey As String = ""
    Private Property mLastFullKey As String = ""
    Private Property mCaretPositions As Array Of Integer = []
    Private Property mCaretXs As Array Of Double = []
    Private Property mCaretYs As Array Of Double = []
    Private Property mCaretWidths As Array Of Double = []
    Private Property mCaretColors As Array Of Color = []
    Private Property mCaretTheme As StudioCodeEditorTheme
    Private Property mCaretLineHeight As Double = 16.0
    Private Property mCaretTextBaseline As Double = 12.0
    Private Property mCaretClipLeft As Double = 0.0
    Private Property mCaretClipRight As Double = 0.0
    Private Property mCaretClipTop As Double = 0.0

    ''' Every repaint request except a blink tick: the content changed.
    Public Overrides Sub Invalidate()
        Me.mInvalidations += 1
        Me.mFullPending = True
        Me.mBlinkOnly = False
        Me.mFrame = Nil
        Super.Invalidate()
    End Sub

    Handle Draw(g As Graphics)
        Dim blinkOnly As Boolean = Me.mBlinkOnly And Not Me.mFullPending
        Me.mBlinkOnly = False
        If blinkOnly Then
            Dim scale As Double = Me.BackingScale()
            Dim key As String = Me.FrameKey(scale)
            If Me.mFrame <> Nil And Me.mFrameKey <> key Then Me.mFrame = Nil
            ' Only build the underlay when nothing (size, scroll, appearance) moved since
            ' the last full paint, so the picture matches what is on screen.
            If Me.mFrame = Nil And key = Me.mLastFullKey Then Me.BuildFrameCache(scale, key)
            If Me.mFrame <> Nil Then
                g.DrawPicture(Me.mFrame, 0, 0, Me.Width, Me.Height)
                Me.DrawCaretLayer(g)
                If Not Me.mBlinkRunning Then Me.mFrame = Nil
                Return
            End If
            ' The platform may repaint only the caret cells: draw this frame fully, but
            ' ask for a whole repaint so no region keeps stale pixels.
            Me.RenderFrame(g)
            Me.Invalidate()
            Return
        End If
        Me.mFullPending = False
        Me.mFrame = Nil
        Me.RenderFrame(g)
        Me.mLastFullKey = Me.FrameKey(Me.BackingScale())
    End Handle

    Private Function BackingScale() As Double
        Dim host As Window = Me.ParentWindow
        If host = Nil Then Return 1.0
        Return Math.Max(1.0, host.ScaleFactor)
    End Function

    Private Function FrameKey(scale As Double) As String
        Return String.From(Me.Width) + "x" + String.From(Me.Height) + "@" + String.From(scale) + "/" + String.From(Me.IsDark) + "/" + String.From(Me.mScrollX) + "," + String.From(Me.mScrollY) + "/" + Me.FontName + "/" + String.From(Me.FontSize) + "/" + String.From(Me.mCharWidth)
    End Function

    ''' Renders the frame without carets into mFrame (kept only if nothing invalidated
    ''' the editor while rendering).
    Private Sub BuildFrameCache(scale As Double, key As String)
        Dim generation As Integer = Me.mInvalidations
        Dim pixelWidth As Integer = Math.Max(1, Math.Round(Me.Width * scale + 0.49))
        Dim pixelHeight As Integer = Math.Max(1, Math.Round(Me.Height * scale + 0.49))
        Dim picture As New Picture(pixelWidth, pixelHeight, scale)
        Dim pg As Graphics = picture.Graphics
        pg.Scale(scale, scale)
        Me.mSuppressCarets = True
        Try
            Me.RenderFrame(pg)
        Catch e As Exception
            Me.mSuppressCarets = False
            Return
        End Try
        Me.mSuppressCarets = False
        ' Rendering can move the view without Invalidate() (wrap rebuilds adjust scroll).
        If Me.mInvalidations <> generation Or Me.FrameKey(scale) <> key Then Return
        Me.mFrame = picture
        Me.mFrameKey = key
    End Sub

    Private Sub ClearCaretRecords()
        Me.mCaretPositions = []
        Me.mCaretXs = []
        Me.mCaretYs = []
        Me.mCaretWidths = []
        Me.mCaretColors = []
    End Sub

    ''' A caret to draw in the caret layer (position -1: the IME composition cursor).
    Private Sub RecordCaret(position As Integer, x As Double, y As Double, caretColor As Color)
        Array.Append(Me.mCaretPositions, position)
        Array.Append(Me.mCaretXs, x)
        Array.Append(Me.mCaretYs, y)
        Array.Append(Me.mCaretWidths, Me.CaretCellWidth(position))
        Array.Append(Me.mCaretColors, caretColor)
    End Sub

    ''' The recorded carets in their blink phase, clipped to the text area below the
    ''' sticky scope headers.
    Private Sub DrawCaretLayer(g As Graphics)
        If Array.Count(Me.mCaretPositions) = 0 Or Me.mCaretTheme = Nil Then Return
        If Not Me.CaretPhaseVisible() Then Return
        If Me.mCaretClipTop >= Me.Height Then Return
        g.Save()
        g.ClipToRect(Me.mCaretClipLeft, Me.mCaretClipTop, Math.Max(1.0, Me.mCaretClipRight - Me.mCaretClipLeft), Math.Max(1.0, Me.Height - Me.ScrollbarSize() - Me.mCaretClipTop))
        For i As Integer = 0 To Array.LastIndex(Me.mCaretPositions)
            Me.DrawCaret(g, Me.mCaretPositions(i), Me.mCaretXs(i), Me.mCaretYs(i), Me.mCaretWidths(i), Me.mCaretColors(i))
        Next
        g.Restore()
    End Sub

    ''' Blink tick (StudioCodeEditorBlinkTimer): repaint just the caret cells. After
    ''' CaretBlinkIdleTicks without a change the caret stays shown and the timer stops
    ''' (GTK's cursor-blink-timeout); any caret move or edit starts blinking again.
    Public Sub BlinkTick()
        If Not Me.mFocused Or Not Me.mCaretBlinks Then
            Me.StopBlinking()
            Me.mBlinkVisible = True
            Me.Invalidate()
            Return
        End If
        Me.mBlinkVisible = Not Me.mBlinkVisible
        Me.mBlinkTicks += 1
        If Me.mBlinkTicks >= StudioCodeEditor.CaretBlinkIdleTicks And Me.mBlinkVisible Then
            Me.StopBlinking()
            Me.mBlinkIdle = True
        End If
        If Me.mFullPending Then Return
        Me.mBlinkOnly = True
        For i As Integer = 0 To Array.LastIndex(Me.mCaretPositions)
            Me.InvalidateRect(Me.mCaretXs(i) - 2.0, Me.mCaretYs(i), Me.mCaretWidths(i) + 4.0, Me.mCaretLineHeight)
        Next
    End Sub

    Private Sub StopBlinking()
        If Me.mBlinkTimer <> Nil And Me.mBlinkRunning Then Me.mBlinkTimer.Stop()
        Me.mBlinkRunning = False
    End Sub

    ''' Restarts the blink cycle (caret shown) when the selection or text changed, and
    ''' reports whether carets are in their shown phase.
    Private Function CaretPhaseVisible() As Boolean
        If Not Me.mFocused Or Not Me.mHadFocus Or Not Me.mCaretBlinks Then
            If Me.mBlinkRunning Then Me.StopBlinking()
            Return True
        End If
        Dim key As String = String.From(Me.mCaret) + "," + String.From(Me.mAnchor) + "," + String.From(Me.TotalLength()) + "," + Me.ExtrasKey() + "," + Me.mIncomplete + "," + String.From(Me.mIncompleteCursor)
        If String.Compare(key, Me.mBlinkKey, True) <> 0 Or (Not Me.mBlinkRunning And Not Me.mBlinkIdle) Then
            Me.mBlinkKey = key
            Me.mBlinkVisible = True
            Me.mBlinkTicks = 0
            Me.mBlinkIdle = False
            If Me.mBlinkTimer = Nil Then
                Me.mBlinkTimer = New StudioCodeEditorBlinkTimer()
                Me.mBlinkTimer.Owner = Me
                Me.mBlinkTimer.Period = StudioCodeEditor.CaretBlinkPeriod
            End If
            Me.mBlinkTimer.Start()
            Me.mBlinkRunning = True
        End If
        Return Me.mBlinkVisible
    End Function

    ''' Width of the cell under a caret: its whole cluster (or tab); one column at a
    ''' line end or for the IME cursor (position < 0).
    Private Function CaretCellWidth(position As Integer) As Double
        If position < 0 Then Return Me.mCharWidth
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        Dim line As String = Me.mLines(lineIndex)
        If column >= String.Len(line) Then Return Me.mCharWidth
        Dim nextColumn As Integer = Me.CaretNextColumn(lineIndex, column)
        Dim span As Double = (Me.VisualColumn(line, nextColumn) - Me.VisualColumn(line, column)) * Me.mCharWidth
        If span > 0.5 Then Return span
        Return Me.mCharWidth
    End Function

    Private Function CaretNextColumn(lineIndex As Integer, column As Integer) As Integer
        Dim nextColumn As Integer = Me.StepPosition(Me.mStarts(lineIndex) + column, True) - Me.mStarts(lineIndex)
        Return Math.Min(Math.Max(column + 1, nextColumn), String.Len(Me.mLines(lineIndex)))
    End Function

    ''' One caret (top-left x, y; `cellWidth` from CaretCellWidth) in the current
    ''' CaretStyle. An unfocused block caret is drawn as an outline; the IME
    ''' composition cursor (position < 0) is always a bar.
    Private Sub DrawCaret(g As Graphics, position As Integer, x As Double, y As Double, cellWidth As Double, caretColor As Color)
        Dim lineHeight As Double = Me.mCaretLineHeight
        Dim style As String = Me.mCaretStyle
        If position < 0 Then style = "line"
        If style = "block" And Not Me.mFocused Then style = "block-outline"
        Select Case style
        Case "line"
            g.FillRect(x - 1.0, y, 2.0, lineHeight, caretColor)
        Case "line-thin"
            g.FillRect(x - 0.5, y, 1.0, lineHeight, caretColor)
        Case "block"
            g.FillRect(x, y, cellWidth, lineHeight, caretColor)
            g.Save()
            g.ClipToRect(x, y, cellWidth, lineHeight)
            Me.DrawCaretGlyph(g, position, y, Me.mCaretTheme.Background)
            g.Restore()
        Case "block-outline"
            g.StrokeRect(x + 0.5, y + 0.5, cellWidth - 1.0, lineHeight - 1.0, 1.0, caretColor)
        Case "underline"
            g.FillRect(x, y + lineHeight - 2.0, cellWidth, 2.0, caretColor)
        Case "underline-thin"
            g.FillRect(x, y + lineHeight - 1.0, cellWidth, 1.0, caretColor)
        End Select
    End Sub

    ''' Redraws the text under a block caret in `tint`, exactly as RenderFrame draws it
    ''' (same token runs, cluster layout, ligature and wrap-segment origin); the caller
    ''' clips to the caret cell, so the glyph lines up with the text around it.
    Private Sub DrawCaretGlyph(g As Graphics, position As Integer, rowY As Double, tint As Color)
        Dim lineIndex As Integer = Me.LineOfPosition(position)
        Dim line As String = Me.mLines(lineIndex)
        Dim column As Integer = position - Me.mStarts(lineIndex)
        If column >= String.Len(line) Then Return
        Dim cellEnd As Integer = Me.CaretNextColumn(lineIndex, column)
        Dim font As String = Me.FontName
        Dim size As Double = Me.FontSize
        Dim cw As Double = Me.mCharWidth
        Dim baselineY As Double = rowY + Me.mCaretTextBaseline
        Dim simple As Boolean = Me.IsSimpleLine(line)
        Dim layout As StudioLineLayout = Nil
        Dim chars As Array Of String = []
        If Not simple Then
            layout = Me.LayoutOf(line)
            chars = String.Chars(line)
        End If
        Dim wrap As StudioWrapLine = Me.SegmentsOf(lineIndex)
        Dim segment As Integer = 0
        Me.RowCellOf(lineIndex, column, segment)
        Dim segFirst As Integer = wrap.Starts(segment)
        Dim segEnd As Integer = wrap.SegmentEnd(segment, String.Len(line))
        Dim origin As Double = Me.SegmentOriginX(lineIndex, wrap, segment)
        For Each token As StudioSyntaxToken In Me.LineTokens(lineIndex).Tokens
            If token.Start >= cellEnd Then Exit For
            If token.Start + token.Length <= column Then Continue For
            Dim a As Integer = Math.Max(token.Start, segFirst)
            Dim b As Integer = Math.Min(token.Start + token.Length, segEnd)
            If b <= a Then Continue For
            If token.Kind = StudioTokenKind.Punctuation And token.Length > 1 And Not Me.mFontLigatures Then
                For k As Integer = Math.Max(a, column) To Math.Min(b, cellEnd) - 1
                    If simple Then
                        g.DrawString(String.Substring(line, k, 1), origin + k * cw, baselineY, font, size, tint)
                    Else
                        Me.DrawClusters(g, chars, layout, k, 1, origin, baselineY, tint)
                    End If
                Next
            ElseIf simple Then
                g.DrawString(String.Substring(line, a, b - a), origin + a * cw, baselineY, font, size, tint)
            Else
                Me.DrawClusters(g, chars, layout, a, b - a, origin, baselineY, tint)
            End If
        Next
    End Sub

    ' ---- Whitespace, indent guides ----------------------------------------------------------

    Private Property mRenderWhitespace As String = "none"
    Private Property mShowsIndentGuides As Boolean = False

    ''' "none", "boundary" (leading, trailing and runs of 2+), "selection" (inside
    ''' selections), "trailing" or "all": spaces as dots, tabs as arrows.
    Public Property RenderWhitespace As String
        Get
            Return Me.mRenderWhitespace
        End Get
        Set
            Select Case value
            Case "none", "boundary", "selection", "trailing", "all"
                Me.mRenderWhitespace = value
            Case Else
                Me.mRenderWhitespace = "none"
            End Select
            Me.Invalidate()
        End Set
    End Property

    ''' Vertical guides at every indent stop of the leading indentation (blank lines take
    ''' the smaller indentation of their neighbours); the caret's block guide is brighter.
    Public Property ShowsIndentGuides As Boolean
        Get
            Return Me.mShowsIndentGuides
        End Get
        Set
            Me.mShowsIndentGuides = value
            Me.Invalidate()
        End Set
    End Property

    ''' Indentation in cells used for guides (-1 for a line of only whitespace in a
    ''' document of only whitespace).
    Private Function GuideIndent(lineIndex As Integer) As Integer
        Dim line As String = Me.mLines(lineIndex)
        If String.Trim(line) <> "" Then Return Me.IndentCells(Me.LeadingWhitespace(line))
        Dim above As Integer = -1
        Dim below As Integer = -1
        For i As Integer = lineIndex - 1 To Math.Max(0, lineIndex - 200) Step -1
            If String.Trim(Me.mLines(i)) <> "" Then
                above = Me.IndentCells(Me.LeadingWhitespace(Me.mLines(i)))
                Exit For
            End If
        Next
        For i As Integer = lineIndex + 1 To Math.Min(Array.LastIndex(Me.mLines), lineIndex + 200)
            If String.Trim(Me.mLines(i)) <> "" Then
                below = Me.IndentCells(Me.LeadingWhitespace(Me.mLines(i)))
                Exit For
            End If
        Next
        If above < 0 Then Return Math.Max(0, below)
        If below < 0 Then Return above
        Return Math.Min(above, below)
    End Function

    ' ---- Folding commands ---------------------------------------------------------------------

    ''' Collapses the region at (or around) a line and every region nested inside it.
    Public Function FoldRecursively(lineIndex As Integer) As Boolean
        If Not Me.mShowsFolding Then Return False
        Dim header As Integer = Me.RegionAround(lineIndex, False)
        If header < 0 Then header = Me.RegionAround(lineIndex, True)
        If header < 0 Then Return False
        Dim last As Integer = Me.mFoldEnds(header)
        For i As Integer = header To last
            If Me.mFoldEnds(i) > i Then Array.Append(Me.mFolded, i)
        Next
        Me.FoldsChanged()
        Return True
    End Function

    ''' Expands the region at (or around) a line and every collapsed region inside it.
    Public Function UnfoldRecursively(lineIndex As Integer) As Boolean
        Me.EnsureFoldRegions()
        Dim header As Integer = Me.RegionAround(lineIndex, True)
        If header < 0 Then header = Me.RegionAround(lineIndex, False)
        If header < 0 Then Return False
        Dim last As Integer = Me.mFoldEnds(header)
        Dim kept As Array Of Integer = []
        For Each other As Integer In Me.mFolded
            If other < header Or other > last Then Array.Append(kept, other)
        Next
        If Array.Count(kept) = Array.Count(Me.mFolded) Then Return False
        Me.mFolded = kept
        Me.FoldsChanged()
        Return True
    End Function

    ''' Collapses every comment region (runs of ' or // lines, /* */ blocks).
    Public Sub FoldComments()
        If Not Me.mShowsFolding Then Return
        Me.EnsureFoldRegions()
        For i As Integer = 0 To Array.LastIndex(Me.mFoldEnds)
            If Me.mFoldEnds(i) > i And Me.mFoldKinds(i) = "comment" Then Array.Append(Me.mFolded, i)
        Next
        Me.FoldsChanged()
    End Sub

    ' ---- Command vocabulary ---------------------------------------------------------------------

    ''' Every user-facing editor command (StudioEditorCommandList).
    Public Function Commands() As Array Of StudioEditorCommandInfo
        Return StudioEditorCommandList()
    End Function

    ''' True when a command applies now (exists, and the editor is writable when it
    ''' edits; snippet/macro commands need their state).
    Public Function CanPerformCommand(command As String) As Boolean
        Dim info As StudioEditorCommandInfo = StudioEditorCommandInfoFor(command)
        If info = Nil Then Return False
        If info.Edits And Me.IsReadOnly Then Return False
        Select Case command
        Case "nextTabstop", "previousTabstop", "exitSnippet"
            Return Me.InSnippet
        Case "replayMacro"
            Return Array.Count(Me.mMacroSteps) > 0 And Not Me.mMacroRecording
        Case "expandSnippet"
            Return Me.SnippetProvider <> Nil
        Case "fold", "unfold", "toggleFold", "foldAll", "unfoldAll", "foldRecursively", "unfoldRecursively", "foldComments"
            Return Me.mShowsFolding
        Case "collapseSelections"
            Return Me.SelectionCount > 1
        End Select
        If String.StartsWith(command, "foldLevel") Then Return Me.mShowsFolding
        Return True
    End Function

    ''' Ends the snippet session (Escape) without moving the selection.
    Public Sub EndSnippetSession()
        Me.EndSnippet()
    End Sub

    ''' Escape: leaves a snippet session, else collapses to the primary selection. True
    ''' when it did something.
    Public Function EscapeEditorState() As Boolean
        If Me.InSnippet Then
            Me.EndSnippet()
            Me.ClearExtras()
            Return True
        End If
        If Me.SelectionCount > 1 Then
            Me.ClearExtras()
            Me.FinishInteraction()
            Return True
        End If
        Return False
    End Function

    ''' Committed text (typing, IME commit without a replacement range, macro replay) at
    ''' every selection.
    Private Sub CommitTyped(value As String)
        If Me.IsReadOnly Then Return
        If Me.HasExtras() Then
            Me.RunBatch("@typeText", False, [value], True)
        Else
            Me.TypeText(value)
        End If
    End Sub

    ''' Editor command dispatcher (DoCommand, menus, macro replay). New commands first,
    ''' then the per-selection fan-out, then the single-selection command set.
    Private Function RunEditorFeatureCommand(command As String, extendSelection As Boolean) As Boolean
        Dim handled As Boolean = True
        Select Case command
        Case "pasteColumn"
            Dim clip As New Clipboard()
            Dim value As String = ""
            If clip.HasText Then value = clip.Text
            clip.Close()
            If value <> "" Then Me.PasteColumn(value)
        Case "nextTabstop"
            If Me.InSnippet Then Me.NextPlaceholder(True)
        Case "previousTabstop"
            If Me.InSnippet Then Me.NextPlaceholder(False)
        Case "exitSnippet"
            Me.EscapeEditorState()
        Case "collapseSelections"
            If Not Me.InSnippet Then Return False
            Me.EscapeEditorState()
        Case "expandSnippet"
            Me.TryExpandSnippet()
        Case "expandSelection"
            Me.ExpandSelections()
        Case "shrinkSelection"
            Me.ShrinkSelections()
        Case "jumpToBlockPartner"
            Me.ClearExtras()
            Me.JumpToBlockPartner()
        Case "toggleMacroRecording"
            If Me.mMacroRecording Then
                Me.StopMacroRecording()
            Else
                Me.StartMacroRecording()
            End If
        Case "replayMacro"
            Me.ReplayMacro(1)
        Case "sortLinesAscending"
            Me.TransformLines("ascending")
        Case "sortLinesDescending"
            Me.TransformLines("descending")
        Case "sortLinesCaseInsensitive"
            Me.TransformLines("caseInsensitive")
        Case "sortLinesNatural"
            Me.TransformLines("natural")
        Case "reverseLines"
            Me.TransformLines("reverse")
        Case "uniqueLines"
            Me.TransformLines("unique")
        Case "trimTrailingWhitespace"
            Me.TransformLines("trim")
        Case "joinLines"
            Me.TransformLines("join")
        Case "foldRecursively"
            Me.FoldRecursively(Me.CaretLine)
        Case "unfoldRecursively"
            Me.UnfoldRecursively(Me.CaretLine)
        Case "foldComments"
            Me.FoldComments()
        Case "toggleWhitespace"
            If Me.mRenderWhitespace = "none" Then
                Me.RenderWhitespace = "all"
            Else
                Me.RenderWhitespace = "none"
            End If
        Case "toggleIndentGuides"
            Me.ShowsIndentGuides = Not Me.ShowsIndentGuides
        Case "toggleStickyScopes"
            Me.ShowsStickyScopes = Not Me.ShowsStickyScopes
        Case "toggleOccurrences"
            Me.HighlightsWordOccurrences = Not Me.HighlightsWordOccurrences
            Me.Invalidate()
        Case "toggleMinimap"
            Me.ShowsMinimap = Not Me.ShowsMinimap
        Case "toggleFolding"
            Me.ShowsFolding = Not Me.ShowsFolding
        Case "toggleWordWrap"
            Me.WordWrap = Not Me.WordWrap
        Case "triggerCompletion"
            RaiseEvent CompletionRequested("invoke", Me.mCaret, Me.Slice(Me.CompletionPrefixStart(), Me.mCaret - Me.CompletionPrefixStart()))
        Case "triggerParameterHints"
            RaiseEvent CompletionRequested("parameters", Me.mCaret, "")
        Case "jumpToBracket"
            Me.ClearExtras()
            Me.JumpToBracket(False)
        Case "selectToBracket"
            Me.ClearExtras()
            Me.JumpToBracket(True)
        Case "transformUppercase", "transformLowercase", "transformTitlecase", "transformSnakecase", "transformCamelcase", "transformKebabcase"
            Dim mode As String = String.LCase(String.Substring(command, 9))
            mode = String.Left(mode, String.Len(mode) - 4)
            If mode = "uppercase" Or mode = "upper" Then mode = "upper"
            If Me.HasExtras() Then
                Me.RunBatch("@transformCase", False, [mode], True)
            Else
                Me.TransformCaseOne(mode)
            End If
        Case Else
            handled = False
        End Select
        If handled Then
            Me.Invalidate()
            Return True
        End If
        If String.StartsWith(command, "foldLevel") Then
            Dim level As Integer = Integer.Parse(String.Substring(command, 9)).Or(0)
            If level < 1 Then Return False
            Me.FoldLevel(level)
            Return True
        End If
        ' Tab and Shift+Tab drive a snippet session (while the caret stays inside it).
        ' Primary+] / Primary+[ ("indent"/"outdent") always shift lines instead.
        If command = "insertTab" And Me.InSnippet Then
            If Me.SnippetStillActive() Then
                Me.NextPlaceholder(True)
                Return True
            End If
        End If
        If command = "insertBacktab" And Me.InSnippet Then
            If Me.SnippetStillActive() Then
                Me.NextPlaceholder(False)
                Return True
            End If
        End If
        If command = "insertTab" And Me.SnippetTabTrigger And Me.SelectionLength = 0 Then
            If Me.TryExpandSnippet() Then Return True
        End If
        Return False
    End Function
    ''' Dots for spaces and arrows for tabs on one row, per RenderWhitespace.
    Private Sub DrawWhitespace(g As Graphics, lineIndex As Integer, segment As Integer, first As Integer, last As Integer, y As Double, originX As Double, anchors As Array Of Integer, carets As Array Of Integer, theme As StudioCodeEditorTheme)
        Dim line As String = Me.mLines(lineIndex)
        If line = "" Then Return
        Dim chars As Array Of String = String.Chars(line)
        Dim lead As Integer = String.Len(Me.LeadingWhitespace(line))
        Dim trimmedEnd As Integer = String.Len(StudioTrimTrailing(line))
        Dim lineStart As Integer = Me.mStarts(lineIndex)
        Dim cw As Double = Me.mCharWidth
        Dim mid As Double = y + Me.LineHeight / 2.0
        Dim shift As Double = 0.0
        For c As Integer = first To Math.Min(last, Array.Count(chars)) - 1
            Dim ch As String = chars(c)
            If ch <> " " And ch <> "\t" Then Continue For
            Dim show As Boolean = True
            Select Case Me.mRenderWhitespace
            Case "boundary"
                show = c < lead Or c >= trimmedEnd
                If Not show Then
                    If c > 0 Then show = chars(c - 1) = " " Or chars(c - 1) = "\t"
                    If Not show And c + 1 < Array.Count(chars) Then show = chars(c + 1) = " " Or chars(c + 1) = "\t"
                End If
            Case "trailing"
                show = c >= trimmedEnd
            Case "selection"
                show = False
                For k As Integer = 0 To Array.LastIndex(carets)
                    Dim p As Integer = lineStart + c
                    If p >= Math.Min(anchors(k), carets(k)) And p < Math.Max(anchors(k), carets(k)) Then show = True
                Next
            End Select
            If Not show Then Continue For
            Dim x As Double = originX + shift + Me.VisualColumn(line, c) * cw
            If ch = " " Then
                g.FillOval(x + cw / 2.0 - 1.0, mid - 1.0, 2.0, 2.0, theme.Whitespace)
            Else
                Dim x2 As Double = originX + shift + Me.VisualColumn(line, c + 1) * cw - 2.0
                g.DrawLine(x + 2.0, mid, x2, mid, 1, theme.Whitespace)
                g.DrawLine(x2 - 3.0, mid - 3.0, x2, mid, 1, theme.Whitespace)
                g.DrawLine(x2 - 3.0, mid + 3.0, x2, mid, 1, theme.Whitespace)
            End If
        Next
    End Sub

    ''' Vertical guides at the indent stops of each row's line (the caret's block brighter).
    Private Sub DrawIndentGuides(g As Graphics, visible As Array Of Integer, left As Double, theme As StudioCodeEditorTheme)
        Dim tab As Integer = Math.Max(1, Me.TabSize())
        Dim cw As Double = Me.mCharWidth
        Dim activeCell As Integer = -1
        Dim activeFirst As Integer = -1
        Dim activeLast As Integer = -1
        Dim chain As Array Of StudioEditorScope = Me.ScopeChain(Me.CaretLine)
        If Array.Count(chain) > 0 Then
            Dim inner As StudioEditorScope = Array.Last(chain)
            activeCell = Me.IndentCells(Me.LeadingWhitespace(Me.mLines(inner.Line)))
            activeFirst = inner.Line + 1
            activeLast = inner.EndLine
        End If
        Dim previousLine As Integer = -1
        Dim indent As Integer = 0
        For Each lineIndex As Integer In visible
            If lineIndex <> previousLine Then
                indent = Me.GuideIndent(lineIndex)
                previousLine = lineIndex
            End If
            Dim y As Double = Me.LineTop(lineIndex)
            ' A wrapped line's guides run down all its rows (continuations are indented).
            Dim span As Double = Me.LineHeight * Me.LineRowSpan(lineIndex)
            Dim cell As Integer = 0
            While cell < indent
                Dim x As Double = Math.Round(left + cell * cw - Me.mScrollX) + 0.5
                Dim tint As Color = theme.IndentGuide
                If cell = activeCell And lineIndex >= activeFirst And lineIndex <= activeLast Then tint = theme.IndentGuideActive
                g.DrawLine(x, y, x, y + span, 1, tint)
                cell += tab
            Wend
        Next
    End Sub

    ''' Pinned headers of the scopes enclosing the top line.
    Private Sub DrawStickyScopes(g As Graphics, gutter As Double, right As Double, left As Double, numberRight As Double, numberSize As Double, baseline As Double, theme As StudioCodeEditorTheme)
        Me.mStickyLines = Me.StickyHeaders()
        If Array.Count(Me.mStickyLines) = 0 Then Return
        Dim lineHeight As Double = Me.LineHeight
        Dim cw As Double = Me.mCharWidth
        For k As Integer = 0 To Array.LastIndex(Me.mStickyLines)
            Dim lineIndex As Integer = Me.mStickyLines(k)
            Dim y As Double = k * lineHeight
            g.FillRect(0, y, gutter, lineHeight, theme.GutterBackground)
            g.FillRect(gutter, y, right - gutter, lineHeight, theme.StickyBackground)
            Dim label As String = String.From(lineIndex + 1)
            Dim labelWidth As Double = String.Len(label) * cw * numberSize / Me.FontSize
            g.DrawString(label, numberRight - labelWidth, y + baseline, Me.FontName, numberSize, theme.GutterText)
            g.Save()
            g.ClipToRect(gutter, y, Math.Max(1.0, right - gutter), lineHeight)
            Me.DrawLineTextAt(g, lineIndex, y, left - Me.mScrollX, gutter, right, baseline, theme)
            g.Restore()
        Next
        Dim bottom As Double = Array.Count(Me.mStickyLines) * lineHeight
        g.DrawLine(0, bottom - 0.5, right, bottom - 0.5, 1, theme.GutterLine)
        g.FillRect(0, bottom, right, 2.0, theme.StickyShadow)
    End Sub

    #If TargetLinux Then
    ''' GTK destroyed the native view; its controllers were freed with it.
    Public Sub GtkWidgetDestroyed(widget As Ptr)
        If widget <> Me.mAttachedWidget Then Return
        Me.mScrollController = Nil
        Me.mTabController = Nil
        Me.mDestroyHandler = 0
        Me.mDestroyedWidget = widget
    End Sub
    #End If

    #If TargetWindows Then
    Public Sub WindowsWheelDetached(remove As Boolean)
        If Me.mWheelWindow = Nil Then Return
        Dim window As Ptr = Me.mWheelWindow
        Me.mWheelWindow = Nil
        Dim slot As UInt64 = Me.mSlot + 1
        If remove Then EditorRemoveSubclass(window, AddressOf EditorWindowsProcedure, 21328 + slot)
    End Sub

    Public Property NativeSlot As Integer
        Get
            Return Me.mSlot
        End Get
    End Property
    #End If

    #If TargetMac Then
    ''' True when this editor's native view is under the window point / first responder.
    Public Function MacOwnsEvent(eventWindow As Ptr, location As EditorPoint) As Boolean
        Dim view As Ptr = Me.NativeWidget
        If view = Nil Or eventWindow = Nil Or Not Me.Visible Then Return False
        If EditorViewWindow(view) <> eventWindow Then Return False
        If EditorHidden(view) Then Return False
        Dim local As EditorPoint = EditorConvert(view, location, Nil)
        Return local.X >= 0 And local.Y >= 0 And local.X <= Me.Width And local.Y <= Me.Height
    End Function

    Public Function MacIsFirstResponder(eventWindow As Ptr) As Boolean
        Dim view As Ptr = Me.NativeWidget
        If view = Nil Or eventWindow = Nil Or Not Me.Visible Then Return False
        If EditorViewWindow(view) <> eventWindow Then Return False
        Return EditorFirstResponder(eventWindow) = view
    End Function
    #End If
End Class

' ---- Editor key tables (pure; used by the native key hooks and tests) -----------------

''' macOS editor shortcuts caught by Studio's NSEvent monitor before AppKit (which has no
''' selector for them, or binds them to something else). `key` is the event's
''' charactersIgnoringModifiers (arrows are U+F700..U+F703). "" = leave the key alone.
Public Function StudioMacEditorCommand(key As String, command As Boolean, control As Boolean, alternate As Boolean, shift As Boolean) As String
    Dim code As Integer = 0
    If String.Len(key) > 0 Then code = String.Asc(key)
    If code = 27 Then
        ' Escape collapses multi-cursor editing (ignored with one cursor).
        If Not command And Not control And Not alternate Then Return "collapseSelections"
        Return ""
    End If
    If code >= 63232 And code <= 63235 Then
        If control Then Return ""
        Dim names As Array Of String = ["Up", "Down", "Left", "Right"]
        Dim direction As String = names(code - 63232)
        If command And alternate And shift Then Return "columnSelect" + direction
        If command And alternate Then
            If direction = "Up" Then Return "addCursorAbove"
            If direction = "Down" Then Return "addCursorBelow"
            Return ""
        End If
        If alternate And shift And Not command Then
            If direction = "Up" Then Return "copyLinesUp"
            If direction = "Down" Then Return "copyLinesDown"
        End If
        Return ""
    End If
    If alternate And shift And Not command And Not control Then
        If key = "i" Or key = "I" Then Return "cursorsAtLineEnds"
        Return ""
    End If
    If Not command Then Return ""
    If control Then
        ' Cmd+Ctrl+G: select all occurrences (VS Code on macOS).
        If (key = "g" Or key = "G") And Not alternate Then Return "selectAllOccurrences"
        Return ""
    End If
    Select Case key
    Case "/"
        Return "toggleComment"
    Case "]"
        If alternate Then Return "moveLinesDown"
        Return "indent"
    Case "["
        If alternate Then Return "moveLinesUp"
        Return "outdent"
    Case "d", "D"
        If Not alternate And Not shift Then Return "addNextOccurrence"
    Case "k", "K"
        If Not alternate And Not shift Then Return "chordPrefix"
    Case "l", "L"
        If shift And Not alternate Then Return "selectAllOccurrences"
    Case "g", "G"
        If shift Then Return "findPrevious"
        Return "findNext"
    Case "e", "E"
        Return "useSelectionForFind"
    Case "'"
        Return "goToNextMarker"
    Case "\""
        Return "goToPreviousMarker"
    End Select
    Return ""
End Function

''' Windows editor shortcuts by virtual key, for Studio's subclass (it runs before the
''' IMM adapter, which binds plain navigation). Ctrl+Alt is AltGr on many layouts, so
''' Ctrl+Alt only binds keys that never type text (arrows). "" = not an editor shortcut.
Public Function StudioWindowsEditorCommand(virtualKey As Integer, control As Boolean, alt As Boolean, shift As Boolean) As String
    If virtualKey = 27 Then
        If Not control And Not alt And Not shift Then Return "collapseSelections"
        Return ""
    End If
    If virtualKey >= 37 And virtualKey <= 40 Then
        Dim names As Array Of String = ["Left", "Up", "Right", "Down"]
        Dim direction As String = names(virtualKey - 37)
        If control And alt And shift Then Return "columnSelect" + direction
        If control And alt Then
            If direction = "Up" Then Return "addCursorAbove"
            If direction = "Down" Then Return "addCursorBelow"
            Return ""
        End If
        If alt And shift And Not control Then
            If direction = "Up" Then Return "copyLinesUp"
            If direction = "Down" Then Return "copyLinesDown"
        End If
        Return ""
    End If
    If alt And shift And Not control And virtualKey = 73 Then Return "cursorsAtLineEnds"
    If Not control Or alt Then Return ""
    Select Case virtualKey
    Case 191 ' VK_OEM_2 "/"
        Return "toggleComment"
    Case 221 ' VK_OEM_6 "]"
        Return "indent"
    Case 219 ' VK_OEM_4 "["
        Return "outdent"
    Case 68 ' D
        If Not shift Then Return "addNextOccurrence"
    Case 75 ' K
        If Not shift Then Return "chordPrefix"
    Case 76 ' L
        If shift Then Return "selectAllOccurrences"
    Case 71 ' G
        If shift Then Return "findPrevious"
        Return "findNext"
    Case 69 ' E
        Return "useSelectionForFind"
    End Select
    Return ""
End Function

' ---- Native drag and drop ------------------------------------------------------------
' Adapters registered on the editor (UIControl.RegisterDragSource/RegisterDropTarget).
' They hold the editor weakly; the editor decides everything.

''' Drags the selected text out (to this or another editor or application). Only active
''' while a press inside the selection is pending, so ordinary drags still select.
Class StudioEditorDragSource Implements IDragSource
    Public Property Editor As Weak StudioCodeEditor

    Public Function AllowedActions() As DragAction
        Dim target As StudioCodeEditor = Me.Editor
        If target = Nil Then Return DragAction.None
        Return target.NativeDragActions()
    End Function

    Public Function DragItems() As Array Of DragItem
        Dim target As StudioCodeEditor = Me.Editor
        Dim items As Array Of DragItem = []
        If target = Nil Then Return items
        Return target.NativeDragItems()
    End Function

    Public Function DragImage() As Picture
        Dim target As StudioCodeEditor = Me.Editor
        If target = Nil Then Return Nil
        Return target.NativeDragImage()
    End Function

    Public Sub DragStarted()
    End Sub

    Public Sub DragMoved(screenPoint As Point, action As DragAction)
    End Sub

    Public Sub DragEnded(action As DragAction, accepted As Boolean)
        Dim target As StudioCodeEditor = Me.Editor
        If target <> Nil Then target.NativeDragEnded(action, accepted)
    End Sub
End Class

''' Accepts text and files dropped from this or other applications.
Class StudioEditorDropTarget Implements IDropTarget
    Public Property Editor As Weak StudioCodeEditor

    Public Function DragEntered(payload As DragItem, requested As DragAction) As DragAction
        Dim target As StudioCodeEditor = Me.Editor
        If target = Nil Then Return DragAction.None
        Return target.NativeDropAction(payload, requested)
    End Function

    Public Function DragOver(payload As DragItem, requested As DragAction, pt As Point) As DragAction
        Dim target As StudioCodeEditor = Me.Editor
        If target = Nil Then Return DragAction.None
        Return target.NativeDragOver(payload, requested, pt)
    End Function

    Public Sub DragLeft()
        Dim target As StudioCodeEditor = Me.Editor
        If target <> Nil Then target.NativeDragLeft()
    End Sub

    Public Function DragDropped(payload As DragItem, action As DragAction, pt As Point) As Boolean
        Dim target As StudioCodeEditor = Me.Editor
        If target = Nil Then Return False
        Return target.NativeDrop(payload, action, pt)
    End Function
End Class

