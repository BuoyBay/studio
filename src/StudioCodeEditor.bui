            Me.StickyShadow = Color.RGBA(0.0, 0.0, 0.0, 0.08)
            Me.SnippetRange = EditorHex(&h9cc9c2)
            Me.SnippetActive = EditorHex(&h0f766e)
            Me.WordHighlight = Color.RGBA(0.20, 0.30, 0.42, 0.13)
            Me.SecondaryCaret = EditorHex(&h2c8c82)
        End If
    End Sub

    Public Function ForKind(kind As StudioTokenKind) As Color
        Select Case kind
        Case StudioTokenKind.Comment
            Return Me.Comment
        Case StudioTokenKind.Keyword
            Return Me.Keyword
        Case StudioTokenKind.TypeName
            Return Me.TypeName
        Case StudioTokenKind.Text
            Return Me.Text
        Case StudioTokenKind.Number
            Return Me.Number
        Case StudioTokenKind.Directive
            Return Me.Directive
        Case StudioTokenKind.FunctionName
            Return Me.FunctionName
        Case StudioTokenKind.Literal
            Return Me.Literal
        Case StudioTokenKind.Punctuation
            Return Me.Punctuation
        End Select
        Return Me.Ink
    End Function

    Public Function ForSeverity(severity As StudioMarkerSeverity) As Color
        Select Case severity
        Case StudioMarkerSeverity.Failure
            Return Me.FailureInk
        Case StudioMarkerSeverity.Warning
            Return Me.WarningInk
        Case StudioMarkerSeverity.Hint
            Return Me.GutterText
        End Select
        Return Me.NoteInk
    End Function
End Class

' Keep the owning reference in a property: Buoy 0.72 leaks displaced objects
' when an Array Of Class element is overwritten with Nil (BUI-506).
Class StudioEditorRegistrySlot
    Public Property Editor As StudioCodeEditor
End Class

''' Open editors, indexed by the slot passed to native wheel/key callbacks.
Class StudioEditorRegistry
    Public Shared Property Slots As Array Of StudioEditorRegistrySlot = []
    Public Shared Property MacMonitor As Ptr = Nil
    Public Shared Property SwallowSysChar As Boolean = False

    Public Shared Function Find(slot As Integer) As StudioCodeEditor
        If slot < 0 Or slot >= Array.Count(StudioEditorRegistry.Slots) Then Return Nil
        Return StudioEditorRegistry.Slots(slot).Editor
    End Function

    Public Shared Function LiveEditors() As Array Of StudioCodeEditor
        Dim editors As Array Of StudioCodeEditor = []
        For Each slot As StudioEditorRegistrySlot In StudioEditorRegistry.Slots
            Dim editor As StudioCodeEditor = slot.Editor
            If editor <> Nil Then editors.Append(editor)
        Next
        Return editors
    End Function

    Public Shared Function OpenCount() As Integer
        Dim count As Integer = 0
        For Each slot As StudioEditorRegistrySlot In StudioEditorRegistry.Slots
            If slot.Editor <> Nil Then count += 1
        Next
        Return count
    End Function
End Class

''' Toggles a StudioCodeEditor's caret between shown and hidden (CaretBlinks).
Public Class StudioCodeEditorBlinkTimer Inherits Timer
    Public Property Owner As Weak StudioCodeEditor
    Public Overrides Sub NotifyTick()
        Dim target As StudioCodeEditor = Me.Owner
        If target <> Nil Then target.BlinkTick()
    End Sub
End Class

Public Class StudioSpellingTimer Inherits Timer
    Public Property Owner As Weak StudioCodeEditor
    Public Overrides Sub NotifyTick()
        Me.Stop()
        Dim target As StudioCodeEditor = Me.Owner
        If target <> Nil Then target.SpellingTick()
    End Sub
End Class

''' Drives StudioCodeEditor's edge auto-scroll while a drag rests near an edge.
Public Class StudioCodeEditorScrollTimer Inherits Timer
    Public Property Owner As Weak StudioCodeEditor
    Public Overrides Sub NotifyTick()
        Dim target As StudioCodeEditor = Me.Owner
        If target <> Nil Then target.EdgeScrollTick()
    End Sub
End Class

''' One entry of the inline completion popup (see StudioCodeEditor.ShowCompletionItems).
''' `Kind` is the LSP CompletionItemKind (14 = keyword); `InsertText` replaces the
''' identifier being typed (the label when empty).
Public Class StudioEditorCompletionItem
    Public Property Label As String
    Public Property Detail As String
    Public Property InsertText As String
    Public Property Kind As Integer
End Class

Public Class StudioCodeEditor Inherits TextInputCanvas
    Public Property FontSize As Double = 12.0
    ''' Selections remembered per document text (fingerprint -> selections), so a host
    ''' that sets Text back to an earlier version (undo/redo) gets that version's
    ''' cursors and selections back. Bounded; oldest entries are dropped first.
    Public Const SelectionMemoryLimit As Integer = 256
    Private Property mSelectionMemory As Map Of String, String = New Map Of String, String()
    Private Property mSelectionMemoryOrder As Array Of String = []
    Private Property mSettledFingerprint As String = ""
    Private Property mSettledSelections As String = ""
    ''' "auto" follows Studio's appearance (and GTK_THEME on Linux); or "light"/"dark".
    Public Property Appearance As String = "auto"
    Private Property mIndentWidth As Integer = 2
    ''' Logical cells per indent level for new documents and documents
    ''' whose indentation cannot be detected. Default 2.
    Public Property IndentWidth As Integer
        Get
            Return Me.mIndentWidth
        End Get
        Set
            Me.mIndentWidth = Math.Max(1, Math.Min(16, value))
            Me.IndentChanged()
        End Set
    End Property
    Private Property mIndentStyle As String = "auto"
    ' "auto" preserves detection; "space" and "tab" explicitly choose inserted indentation.
    ' Changing policy never rewrites existing document text.
    Public Property IndentStyle As String
        Get
            Return Me.mIndentStyle
        End Get
        Set
            Me.mIndentStyle = StudioCodeEditor.IndentStyleName(value)
            Me.IndentChanged()
        End Set
    End Property

    Public Shared Function IndentStyleName(value As String) As String
        Select Case String.LCase(String.Trim(value))
        Case "space"
            Return "space"
        Case "tab"
            Return "tab"
        End Select
        Return "auto"
    End Function

    Private Property mTabWidth As Integer = 0
    ' Display tab stops (1..16); 0 inherits EffectiveIndentWidth.
    Public Property TabWidth As Integer
        Get
            Return Me.mTabWidth
        End Get
        Set
            Me.mTabWidth = Math.Max(0, Math.Min(16, value))
            Me.IndentChanged()
        End Set
    End Property
    Private Property mDetectIndentation As Boolean = True
    Private Property mDetectedIndent As Integer = 0
    ''' When True (default), a loaded document keeps the indent step it already uses
    ''' (e.g. 4 spaces) instead of IndentWidth, like VS Code's detectIndentation.
    Public Property DetectIndentation As Boolean
        Get
            Return Me.mDetectIndentation
        End Get
        Set
            Me.mDetectIndentation = value
            Me.IndentChanged()
        End Set
    End Property
    ''' The indent step in effect: the detected one when DetectIndentation found one,
    ''' else IndentWidth.
    Public Property EffectiveIndentWidth As Integer
        Get
            Return Me.IndentStep()
        End Get
    End Property
    Private Property mFontLigatures As Boolean = False
    ''' Draw operator runs (!=, <=, =>, ...) as whole strings so a ligature font
    ''' (Fira Code, JetBrains Mono, Cascadia Code...) can join them. Off draws each
    ''' operator character of code in its own cell (strings and comments still draw
    ''' whole). Ligatures keep the cell grid either way.
    Public Property FontLigatures As Boolean
        Get
            Return Me.mFontLigatures
        End Get
        Set
            Me.mFontLigatures = value
            Me.Invalidate()
        End Set
    End Property
    Public Property IsReadOnly As Boolean = False
    ''' Enter re-aligns Else/Case/End lines to their opener and indents block bodies.
    Public Property AutoIndentBlocks As Boolean = True
    ''' Enter after a block opener adds its closing line (End If, Next, ...) when missing.
    Public Property AutoCloseBlocks As Boolean = True
    Private Property mFontName As String = ""
    Private Property mLines As Array Of String = []
    Private Property mStarts As Array Of Integer = []
    Private Property mText As String = ""
    Private Property mTextValid As Boolean = True
    Private Property mAnchor As Integer = 0
    Private Property mCaret As Integer = 0
    Private Property mPreferredColumn As Integer = -1
    Private Property mIncomplete As String = ""
    Private Property mIncompleteCursor As Integer = 0
    Private Property mCompositionStart As Integer = -1
    Private Property mCompositionLength As Integer = 0
