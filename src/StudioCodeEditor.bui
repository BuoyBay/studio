    Private Property mFindCase As Boolean = False
    Private Property mFindWord As Boolean = False
    Private Property mFindRegex As Boolean = False
    Private Property mFindMultiline As Boolean = True
    Private Property mFindDotAll As Boolean = False
    Private Property mFindWrap As Boolean = True
