#If TargetLinux Then
Delegate Function EditorScrollCallback(controller As Ptr, dx As Double, dy As Double, data As Ptr) As Int32
Private Optional Declare Function EditorScrollNew Lib "libgtk-4.so.1" Alias "gtk_event_controller_scroll_new" (scrollFlags As Int32) As Ptr
Private Optional Declare Function EditorScrollUnit Lib "libgtk-4.so.1" Alias "gtk_event_controller_scroll_get_unit" (controller As Ptr) As Int32
Private Optional Declare Sub EditorAddController Lib "libgtk-4.so.1" Alias "gtk_widget_add_controller" (widget As Ptr, controller As Ptr)
Private Optional Declare Sub EditorRemoveController Lib "libgtk-4.so.1" Alias "gtk_widget_remove_controller" (widget As Ptr, controller As Ptr)
Private Optional Declare Function EditorConnectScroll Lib "libgobject-2.0.so.0" Alias "g_signal_connect_data" (instance As Ptr, signal As String, callback As EditorScrollCallback, data As Ptr, destroy As Ptr, connectFlags As Int32) As UInt64
Delegate Function EditorKeyCallback(controller As Ptr, keyval As UInt32, keycode As UInt32, state As UInt32, data As Ptr) As Int32
Private Optional Declare Function EditorKeyNew Lib "libgtk-4.so.1" Alias "gtk_event_controller_key_new" () As Ptr
Private Optional Declare Sub EditorKeyPhase Lib "libgtk-4.so.1" Alias "gtk_event_controller_set_propagation_phase" (controller As Ptr, phase As Int32)
Private Optional Declare Function EditorConnectKey Lib "libgobject-2.0.so.0" Alias "g_signal_connect_data" (instance As Ptr, signal As String, callback As EditorKeyCallback, data As Ptr, destroy As Ptr, connectFlags As Int32) As UInt64
Private Optional Declare Function EditorDisconnect Lib "libgobject-2.0.so.0" Alias "g_signal_handlers_disconnect_matched" (instance As Ptr, mask As UInt32, signalId As UInt32, detail As UInt32, signalClosure As Ptr, callback As Ptr, data As Ptr) As UInt32

Delegate Sub EditorWidgetCallback(widget As Ptr, data As Ptr)
Private Optional Declare Function EditorConnectWidget Lib "libgobject-2.0.so.0" Alias "g_signal_connect_data" (instance As Ptr, signal As String, callback As EditorWidgetCallback, data As Ptr, destroy As Ptr, connectFlags As Int32) As UInt64
Private Optional Declare Sub EditorHandlerDisconnect Lib "libgobject-2.0.so.0" Alias "g_signal_handler_disconnect" (instance As Ptr, handlerId As UInt64)

Sub EditorGtkDestroyed(widget As Ptr, data As Ptr)
    Dim editor As StudioCodeEditor = StudioEditorRegistry.Find(CType(data, Integer) - 1)
    If editor <> Nil Then editor.GtkWidgetDestroyed(widget)
End Sub

Function EditorGtkKey(controller As Ptr, keyval As UInt32, keycode As UInt32, state As UInt32, data As Ptr) As Int32
    Dim command As String = StudioCodeEditor.GtkKeyCommand(keyval, state)
    If command = "" Then Return 0
    Dim editor As StudioCodeEditor = StudioEditorRegistry.Find(CType(data, Integer) - 1)
    If editor = Nil Then Return 0
    Try
        If editor.NativeKey(command, False) Then Return 1
    Catch e As Exception
        editor.RecordNativeInputError(e.Message)
    End Try
    Return 0
End Function

Function EditorGtkScroll(controller As Ptr, dx As Double, dy As Double, data As Ptr) As Int32
    Dim editor As StudioCodeEditor = StudioEditorRegistry.Find(CType(data, Integer) - 1)
    If editor = Nil Then Return 0
    Try
        Dim pixels As Boolean = False
        Try
            ' GDK_SCROLL_UNIT_SURFACE (1): precise trackpad deltas in pixels (GTK 4.8+).
            pixels = EditorScrollUnit(controller) = 1
        Catch e As Exception
            pixels = False
        End Try
        editor.NativeWheel(dx, dy, pixels)
        Return 1
    Catch e As Exception
        editor.RecordNativeInputError(e.Message)
        Return 0
    End Try
End Function
#ElseIf TargetWindows Then
Delegate Function EditorSubclassCallback(window As Ptr, message As UInt32, word As UInt64, param As Int64, identifier As UInt64, data As UInt64) As Int64
Private Optional Declare Function EditorSetSubclass Lib "comctl32" Alias "SetWindowSubclass" (window As Ptr, callback As EditorSubclassCallback, identifier As UInt64, data As UInt64) As Int32
Private Optional Declare Function EditorRemoveSubclass Lib "comctl32" Alias "RemoveWindowSubclass" (window As Ptr, callback As EditorSubclassCallback, identifier As UInt64) As Int32
Private Optional Declare Function EditorDefSubclass Lib "comctl32" Alias "DefSubclassProc" (window As Ptr, message As UInt32, word As UInt64, param As Int64) As Int64
Private Optional Declare Function EditorKeyState Lib "user32" Alias "GetKeyState" (key As Int32) As Int16

Function EditorWindowsProcedure(window As Ptr, message As UInt32, word As UInt64, param As Int64, identifier As UInt64, data As UInt64) As Int64
    Dim slotData As Integer = data
    Dim slot As Integer = slotData - 1
    Dim editor As StudioCodeEditor = StudioEditorRegistry.Find(slot)
    If editor = Nil Then Return EditorDefSubclass(window, message, word, param)
    Try
        If message = 522 Or message = 526 Then ' WM_MOUSEWHEEL / WM_MOUSEHWHEEL
            Dim high As UInt64 = (word \ 65536) And 65535
            Dim raw As Integer = high
            If raw >= 32768 Then raw -= 65536
            Dim notches As Double = raw / 120.0
            If message = 522 Then
                editor.NativeWheel(0.0, -notches, False)
            Else
                editor.NativeWheel(notches, 0.0, False)
            End If
            Return 0
        ElseIf message = 256 Or message = 260 Then ' WM_KEYDOWN / WM_SYSKEYDOWN (Alt held)
            ' Runs before the IMM adapter's subclass (installed earlier), which would turn
            ' Ctrl+Alt/Shift+Alt arrows into plain motion. Editor shortcuts by virtual key:
            ' Ctrl+/ and Ctrl+] produce no character on Windows.
            Dim control As Boolean = EditorKeyState(17) < 0
            Dim alt As Boolean = EditorKeyState(18) < 0
            Dim shift As Boolean = EditorKeyState(16) < 0
            Dim virtualKey As Integer = word
            ' Host key bindings first (AltGr = Ctrl+Alt is text, not a chord).
            Dim chordKey As String = StudioCodeEditor.ChordKeyForVirtualKey(virtualKey)
            If chordKey <> "" And Not (control And alt) And (control Or alt Or (virtualKey >= 112 And virtualKey <= 123)) Then
                If editor.AskShortcut(StudioCodeEditor.ChordFor(control, alt, shift, chordKey), True) Then
                    StudioEditorRegistry.SwallowSysChar = message = 260
                    Return 0
                End If
            End If
            Dim command As String = StudioWindowsEditorCommand(virtualKey, control, alt, shift)
            If command <> "" Then
                ' NativeKey is False while composing or when there is nothing to do (Escape
                ' with one cursor), so the key keeps its normal meaning.
                If editor.NativeKey(command, shift) Then
                    ' TranslateMessage already queued a WM_SYSCHAR (menu mnemonic / beep).
                    StudioEditorRegistry.SwallowSysChar = message = 260
                    Return 0
                End If
            End If
        ElseIf message = 262 Then ' WM_SYSCHAR
            If StudioEditorRegistry.SwallowSysChar Then
                StudioEditorRegistry.SwallowSysChar = False
                Return 0
            End If
        ElseIf message = 130 Then ' WM_NCDESTROY
            EditorRemoveSubclass(window, AddressOf EditorWindowsProcedure, identifier)
            editor.WindowsWheelDetached(False)
        End If
    Catch e As Exception
        editor.RecordNativeInputError(e.Message)
    End Try
    Return EditorDefSubclass(window, message, word, param)
End Function
#ElseIf TargetMac Then
Sequential Structure EditorPoint
    X As Double
    Y As Double
End Structure
Private Declare Function EditorClass Lib "objc" Alias "objc_getClass" (name As String) As Ptr
Private Declare Function EditorAddMonitor Lib "AppKit" Selector "addLocalMonitorForEventsMatchingMask:handler:" (cls As Ptr, mask As UInt64, handler As Block(Ptr) As Ptr) As Ptr
Private Declare Sub EditorRemoveMonitor Lib "AppKit" Selector "removeMonitor:" (cls As Ptr, monitor As Ptr)
Private Declare Function EditorRetain Lib "Foundation" Selector "retain" (value As Ptr) As Ptr
Private Declare Sub EditorRelease Lib "Foundation" Selector "release" (value As Ptr)
Private Declare Function EditorEventType Lib "AppKit" Selector "type" (nativeEvent As Ptr) As UInt64
Private Declare Function EditorEventWindow Lib "AppKit" Selector "window" (nativeEvent As Ptr) As Ptr
Private Declare Function EditorEventLocation Lib "AppKit" Selector "locationInWindow" (nativeEvent As Ptr) As EditorPoint
Private Declare Function EditorConvert Lib "AppKit" Selector "convertPoint:fromView:" (view As Ptr, point As EditorPoint, source As Ptr) As EditorPoint
Private Declare Function EditorViewWindow Lib "AppKit" Selector "window" (view As Ptr) As Ptr
Private Declare Function EditorHidden Lib "AppKit" Selector "isHiddenOrHasHiddenAncestor" (view As Ptr) As Boolean
Private Declare Function EditorFirstResponder Lib "AppKit" Selector "firstResponder" (window As Ptr) As Ptr
Private Declare Function EditorDeltaX Lib "AppKit" Selector "scrollingDeltaX" (nativeEvent As Ptr) As Double
Private Declare Function EditorDeltaY Lib "AppKit" Selector "scrollingDeltaY" (nativeEvent As Ptr) As Double
Private Declare Function EditorPrecise Lib "AppKit" Selector "hasPreciseScrollingDeltas" (nativeEvent As Ptr) As Boolean
Private Declare Function EditorModifierFlags Lib "AppKit" Selector "modifierFlags" (nativeEvent As Ptr) As UInt64
Private Declare Function EditorCharacters Lib "AppKit" Selector "charactersIgnoringModifiers" (nativeEvent As Ptr) As Ptr
Private Declare Function EditorUTF8 Lib "Foundation" Selector "UTF8String" (value As Ptr) As String

''' Editor commands for keys AppKit would otherwise drop or bind differently
''' (StudioMacEditorCommand). "" = not an editor shortcut.
Function EditorMacCommand(nativeEvent As Ptr, modifiers As UInt64) As String
    Dim characters As Ptr = EditorCharacters(nativeEvent)
    If characters = Nil Then Return ""
    Dim key As String = EditorUTF8(characters)
    Return StudioMacEditorCommand(key, (modifiers And 1048576) <> 0, (modifiers And 262144) <> 0, (modifiers And 524288) <> 0, (modifiers And 131072) <> 0)
End Function

Sub EditorInstallMacMonitor()
    If StudioEditorRegistry.MacMonitor <> Nil Then Return
    ' NSEventMaskScrollWheel (1 << 22) | NSEventMaskKeyDown (1 << 10)
    Dim monitor As Ptr = EditorAddMonitor(EditorClass("NSEvent"), 4195328, Block(nativeEvent As Ptr) As Ptr
        Return EditorMacEvent(nativeEvent)
    End Block)
    If monitor <> Nil Then StudioEditorRegistry.MacMonitor = EditorRetain(monitor)
End Sub

Sub EditorRemoveMacMonitor()
    Dim monitor As Ptr = StudioEditorRegistry.MacMonitor
    If monitor = Nil Then Return
    StudioEditorRegistry.MacMonitor = Nil
    EditorRemoveMonitor(EditorClass("NSEvent"), monitor)
    EditorRelease(monitor)
End Sub

Function EditorMacEvent(nativeEvent As Ptr) As Ptr
    If nativeEvent = Nil Then Return nativeEvent
    Try
        Dim kind As UInt64 = EditorEventType(nativeEvent)
        Dim window As Ptr = EditorEventWindow(nativeEvent)
        If window = Nil Then Return nativeEvent
        If kind = 22 Then ' NSEventTypeScrollWheel
            Dim location As EditorPoint = EditorEventLocation(nativeEvent)
            For Each editor As StudioCodeEditor In StudioEditorRegistry.LiveEditors()
                If editor <> Nil Then
                    If editor.MacOwnsEvent(window, location) Then
                        Dim precise As Boolean = EditorPrecise(nativeEvent)
                        editor.NativeWheel(-EditorDeltaX(nativeEvent), -EditorDeltaY(nativeEvent), precise)
                        Return Nil
                    End If
                End If
            Next
        ElseIf kind = 10 Then ' NSEventTypeKeyDown
            ' Command shortcuts with no AppKit selector, plus the multi-cursor keys AppKit
            ' binds to something else (Option+Shift+arrows, Option+Shift+I, Escape). Tab,
            ' paging, Home/End and the Emacs keys reach the editor as doCommandBySelector:
            ' (nativemacos.bui).
            Dim modifiers As UInt64 = EditorModifierFlags(nativeEvent)
            ' Host key bindings first: Command and/or Option chords and F-keys (not Control).
            If (modifiers And 262144) = 0 Then
                Dim characters As Ptr = EditorCharacters(nativeEvent)
                Dim chordKey As String = ""
                If characters <> Nil Then chordKey = StudioCodeEditor.ChordKeyForMacCharacters(EditorUTF8(characters))
                Dim commandHeld As Boolean = (modifiers And 1048576) <> 0
                Dim optionHeld As Boolean = (modifiers And 524288) <> 0
                If chordKey <> "" And (commandHeld Or optionHeld Or (String.StartsWith(chordKey, "F") And String.Len(chordKey) > 1)) Then
                    For Each editor As StudioCodeEditor In StudioEditorRegistry.LiveEditors()
                        If editor <> Nil Then
                            If editor.MacIsFirstResponder(window) Then
                                If editor.AskShortcut(StudioCodeEditor.ChordFor(commandHeld, optionHeld, (modifiers And 131072) <> 0, chordKey), True) Then Return Nil
                            End If
                        End If
                    Next
                End If
            End If
            Dim command As String = EditorMacCommand(nativeEvent, modifiers)
            If command = "" Then Return nativeEvent
            For Each editor As StudioCodeEditor In StudioEditorRegistry.LiveEditors()
                If editor <> Nil Then
                    If editor.MacIsFirstResponder(window) Then
                        If editor.NativeKey(command, (modifiers And 131072) <> 0) Then Return Nil
                    End If
                End If
            Next
            Return nativeEvent
        End If
    Catch e As Exception
        Return nativeEvent
    End Try
    Return nativeEvent
End Function
#End If

Public Class StudioEditorProblemWindow Inherits Window
    Private Property Disposing As Boolean = False
    Public Property Details As TextArea = New TextArea()
    Public Sub Constructor()
        Super.Constructor()
        Me.Title = "Line Problems"
        Me.Move(180, 160, 640, 320)
        Me.Details.IsReadOnly = True
        Me.Details.Move(12, 12, 616, 296)
        Me.AddSubview(Me.Details)
    End Sub
    Handle Resized(width As Double, height As Double, finished As Boolean)
        Me.Details.Move(12, 12, Math.Max(1, Me.Width - 24), Math.Max(1, Me.Height - 24))
    End Handle
    Public Sub Dispose()
        Me.Disposing = True
        Me.Close()
    End Sub
    Handle Closing() As Boolean
        If Me.Disposing Then Return False
        Me.Visible = False
        Return True
    End Handle
End Class
