    Private Property mEditEnd As Integer = -1
    Private Property mContinuesTyping As Boolean = False
    ' Multi-cursor: the primary selection is (mAnchor, mCaret); the others are kept here
    ' as parallel anchor/caret arrays (normalized: sorted, non-overlapping).
    Private Property mExtraAnchors As Array Of Integer = []
    Private Property mExtraCarets As Array Of Integer = []
    ' A per-cursor command runs once per selection with every selection held here, so
    ' each edit can shift the selections it does not own (ReplaceRange).
    Private Property mBatch As Boolean = False
    Private Property mBatchAnchors As Array Of Integer = []
