Import textmodel
Import textinputcanvas
Import StudioSyntax
Import StudioFindEngine
Import StudioAppearance
Import StudioEditorTransforms
Import StudioEditorCommands
Import StudioSnippetTypes
Import StudioEditorWrap
Import StudioSpelling
Import StudioInlineEdits

' Studio's source editor: a TextInputCanvas (native IME on macOS/Windows/GTK) that
' draws Buoy with the documentation viewer's colours (documentation.html --t-*),
' a line-number gutter, current-line highlight, selection and caret. The document
' is kept as lines with cached per-line tokens and block-comment state, and only
' visible lines are tokenized and drawn. The host owns undo: Primary+Z/Y raise
' UndoRequested and the host replaces Text with the restored content.
'
' Text is laid out on a monospace cell grid: wide (CJK, emoji) characters take two
' cells, combining marks and ZWJ/flag sequences share their base character's cell and
' the caret never stops inside such a cluster (StudioLineLayout). Positions, columns
' and lengths in this API count Unicode codepoints unless a name says otherwise.

Private Function EditorHex(value As Integer) As Color
    Return Color.FromBytes((value \ 65536) And 255, (value \ 256) And 255, value And 255)
End Function

Private Function EditorHexDigit(code As Integer) As Integer
    If code >= 48 And code <= 57 Then Return code - 48
    If code >= 65 And code <= 70 Then Return code - 55
    If code >= 97 And code <= 102 Then Return code - 87
    Return 0
End Function

Private Function EditorCommonPrefix(a As String, b As String) As Integer
    Dim left As Array Of String = String.Chars(a)
    Dim right As Array Of String = String.Chars(b)
    Dim count As Integer = 0
    While count < Array.Count(left) And count < Array.Count(right)
        If String.Asc(left(count)) <> String.Asc(right(count)) Then Exit While
        count += 1
    End While
    Return count
End Function

''' Length plus two polynomial hashes of a text's UTF-8 bytes: a cheap identity for
''' "the document is back at this exact text" (collisions only mis-place a caret).
Private Function EditorTextFingerprint(value As String) As String
    Dim data As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    Dim first As Integer = 0
    Dim second As Integer = 7
    For i As Integer = 0 To data.Count - 1
        Dim code As Integer = data.Item(i)
        first = (first * 31 + code) Mod 2147483647
        second = (second * 131 + code) Mod 1000000007
    Next
    Return String.From(data.Count) + ":" + String.From(first) + ":" + String.From(second)
End Function

Private Function EditorIsWordCode(code As Integer) As Boolean
    Return (code >= 48 And code <= 57) Or (code >= 65 And code <= 90) Or (code >= 97 And code <= 122) Or code = 95 Or code > 127
End Function

''' Where a line lands when lines [first, lastRemoved] become [first, newLast]. Lines in
''' the edited span stay put (clamped), or follow the span's end when text was inserted
''' before them (`followEnd`).
Private Function EditorShiftedLine(line As Integer, first As Integer, lastRemoved As Integer, newLast As Integer, delta As Integer, followEnd As Boolean) As Integer
    If line > lastRemoved Then Return line + delta
    If line < first Then Return line
    If followEnd Then Return newLast
    Return Math.Min(line, newLast)
End Function

''' Where a line lands when [first, last] rotates by one (Move Lines Up/Down).
Private Function EditorRotatedLine(line As Integer, first As Integer, last As Integer, down As Boolean) As Integer
    If line < first Or line > last Then Return line
    If down Then
        If line = last Then Return first
        Return line + 1
    End If
    If line = first Then Return last
    Return line - 1
End Function

Private Function EditorSameLines(a As Array Of Integer, b As Array Of Integer) As Boolean
    If Array.Count(a) <> Array.Count(b) Then Return False
    For i As Integer = 0 To Array.LastIndex(a)
        If a(i) <> b(i) Then Return False
    Next
    Return True
End Function

''' Pops fold-scan block entries until `keep` remain.
Private Sub EditorTruncateFolds(ByRef lines As Array Of Integer, ByRef kinds As Array Of String, ByRef segments As Array Of Integer, keep As Integer)
    While Array.Count(lines) > Math.Max(0, keep)
        Array.RemoveAt(lines, Array.LastIndex(lines))
        Array.RemoveAt(kinds, Array.LastIndex(kinds))
        Array.RemoveAt(segments, Array.LastIndex(segments))
    Wend
End Sub

Private Function EditorContainsSorted(lines As Array Of Integer, value As Integer) As Boolean
    Dim lo As Integer = 0
    Dim hi As Integer = Array.LastIndex(lines)
    While lo <= hi
        Dim middle As Integer = (lo + hi) \ 2
        If lines(middle) = value Then Return True
        If lines(middle) < value Then
            lo = middle + 1
        Else
            hi = middle - 1
        End If
    Wend
    Return False
End Function

Private Function EditorUniqueSorted(lines As Array Of Integer) As Array Of Integer
    Dim sorted As Array Of Integer = Array.Clone(lines)
    Array.Sort(sorted)
    Dim unique As Array Of Integer = []
    For Each line As Integer In sorted
        If Array.Count(unique) = 0 Then
            Array.Append(unique, line)
        ElseIf Array.Last(unique) <> line Then
            Array.Append(unique, line)
        End If
    Next
    Return unique
End Function

''' For every codepoint offset 0..Len(value) of `value`, the matching offset once CRLF
''' and lone CR are normalized to LF (the editor's Normalize). An offset between the CR
''' and LF of a CRLF pair maps to that line break's start. Other characters (including
''' U+2028/U+2029/U+0085) are kept one for one.
Private Function EditorLineBreakOffsetMap(value As String) As Array Of Integer
    Dim chars As Array Of String = String.Chars(value)
    Dim map As Array Of Integer = []
    Dim normal As Integer = 0
    Dim c As Integer = 0
    While c < Array.Count(chars)
        Array.Append(map, normal)
        If chars(c) = "\r" And c + 1 < Array.Count(chars) Then
            If chars(c + 1) = "\n" Then
                Array.Append(map, normal)
                c += 1
            End If
        End If
        normal += 1
        c += 1
    Wend
    Array.Append(map, normal)
    Return map
End Function

Public Enum StudioMarkerSeverity As Integer
    Failure = 0
    Warning = 1
    Note = 2
    Hint = 3
End Enum

Public Function StudioMarkerSeverityFromLsp(severity As Integer) As StudioMarkerSeverity
    Select Case severity
        Case 1
            Return StudioMarkerSeverity.Failure
        Case 2
            Return StudioMarkerSeverity.Warning
        Case 4
            Return StudioMarkerSeverity.Hint
    End Select
    Return StudioMarkerSeverity.Note
End Function

Public Function StudioMarkerSeverityName(severity As StudioMarkerSeverity) As String
    Select Case severity
        Case StudioMarkerSeverity.Failure
            Return "Error"
        Case StudioMarkerSeverity.Warning
            Return "Warning"
        Case StudioMarkerSeverity.Hint
            Return "Hint"
    End Select
    Return "Information"
End Function

''' A diagnostic drawn in the editor (gutter badge, squiggle, inline message). `Line`
''' is 0-based; `Column` and `Length` count codepoints within that line. Length 0
''' marks the whole line's text. Markers move with edits that insert or remove lines.
Public Class StudioEditorMarker
    Public Property Line As Integer
    Public Property Column As Integer
    Public Property Length As Integer
    Public Property Severity As StudioMarkerSeverity
    Public Property Message As String

    Public Sub Constructor(line As Integer, column As Integer, length As Integer, severity As StudioMarkerSeverity, message As String)
        Me.Line = line
        Me.Column = column
        Me.Length = length
        Me.Severity = severity
        Me.Message = message
    End Sub
End Class

''' The word under a click or the caret, for symbol actions (definition, references,
''' documentation). `Name` is the clicked identifier; `QualifiedName` includes its
''' dotted qualifier up to the clicked segment ("String.Trim" when Trim is clicked).
''' `Line`/`Column` (0-based, codepoints) locate the clicked segment's first character.
Public Class StudioEditorSymbol
    Public Property Name As String
    Public Property QualifiedName As String
    Public Property Kind As StudioTokenKind
    Public Property Line As Integer
    Public Property Column As Integer
    Public Property Position As Integer

    ''' True for language keywords (documentation only; they have no definition).
    Public Function IsKeyword() As Boolean
        Return Me.Kind = StudioTokenKind.Keyword Or Me.Kind = StudioTokenKind.Directive Or Me.Kind = StudioTokenKind.Literal
    End Function
End Class

''' Selection and scroll position, for exact restoration after host undo/redo.
''' One selection of a multi-selection editor: `Anchor` is where it started, `Caret`
''' where the cursor is (Caret < Anchor for a backward selection). Codepoint positions.
Public Class StudioEditorSelection
    Public Property Anchor As Integer
    Public Property Caret As Integer

    Public Sub Constructor(anchor As Integer, caret As Integer)
        Me.Anchor = anchor
        Me.Caret = caret
    End Sub

    Public Property Start As Integer
        Get
            Return Math.Min(Me.Anchor, Me.Caret)
        End Get
    End Property

    Public Property Length As Integer
        Get
            Return Math.Abs(Me.Caret - Me.Anchor)
        End Get
    End Property
End Class

Public Class StudioEditorViewState
    Public Property Anchor As Integer
    Public Property Caret As Integer
    ''' Secondary selections (multi-cursor), as flat anchor/caret pairs.
    Public Property Extras As Array Of Integer = []
    Public Property ScrollX As Double
    Public Property ScrollY As Double
    ''' Header lines of collapsed fold regions (0-based).
    Public Property Folded As Array Of Integer = []
    ''' Trimmed text of each Folded header line, parallel to Folded. When present,
    ''' restoring re-finds each header near its saved line (the file may have changed
    ''' since) and drops folds whose header is gone. Empty = trust the line numbers.
    Public Property FoldHeaders As Array Of String = []
End Class

''' One enclosing scope of a line (breadcrumbs, sticky headers, expand selection).
''' `Line`/`EndLine` are 0-based; Kind is the block kind ("function", "class", "if",
''' ...), "property", "indent" or "heading"; Name a short label; Text the header line.
Public Class StudioEditorScope
    Public Property Line As Integer
    Public Property EndLine As Integer
    Public Property Kind As String = ""
    Public Property Name As String = ""
    Public Property Text As String = ""
End Class

''' Short label of a scope header: the declared name for Buoy declarations
''' ("Public Function Greet(x) As String" -> "Greet"), the heading text for Markdown,
''' else the header text (at most 48 characters).
Public Function StudioScopeName(text As String, kind As String, mode As String) As String
    Dim trimmed As String = String.Trim(text)
    If mode = "markdown" Then
        While String.StartsWith(trimmed, "#")
            trimmed = String.Substring(trimmed, 1)
        Wend
        trimmed = String.Trim(trimmed)
    ElseIf mode = "buoy" Then
        Select Case kind
        Case "class", "structure", "enum", "flags enum", "interface", "sub", "function", "property", "namespace", "module", "event", "operator", "get", "set"
            Dim words As Array Of String = String.Split(trimmed, " ")
            Dim i As Integer = 0
            While i < Array.Count(words)
                Select Case String.LCase(words(i))
                Case "public", "private", "protected", "friend", "internal", "shared", "overrides", "overridable", "partial", "static", "async", "inline", "sequential", "packed", "flags", "sub", "function", "class", "structure", "enum", "interface", "property", "namespace", "module", "event", "operator", "", "mustoverride", "notinheritable", "mustinherit", "default", "readonly", "lazy"
                    i += 1
                Case Else
                    Exit While
                End Select
            Wend
            If i < Array.Count(words) Then
                Dim name As String = words(i)
                Dim paren As Integer = String.IndexOf(name, "(")
                If paren > 0 Then name = String.Left(name, paren)
                If name <> "" Then Return name
            End If
            If kind = "get" Or kind = "set" Then Return String.UCase(String.Left(kind, 1)) + String.Substring(kind, 1)
        End Select
    End If
    If String.Len(trimmed) > 48 Then trimmed = String.Left(trimmed, 47) + "…"
    Return trimmed
End Function

''' Cached fold facts of one line (block role, indent, comment-only).
Class StudioFoldLine
    Public Property Info As StudioBlockInfo
    Public Property StartsInComment As Boolean = False
    ''' Leading indentation in cells, -1 for a blank line.
    Public Property Indent As Integer = -1
    ''' Only a `'`/`//` comment (doc comments included).
    Public Property IsComment As Boolean = False
End Class

