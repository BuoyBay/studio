End Function

''' Glyph for a layout control type: a declared glyph key wins, then the manifest
''' mapping, then the package-control or generic fallback.
Public Function StudioGlyphKeyForControl(typeName As String, declared As String = "") As String
    If declared <> "" And StudioGlyphSource(declared) <> "" Then Return declared
    Select Case typeName
        Case "Button"
            Return "control.button"
        Case "Label"
            Return "control.label"
        Case "TextField", "PasswordField"
            Return "control.text-field"
        Case "Checkbox"
            Return "control.checkbox"
        Case "designerwidgets.StatusBadge"
            Return "control.status-badge"
        Case "DisclosureTriangle"
            Return "control.disclosure-triangle"
        Case "TextArea"
            Return "control.text-area"
        Case "ComboBox", "PopupMenu"
            Return "control.combo-box"
        Case "RadioGroup"
            Return "control.radio-group"
        Case "Slider"
            Return "control.slider"
        Case "Stepper"
            Return "control.stepper"
        Case "DateTimePicker", "DatePicker"
            Return "control.date-time-picker"
        Case "View"
            Return "control.view"
        Case "GroupBox"
            Return "control.group-box"
        Case "TabView"
            Return "control.tab-view"
        Case "PagePanel"
            Return "control.page-panel"
        Case "ProgressBar"
            Return "control.progress-bar"
        Case "ListBox"
            Return "control.list-box"
        Case "ImageView"
            Return "control.image-view"
        Case "Canvas"
            Return "control.canvas"
        Case "HTMLView"
            Return "control.html-view"
        Case "Window"
            Return "control.window"
        Case "RadioButton"
            Return "control.radio-button"
        Case "StackView"
            Return "control.stack-view"
        Case "Splitter"
            Return "control.splitter"
        Case "Toolbar"
            Return "control.toolbar"
        Case "MenuBar"
            Return "control.menu-bar"
        Case "NumericField", "NumberBox"
            Return "control.number-box"
        Case "TreeView"
            Return "control.tree-view"
        Case "SearchField"
            Return "control.search-field"
        Case "SegmentedButton"
            Return "control.segmented-button"
        Case "ScrollView"
            Return "control.scroll-view"
        Case "BevelButton"
            Return "control.bevel-button"
        Case "ColorPicker"
            Return "control.color-picker"
        Case "FontPicker"
            Return "control.font-picker"
        Case "ActivityIndicator"
            Return "control.activity-indicator"
        Case "NativeSeparator"
            Return "control.separator"
        Case "NativePopover"
            Return "control.popover"
        Case "NativeTooltip"
            Return "control.tooltip"
        Case "GTKContextMenu"
            Return "control.context-menu"
    End Select
    If String.Contains(typeName, ".") Then Return "control.package"
    Return "control.generic"
End Function

''' Glyph for a project item by its relative path. Layout sources are decided by
''' the caller, because only a parsed document knows it holds a Window or View.
Public Function StudioGlyphKeyForItem(relativePath As String, isLayout As Boolean) As String
    If isLayout Then Return "file.layout"
    Dim name As String = String.LCase(relativePath)
    Dim slash As Integer = String.InStrRev(name, "/")
    If slash > 0 Then name = String.Substring(name, slash)
    If name = "main.bui" Then Return "file.entry"
    If String.EndsWith(name, "_test.bui") Then Return "file.test"
    If String.EndsWith(name, ".bui") Then Return "file.source"
    If String.EndsWith(name, ".buipkg") Then Return "project.library"
    If String.EndsWith(name, ".json") Then Return "file.config"
    If String.EndsWith(name, ".plist") Then Return "file.config"
    If String.EndsWith(name, ".toml") Then Return "file.config"
    If String.EndsWith(name, ".yaml") Then Return "file.config"
    If String.EndsWith(name, ".yml") Then Return "file.config"
    If String.EndsWith(name, ".md") Then Return "file.text"
    If String.EndsWith(name, ".txt") Then Return "file.text"
    If String.EndsWith(name, ".png") Then Return "file.image"
    If String.EndsWith(name, ".svg") Then Return "file.image"
    If String.EndsWith(name, ".jpg") Then Return "file.image"
    If String.EndsWith(name, ".jpeg") Then Return "file.image"
    If String.EndsWith(name, ".icns") Then Return "file.image"
    If String.EndsWith(name, ".ico") Then Return "file.image"
    If String.EndsWith(name, ".html") Then Return "file.source"
    If String.EndsWith(relativePath, "/") Then Return "file.folder"
    Return "file.document"
End Function

''' Rasterizes a glyph for the current appearance. sizePx is the pixel size;
''' unknown keys render the last-resort fallback glyph instead of Nil.
Public Function StudioGlyph(key As String, sizePx As Integer, dark As Boolean) As Picture
    Dim source As String = StudioGlyphSource(key)
    If source = "" Then source = StudioGlyphSource("status.unknown")
    Dim tint As String = "#3c3c43"
    If dark Then tint = "#e8e8e8"
    Return Picture.FromSVG(Bytes.FromString(String.Replace(source, "currentColor", tint), Text.Encodings.UTF8), sizePx, sizePx)
End Function

''' A small glyph slot. Rasterizes at twice the point size so the glyph stays
''' crisp on HiDPI displays, and caches until the key, size or appearance changes.
Public Class StudioGlyphView Inherits Canvas
    Private Property mKey As String
    Private Property mDark As Boolean = False
    Private Property mImage As Picture
    Private Property mRenderedPixels As Integer = 0
    Public Property Key As String
        Get
            Return Me.mKey
        End Get
        Set
            If value = Me.mKey Then Return
            Me.mKey = value
            Me.mImage = Nil
            Me.Invalidate()
        End Set
    End Property
    Public Property Dark As Boolean
        Get
            Return Me.mDark
        End Get
        Set
            If value = Me.mDark Then Return
            Me.mDark = value
            Me.mImage = Nil
            Me.Invalidate()
        End Set
    End Property
    Handle Paint(g As Graphics)
        If Me.mKey = "" Then Return
        Dim side As Integer = Math.Min(Me.Width, Me.Height)
        If side < 1 Then Return
        If Me.mImage = Nil Or Me.mRenderedPixels <> side * 2 Then
            Me.mImage = StudioGlyph(Me.mKey, side * 2, Me.mDark)
            Me.mRenderedPixels = side * 2
        End If
        If Me.mImage <> Nil Then g.DrawPicture(Me.mImage, (Me.Width - side) / 2.0, (Me.Height - side) / 2.0, side, side)
    End Handle
End Class
