{
  "schema": "buoy.iconset",
  "schemaVersion": 1,
  "name": "buoy-glyphs",
  "version": "1.0.0",
  "grid": {
    "viewBox": "0 0 24 24",
    "liveArea": [
      2,
      22
    ],
    "strokeWidth": 1.75,
    "linecap": "round",
    "linejoin": "round",
    "tint": "currentColor",
    "renderSizes": [
      16,
      20,
      24
    ],
    "minimumOpacity": 0.2,
    "secondaryOpacity": 0.45
  },
  "resolution": [
    "declared: a plugin.json control \"icon\" (or a caller-supplied key) that names a glyph in this manifest",
    "mapping: controls / items / navigator / projectTypes / symbols tables below",
    "category fallback: fallbacks[category]; a package-qualified control type (contains \".\") uses fallbacks.packageControl",
    "last resort: fallbacks.any"
  ],
  "fallbacks": {
    "control": "control.generic",
    "packageControl": "control.package",
    "item": "file.document",
    "project": "brand.buoy",
    "symbol": "symbol.module",
    "any": "status.unknown"
  },
  "controls": {
    "catalog": {
      "Button": "control.button",
      "Label": "control.label",
